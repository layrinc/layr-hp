---
/**
 * サイト管理ダッシュボード（WordPressの管理画面ホーム相当）。
 * ビルド時に data/*.json と記事から自動生成されるので、常に最新の状態を映す。
 * 検索エンジンには載せない（noindex ＋ robots.txt ＋ sitemap除外）。
 */
import '../styles/style.css';
import { getCollection } from 'astro:content';
import settings from '../data/settings.json';
import stats from '../data/stats.json';
import cases from '../data/cases.json';
import message from '../data/message.json';
import theme from '../data/theme.json';

// 記事（下書き含む全件・新しい順）
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const published = posts.filter((p) => !p.data.draft);
const drafts = posts.filter((p) => p.data.draft);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// 最終ビルド（＝デプロイ）日時
const builtAt = new Date().toLocaleString('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
});

// ===== やることリスト（サイトヘルス）を自動判定 =====
type Task = { label: string; hint: string; link: string };
const tasks: Task[] = [];
if (stats.show_edit_note)
  tasks.push({ label: '実績数値がサンプルのまま', hint: '実案件の数値に差し替えて「注意書き」をOFFに', link: '/admin/#/collections/site/entries/stats' });
if (cases.show_edit_note)
  tasks.push({ label: '支援実績（CASE）がサンプルのまま', hint: '実案件に差し替えて「注意書き」をOFFに', link: '/admin/#/collections/site/entries/cases' });
if (!message.photo)
  tasks.push({ label: '代表写真が未設定', hint: '代表挨拶に写真を入れると信頼感が上がる', link: '/admin/#/collections/site/entries/message' });
if (!settings.line_url)
  tasks.push({ label: 'LINE友だち追加URLが未設定', hint: '設定するとサイト全体の緑ボタンがLINE直行になる', link: '/admin/#/collections/site/entries/settings' });
if (!(settings as any).og_image)
  tasks.push({ label: 'SNSシェア画像（OGP）が未設定', hint: 'シェアされた時の見栄えに直結', link: '/admin/#/collections/site/entries/settings' });
if (drafts.length > 0)
  tasks.push({ label: `下書きの記事が${drafts.length}本ある`, hint: '仕上げて公開する', link: '/admin/#/collections/blog' });

// ===== クイック編集（管理画面の各セクションへの直リンク） =====
const sections = [
  ['① 基本設定', 'settings'], ['② ヒーロー', 'hero'], ['③ 実績数値', 'stats'],
  ['④ 支援実績', 'cases'], ['⑤ お約束', 'promise'], ['⑥ 代表挨拶', 'message'],
  ['⑦ FAQ', 'faq'], ['⑧ 会社概要', 'company'], ['⑨ デザイン設定', 'theme'],
  ['⑩ お悩み', 'problem'], ['⑪ 事業内容', 'service'], ['⑫ 選ばれる理由', 'reason'],
  ['⑬ CTA', 'cta'],
] as const;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>サイト管理ダッシュボード｜LAYR CMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
</head>
<body class="dash-body">
  <div class="dash">

    <header class="dash-head">
      <div>
        <p class="dash-brand">LAYR <span>CMS</span></p>
        <h1>サイト管理ダッシュボード</h1>
      </div>
      <div class="dash-head-links">
        <a class="dash-btn ghost" href="/" target="_blank">サイトを見る ↗</a>
        <a class="dash-btn primary" href="/admin/#/collections/blog/new">＋ 新規記事を書く</a>
      </div>
    </header>

    <!-- ===== 状態カード ===== -->
    <div class="dash-cards">
      <div class="dash-card">
        <p class="num">{published.length}<small>本</small></p>
        <p class="cap">公開中の記事</p>
      </div>
      <div class="dash-card">
        <p class="num">{drafts.length}<small>本</small></p>
        <p class="cap">下書き</p>
      </div>
      <div class="dash-card">
        <p class="num">{tasks.length}<small>件</small></p>
        <p class="cap">やること</p>
      </div>
      <div class="dash-card">
        <p class="num small">{builtAt}</p>
        <p class="cap">最終更新（デプロイ）</p>
      </div>
    </div>

    <div class="dash-grid">

      <!-- ===== やることリスト ===== -->
      <section class="dash-panel">
        <h2>やることリスト <span class="dash-tag">自動判定</span></h2>
        {tasks.length === 0 ? (
          <p class="dash-done">✅ 全部完了。サイトは営業に出せる状態です。</p>
        ) : (
          <ul class="dash-tasks">
            {tasks.map((t) => (
              <li>
                <a href={t.link}>
                  <strong>{t.label}</strong>
                  <span>{t.hint}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <!-- ===== クイック編集 ===== -->
      <section class="dash-panel">
        <h2>クイック編集 <span class="dash-tag">トップページの各部分</span></h2>
        <div class="dash-chips">
          {sections.map(([label, name]) => (
            <a class="dash-chip" href={`/admin/#/collections/site/entries/${name}`}>{label}</a>
          ))}
        </div>
        <div class="dash-links">
          <a href="/admin/">🔧 管理画面を開く</a>
          <a href="https://github.com/layrinc/company-brain/actions" target="_blank" rel="noopener">⚙️ デプロイ状況（GitHub Actions）↗</a>
          <a href="https://vercel.com/ikkan-kawades-projects/layr-hp" target="_blank" rel="noopener">▲ Vercel ↗</a>
        </div>
      </section>

    </div>

    <!-- ===== 記事一覧 ===== -->
    <section class="dash-panel">
      <h2>記事一覧 <span class="dash-tag">{posts.length}本</span></h2>
      <table class="dash-table">
        <thead><tr><th>タイトル</th><th>日付</th><th>カテゴリ</th><th>状態</th><th></th></tr></thead>
        <tbody>
          {posts.map((p) => (
            <tr>
              <td class="ttl">{p.data.title}</td>
              <td>{fmt(p.data.date)}</td>
              <td><span class="cat">{p.data.category}</span></td>
              <td>{p.data.draft ? <span class="st draft">下書き</span> : <span class="st live">公開中</span>}</td>
              <td class="acts">
                <a href={`/admin/#/collections/blog/entries/${p.id}`}>編集</a>
                {!p.data.draft && <a href={`/blog/${p.id}/`} target="_blank">表示 ↗</a>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <p class="dash-foot">テーマ: {theme.font_en} ／ メインカラー <span class="sw" style={`background:${theme.accent}`}></span> {theme.accent} ／ ドメイン layr.co.jp ／ 保存＝自動公開（約1分）</p>

  </div>

<style>
  .dash-body{background:#F3F5F4;min-height:100vh}
  .dash{max-width:1040px;margin:0 auto;padding:36px 20px 60px;font-size:14px}
  .dash-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:22px}
  .dash-brand{font-family:var(--font-en);font-weight:800;font-size:13px;letter-spacing:.18em;color:var(--muted)}
  .dash-brand span{color:var(--green-dark)}
  .dash-head h1{font-size:22px;font-weight:900;margin-top:2px}
  .dash-head-links{display:flex;gap:10px}
  .dash-btn{display:inline-block;padding:10px 18px;border-radius:8px;font-weight:700;font-size:13px}
  .dash-btn.primary{background:var(--green);color:#fff}
  .dash-btn.primary:hover{background:var(--green-dark)}
  .dash-btn.ghost{background:#fff;border:1px solid var(--line);color:var(--text)}
  .dash-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px}
  .dash-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px 20px}
  .dash-card .num{font-family:var(--font-en);font-weight:800;font-size:30px;line-height:1.2;color:var(--text)}
  .dash-card .num.small{font-size:15px;padding:8px 0 7px}
  .dash-card .num small{font-size:13px;margin-left:2px;font-weight:700}
  .dash-card .cap{color:var(--muted);font-size:12px;font-weight:700;margin-top:2px}
  .dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
  .dash-panel{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px 22px;margin-bottom:14px}
  .dash-panel h2{font-size:15px;font-weight:900;margin-bottom:14px}
  .dash-tag{font-size:11px;font-weight:700;color:var(--muted);background:#F3F5F4;border-radius:999px;padding:3px 10px;margin-left:8px;vertical-align:middle}
  .dash-done{color:var(--green-dark);font-weight:700}
  .dash-tasks{display:flex;flex-direction:column;gap:8px}
  .dash-tasks a{display:block;background:#FFF9F0;border:1px solid #F0DFC0;border-radius:10px;padding:11px 14px;color:var(--text);text-decoration:none}
  .dash-tasks a:hover{border-color:var(--green)}
  .dash-tasks strong{display:block;font-size:13.5px}
  .dash-tasks span{font-size:12px;color:var(--muted)}
  .dash-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
  .dash-chip{background:#F3F5F4;border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:12.5px;font-weight:700;color:var(--text);text-decoration:none}
  .dash-chip:hover{border-color:var(--green);color:var(--green-dark)}
  .dash-links{display:flex;flex-direction:column;gap:8px;border-top:1px dashed var(--line);padding-top:12px}
  .dash-links a{color:var(--text);font-weight:700;font-size:13px;text-decoration:none}
  .dash-links a:hover{color:var(--green-dark)}
  .dash-table{width:100%;border-collapse:collapse}
  .dash-table th{text-align:left;font-size:11.5px;color:var(--muted);font-weight:700;padding:6px 10px;border-bottom:1px solid var(--line)}
  .dash-table td{padding:11px 10px;border-bottom:1px solid #F0F2F1;vertical-align:middle}
  .dash-table .ttl{font-weight:700;font-size:13.5px}
  .cat{font-size:11.5px;font-weight:700;color:var(--green-dark);background:var(--green-pale);border-radius:4px;padding:3px 9px}
  .st{font-size:11.5px;font-weight:800;border-radius:4px;padding:3px 9px}
  .st.live{color:var(--green-dark);background:var(--green-pale)}
  .st.draft{color:#9C640C;background:#FDF3E7}
  .acts a{font-weight:700;color:var(--green-dark);margin-right:12px;text-decoration:none}
  .dash-foot{color:var(--muted);font-size:12px;margin-top:6px}
  .sw{display:inline-block;width:11px;height:11px;border-radius:3px;vertical-align:-1px}
  @media (max-width:760px){
    .dash-cards{grid-template-columns:1fr 1fr}
    .dash-grid{grid-template-columns:1fr}
    .dash-table th:nth-child(3),.dash-table td:nth-child(3){display:none}
  }
</style>
</body>
</html>
