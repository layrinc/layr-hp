---
/**
 * LINE構築・運用サービス LP（/service/line/）
 * 正式版サービス概要資料（24P）の流れをそのままLP化。
 * 動的ルート [...page].astro からは 'service/line' を除外済み。
 */
import Base from '../../layouts/Base.astro';
import settings from '../../data/settings.json';
import { ISO } from '../../lib/iso-illusts.mjs';

const title = 'LINE公式アカウント構築・運用代行｜料金と事例｜株式会社LAYR';
const description = 'LINEを活用し売上最大化をサポート。構築代行（ライト10万円〜）と運用代行（月3万円〜）を、設計から配信・改善までワンストップで。開封率・クリック率の高いLINEで、地方中小企業の集客・リピート・採用を仕組み化します。';
const docHref = '/document/line-service/';
const consult = settings.line_url?.trim()
  ? settings.line_url
  : `mailto:${settings.email}?subject=${encodeURIComponent('【無料相談】LINE活用について')}`;

const faqs = [
  { q: '運用費用以外に発生する費用はありますか？', a: '本サービスへの報酬とは別に、LINE公式アカウントの月額利用料と、Lステップの月額システム利用料（配信通数に応じたプラン料金）が、それぞれの運営会社に対して発生します。' },
  { q: 'すでにLINE公式アカウントやLステップを導入していても依頼できますか？', a: '問題ありません。すでに運用中のアカウントの改修や、既存の友だちリストを保持したままのLステップ導入も可能です。' },
  { q: 'クリエイティブ（画像制作や文章作成）も任せられますか？', a: 'はい。リッチメニューのデザイン制作や、配信メッセージのライティング、シナリオ設計までワンストップで対応いたします。' },
  { q: '構築だけ・運用だけの依頼もできますか？', a: '可能です。構築のみ・運用のみ、どちらも承ります。構築後に社内運用へ引き継ぐ形にも対応します。' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://layr.co.jp/' },
      { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://layr.co.jp/service/' },
      { '@type': 'ListItem', position: 3, name: 'LINE構築・運用' },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'Service', '@id': 'https://layr.co.jp/#service-line',
    name: 'LINE公式アカウント構築・運用代行', serviceType: 'LINEマーケティング支援',
    provider: { '@id': 'https://layr.co.jp/#organization' }, areaServed: 'JP', url: 'https://layr.co.jp/service/line/',
    hasOfferCatalog: {
      '@type': 'OfferCatalog', name: 'LINE構築・運用プラン',
      itemListElement: [
        { '@type': 'Offer', name: '構築 ライト', priceSpecification: { '@type': 'PriceSpecification', price: 100000, priceCurrency: 'JPY' } },
        { '@type': 'Offer', name: '構築 スタンダード', priceSpecification: { '@type': 'PriceSpecification', price: 250000, priceCurrency: 'JPY' } },
        { '@type': 'Offer', name: '構築 プレミアム', priceSpecification: { '@type': 'PriceSpecification', price: 400000, priceCurrency: 'JPY' } },
        { '@type': 'Offer', name: '運用 サポート', priceSpecification: { '@type': 'UnitPriceSpecification', price: 30000, priceCurrency: 'JPY', unitText: '月' } },
        { '@type': 'Offer', name: '運用 スタンダード', priceSpecification: { '@type': 'UnitPriceSpecification', price: 50000, priceCurrency: 'JPY', unitText: '月' } },
        { '@type': 'Offer', name: '運用 戦略', priceSpecification: { '@type': 'UnitPriceSpecification', price: 100000, priceCurrency: 'JPY', unitText: '月' } },
      ],
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="subpage-pad"></div>

  <!-- HERO -->
  <section class="lp-hero">
    <div class="container lp-hero-in">
      <div class="lp-hero-txt">
        <p class="lp-eyebrow"><i></i>LINE / Lステップ 構築・運用代行</p>
        <h1>LINEを活用し、<br /><span class="mk">売上最大化</span>をサポート。</h1>
        <p class="lp-lead">開封率もクリック率もメールを圧倒するLINEを、設計・構築から毎月の配信・改善までワンストップで。「作って終わり」にしない、成果につながるLINEマーケティングを代行します。</p>
        <div class="lp-cta">
          <a class="btn btn-green btn-lg" href={docHref}>サービス資料をダウンロード</a>
          <a class="btn btn-line btn-lg" href={consult}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11c0 3.9 3.5 7.2 8.2 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5 1.1-.4 5.8-3.4 7.9-5.8 1.4-1.6 2.2-3.2 2.2-5C22 6.6 17.5 3 12 3z"/></svg>
            LINEで相談する
          </a>
        </div>
      </div>
      <div class="lp-hero-fig" aria-hidden="true"><span class="lp-blob"></span><Fragment set:html={ISO.phone} /></div>
    </div>
  </section>

  <!-- 01 数字で見るLINE -->
  <section class="lp-sec lp-stats">
    <div class="container">
      <div class="lp-head"><p class="lp-num">01</p><h2>数字で見る、LINEの活用状況</h2></div>
      <div class="lp-stat-grid">
        <div class="lp-stat"><p class="lp-stat-v">9,600<small>万人</small></p><p class="lp-stat-l">国内No.1の月間アクティブユーザー</p><p class="lp-stat-s">日本の人口の約80%が使う「生活インフラ」</p></div>
        <div class="lp-stat"><p class="lp-stat-v">90.3<small>%</small></p><p class="lp-stat-l">全世代へ届く利用率</p><p class="lp-stat-s">10〜60代まで幅広く普及。毎日利用は約85%</p></div>
        <div class="lp-stat"><p class="lp-stat-v">65.5<small>%</small></p><p class="lp-stat-l">開封率（メルマガの約6倍）</p><p class="lp-stat-s">メルマガ約11.2%に対し、圧倒的に読まれる</p></div>
        <div class="lp-stat"><p class="lp-stat-v">33.2<small>%</small></p><p class="lp-stat-l">クリック率（メルマガの約20倍）</p><p class="lp-stat-s">メルマガ約1.6%に対し、行動につながりやすい</p></div>
      </div>
      <p class="lp-note">※ LINEヤフー社の公表値等をもとにした一般的な参考数値です。</p>
    </div>
  </section>

  <!-- 02 課題 -->
  <section class="lp-sec lp-tint">
    <div class="container">
      <div class="lp-head"><p class="lp-num">02</p><h2>LINE、こんな状態になっていませんか？</h2></div>
      <div class="lp-cards3">
        <div class="lp-card"><h3>成果につながる導線が不十分</h3><p>リッチメニューや自動応答など、運用を始める前に「どこへ誘導するか」の設計が必要です。ただ配信するだけでは離脱を招きます。</p></div>
        <div class="lp-card"><h3>運用施策のミスマッチ</h3><p>「何を配信すればいいか」が定まらず放置されたアカウント。顧客ニーズと乖離した配信がブロック率を高めている場合も。</p></div>
        <div class="lp-card"><h3>友だち集めができていない</h3><p>運用は始めたものの、HPやSNSとの連携が弱く登録者が増えない。増やす具体策がわからず足踏みしているケースも。</p></div>
      </div>
      <p class="lp-arrow">こういった悩みを、まるごと解決するサービスを提供します。</p>
    </div>
  </section>

  <!-- 03 解決できること -->
  <section class="lp-sec">
    <div class="container">
      <div class="lp-head"><p class="lp-num">03</p><h2>LAYRが解決できること</h2></div>
      <div class="lp-cards3">
        <div class="lp-card up"><span class="lp-ic" set:html={ISO.build} /><h3>高品質×低コストで制作</h3><p>初期費用を抑えつつ、成果の出るハイクオリティなアカウントを構築します。</p></div>
        <div class="lp-card up"><span class="lp-ic" set:html={ISO.consult} /><h3>専門スタッフが運用をサポート</h3><p>企画や配信代行まで担うので、リソース不足でも成果の出る運用を実現します。</p></div>
        <div class="lp-card up"><span class="lp-ic" set:html={ISO.crowd} /><h3>集客施策までサポート</h3><p>必要な施策やコンテンツ制作を支援し、友だち数を最大化させます。</p></div>
      </div>
      <p class="lp-arrow">高品質×低コスト。構築から運用まで、担当スタッフに丸投げOK。</p>
    </div>
  </section>

  <!-- 04 PDCA / できること -->
  <section class="lp-sec lp-tint">
    <div class="container">
      <div class="lp-head"><p class="lp-num">04</p><h2>標準機能で「土台」、Lステップで「成果」を最大化</h2></div>
      <p class="lp-sub">LINE公式アカウントの基本機能で情報発信の土台を整え、Lステップの拡張機能で「誰が・いつ・どのボタンを押したか」を可視化。データに基づくPDCAを高速で回します。</p>
      <div class="lp-two">
        <div class="lp-feat">
          <p class="lp-feat-h">LINE公式アカウント</p>
          <ul>
            <li><b>1対1チャット</b>顧客と直接メッセージをやり取り</li>
            <li><b>自動応答メッセージ</b>特定キーワードに自動で即答</li>
            <li><b>リッチメニュー</b>トーク下の画像ボタンでサイト・クーポンへ誘導</li>
            <li><b>クーポン・カード</b>割引券やポイントカードをデジタル発行</li>
            <li><b>LINE広告</b>アプリ内で友だち登録を促す広告</li>
          </ul>
        </div>
        <div class="lp-feat is-green">
          <p class="lp-feat-h">Lステップ</p>
          <ul>
            <li><b>アンケートパネル</b>自由度の高いフォームで顧客情報を収集</li>
            <li><b>高度なセグメンテーション</b>行動履歴や属性で絞った精密配信</li>
            <li><b>ステップシナリオ配信</b>登録日からの日数で複数メッセージを自動送信</li>
            <li><b>詳細な分析レポート</b>流入経路や反応率を可視化</li>
            <li><b>カレンダー予約機能</b>予約受付からリマインドまでLINEで完結</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 3つのサービス -->
  <section class="lp-sec">
    <div class="container">
      <div class="lp-head"><p class="lp-num">05</p><h2>3つのアプローチで解決します</h2></div>
      <div class="lp-cards3">
        <div class="lp-svc"><span class="lp-svc-n">01</span><h3>LINE公式 / Lステップ 構築代行</h3><p>売上に直結する導線設計からリッチメニュー制作まで一括対応。即戦力となるアカウントを構築します。</p><div class="lp-flow"><span>リサーチ</span><i>›</i><span>アカウント設計</span><i>›</i><span>構築</span></div></div>
        <div class="lp-svc"><span class="lp-svc-n">02</span><h3>LINEマーケティング運用代行</h3><p>配信代行から数値分析、改善提案まで丸投げOK。データに基づく運用でLTV（顧客生涯価値）を最大化します。</p><div class="lp-flow"><span>運用</span><i>›</i><span>効果測定</span><i>›</i><span>定例MTG</span><i>›</i><span>改善</span></div></div>
        <div class="lp-svc"><span class="lp-svc-n">03</span><h3>アカウントコンサル</h3><p>貴社の「LINE戦略担当」として自走を支援。最新トレンドやAI活用を取り入れ、成果を出し続ける仕組みを作ります。</p><div class="lp-flow"><span>戦略設計</span><i>›</i><span>伴走</span><i>›</i><span>内製化</span></div></div>
      </div>
    </div>
  </section>

  <!-- 06 事例 -->
  <section class="lp-sec lp-tint">
    <div class="container">
      <div class="lp-head"><p class="lp-num">06</p><h2>LINE活用事例</h2></div>
      <div class="lp-cases">
        <div class="lp-case">
          <p class="lp-case-tag">美容サロン</p>
          <h3>リマインド配信で再来店率向上と売上拡大</h3>
          <p>来店時にQRでポイントを付与する「LINEポイントカード」を導入。3ヶ月以上来店のない顧客へ自動リマインドを送る仕組みを構築しました。</p>
          <div class="lp-case-metric"><span class="before">月商 50万円</span><span class="arrow">→</span><span class="after">約77万円<small>（1.5倍以上）</small></span></div>
          <div class="lp-tags"><span>売上アップ</span><span>広告費削減</span><span>CVRアップ</span></div>
        </div>
        <div class="lp-case">
          <p class="lp-case-tag">クリニック</p>
          <h3>予約自動化による集患と利便性向上</h3>
          <p>YouTube・HPからの流入をLINEに集約。24時間365日対応のカレンダー予約から来院確認、アフターケアまでをLINEで一括管理しました。</p>
          <div class="lp-case-metric"><span class="after">初月からLINE経由の予約が50件<small>／以降も毎月20件超</small></span></div>
          <div class="lp-tags"><span>集患</span><span>予約自動化</span><span>業務効率化</span></div>
        </div>
      </div>
      <p class="lp-note">※ 支援事例の一例です。成果は業種・条件により異なります。</p>
    </div>
  </section>

  <!-- 07 構築プラン -->
  <section class="lp-sec" id="price">
    <div class="container">
      <div class="lp-head"><p class="lp-num">07</p><h2>構築プラン一覧</h2></div>
      <div class="lp-plans">
        <div class="lp-plan">
          <p class="lp-plan-en">LIGHT</p><p class="lp-plan-jp">ライト</p><p class="lp-plan-for">まずは形を整えたい方</p>
          <p class="lp-plan-price">10<small>万円</small></p>
          <ul><li>初期基本設定</li><li>拡張ツール連携</li><li>あいさつメッセージ</li><li>リッチメニュー（1枚）</li><li>キーワード応答設定</li></ul>
        </div>
        <div class="lp-plan is-rec">
          <span class="lp-rec">おすすめ</span>
          <p class="lp-plan-en">STANDARD</p><p class="lp-plan-jp">スタンダード</p><p class="lp-plan-for">集客・教育を始めたい向け</p>
          <p class="lp-plan-price">25<small>万円</small></p>
          <ul><li>ライトプラン＋</li><li>導線作成</li><li>リッチメニューデザイン / 設置</li><li>フォーム制作</li><li>ステップ配信（5〜7日間）</li><li>タグ設置</li></ul>
        </div>
        <div class="lp-plan">
          <p class="lp-plan-en">PREMIUM</p><p class="lp-plan-jp">プレミアム</p><p class="lp-plan-for">売上最大化を目指す方向け</p>
          <p class="lp-plan-price">40<small>万円</small></p>
          <ul><li>スタンダードプラン＋</li><li>戦略設計：3C分析・4P分析</li><li>顧客・ターゲット分析</li><li>タブ付きリッチメニュー</li><li>診断コンテンツ制作</li><li>流入経路分析設定</li></ul>
        </div>
      </div>
      <p class="lp-note">※ 価格は税抜です。別途カスタマイズやオプション設定も対応可能です。</p>
    </div>
  </section>

  <!-- 08 運用プラン -->
  <section class="lp-sec lp-tint">
    <div class="container">
      <div class="lp-head"><p class="lp-num">08</p><h2>運用プラン一覧</h2></div>
      <div class="lp-optable">
        <table>
          <thead><tr><th></th><th>サポート</th><th class="mid">スタンダード</th><th>戦略</th></tr></thead>
          <tbody>
            <tr><th>月額料金（税抜）</th><td><b>3万円</b></td><td class="mid"><b>5万円</b></td><td><b>10万円</b></td></tr>
            <tr><th>主な対象</th><td>知見を確保したい方</td><td class="mid">集客・リピートを伸ばしたい方</td><td>売上最大化したい方</td></tr>
            <tr><th>軽微修正・追加作業</th><td>—</td><td class="mid">○</td><td>○</td></tr>
            <tr><th>配信内容の作成</th><td>—</td><td class="mid">○</td><td>○</td></tr>
            <tr><th>メッセージ配信代行</th><td>月2回</td><td class="mid">月4回（週1回）</td><td>月8回（随時対応）</td></tr>
            <tr><th>Zoomコンサル</th><td>—</td><td class="mid">月1回（60分）</td><td>月1回（60分）</td></tr>
            <tr><th>分析レポート</th><td>—</td><td class="mid">○</td><td>○</td></tr>
          </tbody>
        </table>
      </div>
      <p class="lp-note">※ 大幅な修正・追加は別途見積り。配信内容作成は企画・ライティング・画像制作まで承ります。</p>
    </div>
  </section>

  <!-- 09 料金シミュレーション -->
  <section class="lp-sec" id="sim">
    <div class="container lp-narrow">
      <div class="lp-head"><p class="lp-num">09</p><h2>30秒 料金シミュレーション</h2></div>
      <p class="lp-sub">選択式4問で、貴社に合うプランと料金の目安がその場で分かります。</p>
      <div class="sim-card" id="simCard">
        <div class="sim-prog"><span class="on" data-s="1">1</span><i></i><span data-s="2">2</span><i></i><span data-s="3">3</span><i></i><span data-s="4">4</span><i></i><span data-s="5">¥</span></div>
        <div class="sim-step" data-step="1">
          <p class="sim-q">Q1. 業種を教えてください</p>
          <div class="sim-opts">
            <button data-v="store">店舗・飲食</button><button data-v="clinic">クリニック・美容</button><button data-v="ec">EC・通販</button><button data-v="school">スクール・教育</button><button data-v="other">その他・BtoB</button>
          </div>
        </div>
        <div class="sim-step" data-step="2" hidden>
          <p class="sim-q">Q2. LINE公式アカウントの現状は？</p>
          <div class="sim-opts">
            <button data-v="new">これから開設する</button><button data-v="idle">開設済みだが、ほぼ動かせていない</button><button data-v="active">運用中。テコ入れしたい</button>
          </div>
        </div>
        <div class="sim-step" data-step="3" hidden>
          <p class="sim-q">Q3. LINEで一番やりたいことは？</p>
          <div class="sim-opts">
            <button data-v="base">まずは形を整えたい（土台づくり）</button><button data-v="grow">集客・再来店を伸ばしたい</button><button data-v="auto">予約・販売・診断まで自動化したい</button>
          </div>
        </div>
        <div class="sim-step" data-step="4" hidden>
          <p class="sim-q">Q4. 毎月の運用は誰がやりますか？</p>
          <div class="sim-opts">
            <button data-v="self">自社で運用する（構築のみ依頼）</button><button data-v="lite">配信は任せたい（月2回ほど）</button><button data-v="std">週1配信＋分析まで任せたい</button><button data-v="full">戦略から丸ごと任せたい</button>
          </div>
        </div>
        <div class="sim-step" data-step="5" hidden>
          <p class="sim-q sim-result-t">貴社の目安はこちらです</p>
          <div class="sim-result">
            <div class="sim-price"><p class="t">初期構築</p><p class="n" id="simBuildName"></p><p class="v"><em id="simBuild"></em>万円</p></div>
            <div class="sim-plus">＋</div>
            <div class="sim-price"><p class="t">月額運用</p><p class="n" id="simOpsName"></p><p class="v"><em id="simOps"></em></p></div>
          </div>
          <ul class="sim-inc" id="simInc"></ul>
          <p class="sim-note">※ 税抜の目安です。LINE公式アカウント・Lステップの利用料は別途各社へ発生します。正式なお見積もりはヒアリング後に無料でご提示します。</p>
          <div class="sim-cta">
            <a class="btn btn-green" href={docHref}>この内容で資料をダウンロード</a>
            <a class="btn btn-line" href={consult}>LINEで相談する</a>
          </div>
        </div>
        <button class="sim-back" id="simBack" hidden>← ひとつ戻る</button>
      </div>
    </div>
  </section>

  <!-- 10 FAQ -->
  <section class="lp-sec lp-tint">
    <div class="container lp-narrow">
      <div class="lp-head"><p class="lp-num">10</p><h2>よくあるご質問</h2></div>
      <div class="lp-faq">
        {faqs.map((f) => (
          <details class="lp-q"><summary><span class="lp-qmark">Q</span>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    // 料金シミュレーション: 4問 → 構築プラン(Q3基準) + 運用プラン(Q4基準)
    (function () {
      var card = document.getElementById('simCard');
      if (!card || card.dataset.bound) return;
      card.dataset.bound = '1';
      var ans = {};
      var step = 1;
      var BUILD = { base: ['ライト', 10, ['初期基本設定', 'リッチメニュー', 'あいさつ・応答設定']], grow: ['スタンダード', 25, ['導線作成', 'リッチメニューデザイン', 'ステップ配信', 'フォーム制作']], auto: ['プレミアム', 40, ['戦略設計（3C/4P）', 'タブ付きリッチメニュー', '診断コンテンツ', '流入経路分析']] };
      var OPS = { self: ['なし（自社運用）', 0, []], lite: ['サポート', 3, ['配信代行 月2回']], std: ['スタンダード', 5, ['配信 週1回', '配信内容の作成', '分析レポート', 'Zoomコンサル月1回']], full: ['戦略', 10, ['配信 月8回（随時）', '分析レポート', 'Zoomコンサル月1回', '改善提案']] };
      var KEYS = ['industry', 'status', 'goal', 'ops'];
      function show(n) {
        step = n;
        card.querySelectorAll('.sim-step').forEach(function (s) { s.hidden = String(n) !== s.dataset.step; });
        card.querySelectorAll('.sim-prog span').forEach(function (sp, i) {
          sp.className = i + 1 < n ? 'done' : i + 1 === n ? 'on' : '';
        });
        document.getElementById('simBack').hidden = n === 1;
        if (n === 5) render();
      }
      function render() {
        var b = BUILD[ans.goal] || BUILD.base;
        var o = OPS[ans.ops] || OPS.self;
        document.getElementById('simBuildName').textContent = b[0] + 'プラン';
        document.getElementById('simBuild').textContent = b[1];
        document.getElementById('simOpsName').textContent = o[0];
        var ov = document.getElementById('simOps');
        ov.innerHTML = o[1] ? '<em>' + o[1] + '</em>万円/月' : '<em>0</em>円';
        document.getElementById('simInc').innerHTML = b[2].concat(o[2]).map(function (x) { return '<li>' + x + '</li>'; }).join('');
        if (typeof gtag === 'function') gtag('event', 'sim_complete', { industry: ans.industry, build: b[0], ops: o[0] });
      }
      card.querySelectorAll('.sim-step .sim-opts button').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var s = Number(btn.closest('.sim-step').dataset.step);
          ans[KEYS[s - 1]] = btn.dataset.v;
          show(s + 1);
        });
      });
      document.getElementById('simBack').addEventListener('click', function () { if (step > 1) show(step - 1); });
    })();
  </script>

  <!-- CTA -->
  <section class="lp-final">
    <div class="container">
      <p class="lp-final-t">まずは、サービス資料をご覧ください。</p>
      <p class="lp-final-s">料金・事例・進め方をまとめた資料をその場でダウンロードいただけます。無料相談（オンライン30分）も歓迎です。</p>
      <div class="lp-final-cta">
        <a class="btn lp-btn-white btn-lg" href={docHref}>サービス資料をダウンロード</a>
        <a class="btn btn-line btn-lg" href={consult}>LINEで相談する</a>
      </div>
    </div>
  </section>

