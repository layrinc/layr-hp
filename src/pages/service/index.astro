---
/**
 * サービス一覧（/service/）— 余白を活かしたジグザグ大判レイアウト。
 * 文言の正本は src/data/pages/service.json（capBox/buttonsから抽出して描画）。
 * 動的ルート [...page].astro からは 'service' を除外済み。
 */
import Base from '../../layouts/Base.astro';
import serviceData from '../../data/pages/service.json';
import { ISO } from '../../lib/iso-illusts.mjs';

const title = serviceData.title + '｜株式会社LAYR';
const description = serviceData.description;

// JSONのブロック列から capBox（本文）と直後の buttons（リンク）を対で抽出
type Svc = { title: string; body: string; label: string; url: string; color: string };
const services: Svc[] = [];
const blocks: any[] = serviceData.blocks;
for (let i = 0; i < blocks.length; i++) {
  if (blocks[i].type === 'capBox') {
    const btn = blocks.slice(i + 1).find((b) => b.type === 'buttons');
    services.push({
      title: blocks[i].p.title,
      body: blocks[i].p.body,
      label: btn?.p.items[0]?.label ?? '詳しく見る',
      url: btn?.p.items[0]?.url ?? '#',
      color: blocks[i].p.color ?? 'green',
    });
  }
}

// 表示用メタ（EN・イラスト・チップ＝本文に書かれている範囲のみ）
const META = [
  { en: 'LINE MARKETING', iso: ISO.phone, chips: ['アカウント設計・構築', 'リッチメニュー', 'ステップ配信', '毎月の配信運用・改善'], price: '構築10万円〜／運用 月3万円〜' },
  { en: 'AD OPERATION', iso: ISO.chart, chips: ['Meta広告', 'Google広告', 'LINEヤフー広告', '日々の運用・月次レポート'], price: 'お見積もり（無料）' },
  { en: 'MARKETING BPO', iso: ISO.consult, chips: ['LINE', '広告', 'LP改善', 'AI業務効率化'], price: '月10万円' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://layr.co.jp/' },
      { '@type': 'ListItem', position: 2, name: 'サービス' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '株式会社LAYRのサービス',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem', position: i + 1, name: s.title, url: new URL(s.url, 'https://layr.co.jp').href,
    })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- ヒーロー -->
  <header class="sv-hero">
    <div class="container">
      <nav class="sv-bc" aria-label="パンくず"><a href="/">トップ</a><span>／</span><em>サービス</em></nav>
      <p class="sv-en">SERVICE</p>
      <h1>サービス</h1>
      <p class="sv-lead">LAYRの支援は、大きく3つです。</p>
    </div>
    <span class="sv-wm" aria-hidden="true">SERVICE</span>
  </header>

  <!-- About帯 -->
  <section class="sv-about">
    <div class="container sv-about-in">
      <div class="sv-about-l">
        <p class="sv-about-en">About</p>
        <p class="sv-about-sub">LAYRのサービスについて</p>
      </div>
      <div class="sv-about-r">
        <p>LAYRは、LINE構築・運用を軸にしたマーケティング支援会社です。一度きりの集客を、積み上がる売上に変える。</p>
        <p>広告からLINE、販売までの導線を一体で設計し、「作って終わり」にしない運用まで伴走します。</p>
      </div>
    </div>
  </section>

  <!-- サービス3つ（ジグザグ大判） -->
  <div class="sv-list">
    {services.map((s, i) => (
      <section class={`sv-item ${i % 2 === 1 ? 'is-rev' : ''} ${i === 1 ? 'is-tint' : ''}`}>
        <div class="container sv-item-in">
          <div class="sv-fig" aria-hidden="true">
            <span class="sv-fig-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="sv-fig-iso" set:html={META[i].iso} />
          </div>
          <div class="sv-txt">
            <p class="sv-item-en"><i></i>{META[i].en}</p>
            <h2>{s.title}</h2>
            <p class="sv-body">{s.body}</p>
            <div class="sv-chips">
              {META[i].chips.map((c) => <span>{c}</span>)}
            </div>
            <p class="sv-price"><b>料金</b>{META[i].price}</p>
            <a class={`btn btn-lg ${s.color === 'dark' ? 'btn-black' : 'btn-green'}`} href={s.url}>{s.label}</a>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- 迷ったら -->
  <section class="sv-guide">
    <div class="container">
      <p class="sv-guide-t">どのサービスが合うか迷ったら</p>
      <p class="sv-guide-s">30秒の料金シミュレーションで目安を確認するか、無料相談（オンライン30分）でお気軽にご相談ください。</p>
      <div class="sv-guide-cta">
        <a class="btn btn-green btn-lg" href="/service/line/#sim">30秒 料金シミュレーション</a>
        <a class="btn btn-black btn-lg" href="/contact/">無料相談に申し込む</a>
        <a class="btn btn-ghost btn-lg" href="/document/">サービス紹介資料を見る</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .sv-hero{position:relative;background:linear-gradient(160deg,#F4FAF8 0%,#fff 55%,#EDF7F2 100%);padding:clamp(40px,5.5vw,72px) 0 clamp(44px,5.5vw,72px);overflow:hidden;border-bottom:1px solid var(--line)}
  .sv-bc{font-size:12px;color:var(--muted);margin-bottom:26px}
  .sv-bc a{color:var(--green-dark);font-weight:700;text-decoration:none}
  .sv-bc span{opacity:.4;margin:0 6px}
  .sv-bc em{font-style:normal}
  .sv-en{font-family:var(--font-en);font-weight:800;font-size:13px;letter-spacing:.22em;color:var(--green-dark);margin-bottom:10px}
  .sv-hero h1{font-size:clamp(34px,5.8vw,58px);font-weight:900;letter-spacing:-.01em;line-height:1.25;color:var(--black)}
  .sv-lead{font-size:15px;color:var(--muted);margin-top:18px}
  .sv-wm{position:absolute;right:-1%;bottom:-10%;font-family:var(--font-en);font-weight:800;font-size:clamp(90px,15vw,200px);color:var(--green-dark);opacity:.045;pointer-events:none;line-height:1}
  /* about */
  .sv-about{padding:clamp(56px,7vw,96px) 0;background:#fff}
  .sv-about-in{display:grid;grid-template-columns:.9fr 1.4fr;gap:clamp(28px,5vw,72px);align-items:start}
  .sv-about-en{font-family:var(--font-en);font-weight:800;font-size:clamp(38px,5vw,58px);color:var(--green);line-height:1;letter-spacing:-.01em}
  .sv-about-sub{font-size:13px;font-weight:700;color:var(--muted);margin-top:12px}
  .sv-about-r p{font-size:15.5px;line-height:2.2;color:#1B2A2E;margin:0 0 1.2em}
  .sv-about-r p:last-child{margin-bottom:0}
  /* zigzag */
  .sv-item{padding:clamp(60px,8vw,110px) 0}
  .sv-item.is-tint{background:color-mix(in srgb,var(--green) 5%,#fff)}
  .sv-item-in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5.5vw,84px);align-items:center}
  .sv-item.is-rev .sv-item-in{direction:rtl}
  .sv-item.is-rev .sv-item-in > *{direction:ltr}
  .sv-fig{position:relative;background:linear-gradient(135deg,#EAF6F1 0%,#F8FBFA 55%,#DFF1E9 100%);border-radius:24px;aspect-ratio:5/4;display:grid;place-items:center}
  .sv-fig-num{position:absolute;top:18px;left:26px;font-family:var(--font-en);font-weight:800;font-size:clamp(44px,4.6vw,64px);color:var(--green-dark);opacity:.14;line-height:1}
  .sv-fig-iso{width:58%;max-width:300px;display:block}
  .sv-fig-iso :global(svg){width:100%;height:auto;display:block}
  .sv-item-en{display:flex;align-items:center;gap:12px;font-family:var(--font-en);font-weight:800;font-size:12.5px;letter-spacing:.18em;color:var(--green-dark);margin-bottom:16px}
  .sv-item-en i{width:30px;height:2px;background:var(--green-dark);border-radius:2px}
  .sv-txt h2{font-size:clamp(22px,3.2vw,31px);font-weight:900;line-height:1.5;letter-spacing:-.01em;color:var(--black);margin-bottom:18px}
  .sv-body{font-size:14.5px;line-height:2.15;color:#1B2A2E;margin-bottom:22px;max-width:36em}
  .sv-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
  .sv-chips span{font-size:12px;font-weight:700;color:var(--green-dark);background:var(--tint);border-radius:999px;padding:6px 16px}
  .sv-price{font-size:13.5px;color:var(--black);font-weight:700;margin-bottom:26px}
  .sv-price b{display:inline-block;font-family:var(--font-en);font-weight:800;font-size:11px;letter-spacing:.1em;color:#fff;background:var(--green-dark);border-radius:999px;padding:3px 14px;margin-right:12px}
  /* guide */
  .sv-guide{background:var(--green-dark);color:#fff;text-align:center;padding:clamp(56px,7vw,88px) 0}
  .sv-guide-t{font-size:clamp(20px,3vw,27px);font-weight:900;margin-bottom:10px}
  .sv-guide-s{font-size:14px;opacity:.88;line-height:1.9;max-width:36em;margin:0 auto 28px}
  .sv-guide-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  .sv-guide .btn-green{background:#fff;color:var(--green-dark)}
  .sv-guide .btn-black{background:var(--green);color:#fff}
  .sv-guide .btn-ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.5)}
  @media (max-width: 900px){
    .sv-about-in{grid-template-columns:1fr;gap:18px}
    .sv-item-in{grid-template-columns:1fr;gap:28px}
    .sv-item.is-rev .sv-item-in{direction:ltr}
    .sv-fig{max-width:440px;margin:0 auto;aspect-ratio:16/10;width:100%}
  }
</style>
