---
/**
 * サービス一覧（/service/）— 余白を活かしたジグザグ大判レイアウト。
 * 文言の正本は src/data/pages/service.json（capBox/buttonsから抽出して描画）。
 * 動的ルート [...page].astro からは 'service' を除外済み。
 */
import Base from '../../layouts/Base.astro';
import aiService from '../../data/service-ai.json';
import schoolService from '../../data/service-online-school.json';
import ltoriService from '../../data/service-ltori.json';
import serviceData from '../../data/pages/service.json';
import { ISO } from '../../lib/iso-illusts.mjs';

const title = serviceData.title + '｜株式会社LAYR';
const description = serviceData.description;
const [aiConsulting, aiDevelopment, aiInvoice] = aiService.plans;
// エルトリの紹介動画（YouTube）。youtubeId が空なら「動画でサービスを見る」は出さない
const ltVideo = (ltoriService as any).video as { youtubeId?: string; title?: string; label?: string } | undefined;

// JSONのブロック列から capBox（本文）と直後の buttons（リンク）を対で抽出
type Svc = { title: string; body: string; label: string; url: string; color: string };
const services: Svc[] = [];
const blocks: any[] = serviceData.blocks;
for (let i = 0; i < blocks.length; i++) {
  if (blocks[i].type === 'capBox') {
    const btn = blocks.slice(i + 1).find((b) => b.type === 'buttons');
    services.push({
      title: blocks[i].p.title,
      body: blocks[i].p.body,
      label: btn?.p.items[0]?.label ?? '詳しく見る',
      url: btn?.p.items[0]?.url ?? '#',
      color: blocks[i].p.color ?? 'green',
    });
  }
}

// 表示用メタ（URLで対応づけ。並び順は service.json のブロック順に従う）
type Meta = { en: string; iso: string; illustration?: string; illustrationClass?: string; illustrationSize?: [number, number]; chips: string[]; price: string };
const META: Record<string, Meta> = {
  '/service/school/': { en: 'LINE FOR SCHOOLS', iso: ISO.phone, chips: ['受講申込から逆算した戦略設計', 'LINE配信の企画・原稿', '流入から成約までの数値分析', 'シナリオ・予約導線の改善'], price: `構築${schoolService.prices.initialManYen}万円〜／運用 月${schoolService.prices.operationManYen}万円〜` },
  [ltoriService.path]: { en: 'LINE RECRUITING', iso: ISO.phone, illustration: '/service/ltori/isometric-hero.webp', illustrationClass: 'sv-ltori-illustration', chips: ['採用導線設計', '企業理解を促す配信', '応募・面接のフォロー', '分析・運用改善'], price: `構築${ltoriService.initialPrice / 10000}万円〜／運用 月${ltoriService.plans[0].price / 10000}万円〜（税別）` },
  // アッシュクAI：LPのFVと同じISOME LAB公式イラスト（担当者とAI）
  '/service/ai/': { en: 'BUSINESS AUTOMATION', iso: ISO.build, illustration: '/service/ai/isome/ai-partner.svg', illustrationClass: 'sv-isome-illustration', illustrationSize: [637, 1122], chips: ['AI導入コンサル', '専用ツール・業務アプリ開発', '請求書管理の自動化'], price: `導入${Math.min(aiDevelopment.price, aiInvoice.price) / 10000}万円〜／月${aiConsulting.price / 10000}万円〜（税別）` },
};
const metaFor = (s: Svc): Meta => META[s.url] ?? { en: 'SERVICE', iso: ISO.phone, chips: [], price: '' };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://layr.co.jp/' },
      { '@type': 'ListItem', position: 2, name: 'サービス' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '株式会社LAYRのサービス',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem', position: i + 1, name: s.title, url: new URL(s.url, 'https://layr.co.jp').href,
    })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- ヒーロー -->
  <header class="sv-hero">
    <div class="container">
      <nav class="sv-bc" aria-label="パンくず"><a href="/">トップ</a><span>／</span><em>サービス</em></nav>
      <p class="sv-en">SERVICE</p>
      <h1>サービス</h1>
    </div>
    <span class="sv-wm" aria-hidden="true">SERVICE</span>
  </header>

  <!-- About帯 -->
  <section class="sv-about">
    <div class="container sv-about-in">
      <div class="sv-about-l">
        <p class="sv-about-en">About</p>
        <p class="sv-about-sub">LAYRのサービスについて</p>
      </div>
      <div class="sv-about-r">
        <p>LAYRは、LINE構築・運用を軸にしたマーケティング支援会社です。一度きりの集客を、積み上がる売上に変える。</p>
        <p>広告からLINE、販売までの導線を一体で設計し、「作って終わり」にしない運用まで伴走します。</p>
      </div>
    </div>
  </section>

  <!-- サービス一覧（ジグザグ大判） -->
  <div class="sv-list">
    {services.map((s, i) => (
      <section class={`sv-item ${i % 2 === 1 ? 'is-rev' : ''}`}>
        <div class="container sv-item-in">
          <div class="sv-fig" aria-hidden="true">
            <span class="sv-fig-num">{String(i + 1).padStart(2, '0')}</span>
            {metaFor(s).illustration ? (
              <img class:list={['sv-ai-illustration', metaFor(s).illustrationClass]} src={metaFor(s).illustration} alt="" width={metaFor(s).illustrationSize?.[0] ?? 1536} height={metaFor(s).illustrationSize?.[1] ?? 1024} loading="lazy" decoding="async" />
            ) : (
              <span class="sv-fig-iso" set:html={metaFor(s).iso} />
            )}
          </div>
          <div class="sv-txt">
            <p class="sv-item-en"><i></i>{metaFor(s).en}</p>
            <h2>{s.title}</h2>
            <p class="sv-body">{s.body}</p>
            <div class="sv-chips">
              {metaFor(s).chips.map((c) => <span>{c}</span>)}
            </div>
            {metaFor(s).price && <p class="sv-price"><b>料金</b>{metaFor(s).price}</p>}
            {s.url === ltoriService.path && ltVideo?.youtubeId ? (
              <>
                <div class="sv-cta-row">
                  <a class={`btn btn-lg ${s.color === 'dark' ? 'btn-black' : 'btn-green'}`} href={s.url}>{s.label}</a>
                  <a class="sv-video-toggle" href={`https://www.youtube.com/watch?v=${ltVideo.youtubeId}`} target="_blank" rel="noopener" data-video-toggle data-yt={ltVideo.youtubeId} data-title={ltVideo.title} aria-controls="sv-video-ltori"><span class="sv-pm" aria-hidden="true"></span>{ltVideo.label ?? '動画でサービスを見る'}</a>
                </div>
                <div class="sv-video" id="sv-video-ltori" hidden><div class="sv-video-frame"></div></div>
              </>
            ) : (
              <a class={`btn btn-lg ${s.color === 'dark' ? 'btn-black' : 'btn-green'}`} href={s.url}>{s.label}</a>
            )}
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- 迷ったら -->
  <section class="sv-guide">
    <div class="container">
      <p class="sv-guide-t">どのサービスが合うか迷ったら</p>
      <p class="sv-guide-s">無料相談（オンライン30分）で、現状のお困りごとからお気軽にご相談ください。</p>
      <div class="sv-guide-cta">
        <a class="btn sv-btn-consult btn-lg" href="/contact/">無料相談に申し込む</a>
        <a class="btn sv-btn-doc btn-lg" href="/document/">資料をダウンロード</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // 「動画でサービスを見る」：＋で下に開いてYouTubeを読み込み、−で閉じて再生を止める。
  // JSが無い環境ではYouTubeのページへのリンクとして動く。
  document.querySelectorAll<HTMLAnchorElement>('[data-video-toggle]').forEach((t) => {
    const panel = document.getElementById(t.getAttribute('aria-controls') || '');
    const frame = panel?.querySelector('.sv-video-frame');
    if (!panel || !frame) return;
    t.setAttribute('role', 'button');
    t.setAttribute('aria-expanded', 'false');
    t.removeAttribute('target');
    t.addEventListener('click', (e) => {
      e.preventDefault();
      const open = t.getAttribute('aria-expanded') !== 'true';
      t.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open) {
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${t.dataset.yt}?rel=0&autoplay=1&playsinline=1`;
        f.title = t.dataset.title || '';
        f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        f.allowFullscreen = true;
        f.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.replaceChildren(f);
        const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
        if (typeof gtag === 'function') gtag('event', 'select_content', { content_type: 'service_video', content_id: 'ltori' });
      } else {
        frame.replaceChildren();
      }
    });
    t.addEventListener('keydown', (e) => { if (e.key === ' ') { e.preventDefault(); t.click(); } });
  });
</script>

<style>
  /* エルトリの写真は生成時の自然な色味で表示 */
  /* アッシュクAI：縦長のISOME LABイラストを枠内に収める（色はLPと同じ公式配色のまま） */
  .sv-ai-illustration.sv-isome-illustration{filter:none;position:absolute;inset:0;margin:auto;width:auto;height:86%;max-width:80%;object-fit:contain}
  .sv-ai-illustration.sv-ltori-illustration{filter:none;object-fit:contain;height:100%;background:var(--paper);border-radius:var(--r-lg)}
  /* hero */
  .sv-hero{position:relative;background:linear-gradient(160deg,#F4FAF8 0%,#fff 55%,#EDF7F2 100%);padding:clamp(40px,5.5vw,72px) 0 clamp(44px,5.5vw,72px);overflow:hidden;border-bottom:1px solid var(--line)}
  .sv-bc{font-size:12px;color:var(--muted);margin-bottom:26px}
  .sv-bc a{color:var(--green-dark);font-weight:700;text-decoration:none}
  .sv-bc span{opacity:.4;margin:0 6px}
  .sv-bc em{font-style:normal}
  .sv-en{font-family:var(--font-en);font-weight:700;font-size:13px;letter-spacing:.22em;color:var(--green-dark);margin-bottom:10px}
  .sv-hero h1{font-size:clamp(34px,5.8vw,58px);font-weight:700;letter-spacing:-.01em;line-height:1.25;color:var(--black)}
  .sv-lead{font-size:15px;color:var(--muted);margin-top:18px}
  .sv-wm{position:absolute;right:-1%;bottom:-10%;font-family:var(--font-en);font-weight:700;font-size:clamp(90px,15vw,200px);color:var(--green-dark);opacity:.045;pointer-events:none;line-height:1}
  /* about */
  .sv-about{padding:clamp(56px,7vw,96px) 0;background:#fff}
  .sv-about-in{display:grid;grid-template-columns:.9fr 1.4fr;gap:clamp(28px,5vw,72px);align-items:start}
  .sv-about-en{font-family:var(--font-en);font-weight:700;font-size:clamp(38px,5vw,58px);color:var(--green);line-height:1;letter-spacing:-.01em}
  .sv-about-sub{font-size:13px;font-weight:700;color:var(--muted);margin-top:12px}
  .sv-about-r p{font-size:15.5px;line-height:2.2;color:#1B2A2E;margin:0 0 1.2em}
  .sv-about-r p:last-child{margin-bottom:0}
  /* zigzag */
  .sv-item{padding:clamp(60px,8vw,110px) 0}
  .sv-item.is-tint{background:color-mix(in srgb,var(--green) 5%,#fff)}
  .sv-item-in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5.5vw,84px);align-items:center}
  .sv-item.is-rev .sv-item-in{direction:rtl}
  .sv-item.is-rev .sv-item-in > *{direction:ltr}
  .sv-fig{position:relative;background:linear-gradient(135deg,#EAF6F1 0%,#F8FBFA 55%,#DFF1E9 100%);border-radius:24px;aspect-ratio:5/4;display:grid;place-items:center}
  .sv-fig-num{position:absolute;top:18px;left:26px;font-family:var(--font-en);font-weight:700;font-size:clamp(44px,4.6vw,64px);color:var(--green-dark);opacity:.14;line-height:1}
  .sv-ai-illustration{display:block;width:100%;height:auto;filter:var(--ai-illustration-filter)}
  .sv-fig-iso{width:58%;max-width:300px;display:block}
  .sv-fig-iso :global(svg){width:100%;height:auto;display:block}
  .sv-shot{display:block;width:82%;max-width:420px;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 18px 44px rgba(14,26,28,.16);border:1px solid var(--line)}
  .sv-shot i{display:flex;gap:5px;padding:8px 12px;background:#F1F5F4;border-bottom:1px solid var(--line)}
  .sv-shot i b{width:8px;height:8px;border-radius:50%;background:#D7E0DE}
  .sv-shot img{width:100%;height:auto;display:block}
  .sv-item-en{display:flex;align-items:center;gap:12px;font-family:var(--font-en);font-weight:700;font-size:12.5px;letter-spacing:.18em;color:var(--green-dark);margin-bottom:16px}
  .sv-item-en i{width:30px;height:2px;background:var(--green-dark);border-radius:2px}
  .sv-txt h2{font-size:clamp(22px,3.2vw,31px);font-weight:700;line-height:1.5;letter-spacing:-.01em;color:var(--black);margin-bottom:18px}
  .sv-body{font-size:14.5px;line-height:2.15;color:#1B2A2E;margin-bottom:22px;max-width:36em}
  .sv-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
  .sv-chips span{font-size:12px;font-weight:700;color:var(--green-dark);background:var(--tint);border-radius:999px;padding:6px 16px}
  .sv-price{font-size:13.5px;color:var(--black);font-weight:700;margin-bottom:26px}
  .sv-price b{display:inline-block;font-family:var(--font-en);font-weight:700;font-size:11px;letter-spacing:.1em;color:#fff;background:var(--green-dark);border-radius:999px;padding:3px 14px;margin-right:12px}
  /* guide */
  .sv-guide{background:var(--green-dark);color:#fff;text-align:center;padding:clamp(56px,7vw,88px) 0}
  .sv-guide-t{font-size:clamp(20px,3vw,27px);font-weight:700;margin-bottom:10px}
  .sv-guide-s{font-size:14px;opacity:.88;line-height:1.9;max-width:36em;margin:0 auto 28px}
  .sv-guide-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  /* 濃緑帯の上。主CTA=オレンジ（推奨の役割色）、副CTA=黒で、どちらも緑に沈まない */
  .sv-btn-consult{background:#E9A32F;color:#fff;box-shadow:0 8px 20px color-mix(in srgb, #E9A32F 32%, transparent)}
  .sv-btn-consult:hover{background:color-mix(in srgb, #E9A32F 82%, #7A5510);color:#fff}
  .sv-btn-doc{background:var(--black);color:#fff}
  .sv-btn-doc:hover{background:color-mix(in srgb, var(--black) 80%, #fff);color:#fff}
  .sv-guide .btn-black{background:var(--green);color:#fff}
  .sv-guide .btn-ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.5)}
  /* エルトリ：動画でサービスを見る（＋／−で下に開く） */
  .sv-cta-row{display:flex;flex-wrap:wrap;align-items:center;gap:12px 14px}
  .sv-video-toggle{display:inline-flex;align-items:center;gap:10px;padding:16px 26px;border-radius:var(--r-pill);border:2px solid var(--green-line);background:var(--paper);color:var(--green-ink);font-size:calc(15px * var(--fs,1));font-weight:700;line-height:1.4;text-decoration:none;cursor:pointer;transition:background .2s cubic-bezier(.4,0,.2,1), border-color .2s cubic-bezier(.4,0,.2,1)}
  .sv-video-toggle:hover{background:var(--green-pale);border-color:var(--green)}
  .sv-video-toggle:focus-visible{outline:2px solid var(--green-ink);outline-offset:3px}
  .sv-pm{position:relative;flex-shrink:0;width:22px;height:22px;border-radius:50%;background:var(--green-pale)}
  .sv-pm::before,.sv-pm::after{content:"";position:absolute;left:50%;top:50%;width:10px;height:2px;margin:-1px 0 0 -5px;border-radius:var(--r-pill);background:var(--green-ink);transition:transform .25s cubic-bezier(.4,0,.2,1)}
  .sv-pm::after{transform:rotate(90deg)}
  .sv-video-toggle[aria-expanded="true"] .sv-pm::after{transform:rotate(0deg)}
  .sv-video{margin-top:20px}
  .sv-video-frame{width:100%;aspect-ratio:16/9;border-radius:var(--radius);overflow:hidden;background:var(--black);border:1px solid var(--line)}
  .sv-video-frame :global(iframe){display:block;width:100%;height:100%;border:0}
  @media (max-width: 900px){
    .sv-about-in{grid-template-columns:1fr;gap:18px}
    .sv-item-in{grid-template-columns:1fr;gap:28px}
    .sv-item.is-rev .sv-item-in{direction:ltr}
    .sv-fig{max-width:440px;margin:0 auto;aspect-ratio:16/10;width:100%}
  }
</style>
