---
import ServiceLanding from '../../../../components/ltori/ServiceLanding.astro';
import { regionalAreas } from '../../../../lib/ltori-seo.mjs';
export function getStaticPaths() {
  return regionalAreas.map(area => ({ params: { slug: area.slug }, props: { area } }));
}
const { area } = Astro.props;
---
<ServiceLanding area={area} />
