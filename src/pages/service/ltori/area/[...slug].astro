---
import ServiceLanding from '../../../../components/ltori/ServiceLanding.astro';
import { publishedAreas } from '../../../../lib/ltori-publication.mjs';
export function getStaticPaths() {
  return publishedAreas.map(area => ({ params: { slug: area.slug }, props: { area } }));
}
const { area } = Astro.props;
---
<ServiceLanding area={area} />
