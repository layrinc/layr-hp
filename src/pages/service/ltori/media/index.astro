---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/LtoriMedia.astro';
import Card from '../../../../components/LtoriMediaCard.astro';
import Sidebar from '../../../../components/LtoriMediaSidebar.astro';
import Heading from '../../../../components/LtoriMediaHeading.astro';
import { articlePath, mediaPath, mediaInfo, isPublished, newestFirst } from '../../../../lib/ltori-media.mjs';
const posts = (await getCollection('recruitment', isPublished)).sort(newestFirst);
const title = '採用LINEのお役立ち情報';
const description = '採用LINEの導線設計、応募後フォロー、費用・外注の比較を解説。地方企業の経営者・採用担当者に向けた実務メディア「エルトリ採用ノート」です。';
const jsonLd = {'@context':'https://schema.org','@type':'CollectionPage',name:`${title}｜${mediaInfo.name}`,url:new URL(mediaPath,Astro.site).href,description,mainEntity:{'@type':'ItemList',numberOfItems:posts.length,itemListElement:posts.map((post,index)=>({'@type':'ListItem',position:index+1,url:new URL(articlePath(post.id),Astro.site).href,name:post.data.title}))}};
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <Heading title={title} description="採用LINEの導線設計、応募後フォロー、費用・外注の比較を解説。" home />
  <div class="lm-content-grid">
    <section id="articles" aria-label="新着記事一覧">
      <div class="lm-list" data-lm-archive>{posts.map(post=><Card post={post} />)}</div>
      {posts.length===0 && <p>現在、公開中の記事はありません。</p>}
      <p class="lm-archive-count" data-lm-result-count role="status" aria-live="polite">{posts.length}件の記事 / 公開日の新しい順</p>
      <button class="lm-more" type="button" data-lm-more hidden>もっと見る <span aria-hidden="true">＋</span></button>
    </section>
    <Sidebar posts={posts} />
  </div>
  <nav class="lm-breadcrumb" aria-label="パンくず"><span aria-current="page">{mediaInfo.name}</span></nav>
</Layout>
<script>
  const archive=document.querySelector('[data-lm-archive]');
  const more=document.querySelector<HTMLButtonElement>('[data-lm-more]');
  const status=document.querySelector<HTMLElement>('[data-lm-result-count]');
  if(archive && more && status){
    const cards=[...archive.querySelectorAll<HTMLElement>('.lm-card')];
    let limit=18;
    const show=()=>{
      cards.forEach((card,index)=>{card.hidden=index>=limit;});
      more.hidden=cards.length<=limit;
      status.textContent=`${Math.min(limit,cards.length)} / ${cards.length}件の記事`;
    };
    more.addEventListener('click',()=>{
      const firstNew=cards[limit];
      limit+=18;
      show();
      firstNew?.querySelector<HTMLAnchorElement>('h3 a')?.focus();
    });
    show();
  }
</script>
