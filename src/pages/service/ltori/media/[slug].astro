---
import { getCollection, render } from 'astro:content';
import Layout from '../../../../layouts/LtoriMedia.astro';
import { articlePath, mediaPath, isPublished } from '../../../../lib/ltori-media.mjs';
export async function getStaticPaths(){return (await getCollection('recruitment',isPublished)).map(post=>({params:{slug:post.id},props:{post}}));}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await getCollection('recruitment',isPublished)).filter(p=>p.id!==post.id).slice(0,3);
const jsonLd = [
  {'@context':'https://schema.org','@type':'BlogPosting',headline:post.data.title,description:post.data.description,datePublished:post.data.date.toISOString(),author:{'@type':'Organization',name:'株式会社LAYR'},mainEntityOfPage:new URL(articlePath(post.id),Astro.site).href},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'エルトリ',item:new URL('/service/ltori/',Astro.site).href},{'@type':'ListItem',position:2,name:'メディア',item:new URL(mediaPath,Astro.site).href},{'@type':'ListItem',position:3,name:post.data.title}]},
];
---
<Layout title={post.data.title} description={post.data.description} jsonLd={jsonLd}>
  <article class="lm-article"><a href={mediaPath}>← エルトリメディア</a><p class="lm-kicker">{post.data.category}</p><h1>{post.data.title}</h1><p>{post.data.description}</p><p class="lm-meta">制作：株式会社LAYR ／ <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time> ／ 自社サービスの紹介を含みます。</p>
    <nav class="lm-toc" aria-label="この記事の目次"><strong>この記事でわかること</strong><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
    <Content />
    <aside><h2>次に読む</h2><ul>{related.map(p=><li><a href={articlePath(p.id)}>{p.data.title}</a></li>)}</ul></aside>
  </article>
</Layout>
