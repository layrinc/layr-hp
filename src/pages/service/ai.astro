  .pr-sub{background:#fff;border:1px solid var(--wa-line-strong);border-radius:var(--wa-r-card);padding:clamp(24px,4vw,36px);margin-bottom:18px}
  .pr-label{font-family:var(--wa-font-head);font-size:var(--wa-fs-lead);font-weight:700;color:var(--wa-ink);margin-bottom:20px}
  .pr-ichi{color:var(--wa-shu)}
  .pr-nums{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px}
  .pr-nums > div:not(.pr-x){flex:1;min-width:150px;border:1px solid var(--wa-line);background:var(--wa-card);border-radius:var(--wa-r-btn);padding:16px 20px;text-align:center}
  .pr-x{font-size:var(--wa-fs-h3);font-weight:700;color:var(--wa-muted)}
  .pr-nums span{display:block;font-size:var(--wa-fs-label);font-weight:700;color:var(--wa-muted);margin-bottom:2px}
  .pr-nums b{font-family:var(--wa-font-head);font-size:var(--wa-fs-display);font-weight:700;color:var(--wa-ai);line-height:1.15}
  .pr-nums b i{font-style:normal}
