  .pr-cap{font-family:var(--wa-font-head);font-size:var(--wa-fs-sm);font-weight:700;color:var(--wa-shu);border:1.5px dashed var(--wa-shu);border-radius:var(--wa-r-s);background:#fff;padding:10px 22px;display:table;margin:8px auto 0}

