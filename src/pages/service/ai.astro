---
import Base from '../../layouts/Base.astro';
import AiInvoiceOffer from '../../components/AiInvoiceOffer.astro';
import AiCostSimulator from '../../components/AiCostSimulator.astro';
import settings from '../../data/settings.json';
import service from '../../data/service-ai.json';
import '../../styles/service-ai.css';

const [consulting, development, invoice] = service.plans;
const displayPlans = [invoice, consulting, development];
const brandName = `${service.brand} ${service.byline}`;
const yen = (amount: number) => amount / 10000;
const tax = (included: boolean) => included ? '税込' : '税別';
const mailFor = (topic: string) => 'mailto:' + settings.email + '?subject=' + encodeURIComponent('【無料相談】' + topic) + '&body=' + encodeURIComponent(topic + 'について相談を希望します。\n\n会社名：\nご担当者名：\n現在の業務・管理方法：\n困っている作業：');
const lineUrl = settings.line_url?.trim() || '';
const generalMail = mailFor('AI導入・業務自動化');
const consult = lineUrl || generalMail;
const faqs = [
  { q: '複数の部署の業務を、まとめて管理できますか？', a: '経理・CS・受発注など、部署ごとに分かれている入力や進捗管理をつなぐ仕組みをご提案します。まず既存ツール・権限・データ形式を確認し、連携できる範囲と必要な画面を決めます。業務全体の一括自動化を一律料金で保証するものではなく、開発範囲と費用は事前にご案内します。' },
  { q: 'どのプランを選べばいいですか？', a: 'まず方針を相談したい場合はAI導入コンサル（月' + yen(consulting.price) + '万円）、自社専用の仕組みをつくりたい場合は専用ツール・業務アプリ開発（1件' + yen(development.price) + '万円）、請求書管理から始めたい場合は請求書自動化（導入' + yen(invoice.price) + '万円）をご案内します。いずれも' + tax(invoice.taxIncluded) + 'です。迷っている段階でもご相談ください。' },
  { q: 'AI導入コンサルには、開発も含まれますか？', a: 'コンサルでは、現在の業務の整理、AIを活用する場所の検討、導入・運用方法の相談を行います。専用ツールの開発が必要な場合は、対象範囲と費用をご案内したうえで別途承ります。' },
  { q: '1件30万円で、どこまで開発できますか？', a: '入力・管理・集計など、御社の業務に合わせた専用ツールを開発します。必要な機能、画面、連携先を伺い、1件' + yen(development.price) + '万円（' + tax(development.taxIncluded) + '）で対応する範囲を契約前に決めます。追加開発、外部サービスの利用料、継続保守が必要な場合は、別途費用を事前にご案内します。' },
  { q: '請求書自動化の5万円は、月額料金ですか？', a: '月額ではなく導入費用です。毎月' + invoice.monthlyLimit + '社限定で、通常' + yen(invoice.regularPrice) + '万円のところ' + yen(invoice.price) + '万円（' + tax(invoice.taxIncluded) + '）でご提供します。読み取り対象・書式・連携先を確認し、自動化する範囲を決めます。外部ツール利用料や保守が必要な場合は、契約前にご案内します。' },
  { q: '今使っているExcelやツールのまま相談できますか？', a: 'はい。Excel・スプレッドシート・メール・会計ソフトなど、現在の環境と作業手順を伺います。連携の可否を確認し、今の運用を活かせる方法からご提案します。AIに詳しい社員がいなくてもご相談いただけます。' },
  { q: 'AIの間違いや、機密情報の取り扱いはどうなりますか？', a: 'AIの出力を担当者が確認・修正できる工程を組み込みます。利用するサービス、保存先、閲覧権限、データの取り扱いは導入前に確認します。振込や会計処理の確定など、重要な最終判断は人が確認する前提で設計します。' },
];
const flow = [
  { n: '01', title: '作業とコストを洗い出す', body: '部署別の担当人数・作業時間・外注費を整理。毎月くり返す定型業務から、負担の大きい場所を見つけます。' },
  { n: '02', title: '効果の大きい業務から選ぶ', body: '圧縮できる経費と、別の仕事へ回せる時間を見積もります。導入・運用費用と比べ、優先順位を決めます。' },
  { n: '03', title: '業務に合わせて実装', body: '選んだプランに沿って導入や開発を進め、実際の担当者と動作・操作を確認します。' },
  { n: '04', title: '人の配置と運用を整える', body: '確認・例外対応の担当を決め、浮いた時間を営業や顧客提案へ。少人数で定型業務を回せる運用を目指します。' },
];
const examples = [
  { name: 'LAYR B2B DB', label: '営業管理', text: '営業リストや問い合わせをまとめて管理。探す・転記する作業を減らすための社内ツールです。', images: [
    ['/service/ai/shots/b2b-1.jpg', '営業管理のダッシュボード'], ['/service/ai/shots/b2b-2.jpg', '営業リストと提案文の管理'], ['/service/ai/shots/b2b-3.jpg', '顧客台帳の管理'],
  ] },
  { name: 'バナラボ', label: '制作業務', text: '配信サイズに合わせたバナー制作を支援。繰り返し発生する制作作業にもAIを取り入れています。', images: [
    ['/service/ai/shots/banlabo-1.jpg', '広告バナーの生成画面'], ['/service/ai/shots/banlabo-2.jpg', '媒体別サイズの選択画面'],
  ] },
  { name: 'LINEスコア診断', label: '顧客対応', text: '質問への回答からレポートを作成。ヒアリングから情報整理までの流れを仕組みにしています。', images: [
    ['/service/ai/shots/check-1.jpg', 'LINEスコア診断の開始画面'], ['/service/ai/shots/check-2.jpg', '質問と診断レポートの画面'],
  ] },
  { name: 'L SCOPE', label: '分析業務', text: '広告・LP・LINE配信の流れを可視化。情報を並べて確認する作業から、改善の検討へつなげます。', images: [
    ['/service/ai/shots/lscope-1.svg', '広告からLINE配信までの流れを整理する機能図'],
  ] },
];

const strengths = [
  { n: '01', image: 'paperless', title: '毎月の手作業から、減らす。', body: '入力・転記・集計など、くり返し発生する仕事を整理。作業時間と費用を見て、効果が見込めるところから始めます。' },
  { n: '02', image: 'gears', title: '今の業務に、AIをつなぐ。', body: 'メール、Excel、既存ツールの使い方を確認。御社の仕事の流れに合わせて、自動化する仕組みを設計します。' },
  { n: '03', image: 'dialogue', title: '使える状態まで、整える。', body: '担当者の確認や例外対応も含めて設計。操作方法を共有し、現場で使い始められる状態まで支援します。' },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://layr.co.jp/' },
    { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://layr.co.jp/service/' },
    { '@type': 'ListItem', position: 3, name: brandName },
  ] },
  { '@context': 'https://schema.org', '@type': 'Service', '@id': 'https://layr.co.jp/#service-ai', name: brandName, serviceType: 'AI業務効率化・業務自動化', provider: { '@id': 'https://layr.co.jp/#organization' }, areaServed: 'JP', url: 'https://layr.co.jp/service/ai/', offers: service.plans.map(plan => ({
    '@type': 'Offer', name: plan.name, price: plan.price, priceCurrency: 'JPY', description: plan.billing + '・' + yen(plan.price) + '万円（' + tax(plan.taxIncluded) + '）。' + plan.note, url: 'https://layr.co.jp/service/ai/#plan-' + plan.id, priceSpecification: { '@type': 'PriceSpecification', price: plan.price, priceCurrency: 'JPY', valueAddedTaxIncluded: plan.taxIncluded },
  })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={service.title} description={service.description} jsonLd={jsonLd} hideHeader={true}>
<div class="ai-lp">
  <header class="ai-header">
    <div class="ai-wrap ai-header-inner">
      <a href="/service/ai/" class="ai-brand" aria-label={brandName + ' トップへ'}><span class="ai-brand-mark" aria-hidden="true">AI</span><span><strong>{service.brand}</strong><small>{service.byline}</small></span></a>
      <nav class="ai-nav" aria-label="AIサービスのページ内ナビゲーション"><a href="#about">サービスについて</a><a href="#automation">できること</a><a href="#price">料金</a><a href="#works">支援実績</a><a href="#faq">よくある質問</a></nav>
      <a href="#consult" class="ai-button ai-button-small">無料相談する <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <section class="ai-hero">
    <div class="ai-wrap">
      <div class="ai-hero-copy">
        <p class="ai-hero-kicker">中小企業のための、AI業務効率化・自動化</p>
        <h1><span>{service.hero.line1}<em>{service.hero.emphasis}</em></span><br />{service.hero.line2}</h1>
        <p class="ai-lead">{service.hero.lead.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
        <div class="ai-actions"><a href="#consult" class="ai-button">無料で相談する <span aria-hidden="true">↗</span></a><a href="#price" class="ai-button ai-button-outline">3つのプランを見る <span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="ai-system" aria-label="社内の情報をAIで整理し、人が確認。残業・外注費を見直し、人は本業へ">
        <div class="ai-system-side ai-system-input">
          <p class="ai-system-label">毎月くり返す仕事</p>
          <span><small>01</small>請求書・経理</span><span><small>02</small>問い合わせ対応</span><span><small>03</small>受発注・集計</span>
        </div>
        <figure class="ai-hero-art">
          <img src="/service/ai/isome/ai-partner.svg" alt="担当者とAIが協力してパソコン業務を進めるイラスト" width="637" height="1122" fetchpriority="high" decoding="async" />
          <figcaption><strong>AIが処理、人が確認。</strong><span>会社に合う仕組みをつくる</span></figcaption>
        </figure>
        <div class="ai-system-side ai-system-output">
          <p class="ai-system-label">目指すのは、この変化</p>
          <span>残業・外注費を見直す</span><span>本業に使える時間へ</span><span>利益が残る体制へ</span>
        </div>
      </div>
      <nav class="ai-quick-links" aria-label="知りたい内容から読む"><a href="#automation">どの業務に使える？ ↓</a><a href="#simulation">いくら減らせる？ ↓</a><a href="#flow">どう始める？ ↓</a></nav>
    </div>
  </section>

  <section class="ai-section ai-worries" id="change">
    <div class="ai-wrap">
      <div class="ai-section-heading"><p class="ai-eyebrow">こんなお悩みはありませんか？</p><h2>忙しいのに、<br class="ai-mobile-break" /><em>利益が残りにくい。</em></h2><p>その原因は、毎月の「くり返す仕事」にあるかもしれません。</p></div>
      <div class="ai-worry-grid">
        <article><span>01</span><h3>同じ入力を、何度も。</h3><p>メールや書類を見ながら、Excelへ転記。確認や修正にも時間がかかる。</p></article>
        <article><span>02</span><h3>忙しいたびに、経費が増える。</h3><p>残業、外注、追加採用で対応。売上が増えても、経費も一緒に膨らむ。</p></article>
        <article><span>03</span><h3>本業に、人を回せない。</h3><p>集計や問い合わせに追われ、営業・提案・顧客フォローが後回しになる。</p></article>
      </div>
      <p class="ai-answer">増やすのは、手作業ではなく。<br /><strong>仕事が回る「仕組み」です。</strong></p>
    </div>
  </section>

  <section class="ai-section ai-about" id="about">
    <div class="ai-wrap">
      <div class="ai-section-heading"><p class="ai-eyebrow">{service.brand}とは？</p><h2>御社の業務に、<br /><em>働くAIの仕組みを。</em></h2><p>業務の整理から、設計・開発・使い方まで。<br />現場の仕事に合わせて、AIを組み込みます。</p></div>
      <div class="ai-strengths">{strengths.map(item => <article class="ai-strength"><p class="ai-strength-number">POINT {item.n}</p><img src={'/service/ai/isome/' + item.image + '.svg'} alt="" width="280" height="200" loading="lazy" decoding="async" /><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
    </div>
  </section>

  <section class="ai-section ai-automation" id="automation">
    <div class="ai-wrap">
      <div class="ai-section-heading"><p class="ai-eyebrow">AIで効率化できること</p><h2>まずは、御社の<br class="ai-mobile-break" /><em>身近な業務から。</em></h2><p>経理、CS、受発注、社内申請。<br />部署ごとの「毎回やっている作業」を見直します。</p></div>
      <div class="ai-area-list">{service.automationAreas.map((area, i) => <article class="ai-area" id={'area-' + area.id}>
        <div class="ai-area-title"><span>{String(i + 1).padStart(2,'0')}</span><h3>{area.name}</h3></div>
        <ul>{area.tasks.map(task => <li>{task}</li>)}</ul>
        <div class="ai-area-cost"><p>減らしたいコスト</p><strong>{area.cost}</strong></div>
      </article>)}</div>
      <p class="ai-note">上記は効率化の候補です。書式・連携先・件数に応じて設計し、会計処理の確定や人事判断、例外対応は担当者が確認します。</p>
    </div>
  </section>

  <section class="ai-section ai-management" id="management">
    <div class="ai-wrap">
      <div class="ai-section-heading"><p class="ai-eyebrow">自動化すると、仕事はこう変わる</p><h2>AIに任せる仕事と、<br /><em>人が担う仕事を分ける。</em></h2><p>全部をAIに任せるのではなく、確認と判断の工程を残して設計します。</p></div>
      <div class="ai-comparison">
        <article class="ai-before"><p class="ai-compare-label">BEFORE<span>これまで</span></p><h3>担当者が、ひとつずつ処理。</h3><ol><li>メール・書類を探して集める</li><li>数字を入力・転記する</li><li>集計して、抜け漏れを確認する</li></ol><p class="ai-compare-result">定型作業で一日が終わり、<br /><strong>残業や外注が増えやすい。</strong></p></article>
        <span class="ai-compare-arrow" aria-hidden="true">→</span>
        <article class="ai-after"><p class="ai-compare-label">AFTER<span>AIを業務に組み込むと</span></p><h3>AIが整理。人は確認と本業へ。</h3><ol><li><strong>情報を集める</strong><span>メール・PDF・既存ツールをつなぐ</span></li><li><strong>AIが定型作業を処理</strong><span>分類・転記・集計・下書きを支援</span></li><li><strong>人が確認し、次へ進める</strong><span>確認と例外対応の担当を決める</span></li></ol><p class="ai-compare-result">生まれた時間を、<br /><strong>営業・提案・顧客フォローへ。</strong></p></article>
      </div>
      <p class="ai-note">工数が減っても、給与総額がそのまま下がるわけではありません。残業・外注・追加採用の抑制と、社員の再配置を分けて、導入・運用費用を含む効果を整理します。</p>
    </div>
  </section>

  <AiCostSimulator />

  <section class="ai-section ai-plans-section" id="price">
    <div class="ai-wrap">
      <div class="ai-section-heading"><p class="ai-eyebrow">料金プラン</p><h2>一つから試す。相談する。<br class="ai-mobile-break" /><em>仕組みをつくる。</em></h2><p>今の課題に合わせて、3つの入口から選べます。<br />迷う場合は、無料相談で一緒に整理します。</p></div>
      <div class="ai-plans">{displayPlans.map((plan, i) => <article class={'ai-plan ai-plan-' + plan.id} id={'plan-' + plan.id}>
        <div class="ai-plan-top"><span>PLAN {String(i + 1).padStart(2,'0')}</span><p>{plan.label}</p></div>
        <h3>{plan.name}</h3>
        <div class="ai-plan-price"><span>{plan.billing}</span><p><strong>{yen(plan.price)}</strong><b>万円</b><span> / {plan.unit}</span></p><small>（{tax(plan.taxIncluded)}）</small></div>
        {plan.id === 'invoice' && <p class="ai-plan-limit">毎月{invoice.monthlyLimit}社限定 / 通常<s>{yen(invoice.regularPrice)}万円</s></p>}
        <p class="ai-plan-description">{plan.description}</p>
        <ul>{plan.features.map(feature => <li>{feature}</li>)}</ul>
        <p class="ai-plan-note">{plan.note}</p>
        {plan.id === 'invoice' ? <a href="#invoice" class="ai-button">請求書プランの詳細 <span aria-hidden="true">↓</span></a> : <a href={lineUrl || mailFor(plan.name)} class="ai-button ai-button-outline" data-ai-lead="plan" data-ai-plan={plan.id}>このプランを相談する <span aria-hidden="true">↗</span></a>}
      </article>)}</div>
      <p class="ai-note">外部ツール・APIの利用料や継続保守が必要な場合は、対象範囲とあわせて契約前にご案内します。</p>
    </div>
  </section>

  <AiInvoiceOffer placement="middle" />

  <section class="ai-section ai-works" id="works">
    <div class="ai-wrap">
      <div class="ai-section-heading"><p class="ai-eyebrow">支援実績・自社実装例</p><h2>アイデアを、<br class="ai-mobile-break" /><em>現場で使う仕組みに。</em></h2><p>お客様の業務自動化から、LAYRで毎日使う社内ツールまで。</p></div>
      {service.clientCases.map(client => <article class="ai-client-case"><div><p class="ai-eyebrow">CLIENT CASE / お客様の支援実績</p><p class="ai-client-name">{client.company} 様</p><h3>{client.title}</h3><p class="ai-client-description">{client.description}</p></div><div class="ai-client-info"><dl><div><dt>業種</dt><dd>{client.industry}</dd></div><div><dt>支援内容</dt><dd>{client.support}</dd></div></dl><a href={client.url} class="ai-text-link" target="_blank" rel="noopener noreferrer">同社の商品カタログを見る <span aria-hidden="true">↗</span></a></div></article>)}
      <div class="ai-own-heading"><h3>LAYRの自社実装例</h3><p>気になるツールを開くと、実際の画面をご覧いただけます。</p></div>
      <div class="ai-example-list">{examples.map((example, i) => <details class="ai-example" open={i === 0}><summary><span class="ai-example-label">{example.label}</span><h3>{example.name}</h3><span class="ai-toggle" aria-hidden="true"></span></summary><div class="ai-example-content"><p>{example.text}</p><div class="ai-gallery" tabindex="0" role="region" aria-label={example.name + 'の画面。横にスクロールして閲覧できます。'}>{example.images.map(([src, caption]) => <figure><img src={src} alt={caption} width="1400" height="900" loading="lazy" decoding="async" /><figcaption>{caption}{src.endsWith('.svg') ? '（機能図）' : '（自社ツール）'}</figcaption></figure>)}</div>{example.images.length > 1 && <p class="ai-gallery-note">横にスクロールして、ほかの画面を見る →</p>}</div></details>)}</div>
    </div>
  </section>

  <section class="ai-section ai-flow" id="flow">
    <div class="ai-wrap"><div class="ai-section-heading"><p class="ai-eyebrow">導入の流れ</p><h2>「この作業が大変」<br class="ai-mobile-break" /><em>から始められます。</em></h2><p>AIの知識や、完成した要件書は不要です。<br />まずは現在の仕事をお聞かせください。</p></div><ol class="ai-flow-list">{flow.map(step => <li><span>{step.n}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol></div>
  </section>

  <section class="ai-section ai-faq" id="faq"><div class="ai-wrap"><div class="ai-section-heading"><p class="ai-eyebrow">よくあるご質問</p><h2>導入前の、<em>気になること。</em></h2></div><div class="ai-faq-list">{faqs.map(f => <details><summary><span>Q</span><h3>{f.q}</h3><span class="ai-toggle" aria-hidden="true"></span></summary><p>{f.a}</p></details>)}</div></div></section>

  <section class="ai-section ai-consult" id="consult">
    <div class="ai-wrap"><p class="ai-eyebrow">まずは無料相談から</p><h2>御社なら、<br /><em>どの業務から減らせるか。</em></h2><p>「うちの仕事にも使える？」からで大丈夫です。<br />自動化できることと、かかる費用を整理します。</p><div class="ai-actions"><a href={consult} class="ai-button" data-ai-lead="final" data-ai-plan="general">{lineUrl ? 'LINEで無料相談する' : 'メールで無料相談する'} <span aria-hidden="true">↗</span></a>{lineUrl && <a href={generalMail} class="ai-button ai-button-outline" data-ai-lead="final-email" data-ai-plan="general">メールで相談する <span aria-hidden="true">↗</span></a>}</div><a href="#price" class="ai-text-link">料金プランをもう一度見る ↑</a></div>
  </section>
</div>
</Base>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-ai-lead]').forEach(link => {
    link.addEventListener('click', () => {
      const analytics = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
      if (typeof analytics === 'function') analytics('event', 'generate_lead', {
        event_category: 'ai_automation', event_label: link.dataset.aiLead, plan: link.dataset.aiPlan || 'general', method: link.href.startsWith('mailto:') ? 'email' : 'line',
      });
    });
  });
</script>
