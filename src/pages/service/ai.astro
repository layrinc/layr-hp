---
import Base from '../../layouts/Base.astro';
import AiInvoiceOffer from '../../components/AiInvoiceOffer.astro';
import settings from '../../data/settings.json';
import service from '../../data/service-ai.json';
import '../../styles/service-ai.css';

const [consulting, development, invoice] = service.plans;
const brandName = `${service.brand} ${service.byline}`;
const yen = (amount: number) => amount / 10000;
const tax = (included: boolean) => included ? '税込' : '税別';
const mailFor = (topic: string) => 'mailto:' + settings.email + '?subject=' + encodeURIComponent('【無料相談】' + topic) + '&body=' + encodeURIComponent(topic + 'について相談を希望します。\n\n会社名：\nご担当者名：\n現在の業務・管理方法：\n困っている作業：');
const lineUrl = settings.line_url?.trim() || '';
const generalMail = mailFor('AI導入・業務自動化');
const consult = lineUrl || generalMail;
const faqs = [
  { q: '複数の部署の業務を、まとめて管理できますか？', a: '経理・CS・受発注など、部署ごとに分かれている入力や進捗管理をつなぐ仕組みをご提案します。まず既存ツール・権限・データ形式を確認し、連携できる範囲と必要な画面を決めます。業務全体の一括自動化を一律料金で保証するものではなく、開発範囲と費用は事前にご案内します。' },
  { q: 'どのプランを選べばいいですか？', a: 'まず方針を相談したい場合はAI導入コンサル（月' + yen(consulting.price) + '万円）、自社専用の仕組みをつくりたい場合は専用ツール・業務アプリ開発（1件' + yen(development.price) + '万円）、請求書管理から始めたい場合は請求書自動化（導入' + yen(invoice.price) + '万円）をご案内します。いずれも' + tax(invoice.taxIncluded) + 'です。迷っている段階でもご相談ください。' },
  { q: 'AI導入コンサルには、開発も含まれますか？', a: 'コンサルでは、現在の業務の整理、AIを活用する場所の検討、導入・運用方法の相談を行います。専用ツールの開発が必要な場合は、対象範囲と費用をご案内したうえで別途承ります。' },
  { q: '1件30万円で、どこまで開発できますか？', a: '入力・管理・集計など、御社の業務に合わせた専用ツールを開発します。必要な機能、画面、連携先を伺い、1件' + yen(development.price) + '万円（' + tax(development.taxIncluded) + '）で対応する範囲を契約前に決めます。追加開発、外部サービスの利用料、継続保守が必要な場合は、別途費用を事前にご案内します。' },
  { q: '請求書自動化の5万円は、月額料金ですか？', a: '月額ではなく導入費用です。毎月' + invoice.monthlyLimit + '社限定で、通常' + yen(invoice.regularPrice) + '万円のところ' + yen(invoice.price) + '万円（' + tax(invoice.taxIncluded) + '）でご提供します。読み取り対象・書式・連携先を確認し、自動化する範囲を決めます。外部ツール利用料や保守が必要な場合は、契約前にご案内します。' },
  { q: '今使っているExcelやツールのまま相談できますか？', a: 'はい。Excel・スプレッドシート・メール・会計ソフトなど、現在の環境と作業手順を伺います。連携の可否を確認し、今の運用を活かせる方法からご提案します。AIに詳しい社員がいなくてもご相談いただけます。' },
  { q: 'AIの間違いや、機密情報の取り扱いはどうなりますか？', a: 'AIの出力を担当者が確認・修正できる工程を組み込みます。利用するサービス、保存先、閲覧権限、データの取り扱いは導入前に確認します。振込や会計処理の確定など、重要な最終判断は人が確認する前提で設計します。' },
];
const flow = [
  { n: '01', title: '作業とコストを洗い出す', body: '部署別の担当人数・作業時間・外注費を整理。毎月くり返す定型業務から、負担の大きい場所を見つけます。' },
  { n: '02', title: '効果の大きい業務から選ぶ', body: '圧縮できる経費と、別の仕事へ回せる時間を見積もります。導入・運用費用と比べ、優先順位を決めます。' },
  { n: '03', title: '業務に合わせて実装', body: '選んだプランに沿って導入や開発を進め、実際の担当者と動作・操作を確認します。' },
  { n: '04', title: '人の配置と運用を整える', body: '確認・例外対応の担当を決め、浮いた時間を営業や顧客提案へ。少人数で定型業務を回せる運用を目指します。' },
];
const examples = [
  { name: 'LAYR B2B DB', label: '営業管理', text: '営業リストや問い合わせをまとめて管理。探す・転記する作業を減らすための社内ツールです。', images: [
    ['/service/ai/shots/b2b-1.jpg', '営業管理のダッシュボード'], ['/service/ai/shots/b2b-2.jpg', '営業リストと提案文の管理'], ['/service/ai/shots/b2b-3.jpg', '顧客台帳の管理'],
  ] },
  { name: 'バナラボ', label: '制作業務', text: '配信サイズに合わせたバナー制作を支援。繰り返し発生する制作作業にもAIを取り入れています。', images: [
    ['/service/ai/shots/banlabo-1.jpg', '広告バナーの生成画面'], ['/service/ai/shots/banlabo-2.jpg', '媒体別サイズの選択画面'],
  ] },
  { name: 'LINEスコア診断', label: '顧客対応', text: '質問への回答からレポートを作成。ヒアリングから情報整理までの流れを仕組みにしています。', images: [
    ['/service/ai/shots/check-1.jpg', 'LINEスコア診断の開始画面'], ['/service/ai/shots/check-2.jpg', '質問と診断レポートの画面'],
  ] },
  { name: 'L SCOPE', label: '分析業務', text: '広告・LP・LINE配信の流れを可視化。情報を並べて確認する作業から、改善の検討へつなげます。', images: [
    ['/service/ai/shots/lscope-1.svg', '広告からLINE配信までの流れを整理する機能図'],
  ] },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://layr.co.jp/' },
    { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://layr.co.jp/service/' },
    { '@type': 'ListItem', position: 3, name: brandName },
  ] },
  { '@context': 'https://schema.org', '@type': 'Service', '@id': 'https://layr.co.jp/#service-ai', name: brandName, serviceType: 'AI業務効率化・業務自動化', provider: { '@id': 'https://layr.co.jp/#organization' }, areaServed: 'JP', url: 'https://layr.co.jp/service/ai/', offers: service.plans.map(plan => ({
    '@type': 'Offer', name: plan.name, price: plan.price, priceCurrency: 'JPY', description: plan.billing + '・' + yen(plan.price) + '万円（' + tax(plan.taxIncluded) + '）。' + plan.note, url: 'https://layr.co.jp/service/ai/#plan-' + plan.id, priceSpecification: { '@type': 'PriceSpecification', price: plan.price, priceCurrency: 'JPY', valueAddedTaxIncluded: plan.taxIncluded },
  })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={service.title} description={service.description} jsonLd={jsonLd} hideHeader={true}>
<div class="ai-lp">
  <header class="ai-header">
    <div class="ai-wrap ai-header-inner">
      <a href="/service/ai/" class="ai-brand" aria-label={brandName + ' トップへ'}><strong>{service.brand}</strong><span>{service.byline}</span></a>
      <nav class="ai-nav" aria-label="AIサービスのページ内ナビゲーション"><a href="#automation">効率化できる業務</a><a href="#price">3つのプラン</a><a href="#works">支援実績</a></nav>
      <a href={consult} class="ai-button ai-button-small" data-ai-lead="header" data-ai-plan="general">無料で相談する <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <section class="ai-hero">
    <div class="ai-wrap ai-hero-grid">
      <div class="ai-hero-copy">
        <p class="ai-hero-kicker">人件費・バックオフィス経費を見直す。</p>
        <h1>{service.hero.line1}<br /><em>{service.hero.emphasis}</em></h1>
        <p class="ai-lead">{service.hero.lead.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</p>
        <div class="ai-actions"><a href={consult} class="ai-button" data-ai-lead="hero" data-ai-plan="general">経費を見直す無料相談 <span aria-hidden="true">↗</span></a><a href="#automation" class="ai-text-link">効率化できる業務を見る <span aria-hidden="true">↓</span></a></div>
        <p class="ai-hero-note">AI導入コンサル・専用アプリ開発・業務自動化</p>
      </div>
      <figure class="ai-hero-art">
        <img src="/service/ai/ai-office.webp" alt="AIが会社で入力・情報整理・対応を進め、人が本業に集中する様子を描いたアイソメトリックイラスト" width="1536" height="1024" fetchpriority="high" decoding="async" />
        <figcaption>守りはAIと少数の人で。人は、売上をつくる仕事へ。</figcaption>
      </figure>
    </div>
    <div class="ai-wrap ai-value-strip" aria-label="AI導入で目指すこと">
      <p><span>守りの業務を省力化</span><strong>残業・外注費を圧縮</strong></p>
      <p><span>人の力を活かす</span><strong>営業・顧客提案へ配置</strong></p>
      <p><span>増収を利益につなげる</span><strong>利益率を高める体制へ</strong></p>
    </div>
  </section>

  <section class="ai-section ai-change" id="change">
    <div class="ai-wrap">
      <div class="ai-section-heading ai-heading-wide"><p class="ai-eyebrow">売上が伸びるたびに、人を増やす経営から。</p><h2>守りの業務を、軽くする。<br /><em>人の力を、売上に変える。</em></h2></div>
      <div class="ai-comparison">
        <article class="ai-before">
          <p class="ai-compare-label"><span>BEFORE</span> いまの仕事</p>
          <h3>人を増やして、<br />作業を回す。</h3>
          <ul><li>受注が増えるほど、事務作業も増える</li><li>残業・外注・追加採用で対応する</li><li>営業や顧客提案に人を回せない</li></ul>
          <p class="ai-before-result">売上が増えても、<br /><strong>経費が膨らみ、利益が残りにくい。</strong></p>
        </article>
        <article class="ai-after">
          <p class="ai-compare-label"><span>AFTER</span> AIを業務に組み込むと</p>
          <h3>事務は、AI。<br /><em>人は、売上へ。</em></h3>
          <dl><div><dt>入力・集計・一次対応</dt><dd>AIで定型作業を省力化</dd></div><div><dt>確認・判断・例外対応</dt><dd>少数の担当者で管理</dd></div><div><dt>営業・提案・顧客フォロー</dt><dd>人を、売上を生む部署へ</dd></div></dl>
          <p class="ai-after-result"><span>残業・外注・追加採用を抑え、</span><strong>同じ人員で、利益を伸ばす体制へ。</strong></p>
        </article>
      </div>
      <p class="ai-comparison-note">工数が減るだけで、給与総額がそのまま下がるわけではありません。残業・外注・追加採用の抑制と、既存社員の再配置を分けて、導入・運用費用を含む効果を整理します。</p>
    </div>
  </section>

  <section class="ai-section ai-automation" id="automation">
    <div class="ai-wrap">
      <div class="ai-section-heading ai-heading-wide"><p class="ai-eyebrow">経費を見直せる、6つの業務分野</p><h2>毎月の「人がやる作業」を、<br /><em>AIに任せる仕組みへ。</em></h2><p>人数・件数・頻度が大きい業務ほど、見直す余地があります。<br />バックオフィスからCSまで、部署をまたぐ定型業務をまとめて整理します。</p></div>
      <div class="ai-area-columns" aria-hidden="true"><span>見直す分野</span><span>AIに任せられる定型業務の例</span><span>圧縮を狙えるコスト</span></div>
      <div class="ai-area-list">{service.automationAreas.map((area, index) => <article class="ai-area" id={'area-' + area.id}>
        <div class="ai-area-title"><span>{String(index + 1).padStart(2, '0')}</span><h3>{area.name}</h3></div>
        <ul>{area.tasks.map(task => <li>{task}</li>)}</ul>
        <div class="ai-area-cost"><p>圧縮を狙えるコスト</p><strong>{area.cost}</strong></div>
      </article>)}</div>
      <p class="ai-comparison-note">上記は自動化・効率化の候補です。書式・連携先・件数によって対応範囲を設計し、会計処理の確定や人事判断、例外対応は担当者が確認します。</p>
    </div>
  </section>

  <section class="ai-section ai-hub" id="management">
    <div class="ai-wrap">
      <div class="ai-section-heading ai-heading-wide"><p class="ai-eyebrow">部署ごとの作業を、ひとつの流れに</p><h2>散らばる事務を、<br /><em>まとめて管理。</em></h2><p>メール・PDF・Excel・既存ツールに分かれた情報をつなぎ、<br />AIの処理から担当者の確認までを、御社専用の仕組みに整えます。</p></div>
      <ol class="ai-hub-flow">
        <li><span class="ai-hub-number">01 / 集める</span><h3>部署の情報を集約</h3><p>請求書、注文、問い合わせ、申請データを、必要な管理先へ。</p></li>
        <li><span class="ai-hub-number">02 / 任せる</span><h3>定型作業をAIが処理</h3><p>分類・転記・集計・下書き。担当者が毎回手を動かす工程を減らします。</p></li>
        <li><span class="ai-hub-number">03 / 確かめる</span><h3>人は確認と例外対応へ</h3><p>進捗と確認事項を管理画面に集め、少数の担当者が判断できる状態へ。</p></li>
      </ol>
      <div class="ai-reallocation"><p>そこで生まれた時間と人の力を、</p><strong>営業・顧客提案・既存顧客のフォローへ。</strong><p>守りの経費を抑えながら、売上をつくる体制に変えていきます。</p></div>
      <p class="ai-comparison-note">既存システムとの連携可否、権限、管理画面の範囲は事前に確認します。必要な業務から段階的に構築します。</p>
    </div>
  </section>

  <section class="ai-section ai-plans-section" id="price">
    <div class="ai-wrap">
      <div class="ai-section-heading ai-heading-wide"><p class="ai-eyebrow">相談から、実装まで。</p><h2>御社に合わせて選べる、<br /><em>3つのプラン。</em></h2><p>まず相談する。専用の仕組みをつくる。一つの作業から始める。<br />今の課題に合う入口を選べます。</p></div>
      <div class="ai-plans">{service.plans.map((plan, index) => <article class={'ai-plan ai-plan-' + plan.id} id={'plan-' + plan.id}>
        <div class="ai-plan-top"><span class="ai-plan-number">{String(index + 1).padStart(2, '0')}</span><span>{plan.label}</span></div>
        <h3>{plan.name}</h3>
        <p class="ai-plan-description">{plan.description}</p>
        <div class="ai-plan-price"><span class="ai-plan-billing">{plan.billing}</span><p><strong>{yen(plan.price)}</strong><b>万円</b><span> / {plan.unit}</span></p><small>（{tax(plan.taxIncluded)}）</small></div>
        {plan.id === 'invoice' && <p class="ai-plan-limit">通常<s>{yen(invoice.regularPrice)}万円</s> → 毎月{invoice.monthlyLimit}社限定</p>}
        <ul>{plan.features.map(feature => <li>{feature}</li>)}</ul>
        <p class="ai-plan-note">{plan.note}</p>
        {plan.id === 'invoice' ? <a href="#invoice" class="ai-button ai-button-outline">請求書プランを見る <span aria-hidden="true">↓</span></a> : <a href={lineUrl || mailFor(plan.name)} class="ai-button" data-ai-lead="plan" data-ai-plan={plan.id}>このプランを相談する <span aria-hidden="true">↗</span></a>}
      </article>)}</div>
      <p class="ai-plans-note">外部ツール・APIの利用料や継続保守が必要な場合は、対象範囲とあわせて契約前にご案内します。</p>
    </div>
  </section>

  <AiInvoiceOffer placement="middle" />

  <section class="ai-section ai-flow" id="flow">
    <div class="ai-wrap ai-split"><div class="ai-section-heading"><p class="ai-eyebrow">導入の流れ</p><h2>毎月かかる経費から、<br /><em>見直す場所を見つける。</em></h2><p>部署ごとの業務と、かかっている時間。<br />まずは今の体制をお聞かせください。</p><a href={consult} class="ai-text-link" data-ai-lead="flow" data-ai-plan="general">まずは無料で相談 <span aria-hidden="true">↗</span></a></div><ol class="ai-flow-list">{flow.map(step => <li><span>{step.n}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol></div>
  </section>

  <section class="ai-section ai-works" id="works">
    <div class="ai-wrap">
      <div class="ai-section-heading ai-heading-wide"><p class="ai-eyebrow">支援実績・自社実装例</p><h2>AIはもう、<br /><em>現場で働いています。</em></h2><p>お客様のオーダー業務の自動化から、自社ツールの開発まで。<br />仕事の中で使える仕組みをつくっています。</p></div>
      {service.clientCases.map(client => <article class="ai-client-case">
        <div class="ai-client-story"><p class="ai-eyebrow">お客様の支援実績</p><p class="ai-client-name">{client.company}<span> 様</span></p><h3>{client.title}</h3><p class="ai-client-description">{client.description}</p></div>
        <div class="ai-client-info"><dl><div><dt>業種</dt><dd>{client.industry}</dd></div><div><dt>支援内容</dt><dd>{client.support}</dd></div></dl><a href={client.url} class="ai-text-link" target="_blank" rel="noopener noreferrer" aria-label={client.company + 'の商品カタログを見る（新しいタブで開きます）'}>同社の商品カタログを見る <span aria-hidden="true">↗</span></a></div>
      </article>)}
      <div class="ai-own-heading"><p class="ai-eyebrow">LAYRの自社実装例</p><p>営業管理、制作、情報整理。自分たちの実務でも使っています。</p></div>
      <div class="ai-example-list">{examples.map((example, i) => <details class="ai-example" open={i === 0}>
        <summary><span class="ai-example-label">{example.label}</span><h3>{example.name}</h3><span class="ai-toggle" aria-hidden="true"></span></summary>
        <div class="ai-example-content"><p>{example.text}</p><div class="ai-gallery" tabindex="0" role="region" aria-label={example.name + 'の画面。横にスクロールして閲覧できます。'}>{example.images.map(([src, caption]) => <figure><img src={src} alt={caption} width="1400" height="900" loading="lazy" decoding="async" /><figcaption>{caption}{src.endsWith('.svg') ? '（機能図）' : '（自社ツール）'}</figcaption></figure>)}</div>{example.images.length > 1 && <p class="ai-gallery-note">横にスクロールして、ほかの画面を見る <span aria-hidden="true">→</span></p>}</div>
      </details>)}</div>
    </div>
  </section>

  <section class="ai-section ai-faq" id="faq"><div class="ai-wrap ai-split"><div class="ai-section-heading"><p class="ai-eyebrow">よくあるご質問</p><h2>導入前の<br /><em>気になること。</em></h2></div><div class="ai-faq-list">{faqs.map(f => <details><summary><span>Q</span><h3>{f.q}</h3><span class="ai-toggle" aria-hidden="true"></span></summary><p>{f.a}</p></details>)}</div></div></section>

  <AiInvoiceOffer placement="final" />
</div>
</Base>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-ai-lead]').forEach(link => {
    link.addEventListener('click', () => {
      const analytics = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
      if (typeof analytics === 'function') analytics('event', 'generate_lead', {
        event_category: 'ai_automation', event_label: link.dataset.aiLead, plan: link.dataset.aiPlan || 'general', method: link.href.startsWith('mailto:') ? 'email' : 'line',
      });
    });
  });
</script>
