  .fin-s{font-size:var(--wa-fs-sm);color:color-mix(in srgb, var(--wa-paper) 85%, transparent);line-height:2;margin-bottom:30px}
  .fin-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  .btn-ink.is-w{background:var(--wa-shu);color:var(--wa-paper)}
  .btn-ink.is-w:hover{background:var(--wa-shu-dark)}
  .btn-line2.is-w{background:transparent;color:var(--wa-paper);border-color:color-mix(in srgb, var(--wa-paper) 60%, transparent)}
  .btn-line2.is-w:hover{background:color-mix(in srgb, var(--wa-paper) 10%, transparent)}

  @media(max-width:1100px){
    .hanko{display:none}
  }
  @media(max-width:920px){
    .hv-in{grid-template-columns:1fr}
