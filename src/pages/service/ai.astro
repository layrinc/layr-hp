---
/**
 * 法人向けAI導入・業務実装支援 LP（/service/ai/）— v2 仮公開版
 * ターゲット: 地方中小・AI超初心者（2026-08-18確定）
 * 価格: AI顧問 初期10万＋月5万を主役に、開発30万〜を従に（2階建て）
 * トンマナ: 白×淡青・語りかけ型（参考: freelance-gakkou.com ／ AX CAMP資料）
 * 正本: AI導入支援事業/（競合調査・LP修正案）。値上げ運用ルールはLPに書かない。
 */
import Base from '../../layouts/Base.astro';
import settings from '../../data/settings.json';

const title = '法人向けAI導入・業務実装支援｜株式会社LAYR';
const description = 'AIを何から始めればいいか分からない中小企業向け。初期10万円・月額5万円のAI顧問から、業務アプリ開発まで。専門知識は不要です。';
const mail = `mailto:${settings.email}?subject=${encodeURIComponent('【無料相談】AI導入について')}`;
const lineUrl = settings.line_url?.trim() || '';

const starts = [
  'AIが良いのは分かるけど、何から始めればいいのか分からない',
  'ChatGPTは登録してみたが、結局使っていない',
  'うちみたいな会社に、AIなんてまだ早いと思っている',
  '詳しい社員がいない。相談できる相手もいない',
  '業者に頼むと高いイメージがあって、聞くのが怖い',
  'そもそも、うちの何がAIでできるのか分からない',
];

const pains = [
  ['📅', '予約・スケジュール管理', '電話とホワイトボードで管理していて、ダブルブッキングが怖い'],
  ['👥', 'スタッフの割り振り', 'シフトと案件のマッチングを毎週、手で組んでいる'],
  ['🧾', '請求書の発行', '月末に1件ずつ作って送っている。ミスも起きる'],
  ['💬', '問い合わせ対応', '同じ質問への返信に、毎日時間が溶けている'],
  ['⌨️', '転記・入力作業', '紙やExcelからの転記が誰かの仕事になっている'],
  ['📊', 'レポート作成', '数字を集めて資料にするだけで半日かかる'],
];

const services = [
  { n: '01', t: 'AI顧問（毎月の伴走）', d: '月1回の定例とチャット相談で、御社の業務を一緒に見ながら「AIで手放せる作業」から順番に片づけます。毎月ひとつ、小さな自動化を作って納品します。', chips: ['月1回の定例MTG', 'チャット相談 無制限', '毎月1つの自動化', '使い方レクチャー'] },
  { n: '02', t: '業務Webアプリ開発', d: '予約受付からカレンダー表示、スタッフ割り振り、LINE連携、請求書のダウンロードまで。バラバラだった業務をひとつのアプリに束ねます。必要になったタイミングで、プロトタイプを見てから決められます。', chips: ['予約・カレンダー', 'スタッフ管理', 'LINE連携', '請求書発行'] },
  { n: '03', t: 'AI業務効率化の実装', d: '文書作成・問い合わせ一次対応・データ整理・レポート生成など、繰り返し業務にAIを組み込みます。「ツールを契約して終わり」ではなく、御社の業務フローの中で毎日動く仕組みにします。', chips: ['文書・資料の自動作成', '問い合わせ自動化', 'データ整理', '定型レポート'] },
];

const tools = [
  ['🧾', '経理まとめ君', '請求書の発行から記帳、納税の積立額まで自動で'],
  ['📝', '提案書つくる君', '商談用の提案書を、9章構成でAIが下書き'],
  ['🎨', 'バナラボ', '広告バナーをAIで量産・微調整'],
  ['⭐', '口コミあつめ君', 'Google口コミの獲得からAI返信まで'],
  ['📊', '経営ダッシュボード', '毎週月曜7時に、数字が勝手に更新される'],
  ['💬', 'LINE配信作成', '配信文の切り口出しから原稿まで'],
];

const faqs = [
  { q: '費用の目安を教えてください。', a: 'AI顧問は初期10万円＋月額5万円からです。業務アプリの開発が必要になった場合は別途、単機能の業務ツールで30万円〜、予約・請求まで束ねた一式で80万円〜が目安です(税抜)。' },
  { q: '本当に何も分かっていないのですが、大丈夫ですか？', a: 'それが普通です。「ChatGPTを開いたことがない」状態からのご相談がいちばん多い前提で設計しています。専門用語は使いません。' },
  { q: '月5万円で、具体的に何をしてもらえますか？', a: '月1回の定例ミーティング(オンライン60〜90分)、チャットでの相談(回数無制限)、毎月ひとつの小さな自動化の納品、ツール選定と社内向けの使い方レクチャーです。' },
  { q: '途中でやめられますか？', a: '最低3ヶ月で、4ヶ月目以降は月単位でいつでも停止できます。違約金もありません。' },
  { q: '地方なのですが、対応できますか？', a: 'オンラインで完結するので全国対応しています。必要な場合のみ訪問します。' },
  { q: '補助金は使えますか？', a: '業務アプリの開発は「デジタル化・AI導入補助金2026」の対象になる可能性があります(最大450万円・小規模事業者は補助率最大4/5)。申請の進め方もご相談ください。※支給は審査によるもので、保証するものではありません。' },
  { q: '社員が「AIに仕事を奪われる」と不安がっています。', a: '人を減らすためではなく、面倒な作業を手放して、人にしかできない仕事に時間を回すための導入です。社内向けの使い方レクチャーも含めて設計します。' },
  { q: '発注前に完成イメージを確認できますか？', a: 'はい。開発をご検討いただく場合は、ご発注の前に動くプロトタイプをご覧いただき、確認してから範囲と金額を決めていただけます。' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://layr.co.jp/' },
      { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://layr.co.jp/service/' },
      { '@type': 'ListItem', position: 3, name: 'AI導入・業務実装支援' },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'Service', '@id': 'https://layr.co.jp/#service-ai',
    name: '法人向けAI導入・業務実装支援', serviceType: 'AI導入支援・AI顧問・業務システム開発',
    provider: { '@id': 'https://layr.co.jp/#organization' }, areaServed: 'JP', url: 'https://layr.co.jp/service/ai/',
    hasOfferCatalog: {
      '@type': 'OfferCatalog', name: 'AI導入支援プラン',
      itemListElement: [
        { '@type': 'Offer', name: 'AI顧問', priceSpecification: { '@type': 'UnitPriceSpecification', price: 50000, priceCurrency: 'JPY', unitText: '月' } },
        { '@type': 'Offer', name: '業務アプリ開発', priceSpecification: { '@type': 'PriceSpecification', minPrice: 300000, priceCurrency: 'JPY' } },
      ],
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="subpage-pad"></div>

  <!-- HERO（淡青・語りかけ型） -->
  <section class="av-hero">
    <div class="container av-hero-in">
      <p class="av-badge">地方の中小企業向け ／ AI導入・業務実装支援</p>
      <h1>「AIって、うちに関係あるの？」<br /><em>——からで、大丈夫です。</em></h1>
      <p class="av-lead">何から手をつければいいか分からない。それが普通です。LAYRは専門用語を使わずに御社の業務を一緒に見て、AIで手放せる作業から順番に片づけていきます。まずは、1つの業務を自動化するところから。</p>
      <div class="av-cta-row">
        {lineUrl ? (
          <>
            <a class="av-btn" href={lineUrl}>LINEで相談する<i>›</i></a>
            <a class="av-btn is-ghost" href={mail}>メールで相談する</a>
          </>
        ) : (
          <>
            <a class="av-btn" href={mail}>無料で相談する<i>›</i></a>
            <a class="av-btn is-ghost" href="#price">料金を見る</a>
          </>
        )}
      </div>
      <p class="av-checks"><span>✓ 売り込みなし</span><span>✓ 専門用語なし</span><span>✓ 質問だけでもOK</span></p>
      <div class="av-hero-stats">
        <div><b>月5万円〜</b><span>AI顧問（初期10万円）</span></div>
        <div><b>0円</b><span>発注前のプロトタイプ</span></div>
        <div><b>30本+</b><span>自社でAI内製した業務ツール</span></div>
      </div>
    </div>
  </section>

  <!-- スタート地点 -->
  <section class="av-sec">
    <div class="container av-narrow">
      <p class="av-en">START ／ こんなところから、始まります</p>
      <h2 class="av-h2">皆さん、だいたいここから始まります。</h2>
      <div class="av-starts">
        {starts.map((s, i) => (
          <div class="av-start"><span class="n">{i + 1}</span><p>「{s}」</p></div>
        ))}
      </div>
      <div class="av-callout">
        <p class="t">→ ぜんぶ、普通です。</p>
        <p class="s">実際、AIを導入していない中小企業のいちばんの理由は「何から始めればいいか分からない」でした。<br /><small>（中小企業基盤整備機構 調査／2026年3月）</small></p>
      </div>
    </div>
  </section>

  <!-- 手放せる作業の例 -->
  <section class="av-sec is-tint">
    <div class="container">
      <p class="av-en">EXAMPLES ／ AIで手放せる作業の例</p>
      <h2 class="av-h2">たとえば、こんな「手作業」。</h2>
      <div class="av-pains">
        {pains.map((p) => (
          <div class="av-pain"><span class="ic">{p[0]}</span><b>{p[1]}</b><p>{p[2]}</p></div>
        ))}
      </div>
      <p class="av-arrow">こうした作業から、<b>ひとつずつ手放していけます。</b></p>
    </div>
  </section>

  <!-- できること3つ -->
  <section class="av-sec">
    <div class="container">
      <p class="av-en">SERVICE ／ できること</p>
      <h2 class="av-h2">LAYRのAI支援は、3つ。</h2>
      <div class="av-svcs">
        {services.map((s) => (
          <div class="av-svc">
            <span class="num">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <div class="chips">{s.chips.map((c) => <span>{c}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 自社で使っています -->
  <section class="av-sec is-blue">
    <div class="container av-narrow">
      <p class="av-en is-w">OUR OWN ／ 自社での実践</p>
      <h2 class="av-h2 is-w">このAI、まず自分たちで使っています。</h2>
      <p class="av-blue-lead">LAYRは社員を増やさずに会社を回すため、業務ツールをすべてAIで内製しています。売るために作ったのではなく、自分たちが必要だから作ったものです。</p>
      <div class="av-tools">
        {tools.map((t) => (
          <div class="av-tool"><span class="ic">{t[0]}</span><div><b>{t[1]}</b><p>{t[2]}</p></div></div>
        ))}
      </div>
      <p class="av-blue-note">…ほか、30本以上。御社にお渡しするのは、<b>この体制そのもの</b>です。</p>
    </div>
  </section>

  <!-- 選ばれる理由 -->
  <section class="av-sec">
    <div class="container av-narrow">
      <p class="av-en">WHY LAYR ／ 選ばれる理由</p>
      <h2 class="av-h2">安心して、任せてもらえる理由。</h2>
      <div class="av-whys">
        <div class="av-why"><b>分からないことを、分からないまま聞けます</b><p>「こんなことも知らないのか」と思われる心配は不要です。専門用語を使わず、御社の言葉で会話します。</p></div>
        <div class="av-why"><b>発注前に、動くものを見せます</b><p>開発をご検討の場合は「完成してみないと分からない」を無くすため、契約前にプロトタイプをご覧いただきます。</p></div>
        <div class="av-why"><b>自社で毎日やっていることを、そのまま提供</b><p>LAYR自身が30本以上の業務ツールをAIで内製して経営しています。売るためのAIではなく、使うためのAIを知っています。</p></div>
        <div class="av-why"><b>LINE連携が得意</b><p>LINEマーケティング専業の知見をそのまま接続。予約通知・顧客対応・配信まで、LINEと業務の仕組みを一体で設計できます。</p></div>
      </div>
    </div>
  </section>

  <!-- 進め方（2本立て） -->
  <section class="av-sec is-tint" id="flow">
    <div class="container av-narrow">
      <p class="av-en">FLOW ／ 進め方</p>
      <h2 class="av-h2">進め方は、2通り。</h2>
      <div class="av-flows">
        <div class="av-flowcard">
          <p class="fc-t">🟦 AI顧問で始める（おすすめ）</p>
          <ol>
            <li><b>無料相談</b>困りごとが言葉にできていなくても大丈夫です。一緒に探します</li>
            <li><b>初期設定</b>ツールの用意と、最初の自動化テーマを決めます</li>
            <li><b>毎月の伴走</b>定例＋チャット相談＋毎月ひとつの自動化</li>
          </ol>
        </div>
        <div class="av-flowcard">
          <p class="fc-t">🏗️ 業務アプリを開発する</p>
          <ol>
            <li><b>ヒアリング</b>現状の業務と、束ねたい作業を伺います</li>
            <li><b>プロトタイプ提示</b>発注前に、動くものをご覧いただきます（無料）</li>
            <li><b>松竹梅お見積もり→開発</b>3案から選んで、開発・運用伴走へ</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 料金（2階建て） -->
  <section class="av-sec" id="price">
    <div class="container av-narrow">
      <p class="av-en">PRICE ／ 料金</p>
      <h2 class="av-h2">月5万円から、始められます。</h2>

      <div class="av-price is-main">
        <p class="pr-label">① まずは「AI顧問」から</p>
        <div class="pr-nums">
          <div><span>初期費用</span><b>10<small>万円</small></b></div>
          <div><span>月額</span><b>5<small>万円</small></b></div>
        </div>
        <ul class="pr-list">
          <li>月1回の定例ミーティング（オンライン60〜90分）</li>
          <li>チャットでの相談は回数無制限</li>
          <li>毎月ひとつ、小さな自動化をつくって納品</li>
          <li>ツール選定と、社内の使い方レクチャー</li>
        </ul>
        <p class="pr-note">最低3ヶ月から。4ヶ月目以降は月単位で、いつでも停止できます。</p>
      </div>

      <div class="av-price is-sub">
        <p class="pr-label">② 本格的に作るなら「業務アプリ開発」</p>
        <div class="pr-rows">
          <div><b>単機能の業務ツール</b><span>30万円〜</span></div>
          <div><b>業務アプリ一式（予約〜請求まで）</b><span>80万円〜</span></div>
          <div><b>大規模・基幹連携・LINE連携込み</b><span>150万円〜</span></div>
        </div>
        <p class="pr-note">※ 顧問契約とは別のお見積もりです。必要になったタイミングで、動くプロトタイプをご確認いただいてから決めていただけます。※ 税抜・目安</p>
      </div>

      <p class="av-price-cap">※ 現在の価格は、先着5社さまの実績づくり価格です。</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="av-sec is-tint">
    <div class="container av-narrow">
      <p class="av-en">FAQ ／ よくあるご質問</p>
      <h2 class="av-h2">よくあるご質問</h2>
      <div class="av-faq">
        {faqs.map((f) => (
          <details class="av-q"><summary><span>Q</span>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="av-final">
    <div class="container">
      <p class="t">まずは、御社の「よく分からない」を聞かせてください。</p>
      <p class="s">まだ何も決まっていない段階で構いません。質問だけでも大丈夫です。</p>
      <div class="row">
        {lineUrl ? (
          <>
            <a class="av-btn" href={lineUrl}>LINEで相談する<i>›</i></a>
            <a class="av-btn is-ghost2" href={mail}>メールで相談する</a>
          </>
        ) : (
          <a class="av-btn" href={mail}>無料で相談する<i>›</i></a>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== 白×淡青・語りかけ型（freelance-gakkou参考トンマナ） ===== */
  .av-hero{background:linear-gradient(165deg,#F3F9FF 0%,#fff 45%,#E7F2FD 100%);padding:clamp(52px,7.5vw,92px) 0;border-bottom:1px solid #E3EEF9}
  .av-hero-in{max-width:820px}
  .av-badge{display:inline-block;background:#fff;border:1.5px solid #CBE2F7;color:#2B6CB0;border-radius:999px;padding:7px 20px;font-size:12.5px;font-weight:800;letter-spacing:.04em;margin-bottom:24px}
  .av-hero h1{font-size:clamp(26px,4.8vw,44px);font-weight:900;line-height:1.6;letter-spacing:-.005em;color:#16324F}
  .av-hero h1 em{font-style:normal;color:#2B6CB0}
  .av-lead{font-size:15px;line-height:2.15;color:#3D5570;max-width:38em;margin:20px 0 28px}
  .av-cta-row{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:14px}
  .av-btn{display:inline-flex;align-items:center;gap:10px;background:linear-gradient(90deg,#57A5E8,#3B82D6);color:#fff;font-weight:800;font-size:15px;border-radius:999px;padding:15px 40px;text-decoration:none;box-shadow:0 8px 22px rgba(59,130,214,.3);transition:transform .15s,box-shadow .15s}
  .av-btn:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(59,130,214,.4)}
  .av-btn i{font-style:normal;font-weight:900}
  .av-btn.is-ghost{background:#fff;color:#2B6CB0;border:2px solid #BBD9F3;box-shadow:none}
  .av-btn.is-ghost2{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.5);box-shadow:none}
  .av-checks{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;font-weight:700;color:#5B7A97;margin-bottom:32px}
  .av-checks span::first-letter{color:#3B82D6}
  .av-hero-stats{display:flex;gap:clamp(20px,4vw,54px);flex-wrap:wrap;border-top:1.5px solid #DCEBF9;padding-top:24px}
  .av-hero-stats b{display:block;font-weight:900;font-size:24px;color:#2B6CB0;line-height:1.3}
  .av-hero-stats span{font-size:11.5px;color:#5B7A97;font-weight:700}
  /* sections */
  .av-sec{padding:clamp(54px,7vw,90px) 0;background:#fff}
  .av-sec.is-tint{background:#F3F9FF}
  .av-sec.is-blue{background:linear-gradient(160deg,#2B6CB0,#1E518C);color:#fff}
  .av-en{font-size:11.5px;font-weight:800;letter-spacing:.14em;color:#57A5E8;text-align:center;margin-bottom:10px}
  .av-en.is-w{color:#A8D4F7}
  .av-h2{font-size:clamp(21px,3.3vw,30px);font-weight:900;letter-spacing:-.005em;line-height:1.6;color:#16324F;text-align:center;margin-bottom:32px}
  .av-h2.is-w{color:#fff}
  .av-narrow{max-width:860px}
  /* starts */
  .av-starts{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px}
  .av-start{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1.5px solid #E3EEF9;border-radius:14px;padding:18px 20px;box-shadow:0 2px 10px rgba(43,108,176,.05)}
