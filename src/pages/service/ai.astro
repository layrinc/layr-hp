    .hv-frames img:first-child{opacity:1}
    .reveal{opacity:1;transform:none;transition:none}
    .td-check::after,.td-strike::after,.td-done{transition:none}
    .sw-panel.is-on{animation:none}
  }
</style>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // ---------- ショーケース: スライダー（パネルごとに独立） ----------
  // パネルはdisplay:noneで隠すため、再表示時にscrollLeftが0へ戻る。
  // 表示のたびにsyncを呼んで内部状態と実位置を合わせ直す。
  const sliders = new Map<string, () => void>();

  document.querySelectorAll<HTMLElement>('.sw-panel').forEach((panel) => {
    const vp = panel.querySelector<HTMLElement>('.sw-viewport');
    const slides = panel.querySelectorAll('.sw-slide');
    const dots = panel.querySelectorAll<HTMLButtonElement>('.sw-dot');
    const prev = panel.querySelector<HTMLButtonElement>('.sw-arrow.is-prev');
    const next = panel.querySelector<HTMLButtonElement>('.sw-arrow.is-next');
    if (!vp) return;
    let idx = 0;
    // スライド間のgapを含めた1枚あたりの送り幅
    const step = () => {
      const first = slides[0] as HTMLElement | undefined;
      const second = slides[1] as HTMLElement | undefined;
      if (first && second) return second.offsetLeft - first.offsetLeft;
      return vp.clientWidth;
    };
    const setUI = () => {
      dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
      if (prev) prev.disabled = idx <= 0;
      if (next) next.disabled = idx >= slides.length - 1;
    };
    const go = (i: number, smooth = true) => {
      idx = Math.max(0, Math.min(slides.length - 1, i));
      vp.scrollTo({ left: idx * step(), behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto' });
      setUI();
    };
    prev?.addEventListener('click', () => go(idx - 1));
    next?.addEventListener('click', () => go(idx + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    // 手動スワイプにもドット・矢印を追従させる
    let st: number | undefined;
    vp.addEventListener('scroll', () => {
      if (st) window.clearTimeout(st);
      st = window.setTimeout(() => { idx = Math.round(vp.scrollLeft / step()); setUI(); }, 80);
    }, { passive: true });
    // 表示直後・リサイズ後に実位置へ合わせ直す
    const sync = () => { idx = slides.length ? Math.round(vp.scrollLeft / step()) : 0; setUI(); };
    window.addEventListener('resize', sync);
    if (panel.dataset.panel) sliders.set(panel.dataset.panel, sync);
    setUI();
  });

  // ---------- ショーケース: タブ（ARIA tabs パターン） ----------
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.sw-tab')];
  const activate = (tab: HTMLButtonElement, focus = false) => {
    const key = tab.dataset.tab;
    tabs.forEach((t) => {
      const on = t === tab;
      t.classList.toggle('is-on', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
    });
    document.querySelectorAll<HTMLElement>('.sw-panel').forEach((p) => p.classList.toggle('is-on', p.dataset.panel === key));
    if (focus) tab.focus();
    if (key) sliders.get(key)?.();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', (e) => {
      const map: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
      const to = map[e.key];
      if (to === undefined) return;
      e.preventDefault();
      activate(tabs[(to + tabs.length) % tabs.length], true);
    });
  });

  // ---------- 赤ペン取り消し線（表示されたら一括発火・CSS変数で時差） ----------
  const sheet = document.getElementById('tdSheet');
  if (sheet && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { sheet.classList.add('td-on'); io.disconnect(); } });
    }, { threshold: 0.35 });
    io.observe(sheet);
  } else if (sheet) {
    sheet.classList.add('td-on');
  }

  // ---------- 数字カウントアップ ----------
  const counters = document.querySelectorAll<HTMLElement>('.cnt');
  if (counters.length && 'IntersectionObserver' in window && !reduceMotion.matches) {
    const io2 = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        io2.unobserve(el);
        const to = parseInt(el.dataset.to || '0', 10);
        const t0 = performance.now();
        const dur = 900;
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    counters.forEach((c) => io2.observe(c));
  }

  // ---------- FAQ スムーズ開閉 ----------
  document.querySelectorAll<HTMLDetailsElement>('.fq-item').forEach((d) => {
    const sum = d.querySelector('summary');
    const body = d.querySelector<HTMLElement>('.fq-a');
    if (!sum || !body) return;
    let busy = false;
    // transitionendが来ない環境でも必ず後始末する
    const finish = (close: boolean) => {
      if (close) d.open = false;
      body.style.cssText = '';
      busy = false;
    };
    sum.addEventListener('click', (ev) => {
      ev.preventDefault();
      if (busy) return;
      if (reduceMotion.matches) { d.open = !d.open; return; }
      busy = true;
      const close = d.open;
      if (!close) d.open = true;
      const h = body.scrollHeight;
      body.style.height = close ? h + 'px' : '0px';
      requestAnimationFrame(() => {
        body.style.transition = 'height .3s ease';
        body.style.height = close ? '0px' : h + 'px';
        let done = false;
        const onEnd = () => { if (done) return; done = true; finish(close); };
        body.addEventListener('transitionend', onEnd, { once: true });
        window.setTimeout(onEnd, 400);
      });
    });
  });
</script>
