    /* 開発料金は品目と金額を2行に分ける（nowrap同士で横にはみ出すため） */
    .pr-rows > div{flex-wrap:wrap}
    .pr-rows b{white-space:normal;flex:1 0 100%}
    .pr-dots{display:none}
    .pr-rows em{margin-left:auto}
    /* 回答のインデントは狭い画面では畳む（62pxは幅の17%を食う） */
