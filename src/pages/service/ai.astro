---
import Base from '../../layouts/Base.astro';
import settings from '../../data/settings.json';
import service from '../../data/service-ai.json';
import '../../styles/service-ai.css';

const { offer } = service;
const regular = offer.regularPrice / 10000;
const price = offer.price / 10000;
const tax = offer.taxIncluded ? '税込' : '税別';
const mail = `mailto:${settings.email}?subject=${encodeURIComponent('【無料相談】請求書管理のAI自動化について')}&body=${encodeURIComponent('請求書管理のAI自動化について相談を希望します。\n\n会社名：\nご担当者名：\n毎月の請求書の件数：\n現在の管理方法：\n困っている作業：')}`;
const lineUrl = settings.line_url?.trim() || '';
const consult = lineUrl || mail;
const faqs = [
  { q: '5万円で、どこまで自動化できますか？', a: '請求書管理の中から、まず自動化する業務を決めて仕組みを構築します。たとえば、受領した請求書の情報を読み取り、管理台帳にまとめる流れです。対応できる書式や連携先、含まれる作業は、現在の運用を確認したうえで契約前にご案内します。' },
  { q: '5万円は月額料金ですか？', a: `月額料金ではなく、自動化の導入費用です。毎月${offer.monthlyLimit}社限定で、通常${regular}万円のところ${price}万円（${tax}）でご提供します。外部ツールの利用料、追加開発、継続保守の有無と費用は、必要な構成に応じて事前にご案内します。` },
  { q: 'Excelや、今使っているツールのまま相談できますか？', a: 'はい。まずは現在お使いのExcel・スプレッドシート・メール・会計ソフトと、担当者の作業手順を伺います。連携の可否を確認し、今の運用を活かせる方法からご提案します。' },
  { q: 'AIに詳しい社員がいなくても使えますか？', a: 'はい。日々使う担当者の操作に合わせて設計し、使い方までご案内します。専門用語で考える必要はありません。「毎月この作業が大変」というお話から始められます。' },
  { q: '読み取りミスや、機密情報の取り扱いはどうなりますか？', a: 'AIの読み取り結果を担当者が確認・修正できる工程を組み込みます。利用するサービス、保存先、閲覧権限、データの取り扱いは導入前に確認します。振込や会計処理の確定など、最終判断が必要な作業は人が確認する前提で設計します。' },
  { q: '請求書以外の業務も相談できますか？', a: 'はい。見積書・報告書の作成、問い合わせ対応、データ入力、営業管理などもご相談いただけます。自動化の効果と導入費用を見ながら、優先順位を一緒に決めます。請求書管理の限定プランとは別に、必要な範囲をお見積もりします。' },
];
const flow = [
  { n: '01', title: '今の業務を伺う', body: '請求書の件数、届き方、管理方法を確認。「何に時間がかかっているか」を整理します。' },
  { n: '02', title: '範囲と費用を決める', body: '自動化できる作業と完成イメージをご案内。対象範囲・費用に納得いただいてから進めます。' },
  { n: '03', title: '構築・動作確認', body: '現在の業務に合わせて仕組みを構築。担当者と一緒に読み取りや転記の流れを確認します。' },
  { n: '04', title: '使い方までサポート', body: '操作手順と確認ポイントを共有。実際の業務で使い始められる状態に整えます。' },
];
const examples = [
  { name: 'LAYR B2B DB', label: '営業管理', text: '営業リストや問い合わせをまとめて管理。探す・転記する作業を減らすための社内ツールです。', images: [
    ['/service/ai/shots/b2b-1.jpg', '営業管理のダッシュボード'], ['/service/ai/shots/b2b-2.jpg', '営業リストと提案文の管理'], ['/service/ai/shots/b2b-3.jpg', '顧客台帳の管理'],
  ] },
  { name: 'バナラボ', label: '制作業務', text: '配信サイズに合わせたバナー制作を支援。繰り返し発生する制作作業にもAIを取り入れています。', images: [
    ['/service/ai/shots/banlabo-1.jpg', '広告バナーの生成画面'], ['/service/ai/shots/banlabo-2.jpg', '媒体別サイズの選択画面'],
  ] },
  { name: 'LINEスコア診断', label: '顧客対応', text: '質問への回答からレポートを作成。ヒアリングから情報整理までの流れを仕組みにしています。', images: [
    ['/service/ai/shots/check-1.jpg', 'LINEスコア診断の開始画面'], ['/service/ai/shots/check-2.jpg', '質問と診断レポートの画面'],
  ] },
  { name: 'L SCOPE', label: '分析業務', text: '広告・LP・LINE配信の流れを可視化。情報を並べて確認する作業から、改善の検討へつなげます。', images: [
    ['/service/ai/shots/lscope-1.svg', '広告からLINE配信までの流れを整理する機能図'],
  ] },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://layr.co.jp/' },
    { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://layr.co.jp/service/' },
    { '@type': 'ListItem', position: 3, name: service.name },
  ] },
  { '@context': 'https://schema.org', '@type': 'Service', '@id': 'https://layr.co.jp/#service-ai', name: service.name, serviceType: 'AI業務効率化・業務自動化', provider: { '@id': 'https://layr.co.jp/#organization' }, areaServed: 'JP', url: 'https://layr.co.jp/service/ai/', offers: {
    '@type': 'Offer', name: `${offer.name}・毎月${offer.monthlyLimit}社限定`, price: offer.price, priceCurrency: 'JPY', description: `通常${regular}万円から${price}万円（${tax}）。${offer.billing}。対象範囲と外部ツール費用等は契約前に確認。`, url: 'https://layr.co.jp/service/ai/#price', priceSpecification: { '@type': 'PriceSpecification', price: offer.price, priceCurrency: 'JPY', valueAddedTaxIncluded: offer.taxIncluded },
  } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={service.title} description={service.description} jsonLd={jsonLd} hideHeader={true}>
<div class="ai-lp">
  <header class="ai-header">
    <div class="ai-wrap ai-header-inner">
      <a href="/" class="ai-brand" aria-label="株式会社LAYR トップへ"><img src="/logo.png" alt="LAYR" width="969" height="246" /><span>{service.name}</span></a>
      <nav class="ai-nav" aria-label="AIサービスのページ内ナビゲーション"><a href="#invoice">自動化できること</a><a href="#price">費用</a><a href="#flow">導入の流れ</a></nav>
      <a href="#consult" class="ai-button ai-button-small">無料で相談する <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <section class="ai-hero">
    <div class="ai-wrap ai-hero-grid">
      <div class="ai-hero-copy">
        <p class="ai-eyebrow">LAYR / BUSINESS AUTOMATION</p>
        <p class="ai-hero-kicker">中小企業のための、AI業務自動化。</p>
        <h1>AIで業務を効率化。<br />ムダな経費を削減して、<br />会社の<em>利益</em>を<br class="ai-mobile-break" />上げませんか。</h1>
        <p class="ai-lead">毎月くり返す入力、転記、確認。<br />その手作業をAIで減らして、<br />人と時間を、売上をつくる仕事へ。</p>
        <div class="ai-actions"><a href="#price" class="ai-button">まずは請求書管理の自動化から <span aria-hidden="true">↓</span></a></div>
        <p class="ai-hero-note">毎月{offer.monthlyLimit}社限定｜通常{regular}万円 → {price}万円（{tax}）</p>
      </div>
      <div class="ai-hero-aside">
        <div class="ai-workspace" aria-label="請求書管理の画面構成例">
          <div class="ai-workspace-top"><span>請求書管理</span><span class="ai-sample">画面構成例</span></div>
          <div class="ai-workspace-body">
            <p class="ai-workspace-label">月末の作業を、ひとつの流れに。</p>
            <div class="ai-document-row"><span class="ai-filetype">PDF</span><div><b>受け取った請求書</b><span>メール・共有フォルダなど</span></div></div>
            <div class="ai-extract"><span class="ai-step-tag">AIが読み取り・整理</span><dl><div><dt>取引先</dt><dd>サンプル商事</dd></div><div><dt>請求金額</dt><dd>¥55,000</dd></div><div><dt>支払期日</dt><dd>月末</dd></div></dl></div>
            <div class="ai-ledger"><div><b>管理台帳へまとめる</b><span>取引先・金額・期限を一覧に</span></div><span class="ai-status">確認待ち</span></div>
            <div class="ai-review"><span>最後は、人が確認。</span><p>読み取り内容を確認・修正して、<br />次の処理へ進めます。</p></div>
          </div>
        </div>
        <p class="ai-visual-caption">※説明用の架空データです。実際の構成は業務に合わせて設計します。</p>
      </div>
    </div>
    <div class="ai-wrap ai-hero-footer"><span>小さく始めて、毎月のムダを減らす。</span><a href="#invoice">請求書管理で、できることを見る <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="ai-offer-section" id="price" aria-labelledby="offer-heading">
    <div class="ai-wrap ai-offer">
      <div class="ai-offer-copy"><p class="ai-eyebrow">FIRST STEP</p><h2 id="offer-heading">まずは、請求書管理を<br /><em>AIで自動化</em>しませんか？</h2><p>毎月の「届いた請求書を探す」「数字を打ち直す」を、<br class="ai-desktop-break" />仕組みで減らす。ひとつの業務から始められます。</p><a href="#consult" class="ai-text-link">自社でもできるか相談する <span aria-hidden="true">↗</span></a></div>
      <div class="ai-offer-price"><span class="ai-limit">毎月 <b>{offer.monthlyLimit}社限定</b></span><p class="ai-price-label">{offer.name} / {offer.billing}</p><div class="ai-pricing"><span class="ai-regular">通常 <s>{regular}万円</s></span><span class="ai-price-arrow" aria-hidden="true">→</span><strong>{price}<span>万円<small>（{tax}）</small></span></strong></div><p class="ai-price-note">月額料金ではなく、導入時の費用です。</p><a href={consult} class="ai-button ai-button-light" data-ai-lead="offer">{price}万円プランを相談する <span aria-hidden="true">↗</span></a><p class="ai-offer-terms">対象範囲・連携先は事前に確認。外部ツール利用料や追加開発・保守が必要な場合は、契約前にご案内します。</p></div>
    </div>
  </section>

  <section class="ai-section ai-problem">
    <div class="ai-wrap ai-split">
      <div class="ai-section-heading"><p class="ai-section-index">01 <span>見直したい業務</span></p><h2>その手作業にも、<br /><em>コスト</em>が<br />かかっています。</h2><p>見えにくい経費は、<br />担当者の時間の中にもあります。</p></div>
      <div class="ai-problem-list">
        <article><span class="ai-row-number">01</span><div><h3>請求書を探す、集める。</h3><p>メール、PDF、共有フォルダ。届く場所がバラバラで、確認するだけでもひと仕事。</p></div></article>
        <article><span class="ai-row-number">02</span><div><h3>同じ数字を、何度も入力する。</h3><p>取引先、金額、支払期日。管理表へ打ち直すたびに、時間も入力ミスの心配も増えていく。</p></div></article>
        <article><span class="ai-row-number">03</span><div><h3>月末になると、本業が止まる。</h3><p>確認と取りまとめに追われて、営業やお客様への対応が後回しになってしまう。</p></div></article>
      </div>
    </div>
  </section>

  <section class="ai-section ai-invoice" id="invoice">
    <div class="ai-wrap">
      <div class="ai-section-heading ai-heading-wide"><p class="ai-section-index">02 <span>請求書管理の自動化</span></p><h2>「入力する仕事」を減らして、<br /><em>確認する仕事</em>へ。</h2><p>たとえば、受領した請求書の整理から台帳への転記まで。<br />今の業務を見ながら、自動化する範囲を設計します。</p></div>
      <div class="ai-comparison">
        <div class="ai-before"><p class="ai-eyebrow">BEFORE / これまで</p><h3>担当者が、ひとつずつ処理。</h3><ol><li>メールやフォルダから請求書を集める</li><li>書面を見ながら管理表へ入力する</li><li>金額や期限の抜け漏れを見直す</li><li>社内の確認・承認へ回す</li></ol></div>
        <div class="ai-after"><p class="ai-eyebrow">AFTER / 自動化の一例</p><h3>AIが整理。人が確認。</h3><ol><li><span>受領</span><div><b>請求書の取り込み先をまとめる</b><p>メール・フォルダなど、届き方に合わせて設計。</p></div></li><li><span>AI</span><div><b>必要な情報を読み取り、台帳へ</b><p>取引先・請求金額・支払期日などを整理。</p></div></li><li><span>確認</span><div><b>読み取り結果を確認・修正する</b><p>人の確認をはさんで、次の処理へ。</p></div></li></ol></div>
      </div>
      <div class="ai-scope"><b>いつもの仕事に、無理なく組み込む。</b><p>Excel・スプレッドシート・会計ソフトなど、今お使いのツールを伺い、連携できる方法を確認します。読み取り対象や書式によっては、自動化に向かない作業も事前にお伝えします。</p></div>
    </div>
  </section>

  <div class="ai-manifesto ai-wrap"><p>毎月の作業を減らすことが、<br />これからの<em>利益</em>につながる。</p></div>

  <section class="ai-section ai-flow" id="flow">
    <div class="ai-wrap ai-split"><div class="ai-section-heading"><p class="ai-section-index">03 <span>導入の流れ</span></p><h2>「この作業が大変」<br />から、<em>始められます。</em></h2><p>AIの知識は不要です。<br />普段の業務を、そのままお聞かせください。</p><a href="#consult" class="ai-text-link">まずは無料で相談する <span aria-hidden="true">↗</span></a></div><ol class="ai-flow-list">{flow.map(step => <li><span>{step.n}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol></div>
  </section>

  <section class="ai-section ai-works" id="works">
    <div class="ai-wrap">
      <div class="ai-section-heading ai-heading-wide"><p class="ai-section-index">04 <span>LAYRの自社実装例</span></p><h2>自分たちの業務でも、<br />AIを<em>使っています。</em></h2><p>営業管理、制作、情報整理。自社の実務で使う仕組みを開発しています。<br />請求書管理のその先も、必要な業務からご相談いただけます。</p></div>
      <div class="ai-example-list">{examples.map((example, i) => <details class="ai-example" open={i === 0}>
        <summary><span class="ai-example-label">{example.label}</span><h3>{example.name}</h3><span class="ai-toggle" aria-hidden="true"></span></summary>
        <div class="ai-example-content"><p>{example.text}</p><div class="ai-gallery" tabindex="0" role="region" aria-label={`${example.name}の画面。横にスクロールして閲覧できます。`}>{example.images.map(([src, caption]) => <figure><img src={src} alt={caption} width="1400" height="900" loading="lazy" decoding="async" /><figcaption>{caption}{src.endsWith('.svg') ? '（機能図）' : '（自社ツール）'}</figcaption></figure>)}</div>{example.images.length > 1 && <p class="ai-gallery-note">横にスクロールして、ほかの画面を見る <span aria-hidden="true">→</span></p>}</div>
      </details>)}</div>
    </div>
  </section>

  <section class="ai-section ai-faq" id="faq"><div class="ai-wrap ai-split"><div class="ai-section-heading"><p class="ai-section-index">05 <span>よくあるご質問</span></p><h2>導入前の<br /><em>気になること。</em></h2></div><div class="ai-faq-list">{faqs.map(f => <details><summary><span>Q</span><h3>{f.q}</h3><span class="ai-toggle" aria-hidden="true"></span></summary><p>{f.a}</p></details>)}</div></div></section>

  <section class="ai-final" id="consult"><div class="ai-wrap ai-final-inner"><p class="ai-eyebrow">LET’S START SMALL.</p><h2>まずは、月末の請求書管理から。<br />会社の<em>ムダ</em>を、一緒に減らしませんか。</h2><p>「うちの業務でも自動化できる？」というご相談からどうぞ。<br />現在の運用を伺い、できることと費用をご案内します。</p><div class="ai-final-offer"><span>毎月{offer.monthlyLimit}社限定</span><span>通常<s>{regular}万円</s> → <b>{price}万円</b>（{tax}）</span></div><div class="ai-actions">{lineUrl && <a href={lineUrl} class="ai-button" data-ai-lead="line">LINEで無料相談する <span aria-hidden="true">↗</span></a>}<a href={mail} class="ai-button ai-button-outline" data-ai-lead="email">メールで相談する <span aria-hidden="true">↗</span></a></div><p class="ai-final-note">株式会社LAYR / {service.name}「{service.brand}」</p></div></section>
</div>
</Base>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-ai-lead]').forEach(link => {
    link.addEventListener('click', () => {
      const analytics = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
      if (typeof analytics === 'function') analytics('event', 'generate_lead', {
        event_category: 'ai_invoice_automation', event_label: link.dataset.aiLead, method: link.href.startsWith('mailto:') ? 'email' : 'line',
      });
    });
  });
</script>
