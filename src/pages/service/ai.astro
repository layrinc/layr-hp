  .pr-list{list-style:none;margin:0 0 14px;padding:0;display:flex;flex-direction:column;gap:9px}
  .pr-list li{position:relative;padding-left:26px;font-size:var(--wa-fs-sm);font-weight:700;color:var(--wa-ink);line-height:1.85}
  .pr-list li::before{content:"✓";position:absolute;left:2px;color:var(--wa-shu);font-weight:700}
