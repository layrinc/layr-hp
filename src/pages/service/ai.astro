  .fq-item summary::-webkit-details-marker{display:none}
  .fq-q{font-family:var(--wa-font-head);font-weight:700;font-size:var(--wa-fs-label);letter-spacing:.08em;color:var(--wa-paper);background:var(--wa-ai);border-radius:var(--wa-r-s);flex:none;padding:3px 9px}
  .fq-plus{margin-left:auto;position:relative;width:14px;height:14px;flex:none}
  .fq-plus::before,.fq-plus::after{content:"";position:absolute;background:var(--wa-shu);transition:transform .25s var(--wa-ease)}
  .fq-plus::before{left:0;top:6px;width:14px;height:2px}
  .fq-plus::after{left:6px;top:0;width:2px;height:14px}
  .fq-item[open] .fq-plus::after{transform:scaleY(0)}
  .fq-a{overflow:hidden}
  .fq-a p{padding:0 20px 18px 62px;font-size:var(--wa-fs-sm);line-height:2.05;color:var(--wa-muted)}

  /* ---------- final ---------- */
  .fin{padding:clamp(88px,9vw,136px) 0 clamp(56px,6vw,88px)}
