---
/**
 * 法人向けAI導入・業務実装支援 LP（/service/ai/）— v3 独立LP版
 * ターゲット: 地方中小・AI超初心者（2026-08-18確定）
 * 価格: AI顧問 初期10万＋月5万を主役に、開発30万〜を従に（2階建て）
 * v3: 共通ヘッダー撤去（hideHeader・専用ミニヘッダー）／エディトリアル調に刷新
 *     （明朝見出し×生成り紙×インクブルー・AI感の排除）／実ツールのスクショを
 *     タブ+スライド形式で見せるショーケース新設／会話ヒーロー・赤ペン取り消し線・
 *     マーキー・カウントアップ等のギミック追加
 * 正本: AI導入支援事業/（競合調査・LP修正案）。値上げ運用ルールはLPに書かない。
 */
import Base from '../../layouts/Base.astro';
import settings from '../../data/settings.json';

const title = '法人向けAI導入・業務実装支援｜株式会社LAYR';
const description = 'AIを何から始めればいいか分からない中小企業向け。初期10万円・月額5万円のAI顧問から、業務アプリ開発まで。専門知識は不要です。';
const mail = `mailto:${settings.email}?subject=${encodeURIComponent('【無料相談】AI導入について')}`;
const lineUrl = settings.line_url?.trim() || '';

const starts = [
  'AIが良いのは分かるけど、何から始めればいいのか分からない',
  'ChatGPTは登録してみたが、結局使っていない',
  'うちみたいな会社に、AIなんてまだ早いと思っている',
  '詳しい社員がいない。相談できる相手もいない',
  '業者に頼むと高いイメージがあって、聞くのが怖い',
  'そもそも、うちの何がAIでできるのか分からない',
];

const pains = [
  ['予約・スケジュール管理', '電話とホワイトボードで管理していて、ダブルブッキングが怖い'],
  ['スタッフの割り振り', 'シフトと案件のマッチングを毎週、手で組んでいる'],
  ['請求書の発行', '月末に1件ずつ作って送っている。ミスも起きる'],
  ['問い合わせ対応', '同じ質問への返信に、毎日時間が溶けている'],
  ['転記・入力作業', '紙やExcelからの転記が誰かの仕事になっている'],
  ['レポート作成', '数字を集めて資料にするだけで半日かかる'],
];

// ショーケース: 実際に社内で毎日使っているツールのスクリーンショット
const showcase = [
  {
    key: 'b2b', name: 'LAYR B2B DB', label: '営業管理ダッシュボード',
    desc: '問い合わせ・診断・営業リスト・顧客台帳をひとつに束ねた、LAYR自身の営業司令塔。未対応のリードを取りこぼさない仕組みです。',
    slides: [
      { img: '/service/ai/shots/b2b-1.jpg', cap: 'ダッシュボード — 集客と営業の全体像がひと目で分かる' },
      { img: '/service/ai/shots/b2b-2.jpg', cap: '営業リスト — 候補企業の収集から提案文の下書きまでAIが用意' },
      { img: '/service/ai/shots/b2b-3.jpg', cap: '顧客台帳 — すべてのリードを名寄せして一元管理' },
    ],
  },
  {
    key: 'banlabo', name: 'バナラボ', label: '広告バナー生成ツール',
    desc: '広告バナーを話し言葉から一括生成する社内ツール。媒体ごとの規定サイズを選ぶだけで、複数パターンをまとめて作れます。',
    slides: [
      { img: '/service/ai/shots/banlabo-1.jpg', cap: '配信サイズを選んで、やりたいことを話し言葉で入力するだけ' },
      { img: '/service/ai/shots/banlabo-2.jpg', cap: 'LINE・Meta・GDN…媒体ごとの規定サイズを網羅' },
    ],
  },
  {
    key: 'check', name: 'LINEスコア診断', label: '見込み客獲得ツール',
    desc: '10問に答えるとその場で100点満点のスコアと個別レポートが出る診断ツール。LAYRのWebサイトで、問い合わせの入口として運用しています。',
    slides: [
      { img: '/service/ai/shots/check-1.jpg', cap: '診断の入口 — 訪問者が気軽に始められる設計' },
      { img: '/service/ai/shots/check-2.jpg', cap: '10問の質問に答えると、その場でレポートを生成' },
    ],
  },
  {
    key: 'lscope', name: 'L SCOPE', label: 'LINE配信の分析ツール',
    desc: '広告→LP→LINEの流れを1本のタイムラインに並べて見比べる分析ツール。トーク履歴を取り込むと配信の流れが時系列で可視化され、AIがシナリオの初稿づくりまで支援します。',
    slides: [
      // 実データに他社情報が含まれるため、この1枚のみ機能図（figure）で掲載する
      { img: '/service/ai/shots/lscope-1.svg', cap: '広告→LP→LINE配信を1本の時間軸に並べて見比べる（機能図）', figure: true },
    ],
  },
];

const services = [
  { n: '01', t: 'AI顧問（毎月の伴走）', d: '月1回の定例とチャット相談で、御社の業務を一緒に見ながら「AIで手放せる作業」から順番に片づけます。毎月ひとつ、小さな自動化を作って納品します。', chips: ['月1回の定例MTG', 'チャット相談 無制限', '毎月1つの自動化', '使い方レクチャー'] },
  { n: '02', t: '業務Webアプリ開発', d: '予約受付からカレンダー表示、スタッフ割り振り、LINE連携、請求書のダウンロードまで。バラバラだった業務をひとつのアプリに束ねます。必要になったタイミングで、プロトタイプを見てから決められます。', chips: ['予約・カレンダー', 'スタッフ管理', 'LINE連携', '請求書発行'] },
  { n: '03', t: 'AI業務効率化の実装', d: '文書作成・問い合わせ一次対応・データ整理・レポート生成など、繰り返し業務にAIを組み込みます。「ツールを契約して終わり」ではなく、御社の業務フローの中で毎日動く仕組みにします。', chips: ['文書・資料の自動作成', '問い合わせ自動化', 'データ整理', '定型レポート'] },
];

const faqs = [
  { q: '費用の目安を教えてください。', a: 'AI顧問は初期10万円＋月額5万円からです。業務アプリの開発が必要になった場合は別途、単機能の業務ツールで10万円〜、予約・請求まで束ねた一式で30万円〜、大規模・基幹連携込みで50万円〜が目安です(税抜)。' },
  { q: '本当に何も分かっていないのですが、大丈夫ですか？', a: 'それが普通です。「ChatGPTを開いたことがない」状態からのご相談がいちばん多い前提で設計しています。専門用語は使いません。' },
  { q: '月5万円で、具体的に何をしてもらえますか？', a: '月1回の定例ミーティング(オンライン60〜90分)、チャットでの相談(回数無制限)、毎月ひとつの小さな自動化の納品、ツール選定と社内向けの使い方レクチャーです。' },
  { q: '途中でやめられますか？', a: '最低3ヶ月で、4ヶ月目以降は月単位でいつでも停止できます。違約金もありません。' },
  { q: '地方なのですが、対応できますか？', a: 'オンラインで完結するので全国対応しています。必要な場合のみ訪問します。' },
  { q: '補助金は使えますか？', a: '業務アプリの開発は「デジタル化・AI導入補助金2026」の対象になる可能性があります(最大450万円・小規模事業者は補助率最大4/5)。申請の進め方もご相談ください。※支給は審査によるもので、保証するものではありません。' },
  { q: '社員が「AIに仕事を奪われる」と不安がっています。', a: '人を減らすためではなく、面倒な作業を手放して、人にしかできない仕事に時間を回すための導入です。社内向けの使い方レクチャーも含めて設計します。' },
  { q: '発注前に完成イメージを確認できますか？', a: 'はい。開発をご検討いただく場合は、ご発注の前に動くプロトタイプをご覧いただき、確認してから範囲と金額を決めていただけます。' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://layr.co.jp/' },
      { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://layr.co.jp/service/' },
      { '@type': 'ListItem', position: 3, name: 'AI導入・業務実装支援' },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'Service', '@id': 'https://layr.co.jp/#service-ai',
    name: '法人向けAI導入・業務実装支援', serviceType: 'AI導入支援・AI顧問・業務システム開発',
    provider: { '@id': 'https://layr.co.jp/#organization' }, areaServed: 'JP', url: 'https://layr.co.jp/service/ai/',
    hasOfferCatalog: {
      '@type': 'OfferCatalog', name: 'AI導入支援プラン',
      itemListElement: [
        { '@type': 'Offer', name: 'AI顧問', priceSpecification: { '@type': 'UnitPriceSpecification', price: 50000, priceCurrency: 'JPY', unitText: '月' } },
        { '@type': 'Offer', name: '業務アプリ開発', priceSpecification: { '@type': 'PriceSpecification', minPrice: 100000, priceCurrency: 'JPY' } },
      ],
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd} hideHeader={true}>

  <!-- LP専用ミニヘッダー -->
  <header class="lp-head">
    <div class="lp-head-in">
      <a class="lp-brand" href="/" aria-label="株式会社LAYR トップへ">
        <b>LAYR</b><span>AI導入・業務実装支援</span>
      </a>
      <a class="lp-head-cta" href={lineUrl || mail}>無料で相談する</a>
    </div>
  </header>

  <!-- HERO: 会話から始まる -->
  <section class="hv">
    <div class="container hv-in">
      <div class="hv-copy">
        <p class="hv-tag">地方の中小企業のための、AIの相談窓口</p>
        <div class="hv-talk">
          <p class="hv-q">「AIって、うちに関係あるの？」</p>
        </div>
        <h1 class="hv-h1">——からで、<br class="sp" /><em>大丈夫です。<svg class="hv-line" viewBox="0 0 300 14" aria-hidden="true" preserveAspectRatio="none"><path d="M4 9 C 60 3, 120 12, 170 8 S 260 5, 296 9" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></em></h1>
        <p class="hv-lead">何から手をつければいいか分からない。それが普通です。LAYRは専門用語を使わずに御社の業務を一緒に見て、AIで手放せる作業から順番に片づけていきます。まずは、1つの業務を自動化するところから。</p>
        <div class="hv-cta">
          {lineUrl ? (
            <>
              <a class="btn-ink" href={lineUrl}>LINEで相談する<i>→</i></a>
              <a class="btn-line2" href={mail}>メールで相談する</a>
            </>
          ) : (
            <>
              <a class="btn-ink" href={mail}>無料で相談する<i>→</i></a>
              <a class="btn-line2" href="#price">料金を見る</a>
            </>
          )}
        </div>
        <p class="hv-checks"><span>売り込みなし</span><span>専門用語なし</span><span>質問だけでもOK</span></p>
      </div>
      <div class="hv-visual">
        <div class="hv-browser" aria-hidden="true">
          <div class="hv-bar"><i></i><i></i><i></i><em>LAYRが自社で使っているツール</em></div>
          <div class="hv-frames">
            <img src="/service/ai/shots/b2b-1.jpg" alt="" loading="eager" />
            <img src="/service/ai/shots/banlabo-1.jpg" alt="" loading="lazy" />
            <img src="/service/ai/shots/lscope-1.svg" alt="" loading="lazy" />
            <img src="/service/ai/shots/check-1.jpg" alt="" loading="lazy" />
          </div>
        </div>
        <p class="hv-visual-note">ぜんぶ、AIで内製した自社ツールです（<a href="#works">実物を見る</a>）</p>
      </div>
    </div>
    <div class="hv-stats container">
      <div><b><span class="cnt" data-to="5">5</span><small>万円〜</small></b><span>AI顧問・月額（初期10万円）</span></div>
      <div><b>0<small>円</small></b><span>発注前のプロトタイプ</span></div>
      <div><b><span class="cnt" data-to="30">30</span><small>本+</small></b><span>自社でAI内製した業務ツール</span></div>
    </div>
  </section>

  <!-- スタート地点 -->
  <section class="sec">
    <div class="container narrow">
      <p class="en reveal">START</p>
      <h2 class="h2 reveal">皆さん、だいたい<em>ここから</em>始まります。</h2>
      <div class="st-grid">
        {starts.map((s, i) => (
          <div class="st-card reveal" style={`transition-delay:${i * 70}ms`}>
            <span class="st-n">{String(i + 1).padStart(2, '0')}</span>
            <p>「{s}」</p>
          </div>
        ))}
      </div>
      <div class="st-callout reveal">
        <p class="t">→ ぜんぶ、普通です。</p>
        <p class="s">実際、AIを導入していない中小企業のいちばんの理由は「何から始めればいいか分からない」でした。<br /><small>（中小企業基盤整備機構 調査／2026年3月）</small></p>
      </div>
    </div>
  </section>

  <!-- 手放せる作業: 赤ペンで消していく -->
  <section class="sec is-paper">
    <div class="container narrow">
      <p class="en reveal">TO-DO LIST</p>
      <h2 class="h2 reveal">その「手作業」、<em>リストから消していけます</em>。</h2>
      <div class="td-sheet reveal" id="tdSheet">
        {pains.map((p, i) => (
          <div class="td-row" style={`--d:${i * 350}ms`}>
            <span class="td-check" aria-hidden="true"></span>
            <div class="td-body">
              <b><span class="td-strike">{p[0]}</span></b>
              <p>{p[1]}</p>
            </div>
            <span class="td-done" aria-hidden="true">AIへ</span>
          </div>
        ))}
        <p class="td-foot">こうした作業から、ひとつずつ手放していけます。</p>
      </div>
    </div>
  </section>

  <!-- ショーケース: 例えば、こんなものが作れます -->
  <section class="sec is-ink" id="works">
    <div class="container">
      <p class="en is-w reveal">SHOWCASE</p>
      <h2 class="h2 is-w reveal">例えば、<em>こんなもの</em>が作れます。</h2>
      <p class="ink-lead reveal">これらは販売用のデモではありません。LAYRが社員を増やさずに会社を回すため、自分たちのために作って毎日使っている実物のツールです。同じ作り方を、御社の業務に合わせて持ち込みます。</p>

      <div class="sw reveal">
        <div class="sw-tabs" role="tablist" aria-label="自社ツールの実例">
          {showcase.map((t, i) => (
            <button
              class={`sw-tab${i === 0 ? ' is-on' : ''}`}
              role="tab"
              id={`swtab-${t.key}`}
              aria-controls={`swpanel-${t.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab={t.key}
            >
              <b>{t.name}</b><span>{t.label}</span>
            </button>
          ))}
        </div>

        {showcase.map((t, i) => (
          <div
            class={`sw-panel${i === 0 ? ' is-on' : ''}`}
            data-panel={t.key}
            role="tabpanel"
            id={`swpanel-${t.key}`}
            aria-labelledby={`swtab-${t.key}`}
            tabindex="0"
          >
            <p class="sw-desc">{t.desc}</p>
            <div class="sw-stage">
              <button class="sw-arrow is-prev" aria-label="前のスクリーンショット" data-dir="-1">‹</button>
              <div class="sw-viewport">
                <div class="sw-strip">
                  {t.slides.map((s) => (
                    <figure class="sw-slide">
                      {(s as any).figure ? (
                        <div class="sw-figure">
                          <img src={s.img} alt={`${t.name}の機能図 — ${s.cap}`} loading="lazy" width="1200" height="620" />
                        </div>
                      ) : (
                        <div class="sw-browser">
                          <div class="sw-bar"><i></i><i></i><i></i></div>
                          <img src={s.img} alt={`${t.name}の画面 — ${s.cap}`} loading="lazy" width="1600" height="900" />
                        </div>
                      )}
                      <figcaption>{s.cap}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
              <button class="sw-arrow is-next" aria-label="次のスクリーンショット" data-dir="1">›</button>
            </div>
            <div class="sw-dots" role="presentation">
              {t.slides.map((_, di) => <button class={`sw-dot${di === 0 ? ' is-on' : ''}`} data-i={di} aria-label={`${di + 1}枚目`}></button>)}
            </div>
          </div>
        ))}
      </div>

      <p class="ink-note reveal">…ほか、30本以上。御社にお渡しするのは、<b>この体制そのもの</b>です。</p>
    </div>
  </section>

  <!-- できること3つ -->
  <section class="sec">
    <div class="container narrow">
      <p class="en reveal">SERVICE</p>
      <h2 class="h2 reveal">LAYRのAI支援は、<em>3つ</em>。</h2>
      <div class="sv-list">
        {services.map((s, i) => (
          <div class="sv-row reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="sv-num">{s.n}</span>
            <div class="sv-body">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <div class="sv-chips">{s.chips.map((c) => <span>{c}</span>)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 選ばれる理由 -->
  <section class="sec is-paper">
    <div class="container narrow">
      <p class="en reveal">WHY LAYR</p>
      <h2 class="h2 reveal">安心して、<em>任せてもらえる理由</em>。</h2>
      <div class="wh-grid">
        <div class="wh-card reveal"><b>分からないことを、分からないまま聞けます</b><p>「こんなことも知らないのか」と思われる心配は不要です。専門用語を使わず、御社の言葉で会話します。</p></div>
        <div class="wh-card reveal" style="transition-delay:80ms"><b>発注前に、動くものを見せます</b><p>開発をご検討の場合は「完成してみないと分からない」を無くすため、契約前にプロトタイプをご覧いただきます。</p></div>
        <div class="wh-card reveal" style="transition-delay:160ms"><b>自社で毎日やっていることを、そのまま提供</b><p>LAYR自身が30本以上の業務ツールをAIで内製して経営しています。売るためのAIではなく、使うためのAIを知っています。</p></div>
        <div class="wh-card reveal" style="transition-delay:240ms"><b>LINE連携が得意</b><p>LINEマーケティング専業の知見をそのまま接続。予約通知・顧客対応・配信まで、LINEと業務の仕組みを一体で設計できます。</p></div>
      </div>
    </div>
  </section>

  <!-- 進め方（2本立て） -->
  <section class="sec" id="flow">
    <div class="container narrow">
      <p class="en reveal">FLOW</p>
      <h2 class="h2 reveal">進め方は、<em>2通り</em>。</h2>
      <div class="fl-grid">
        <div class="fl-card reveal">
          <p class="fl-t">AI顧問で始める <span class="fl-osusume">おすすめ</span></p>
          <ol>
            <li><b>無料相談</b>困りごとが言葉にできていなくても大丈夫です。一緒に探します</li>
            <li><b>初期設定</b>ツールの用意と、最初の自動化テーマを決めます</li>
            <li><b>毎月の伴走</b>定例＋チャット相談＋毎月ひとつの自動化</li>
          </ol>
        </div>
        <div class="fl-card reveal" style="transition-delay:100ms">
          <p class="fl-t">業務アプリを開発する</p>
          <ol>
            <li><b>ヒアリング</b>現状の業務と、束ねたい作業を伺います</li>
            <li><b>プロトタイプ提示</b>発注前に、動くものをご覧いただきます（無料）</li>
            <li><b>松竹梅お見積もり→開発</b>3案から選んで、開発・運用伴走へ</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 料金（2階建て） -->
  <section class="sec is-paper" id="price">
    <div class="container narrow">
      <p class="en reveal">PRICE</p>
      <h2 class="h2 reveal">月5万円から、<em>始められます</em>。</h2>

      <div class="pr-main reveal">
        <p class="pr-label"><span class="pr-ichi">①</span> まずは「AI顧問」から</p>
        <div class="pr-nums">
          <div><span>初期費用</span><b><i class="cnt" data-to="10">10</i><small>万円</small></b></div>
          <div class="pr-x">＋</div>
          <div><span>月額</span><b><i class="cnt" data-to="5">5</i><small>万円</small></b></div>
        </div>
        <ul class="pr-list">
          <li>月1回の定例ミーティング（オンライン60〜90分）</li>
          <li>チャットでの相談は回数無制限</li>
          <li>毎月ひとつ、小さな自動化をつくって納品</li>
          <li>ツール選定と、社内の使い方レクチャー</li>
        </ul>
        <p class="pr-note">最低3ヶ月から。4ヶ月目以降は月単位で、いつでも停止できます。</p>
      </div>

      <div class="pr-sub reveal">
        <p class="pr-label"><span class="pr-ichi">②</span> 本格的に作るなら「業務アプリ開発」</p>
        <div class="pr-rows">
          <div><b>単機能の業務ツール</b><span class="pr-dots"></span><em>10万円〜</em></div>
          <div><b>業務アプリ一式（予約〜請求まで）</b><span class="pr-dots"></span><em>30万円〜</em></div>
          <div><b>大規模・基幹連携・LINE連携込み</b><span class="pr-dots"></span><em>50万円〜</em></div>
        </div>
        <p class="pr-note">※ 顧問契約とは別のお見積もりです。必要になったタイミングで、動くプロトタイプをご確認いただいてから決めていただけます。※ 税抜・目安</p>
      </div>

      <p class="pr-cap reveal">※ 現在の価格は、先着5社さまの実績づくり価格です。</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec">
    <div class="container narrow">
      <p class="en reveal">FAQ</p>
      <h2 class="h2 reveal">よくあるご質問</h2>
      <div class="fq">
        {faqs.map((f, i) => (
          <details class="fq-item reveal" style={`transition-delay:${i * 40}ms`}>
            <summary><span class="fq-q">Q{i + 1}</span>{f.q}<span class="fq-plus" aria-hidden="true"></span></summary>
            <div class="fq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 最終CTA -->
  <section class="fin">
    <div class="container">
      <p class="fin-t reveal">まずは、御社の<em>「よく分からない」</em>を<br class="sp" />聞かせてください。</p>
      <p class="fin-s reveal">まだ何も決まっていない段階で構いません。質問だけでも大丈夫です。</p>
      <div class="fin-row reveal">
        {lineUrl ? (
          <>
            <a class="btn-ink is-w" href={lineUrl}>LINEで相談する<i>→</i></a>
            <a class="btn-line2 is-w" href={mail}>メールで相談する</a>
          </>
        ) : (
          <a class="btn-ink is-w" href={mail}>無料で相談する<i>→</i></a>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ============ v3 エディトリアル調（生成り紙×墨×インクブルー） ============ */
  /* 明朝はシステムフォントで賄う（追加Webフォントなし＝軽い・確実） */
  .lp-head{position:fixed;inset:0 0 auto 0;z-index:100;background:rgba(252,250,245,.92);backdrop-filter:blur(8px);border-bottom:1px solid #E2DCCE}
  .lp-head-in{max-width:1160px;margin:0 auto;padding:0 20px;height:60px;display:flex;align-items:center;justify-content:space-between}
  .lp-brand{display:flex;align-items:baseline;gap:12px;text-decoration:none;color:#23272E}
  .lp-brand b{font-family:var(--font-en);font-weight:800;font-size:19px;letter-spacing:.14em}
  .lp-brand span{font-size:11px;font-weight:700;color:#5D6672;border-left:1px solid #C9C2B2;padding-left:12px}
  .lp-head-cta{background:#24466E;color:#fff;font-size:13px;font-weight:800;border-radius:999px;padding:9px 22px;text-decoration:none;transition:opacity .15s}
  .lp-head-cta:hover{opacity:.85}

  /* ---------- HERO ---------- */
  .hv{background:#FCFAF5;padding:118px 0 0;border-bottom:1px solid #E2DCCE;overflow:hidden}
  .hv-in{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(28px,4vw,56px);align-items:center}
  /* 初速優先: 遅延はLCP候補(h1)が0.3s以内に出る範囲に圧縮する */
  .hv-tag{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.06em;color:#24466E;border:1px solid #B9C9DD;background:#fff;border-radius:3px;padding:6px 14px;margin-bottom:26px;animation:rise .5s .04s both}
  .hv-talk{margin-bottom:6px}
  .hv-q{position:relative;display:inline-block;background:#fff;border:1.5px solid #23272E;border-radius:16px 16px 16px 4px;padding:14px 22px;font-size:clamp(16px,2.4vw,21px);font-weight:800;color:#23272E;animation:pop .45s .14s both}
  .hv-q::after{content:"";position:absolute;left:18px;bottom:-9px;width:14px;height:14px;background:#fff;border-left:1.5px solid #23272E;border-bottom:1.5px solid #23272E;transform:skewX(35deg) rotate(-45deg)}
  .hv-h1{font-family:"Hiragino Mincho ProN","Yu Mincho","Noto Serif JP",serif;font-size:clamp(30px,5vw,52px);font-weight:800;line-height:1.5;letter-spacing:.01em;color:#23272E;margin:18px 0 20px;animation:rise .55s .3s both}
  .hv-h1 em{font-style:normal;position:relative;display:inline-block;color:#24466E}
  .hv-line{position:absolute;left:0;bottom:-6px;width:100%;height:10px;color:#C94F35;opacity:.85}
  .hv-line path{stroke-dasharray:320;stroke-dashoffset:320;animation:draw .9s .8s forwards}
  .hv-lead{font-size:14.5px;line-height:2.2;color:#5D6672;max-width:34em;margin-bottom:26px;animation:rise .55s .42s both}
  .hv-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:14px;animation:rise .55s .52s both}
  .btn-ink{display:inline-flex;align-items:center;gap:10px;background:#24466E;color:#fff;font-weight:800;font-size:14.5px;border-radius:3px;padding:15px 34px;text-decoration:none;box-shadow:3px 3px 0 #1B3355;transition:transform .15s,box-shadow .15s}
  .btn-ink:hover{transform:translate(2px,2px);box-shadow:1px 1px 0 #1B3355}
  .btn-ink i{font-style:normal}
  .btn-line2{display:inline-flex;align-items:center;background:transparent;color:#24466E;font-weight:800;font-size:14.5px;border:1.5px solid #24466E;border-radius:3px;padding:15px 30px;text-decoration:none;transition:background .15s}
  .btn-line2:hover{background:rgba(36,70,110,.06)}
  .hv-checks{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;font-weight:700;color:#5D6672;animation:rise .55s .62s both}
  .hv-checks span{position:relative;padding-left:18px}
  .hv-checks span::before{content:"✓";position:absolute;left:0;color:#C94F35;font-weight:900}
  /* hero browser visual */
  .hv-visual{animation:rise .7s .34s both}
  .hv-browser{background:#fff;border:1.5px solid #23272E;border-radius:10px;overflow:hidden;box-shadow:8px 8px 0 rgba(36,70,110,.12);transform:rotate(.6deg)}
  .hv-bar{display:flex;align-items:center;gap:6px;background:#F1EDE2;border-bottom:1.5px solid #23272E;padding:9px 12px}
  .hv-bar i{width:10px;height:10px;border-radius:50%;background:#D9D2C0;border:1px solid #B9B29E}
  .hv-bar em{font-style:normal;font-size:10.5px;font-weight:700;color:#5D6672;margin-left:8px;background:#fff;border-radius:99px;padding:2px 12px;border:1px solid #E2DCCE}
  .hv-frames{position:relative;aspect-ratio:16/9.6;background:#EDE9DD}
  .hv-frames img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;opacity:0;animation:frameCycle 16s infinite}
  /* 1枚目はLCP候補になり得るので透明から始めない（フェードは最終盤で戻す） */
  .hv-frames img:nth-child(1){opacity:1;animation-name:frameCycleFirst;animation-delay:0s}
  .hv-frames img:nth-child(2){animation-delay:4s}
  .hv-frames img:nth-child(3){animation-delay:8s}
  .hv-frames img:nth-child(4){animation-delay:12s}
  .hv-visual-note{font-size:11.5px;font-weight:700;color:#5D6672;text-align:right;margin-top:12px}
  .hv-visual-note a{color:#24466E}
  /* stats */
  .hv-stats{display:flex;gap:clamp(24px,5vw,70px);flex-wrap:wrap;border-top:1px solid #E2DCCE;margin-top:clamp(30px,4vw,50px);padding-top:22px;padding-bottom:26px}
  .hv-stats b{display:flex;align-items:baseline;font-family:var(--font-en);font-weight:800;font-size:30px;color:#24466E;line-height:1.2}
  .hv-stats b small{font-size:13px;font-weight:800;margin-left:2px;font-family:inherit}
  .hv-stats > div > span{display:block;font-size:11px;color:#5D6672;font-weight:700;margin-top:2px}

  @keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  @keyframes pop{from{opacity:0;transform:translateY(10px) scale(.92)}to{opacity:1;transform:none}}
  @keyframes draw{to{stroke-dashoffset:0}}
  @keyframes frameCycle{0%{opacity:0}3%{opacity:1}25%{opacity:1}31%{opacity:0}100%{opacity:0}}
  @keyframes frameCycleFirst{0%{opacity:1}25%{opacity:1}31%{opacity:0}97%{opacity:0}100%{opacity:1}}

  /* ---------- 共通セクション ---------- */
  .sec{padding:clamp(60px,7.5vw,104px) 0;background:#fff;scroll-margin-top:60px}
  .sec.is-paper{background:#F8F5EE}
  .sec.is-ink{background:#20344E;color:#fff}
  .narrow{max-width:880px}
  .en{font-family:var(--font-en);font-size:12px;font-weight:800;letter-spacing:.22em;color:#C94F35;margin-bottom:12px}
  .en.is-w{color:#8FB3DE}
  .h2{font-family:"Hiragino Mincho ProN","Yu Mincho","Noto Serif JP",serif;font-size:clamp(23px,3.6vw,34px);font-weight:800;line-height:1.65;color:#23272E;margin-bottom:34px}
  .h2 em{font-style:normal;background:linear-gradient(transparent 62%, #F5E3A8 62%)}
  .h2.is-w{color:#fff}
  .h2.is-w em{background:linear-gradient(transparent 62%, rgba(201,79,53,.55) 62%)}

  /* reveal（Baseの共通IntersectionObserverが is-visible を付ける） */
  .reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}
  .reveal:global(.is-visible){opacity:1;transform:none}

  /* ---------- start ---------- */
  .st-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:30px}
  .st-card{display:flex;gap:16px;align-items:flex-start;background:#fff;border:1px solid #E2DCCE;border-left:3px solid #24466E;padding:18px 20px}
  .st-n{font-family:var(--font-en);font-weight:800;font-size:13px;color:#C94F35;padding-top:3px}
  .st-card p{font-size:13.5px;font-weight:700;color:#3A4250;line-height:1.9}
  .st-callout{border:1.5px solid #23272E;background:#fff;padding:26px 28px;text-align:center;position:relative}
  .st-callout::before{content:"";position:absolute;inset:5px;border:1px solid #E2DCCE;pointer-events:none}
  .st-callout .t{font-family:"Hiragino Mincho ProN","Yu Mincho",serif;font-size:clamp(17px,2.6vw,22px);font-weight:800;color:#24466E;margin-bottom:8px}
  .st-callout .s{font-size:13px;color:#5D6672;line-height:2}
  .st-callout small{color:#9AA1AC;font-size:10.5px}

  /* ---------- to-do 赤ペン ---------- */
  .td-sheet{background:#fff;border:1px solid #E2DCCE;box-shadow:6px 6px 0 rgba(36,70,110,.08);padding:10px 26px 22px}
  .td-row{display:flex;align-items:center;gap:16px;padding:16px 0;border-bottom:1px dashed #E2DCCE}
  .td-check{flex:none;width:20px;height:20px;border:1.5px solid #B9B29E;border-radius:4px;position:relative}
  .td-check::after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;color:#C94F35;font-weight:900;font-size:14px;opacity:0;transform:scale(.4);transition:opacity .3s var(--d),transform .3s var(--d)}
  .td-body{flex:1}
  .td-body b{font-size:14.5px;color:#23272E;display:block}
  .td-strike{position:relative;display:inline-block}
  .td-strike::after{content:"";position:absolute;left:-2%;top:54%;height:2.5px;width:0;background:#C94F35;border-radius:2px;transform:rotate(-.7deg);transition:width .5s cubic-bezier(.6,0,.3,1) var(--d)}
  .td-body p{font-size:12px;color:#8B93A0;line-height:1.8;margin-top:3px}
  .td-done{flex:none;font-size:11px;font-weight:800;color:#C94F35;border:1.5px solid #C94F35;border-radius:3px;padding:4px 10px;opacity:0;transform:rotate(-6deg) scale(.6);transition:opacity .35s var(--d),transform .35s var(--d)}
  .td-sheet:global(.td-on) .td-check::after{opacity:1;transform:scale(1)}
  .td-sheet:global(.td-on) .td-strike::after{width:104%}
  .td-sheet:global(.td-on) .td-done{opacity:1;transform:rotate(-6deg) scale(1)}
  .td-foot{text-align:center;font-family:"Hiragino Mincho ProN","Yu Mincho",serif;font-weight:800;font-size:clamp(14.5px,2.2vw,18px);color:#23272E;padding-top:20px}

  /* ---------- showcase ---------- */
  .ink-lead{font-size:14px;line-height:2.15;color:rgba(255,255,255,.85);max-width:40em;margin-bottom:34px}
  .sw-tabs{display:flex;gap:8px;flex-wrap:wrap;border-bottom:1px solid rgba(255,255,255,.25);margin-bottom:26px}
  .sw-tab{appearance:none;background:transparent;border:none;border-bottom:3px solid transparent;color:rgba(255,255,255,.62);padding:10px 18px 14px;cursor:pointer;text-align:left;transition:color .15s,border-color .15s}
  .sw-tab b{display:block;font-family:var(--font-en);font-weight:800;font-size:14px;letter-spacing:.03em}
  .sw-tab span{display:block;font-size:10.5px;font-weight:700;margin-top:2px}
  .sw-tab:hover{color:#fff}
  .sw-tab.is-on{color:#fff;border-bottom-color:#C94F35}
  .sw-panel{display:none}
  .sw-panel.is-on{display:block;animation:rise .45s both}
  .sw-desc{font-size:13px;line-height:2;color:rgba(255,255,255,.8);max-width:44em;margin-bottom:20px}
  .sw-stage{position:relative}
  .sw-viewport{overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;border-radius:6px}
  .sw-viewport::-webkit-scrollbar{display:none}
  .sw-strip{display:flex;gap:18px}
  .sw-slide{flex:0 0 100%;scroll-snap-align:center;margin:0}
  .sw-browser{background:#fff;border-radius:8px;overflow:hidden;border:1px solid rgba(255,255,255,.3);box-shadow:0 18px 44px rgba(0,0,0,.35)}
  .sw-bar{display:flex;gap:6px;background:#E9E5D8;padding:9px 14px}
  .sw-bar i{width:10px;height:10px;border-radius:50%;background:#C9C2B0}
  .sw-browser img{display:block;width:100%;height:auto}
  /* 機能図はブラウザ枠を付けず、スクリーンショットと見分けがつくようにする */
  .sw-figure{background:#F8F5EE;border:1px solid rgba(255,255,255,.3);border-radius:8px;overflow:hidden;box-shadow:0 18px 44px rgba(0,0,0,.35)}
  .sw-figure img{display:block;width:100%;height:auto}
  .sw-slide figcaption{font-size:12px;font-weight:700;color:rgba(255,255,255,.75);margin-top:12px;text-align:center}
  .sw-arrow{position:absolute;top:42%;z-index:2;appearance:none;width:44px;height:44px;border-radius:50%;border:1.5px solid rgba(255,255,255,.5);background:rgba(32,52,78,.7);color:#fff;font-size:24px;line-height:1;cursor:pointer;backdrop-filter:blur(4px);transition:background .15s,opacity .15s}
  .sw-arrow:hover{background:#C94F35;border-color:#C94F35}
  .sw-arrow.is-prev{left:-12px}
  .sw-arrow.is-next{right:-12px}
  .sw-arrow[disabled]{opacity:.25;pointer-events:none}
  .sw-dots{display:flex;gap:2px;justify-content:center;margin-top:10px}
  /* 見た目は8pxのまま、当たり判定はpaddingで24px以上を確保する */
  .sw-dot{appearance:none;border:none;width:8px;height:8px;padding:9px;box-sizing:content-box;border-radius:50%;background:rgba(255,255,255,.3);background-clip:content-box;cursor:pointer;transition:background .15s,transform .15s}
  .sw-dot.is-on{background:#C94F35;background-clip:content-box;transform:scale(1.3)}
  .ink-note{text-align:center;font-size:14px;font-weight:700;color:rgba(255,255,255,.9);margin-top:34px}
  .ink-note b{color:#F5E3A8}

  /* ---------- services ---------- */
  .sv-list{display:flex;flex-direction:column}
  .sv-row{display:flex;gap:clamp(18px,3vw,36px);padding:30px 4px;border-bottom:1px solid #E2DCCE}
  .sv-row:first-child{border-top:1px solid #E2DCCE}
  .sv-num{font-family:var(--font-en);font-weight:800;font-size:clamp(26px,4vw,40px);color:#D9D2C0;line-height:1;padding-top:4px}
  .sv-body h3{font-family:"Hiragino Mincho ProN","Yu Mincho",serif;font-size:18px;font-weight:800;color:#23272E;margin-bottom:10px}
  .sv-body p{font-size:13px;color:#5D6672;line-height:2.05;margin-bottom:14px;max-width:44em}
  .sv-chips{display:flex;gap:8px;flex-wrap:wrap}
  .sv-chips span{font-size:11px;font-weight:700;color:#24466E;border:1px solid #B9C9DD;border-radius:2px;padding:4px 12px;background:#F6F9FC}

  /* ---------- why ---------- */
  .wh-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .wh-card{background:#fff;border:1px solid #E2DCCE;padding:24px;position:relative}
  .wh-card::before{content:"";position:absolute;left:0;top:0;width:100%;height:3px;background:#24466E}
  .wh-card b{font-size:14.5px;color:#23272E;display:block;margin-bottom:8px;line-height:1.7}
  .wh-card p{font-size:12.5px;color:#5D6672;line-height:2}

  /* ---------- flow ---------- */
  .fl-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .fl-card{background:#fff;border:1.5px solid #23272E;padding:26px;box-shadow:5px 5px 0 rgba(36,70,110,.1)}
  .fl-t{font-family:"Hiragino Mincho ProN","Yu Mincho",serif;font-size:16px;font-weight:800;color:#23272E;margin-bottom:18px;display:flex;align-items:center;gap:10px}
  .fl-osusume{font-size:10.5px;font-weight:800;color:#fff;background:#C94F35;border-radius:2px;padding:3px 10px;font-family:'Noto Sans JP',sans-serif}
  .fl-card ol{list-style:none;margin:0;padding:0;counter-reset:fl;display:flex;flex-direction:column;gap:14px}
  .fl-card li{counter-increment:fl;position:relative;padding-left:42px;font-size:12.5px;color:#5D6672;line-height:1.9}
  .fl-card li::before{content:"0" counter(fl);position:absolute;left:0;top:1px;font-family:var(--font-en);font-weight:800;font-size:14px;color:#C94F35}
  .fl-card li::after{content:"";position:absolute;left:4px;top:26px;bottom:-12px;width:1px;background:#E2DCCE}
  .fl-card li:last-child::after{display:none}
  .fl-card li b{display:block;font-size:14px;color:#23272E;margin-bottom:2px}

  /* ---------- price ---------- */
  .pr-main{background:#fff;border:2px solid #24466E;padding:clamp(24px,4vw,36px);position:relative;box-shadow:7px 7px 0 rgba(36,70,110,.12);margin-bottom:18px}
  .pr-main::before{content:"おすすめ";position:absolute;top:-13px;left:26px;background:#C94F35;color:#fff;font-size:11.5px;font-weight:800;padding:4px 16px;letter-spacing:.08em}
  .pr-sub{background:#fff;border:1px solid #E2DCCE;padding:clamp(24px,4vw,36px);margin-bottom:18px}
  .pr-label{font-family:"Hiragino Mincho ProN","Yu Mincho",serif;font-size:16.5px;font-weight:800;color:#23272E;margin-bottom:20px}
  .pr-ichi{color:#C94F35}
  .pr-nums{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px}
  .pr-nums > div:not(.pr-x){flex:1;min-width:150px;border:1px solid #E2DCCE;background:#F8F5EE;padding:16px 20px;text-align:center}
  .pr-x{font-size:20px;font-weight:800;color:#5D6672}
  .pr-nums span{display:block;font-size:11.5px;font-weight:800;color:#5D6672;margin-bottom:2px}
  .pr-nums b{font-family:var(--font-en);font-size:44px;font-weight:800;color:#24466E;line-height:1.15}
  .pr-nums b i{font-style:normal}
  .pr-nums b small{font-size:14px;font-weight:800}
  .pr-list{list-style:none;margin:0 0 14px;padding:0;display:flex;flex-direction:column;gap:9px}
  .pr-list li{position:relative;padding-left:26px;font-size:13.5px;font-weight:700;color:#3A4250;line-height:1.85}
  .pr-list li::before{content:"✓";position:absolute;left:2px;color:#C94F35;font-weight:900}
  .pr-note{font-size:11.5px;color:#8B93A0;line-height:1.9}
  .pr-rows{display:flex;flex-direction:column;gap:12px;margin-bottom:14px}
  .pr-rows > div{display:flex;align-items:baseline;gap:10px}
  .pr-rows b{font-size:13.5px;color:#23272E;white-space:nowrap}
  .pr-dots{flex:1;border-bottom:1.5px dotted #C9C2B0;transform:translateY(-4px)}
  .pr-rows em{font-style:normal;font-family:var(--font-en);font-weight:800;font-size:17px;color:#24466E;white-space:nowrap}
  .pr-cap{text-align:center;font-size:13px;font-weight:800;color:#C94F35;border:1.5px dashed #C94F35;background:#fff;padding:10px 22px;display:table;margin:8px auto 0}

  /* ---------- faq ---------- */
  .fq{display:flex;flex-direction:column;gap:10px}
  .fq-item{background:#fff;border:1px solid #E2DCCE}
  .fq-item summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:14px;padding:17px 20px;font-weight:800;font-size:14px;color:#23272E}
  .fq-item summary::-webkit-details-marker{display:none}
  .fq-q{font-family:var(--font-en);font-weight:800;font-size:12px;color:#C94F35;flex:none;border:1px solid #C94F35;padding:2px 8px}
  .fq-plus{margin-left:auto;position:relative;width:14px;height:14px;flex:none}
  .fq-plus::before,.fq-plus::after{content:"";position:absolute;background:#24466E;transition:transform .25s}
  .fq-plus::before{left:0;top:6px;width:14px;height:2px}
  .fq-plus::after{left:6px;top:0;width:2px;height:14px}
  .fq-item[open] .fq-plus::after{transform:scaleY(0)}
  .fq-a{overflow:hidden}
  .fq-a p{padding:0 20px 18px 62px;font-size:13px;line-height:2.05;color:#5D6672}

  /* ---------- final ---------- */
  .fin{background:#20344E;color:#fff;text-align:center;padding:clamp(64px,8vw,100px) 0}
  .fin-t{font-family:"Hiragino Mincho ProN","Yu Mincho",serif;font-size:clamp(21px,3.4vw,30px);font-weight:800;line-height:1.8;margin-bottom:12px}
  .fin-t em{font-style:normal;background:linear-gradient(transparent 62%, rgba(201,79,53,.55) 62%)}
  .fin-s{font-size:13.5px;opacity:.85;line-height:2;margin-bottom:30px}
  .fin-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  .btn-ink.is-w{background:#fff;color:#20344E;box-shadow:3px 3px 0 rgba(0,0,0,.3)}
  .btn-line2.is-w{color:#fff;border-color:rgba(255,255,255,.6)}
  .btn-line2.is-w:hover{background:rgba(255,255,255,.08)}

  .sp{display:none}

  @media(max-width:920px){
    .hv-in{grid-template-columns:1fr}
    .hv{padding-top:96px}
    .st-grid,.wh-grid,.fl-grid{grid-template-columns:1fr}
    .sw-arrow.is-prev{left:4px}
    .sw-arrow.is-next{right:4px}
    .sp{display:inline}
  }
  @media(max-width:560px){
    .lp-brand span{display:none}
    /* 「初期費用 ＋ 月額」は縦積みにして＋を中央に置く（横並びだと＋が行末に取り残される） */
    .pr-nums{flex-direction:column;align-items:stretch}
    .pr-nums > div:not(.pr-x){width:100%}
    .pr-x{text-align:center}
    /* 開発料金は品目と金額を2行に分ける（nowrap同士で横にはみ出すため） */
    .pr-rows > div{flex-wrap:wrap}
    .pr-rows b{white-space:normal;flex:1 0 100%}
    .pr-dots{display:none}
    .pr-rows em{margin-left:auto}
  }
  @media (prefers-reduced-motion: reduce){
    .hv-tag,.hv-q,.hv-h1,.hv-lead,.hv-cta,.hv-checks,.hv-visual{animation:none}
    .hv-line path{animation:none;stroke-dashoffset:0}
    .hv-frames img{animation:none}
    .hv-frames img:first-child{opacity:1}
    .reveal{opacity:1;transform:none;transition:none}
    .td-check::after,.td-strike::after,.td-done{transition:none}
    .sw-panel.is-on{animation:none}
  }
</style>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // ---------- ショーケース: スライダー（パネルごとに独立） ----------
  // パネルはdisplay:noneで隠すため、再表示時にscrollLeftが0へ戻る。
  // 表示のたびにsyncを呼んで内部状態と実位置を合わせ直す。
  const sliders = new Map<string, () => void>();

  document.querySelectorAll<HTMLElement>('.sw-panel').forEach((panel) => {
    const vp = panel.querySelector<HTMLElement>('.sw-viewport');
    const slides = panel.querySelectorAll('.sw-slide');
    const dots = panel.querySelectorAll<HTMLButtonElement>('.sw-dot');
    const prev = panel.querySelector<HTMLButtonElement>('.sw-arrow.is-prev');
    const next = panel.querySelector<HTMLButtonElement>('.sw-arrow.is-next');
    if (!vp) return;
    let idx = 0;
    // スライド間のgapを含めた1枚あたりの送り幅
    const step = () => {
      const first = slides[0] as HTMLElement | undefined;
      const second = slides[1] as HTMLElement | undefined;
      if (first && second) return second.offsetLeft - first.offsetLeft;
      return vp.clientWidth;
    };
    const setUI = () => {
      dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
      if (prev) prev.disabled = idx <= 0;
      if (next) next.disabled = idx >= slides.length - 1;
    };
    const go = (i: number, smooth = true) => {
      idx = Math.max(0, Math.min(slides.length - 1, i));
      vp.scrollTo({ left: idx * step(), behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto' });
      setUI();
    };
    prev?.addEventListener('click', () => go(idx - 1));
    next?.addEventListener('click', () => go(idx + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    // 手動スワイプにもドット・矢印を追従させる
    let st: number | undefined;
    vp.addEventListener('scroll', () => {
      if (st) window.clearTimeout(st);
      st = window.setTimeout(() => { idx = Math.round(vp.scrollLeft / step()); setUI(); }, 80);
    }, { passive: true });
    // 表示直後・リサイズ後に実位置へ合わせ直す
    const sync = () => { idx = slides.length ? Math.round(vp.scrollLeft / step()) : 0; setUI(); };
    window.addEventListener('resize', sync);
    if (panel.dataset.panel) sliders.set(panel.dataset.panel, sync);
    setUI();
  });

  // ---------- ショーケース: タブ（ARIA tabs パターン） ----------
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.sw-tab')];
  const activate = (tab: HTMLButtonElement, focus = false) => {
    const key = tab.dataset.tab;
    tabs.forEach((t) => {
      const on = t === tab;
      t.classList.toggle('is-on', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
    });
    document.querySelectorAll<HTMLElement>('.sw-panel').forEach((p) => p.classList.toggle('is-on', p.dataset.panel === key));
    if (focus) tab.focus();
    if (key) sliders.get(key)?.();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', (e) => {
      const map: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
      const to = map[e.key];
      if (to === undefined) return;
      e.preventDefault();
      activate(tabs[(to + tabs.length) % tabs.length], true);
    });
  });

  // ---------- 赤ペン取り消し線（表示されたら一括発火・CSS変数で時差） ----------
  const sheet = document.getElementById('tdSheet');
  if (sheet && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { sheet.classList.add('td-on'); io.disconnect(); } });
    }, { threshold: 0.35 });
    io.observe(sheet);
  } else if (sheet) {
    sheet.classList.add('td-on');
  }

  // ---------- 数字カウントアップ ----------
  const counters = document.querySelectorAll<HTMLElement>('.cnt');
  if (counters.length && 'IntersectionObserver' in window && !reduceMotion.matches) {
    const io2 = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        io2.unobserve(el);
        const to = parseInt(el.dataset.to || '0', 10);
        const t0 = performance.now();
        const dur = 900;
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    counters.forEach((c) => io2.observe(c));
  }

  // ---------- FAQ スムーズ開閉 ----------
  document.querySelectorAll<HTMLDetailsElement>('.fq-item').forEach((d) => {
    const sum = d.querySelector('summary');
    const body = d.querySelector<HTMLElement>('.fq-a');
    if (!sum || !body) return;
    let busy = false;
    // transitionendが来ない環境でも必ず後始末する
    const finish = (close: boolean) => {
      if (close) d.open = false;
      body.style.cssText = '';
      busy = false;
    };
    sum.addEventListener('click', (ev) => {
      ev.preventDefault();
      if (busy) return;
      if (reduceMotion.matches) { d.open = !d.open; return; }
      busy = true;
      const close = d.open;
      if (!close) d.open = true;
      const h = body.scrollHeight;
      body.style.height = close ? h + 'px' : '0px';
      requestAnimationFrame(() => {
        body.style.transition = 'height .3s ease';
        body.style.height = close ? '0px' : h + 'px';
        let done = false;
        const onEnd = () => { if (done) return; done = true; finish(close); };
        body.addEventListener('transitionend', onEnd, { once: true });
        window.setTimeout(onEnd, 400);
      });
    });
  });
</script>
