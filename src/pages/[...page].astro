---
/**
 * 下層ページ（ページビルダーで作成した src/data/pages/<slug>.json を描画する動的ルート）。
 * トップページ（index.astro / page-home.json）と同じブロック機構をそのまま使う。
 * blog / admin などの静的ルートが優先されるので衝突しない（エディタ側でも予約語を弾く）。
 */
import Base from '../layouts/Base.astro';
import Block from '../components/Block.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // サブフォルダ対応: data/pages/service/line.json → /service/line/
  const mods = import.meta.glob('../data/pages/**/*.json', { eager: true });
  // service/line は専用LP（src/pages/service/line.astro）で描画するため動的ルートから除外
  const OWN_PAGES = new Set(['service/line']);
  return Object.entries(mods)
    .map(([path, mod]) => {
      const slug = path.replace('../data/pages/', '').replace('.json', '');
      return { params: { page: slug }, props: { pageData: (mod as any).default } };
    })
    .filter((r) => !OWN_PAGES.has(r.params.page));
}

const { pageData } = Astro.props;

// コラム系ブロック（postList / column）用に最新記事を渡す
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// タイトルが長いページは社名サフィックスを短縮して検索結果での切れを防ぐ
const title = pageData.title.length > 24 ? `${pageData.title}｜LAYR` : `${pageData.title}｜株式会社LAYR`;
const description = pageData.description || `株式会社LAYRの${pageData.title}のページです。`;

const slug = (Astro.params.page as string) || '';
const isServiceChild = slug.startsWith('service/');
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
    ...(isServiceChild ? [{ '@type': 'ListItem', position: 2, name: 'サービス', item: new URL('/service/', Astro.site).href }] : []),
    { '@type': 'ListItem', position: isServiceChild ? 3 : 2, name: pageData.title },
  ],
};

// ページ内のaccordion（FAQ）ブロックからFAQPageを生成
const faqItems = pageData.blocks
  .filter((b: any) => b.type === 'faq' || b.type === 'accordion')
  .flatMap((b: any) => b.p?.items ?? [])
  .filter((i: any) => i?.q && i?.a);
const faqJsonLd = faqItems.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item: any) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

// slug固有の追加構造化データ（CMSのJSONに巻き込まれないようコード側に持つ）
const slugJsonLd: Record<string, object[]> = {
  'service': [
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: '株式会社LAYRのサービス',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'LINE構築・運用マーケティング', url: 'https://layr.co.jp/service/line/' },
        { '@type': 'ListItem', position: 2, name: 'Web広告運用代行', url: 'https://layr.co.jp/service/ad/' },
        { '@type': 'ListItem', position: 3, name: 'WebマーケティングBPO「よろず屋マーケくん」', url: 'https://layr.co.jp/yorozuya/' },
      ],
    },
  ],
  'service/ad': [
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': 'https://layr.co.jp/#service-ad',
      name: 'Web広告運用代行',
      serviceType: 'Web広告運用代行（Meta広告・Google広告・LINEヤフー広告）',
      provider: { '@id': 'https://layr.co.jp/#organization' },
      areaServed: 'JP',
      url: 'https://layr.co.jp/service/ad/',
    },
  ],
  'service/line': [
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': 'https://layr.co.jp/#service-line',
      name: 'LINE公式アカウント構築・運用代行',
      serviceType: 'LINEマーケティング支援',
      provider: { '@id': 'https://layr.co.jp/#organization' },
      areaServed: 'JP',
      url: 'https://layr.co.jp/service/line/',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'LINEマーケティング支援プラン',
        itemListElement: [
          {
            '@type': 'Offer',
            name: 'LINE公式アカウント構築',
            description: 'アカウント設計・リッチメニュー・ステップ配信の初期構築（制作期間2〜4週間）',
            priceSpecification: { '@type': 'PriceSpecification', price: 150000, priceCurrency: 'JPY' },
          },
          {
            '@type': 'Offer',
            name: 'LINE運用支援',
            description: '月次の配信企画・セグメント配信・効果測定・改善提案',
            priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: 50000, priceCurrency: 'JPY', unitText: '月' },
          },
        ],
      },
    },
  ],
};
const jsonLd = [
  breadcrumbJsonLd,
  ...(faqJsonLd ? [faqJsonLd] : []),
  ...(slugJsonLd[Astro.params.page as string] ?? []),
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="subpage-pad"></div>
  {pageData.h1 && (
    <div class="page-hero container">
      <h1 class="sec-jp">{pageData.h1}</h1>
    </div>
  )}
  {pageData.blocks.map((block: any) => {
    const fs = Number(block.p?._fs) || 1;
    return fs !== 1
      ? <div style={`--fs:${fs}`}><Block block={block} posts={posts} /></div>
      : <Block block={block} posts={posts} />;
  })}
</Base>
