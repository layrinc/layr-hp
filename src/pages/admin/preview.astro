---
/**
 * ブロックエディタ用のライブプレビュー。
 * カスタマイザー（親ウィンドウ）から postMessage で受け取ったブロック配列を
 * その場でJS描画する。本番の Block.astro と見た目を一致させること。
 */
import Base from '../../layouts/Base.astro';
import IllustWorry from '../../components/IllustWorry.astro';
import IllustGrowth from '../../components/IllustGrowth.astro';
import IllustConsult from '../../components/IllustConsult.astro';
import settings from '../../data/settings.json';
import { ILLUSTS } from '../../lib/illusts.mjs';
import { ISO } from '../../lib/iso-illusts.mjs';
import { getCollection } from 'astro:content';

const postsRaw = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 9);
const posts = postsRaw.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  date: p.data.date.toISOString().slice(0, 10),
}));
const previewSettings = { email: settings.email, line_url: settings.line_url || '' };
---
<Base title="プレビュー｜LAYR CMS" description="編集プレビュー" robots="noindex, nofollow">
  <div id="pv-root"></div>

  <!-- 静的パーツの型（JS描画で複製して使う） -->
  <template id="tpl-worry"><IllustWorry class="illust" /></template>
  <template id="tpl-growth"><IllustGrowth class="illust illust-sm" /></template>
  <template id="tpl-consult"><IllustConsult class="illust illust-md" /></template>
  {/* problem / promise セクションの既定イラスト（Block.astro と同じ iso を使う） */}
  <template id="tpl-iso-bubbles" set:html={ISO.bubbles}></template>
  <template id="tpl-iso-consult" set:html={ISO.consult}></template>
  <template id="tpl-hero-visual">
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-swoosh"></div>
      <div class="browser-mock">
        <div class="bm-bar"><span></span><span></span><span></span></div>
        <div class="bm-body">
          <div class="bm-side"><i></i><i></i><i></i><i></i><i></i></div>
          <div class="bm-main">
            <div class="bm-title"></div>
            <div class="bm-chart"><b style="--h:38%"></b><b style="--h:62%"></b><b style="--h:48%"></b><b style="--h:82%"></b><b style="--h:66%"></b><b style="--h:96%"></b></div>
            <div class="bm-row"></div><div class="bm-row short"></div>
          </div>
        </div>
      </div>
      <div class="hero-badge"><span class="s1"></span><span class="s2"></span></div>
      <div class="phone">
        <div class="phone-screen">
          <div class="talk-header"><span class="oa-icon">S</span>〇〇サロン 公式LINE<span class="oa-check">友だち 3,214</span></div>
          <div class="talk-body">
            <div class="msg in">友だち追加ありがとうございます🎁 30秒のアンケートに答えると、初回クーポンをお届けします</div>
            <div class="msg out">回答しました！</div>
            <div class="msg in">ありがとうございます！あなた向けのクーポンです<span class="coupon">初回限定 20%OFFクーポン</span></div>
          </div>
          <div class="richmenu"><span class="hot">予約する</span><span>クーポン</span><span>メニュー</span><span>口コミ</span><span>アクセス</span><span>相談する</span></div>
        </div>
      </div>
      <div class="float-chip chip1"></div>
      <div class="float-chip chip2"></div>
      <div class="float-chip chip3"></div>
    </div>
  </template>

  <style is:inline>
    /* プレビュー内では資料ポップアップとリビール待ちを無効化 */
    .doc-pop{display:none!important}
    #pv-root .reveal{opacity:1;transform:none}
  </style>

  <script define:vars={{ posts, previewSettings, ILLUSTS, ISO }} is:inline>
    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const nl = (s) => esc(s).replace(/\n/g, '<br>');
    // リッチテキスト: 全部エスケープ後、正規形タグ（strong/em/mark.mk-*/span.tc-*/a href）だけ復元。本番 Block.astro と同一仕様
    const rich = (s) => esc(s)
      .replace(/&lt;(\/?)(strong|em)&gt;/g, '<$1$2>')
      .replace(/&lt;mark class=&quot;(mk-[gy])&quot;&gt;/g, '<mark class="$1">')
      .replace(/&lt;\/mark&gt;/g, '</mark>')
      .replace(/&lt;span class=&quot;(tc-[gr])&quot;&gt;/g, '<span class="$1">')
      .replace(/&lt;\/span&gt;/g, '</span>')
      .replace(/&lt;a href=&quot;((?:https?:\/\/|\/|#|mailto:)[^\s]*?)&quot;&gt;/g, '<a href="$1">')
      .replace(/&lt;\/a&gt;/g, '</a>')
      .replace(/\n/g, '<br>');
    const icoBadge = { point: '💡', warn: '⚠️', memo: '📝', check: '✅' };
    const tpl = (id) => document.getElementById(id).innerHTML;
    const consult = previewSettings.line_url && previewSettings.line_url.trim()
      ? previewSettings.line_url
      : 'mailto:' + previewSettings.email;
    const contact = 'mailto:' + previewSettings.email;

    const svcIcons = [
      '<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="3" y1="20" x2="21" y2="20"/></svg>',
      '<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="9" y1="13" x2="13" y2="13"/></svg>',
    ];
    const secHead = (p, lead) => (!p.en && !p.title_jp) ? '' : `<div class="sec-head reveal"><p class="sec-en">${esc(p.en)}</p><h2 class="sec-jp">${esc(p.title_jp)}</h2>${lead ? `<p class="sec-lead">${esc(lead)}</p>` : ''}</div>`;
    const fmtD = (isoStr) => isoStr.replace(/-/g, '.').replace(/\.(\d)\./, '.0$1.');

    // ===== zigzag 用パーツ（Block.astro と同一） =====
    const ZZ_WAVE = {
      a: 'M0,46 C170,102 330,6 560,32 C782,57 902,106 1122,86 C1272,72 1362,36 1440,18',
      b: 'M0,18 C150,58 300,100 528,90 C752,80 884,18 1084,26 C1244,32 1352,70 1440,94',
    };
    const zzWave = (tint) => (tint ? ZZ_WAVE.a : ZZ_WAVE.b);
    const zzCheck = '<svg viewBox="0 0 17 17" aria-hidden="true"><circle cx="8.5" cy="8.5" r="8.5" fill="rgba(15,158,150,.12)"/><path d="M4.6 8.7l2.6 2.6 5.2-5.6" stroke="#0F9E96" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    const zzArrow = '<svg class="zz-ar" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h15M11 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>';

    const R = {
      hero(p) {
        const vis = document.createElement('div');
        vis.innerHTML = tpl('tpl-hero-visual');
        vis.querySelector('.s1').textContent = p.badge_line1;
        vis.querySelector('.s2').textContent = p.badge_line2;
        ['chip1', 'chip2', 'chip3'].forEach((c, i) => {
          const el = vis.querySelector('.' + c);
          const fc = (p.float_chips || [])[i];
          if (fc) el.innerHTML = esc(fc.label) + '<strong>' + esc(fc.value) + '</strong>'; else el.remove();
        });
        return `<section class="hero"><div class="hero-deco" aria-hidden="true"><div class="ring1"></div><div class="ring2"></div><div class="dot-grid"></div></div><div class="hero-inner"><div class="hero-copy"><p class="hero-eyebrow">${esc(p.eyebrow)}</p><h1>${esc(p.catch_line1)}<br><span class="marker">${esc(p.catch_line2)}</span>${p.catch_line3 ? '<br>' + esc(p.catch_line3) : ''}</h1><p class="hero-sub">${esc(p.sub)}</p><div class="hero-actions"><a class="btn btn-green btn-lg" href="${consult}">${esc(p.cta_primary)}</a><a class="btn btn-black btn-lg" href="#service">${esc(p.cta_secondary)}</a></div><ul class="hero-chips">${(p.chips || []).map((c) => `<li>${esc(c)}</li>`).join('')}</ul></div>${vis.innerHTML}</div></section>`;
      },
      heroText(p) {
        const t2 = p.line2 ? '<br>' + (p.marker ? `<span class="marker">${esc(p.line2)}</span>` : esc(p.line2)) : '';
        const t3 = p.line3 ? '<br>' + esc(p.line3) : '';
        // Block.astro の splitPoint と同じ分け方（ラベル小 ＋ 数値を第2階層に立てる）
        const pts = (p.points || []).map((c) => {
          const m = String(c ?? '').match(/^(\S+?)[ 　]+(.+)$/);
          const label = m ? `<span class="label">${esc(m[1])}</span>` : '';
          return `<li>${label}<span class="val">${esc(m ? m[2] : c)}</span></li>`;
        }).join('');
        // 3シーン（店舗→スマホ→賑わう店）＋つなぎパス。Block.astro の p.scene と同一構造
        const scene = p.scene
          ? `<div class="hero2-scene" aria-hidden="true"><div class="hs-row"><div class="hs-item">${ISO.shop}</div><div class="hs-item is-main">${ISO.phone}</div><div class="hs-item">${ISO.crowd}</div></div><div class="hs-path">${ISO.path}</div></div>`
          : '';
        return `<section class="hero2"><div class="container hero2-inner">${p.eyebrow ? `<p class="hero2-eyebrow">${esc(p.eyebrow)}</p>` : ''}<h1 class="hero2-title">${esc(p.line1)}${t2}${t3}</h1>${p.sub ? `<p class="hero2-sub">${rich(p.sub)}</p>` : ''}<div class="hero2-actions">${p.cta_primary ? `<a class="btn btn-green btn-lg" href="${esc(p.cta_primary_url || consult)}">${esc(p.cta_primary)}</a>` : ''}${p.cta_line ? `<a class="btn btn-line btn-lg hero2-line" href="${esc(consult)}"><svg viewBox="0 0 24 24" aria-hidden="true" style="width:1.2em;height:1.2em"><path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11c0 3.9 3.5 7.2 8.2 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5 1.1-.4 5.8-3.4 7.9-5.8 1.4-1.6 2.2-3.2 2.2-5C22 6.6 17.5 3 12 3z"/></svg>${esc(p.cta_line)}</a>` : ''}${p.cta_secondary ? `<a class="btn btn-black btn-lg" href="${esc(p.cta_secondary_url || '#service')}">${esc(p.cta_secondary)}</a>` : ''}</div>${scene}${pts ? `<ul class="hero2-points">${pts}</ul>` : ''}${(p.badge_top || p.badge_num || p.badge_unit) ? `<div class="hero2-badge"><span class="b-top">${esc(p.badge_top)}</span><strong class="b-num">${esc(p.badge_num)}</strong><span class="b-unit">${esc(p.badge_unit)}</span></div>` : ''}</div></section>`;
      },
      pricing(p) {
        const cards = (p.items || []).map((it) => `<div class="price-card ${it.featured ? 'is-featured' : ''}">${it.tag ? `<p class="price-tag">${esc(it.tag)}</p>` : ''}<h3 class="price-name">${esc(it.name)}</h3><p class="price-amount"><span class="price-num">${esc(it.amount)}</span><small>${esc(it.unit)}</small></p>${it.note ? `<p class="price-note">${esc(it.note)}</p>` : ''}${(it.items || []).length ? `<ul class="price-list">${it.items.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}</div>`).join('');
        return `<section class="blk-sec"><div class="container"><div class="price-grid cols-${(p.items || []).length || 2}">${cards}</div>${p.note ? `<p class="price-foot">${esc(p.note)}</p>` : ''}</div></section>`;
      },
      stats(p) {
        return `<section class="stats">${p.show_edit_note ? '<div class="draft-note"><p>【要編集】実績数値はサンプルです。カスタマイザーで実数値に差し替え、この注意書きをオフにしてください。</p></div>' : ''}<div class="container"><h2 class="stats-title">${esc(p.title_before)}<span class="marker">${esc(p.title_marker)}</span></h2><div class="stats-grid">${p.items.map((it) => `<div class="stat-card reveal"><span class="stat-tag">${esc(it.tag)}</span><p class="stat-num">${it.arrow ? '<span class="up">▲</span>' : ''}${esc(it.number)}<small>${esc(it.unit)}</small></p><p class="stat-desc">${nl(it.desc)}</p></div>`).join('')}</div></div></section>`;
      },
      problem(p) {
        return `<section class="problem"><div class="container">${secHead(p)}<div class="problem-cols"><ul class="problem-list">${p.items.map((it) => `<li class="reveal"><span class="check"></span>${esc(it)}</li>`).join('')}</ul><div class="problem-illust reveal is-iso" aria-hidden="true">${tpl('tpl-iso-bubbles')}</div></div><div class="problem-arrow" aria-hidden="true"></div><div class="problem-answer reveal"><strong>${esc(p.answer_lead)}<span class="marker">${esc(p.answer_marker)}</span>${esc(p.answer_tail)}</strong><p>${esc(p.answer_body)}</p></div></div></section>`;
      },
      ctaBand(p) {
        return `<div class="cta-band"><div class="container cta-band-inner"><div><h2>${esc(p.title_before)}<span>${esc(p.title_em)}</span>${esc(p.title_after)}</h2><p>${esc(p.desc)}</p></div><div class="cta-band-btns"><a class="btn btn-green" href="${consult}">${esc(p.btn_primary)}</a><a class="btn btn-white" href="${contact}">${esc(p.btn_secondary)}</a></div></div></div>`;
      },
      service(p) {
        return `<section id="service"><div class="container">${secHead(p, p.lead)}<div class="service-grid">${p.items.map((s, i) => s.featured
          ? `<div class="service-card wide reveal">${s.badge ? `<span class="service-badge">${esc(s.badge)}</span>` : ''}<p class="service-num">${esc(s.number)}</p><h3>${esc(s.title)}</h3><p>${esc(s.desc)}</p><ul class="service-tags">${s.tags.map((tg) => `<li>${esc(tg)}</li>`).join('')}</ul></div>`
          : `<div class="service-card reveal"><div class="service-visual" aria-hidden="true">${svcIcons[i % svcIcons.length]}</div><p class="service-num">${esc(s.number)}</p><h3>${esc(s.title)}</h3><p>${esc(s.desc)}</p><ul class="service-tags">${s.tags.map((tg) => `<li>${esc(tg)}</li>`).join('')}</ul></div>`).join('')}</div>${p.note ? `<p class="service-note">${esc(p.note)}</p>` : ''}</div></section>`;
      },
      reason(p) {
        return `<section class="reason"><div class="container">${secHead(p)}<div class="reason-grid">${p.items.map((r, i) => `<div class="reason-card reveal"><span class="reason-num" aria-hidden="true">${String(i + 1).padStart(2, '0')}</span><h3>${esc(r.title)}</h3><p>${esc(r.desc)}</p></div>`).join('')}</div></div></section>`;
      },
      cases(p) {
        return `<section id="case"><div class="container">${secHead(p)}</div>${p.show_edit_note ? '<div class="draft-note"><p>【要編集】以下の実績はサンプルです。カスタマイザーで実案件に差し替え、この注意書きをオフにしてください（クライアント名の掲載は先方の許可を取ってから）。</p></div>' : ''}<div class="container"><div class="case-grid">${p.items.map((c) => `<div class="case-card reveal"><div class="case-head"><span class="case-tag">${esc(c.tag)}</span><h3>${esc(c.title)}</h3></div><div class="case-body"><dl><div class="case-row"><dt>課題</dt><dd>${esc(c.problem)}</dd></div><div class="case-row"><dt>施策</dt><dd>${esc(c.action)}</dd></div></dl></div><div class="case-result"><p class="label">${esc(c.metric_label)}</p><div class="case-graph" aria-hidden="true"><span class="bar b1" style="--h:${Number(c.graph_before) || 0}%" data-label="Before"></span><span class="bar b2" style="--h:${Number(c.graph_after) || 0}%" data-label="After"></span></div><div class="case-metric"><span class="before">${esc(c.before)}</span><span class="arrow">→</span><span class="after">${esc(c.after_number)}<small>${esc(c.after_unit)}</small></span></div></div></div>`).join('')}</div></div></section>`;
      },
      column(p) {
        return `<section id="column"><div class="container">${secHead(p, p.lead)}<div class="column-grid">${posts.slice(0, 3).map((post) => `<a class="column-card reveal" href="/blog/${post.id}/"><div class="column-meta"><time datetime="${post.date}">${fmtD(post.date)}</time><span class="column-cat">${esc(post.category)}</span></div><h3>${esc(post.title)}</h3><p>${esc(post.description)}</p><span class="more">READ MORE ›</span></a>`).join('')}</div><div class="column-more reveal"><a class="btn btn-black" href="/blog/">コラム一覧を見る</a></div></div></section>`;
      },
      promise(p) {
        const li = (mark, it) => `<li><span class="mark">${mark}</span><div><strong>${esc(it.title)}</strong><span>${esc(it.desc)}</span></div></li>`;
        return `<section class="promise"><div class="container">${secHead(p)}<div class="promise-grid"><div class="promise-box yes reveal"><h3><span class="ico">○</span>お約束できること</h3><ul>${p.yes_items.map((it) => li('○', it)).join('')}</ul></div><div class="promise-box no reveal"><h3><span class="ico">×</span>お約束できないこと</h3><ul>${p.no_items.map((it) => li('×', it)).join('')}</ul></div></div><div class="sec-illust reveal is-iso" aria-hidden="true">${tpl('tpl-iso-consult')}</div><p class="promise-close reveal">${esc(p.close_before)}<br>${esc(p.close_mid)}<span class="marker">${esc(p.close_marker)}</span>${esc(p.close_after)}</p></div></section>`;
      },
      message(p) {
        return `<section class="message"><div class="container">${secHead(p)}<div class="message-wrap"><div class="message-photo reveal">${p.photo ? `<img src="${esc(p.photo)}" alt="${esc(p.sign_name)}">` : '<span class="todo">【要編集】<br>代表写真をカスタマイザーの<br>「代表挨拶」で設定</span>'}</div><div class="message-body reveal">${p.paragraphs.map((para) => `<p>${esc(para)}</p>`).join('')}<div class="sign"><span class="title">${esc(p.sign_title)}</span><span class="name">${esc(p.sign_name)}</span></div></div></div></div></section>`;
      },
      faq(p) {
        return `<section class="faq"><div class="container">${secHead(p)}<div class="faq-list reveal">${p.items.map((it) => `<details class="faq-item"><summary><span class="q">Q.</span>${esc(it.q)}</summary><div class="a"><span class="mark">A.</span><p>${esc(it.a)}</p></div></details>`).join('')}</div></div></section>`;
      },
      company(p) {
        return `<section class="company"><div class="container">${secHead(p)}<table class="company-table reveal"><tbody><tr><th>会社名</th><td>${esc(p.name)}</td></tr><tr><th>代表者</th><td>${esc(p.representative)}</td></tr><tr><th>所在地</th><td>${esc(p.address)}</td></tr><tr><th>設立</th><td>${esc(p.founded)}</td></tr><tr><th>事業内容</th><td><ul>${p.business.map((b) => `<li>${esc(b)}</li>`).join('')}</ul></td></tr><tr><th>お問い合わせ</th><td><a href="${contact}">${esc(previewSettings.email)}</a></td></tr></tbody></table></div></section>`;
      },
      ctaFinal(p) {
        return `<section class="cta-final"><div class="cta-final-inner"><p class="sec-en">${esc(p.en)}</p><h2>${esc(p.title_line1)}<br>${esc(p.title_before)}<span>${esc(p.title_em)}</span>${esc(p.title_after)}</h2><p>${nl(p.desc)}</p><a class="btn btn-green btn-lg" href="${consult}">${esc(p.btn)}</a><p class="mail">メールでのご連絡：<a href="${contact}">${esc(previewSettings.email)}</a></p></div></section>`;
      },
      heading(p) {
        const tag = p.level === 2 ? 'h2' : p.level === 4 ? 'h4' : 'h3';
        return `<section class="blk-sec"><div class="container"><${tag} class="blk-h blk-h${p.level || 3} ${p.align === 'center' ? 'is-center' : ''}">${esc(p.text)}</${tag}></div></section>`;
      },
      text(p) {
        return `<section class="blk-sec"><div class="container"><p class="blk-text blk-rich ${p.align === 'center' ? 'is-center' : ''}">${rich(p.body)}</p></div></section>`;
      },
      box(p) {
        return `<section class="blk-sec"><div class="container"><div class="blk-box is-${p.style || 'plain'}">${p.title ? `<p class="blk-box-title">${esc(p.title)}</p>` : ''}<p class="blk-rich">${rich(p.body)}</p></div></div></section>`;
      },
      sectionHead(p) {
        const wm = p.watermark ? `<span class="sec-wm" aria-hidden="true">${esc(p.watermark)}</span>` : '';
        const label = p.pill ? `<span class="sec-pill">${esc(p.en)}</span>` : `<p class="sec-en">${esc(p.en)}</p>`;
        return `<section class="blk-sec"${p.anchor ? ` id="${esc(p.anchor)}"` : ''}><div class="container"><div class="sec-head ${p.align === 'center' ? 'is-center' : ''}">${wm}${label}<h2 class="sec-jp">${esc(p.title_jp)}</h2>${p.lead ? `<p class="sec-lead">${esc(p.lead)}</p>` : ''}</div></div></section>`;
      },
      marquee(p) {
        const items = (p.items || []);
        const one = items.map((it) => `<span class="mq-item">${esc(it)}</span><span class="mq-sep">····&gt;</span>`).join('');
        return `<div class="mq" aria-hidden="true"><div class="mq-track" style="--mq-speed:${Number(p.speed) || 28}s">${one}${one}</div></div>`;
      },
      capBox(p) {
        return `<section class="blk-sec"><div class="container"><div class="blk-cap is-${p.color || 'green'}"><p class="blk-cap-title">${esc(p.title)}</p><div class="blk-cap-body blk-rich">${rich(p.body)}</div></div></div></section>`;
      },
      iconBox(p) {
        return `<section class="blk-sec"><div class="container"><div class="blk-ico is-${p.type || 'point'}"><span class="blk-ico-badge" aria-hidden="true">${icoBadge[p.type] || '💡'}</span><div class="blk-ico-inner">${p.title ? `<p class="blk-ico-title">${esc(p.title)}</p>` : ''}<div class="blk-rich">${rich(p.body)}</div></div></div></div></section>`;
      },
      speech(p) {
        const face = p.avatar ? `<img src="${esc(p.avatar)}" alt="${esc(p.name)}">` : '<span class="noimg" aria-hidden="true">🙂</span>';
        return `<section class="blk-sec"><div class="container"><div class="blk-speech is-${p.side === 'right' ? 'right' : 'left'} is-${p.color === 'green' ? 'green' : 'gray'}"><div class="blk-speech-face">${face}${p.name ? `<p class="blk-speech-name">${esc(p.name)}</p>` : ''}</div><div class="blk-speech-bubble blk-rich">${rich(p.body)}</div></div></div></section>`;
      },
      list(p) {
        return `<section class="blk-sec"><div class="container"><ul class="blk-list is-${p.style || 'check'}">${(p.items || []).map((it) => `<li class="blk-rich">${rich(it)}</li>`).join('')}</ul></div></section>`;
      },
      steps(p) {
        return `<section class="blk-sec"><div class="container"><div class="blk-steps">${(p.items || []).map((s, i) => `<div class="blk-step"><span class="blk-step-num" aria-hidden="true">${i + 1}</span><p class="blk-step-title">${esc(s.title)}</p>${s.body ? `<div class="blk-step-body blk-rich">${rich(s.body)}</div>` : ''}</div>`).join('')}</div></div></section>`;
      },
      accordion(p) {
        return `<section class="blk-sec"><div class="container"><div class="faq-list">${(p.items || []).map((it) => `<details class="faq-item"><summary><span class="q">Q.</span>${esc(it.q)}</summary><div class="a"><span class="mark">A.</span><p class="blk-rich">${rich(it.a)}</p></div></details>`).join('')}</div></div></section>`;
      },
      quote(p) {
        return `<section class="blk-sec"><div class="container"><blockquote class="blk-quote"><span class="blk-rich">${rich(p.body)}</span>${p.cite ? `<cite>出典：${esc(p.cite)}</cite>` : ''}</blockquote></div></section>`;
      },
      cols2(p) {
        const col = (title, body) => `<div class="blk-col">${title ? `<p class="blk-col-title">${esc(title)}</p>` : ''}<div class="blk-rich">${rich(body)}</div></div>`;
        return `<section class="blk-sec"><div class="container"><div class="blk-cols">${col(p.left_title, p.left_body)}${col(p.right_title, p.right_body)}</div></div></section>`;
      },
      illust(p) {
        const legacy = { worry: 'tpl-worry', growth: 'tpl-growth', consult: 'tpl-consult' };
        const isIso = String(p.kind || '').startsWith('iso-');
        const svg = legacy[p.kind] ? tpl(legacy[p.kind])
          : isIso ? (ISO[String(p.kind).slice(4)] || ISO.shop)
          : (ILLUSTS[p.kind] || ILLUSTS.rocket);
        return `<section class="blk-sec"><div class="container"><div class="blk-illust is-${p.size || 'm'} ${p.align === 'left' ? 'is-left' : ''} ${isIso ? 'is-iso' : ''}" aria-hidden="true">${svg}</div></div></section>`;
      },
      mediaText(p) {
        const img = p.img ? `<img src="${esc(p.img)}" alt="${esc(p.alt || p.title)}">` : '<div class="blk-img-empty">画像未設定（左のパネルでアップロード）</div>';
        const btn = p.btn_label ? `<a class="btn btn-green" style="margin-top:18px" href="${p.btn_url === 'consult' ? consult : p.btn_url === 'contact' ? contact : esc(p.btn_url || '#')}">${esc(p.btn_label)}</a>` : '';
        return `<section class="blk-sec"><div class="container"><div class="blk-media ${p.side === 'right' ? 'is-right' : ''}"><div class="blk-media-img">${img}</div><div class="blk-media-body">${p.title ? `<h3 class="blk-media-title">${esc(p.title)}</h3>` : ''}<div class="blk-rich">${rich(p.body)}</div>${btn}</div></div></div></section>`;
      },
      gallery(p) {
        return `<section class="blk-sec"><div class="container"><div class="blk-gallery cols-${p.cols || 3}">${(p.items || []).map((g) => `<figure class="blk-gallery-item">${g.src ? `<img src="${esc(g.src)}" alt="${esc(g.cap)}">` : '<div class="blk-img-empty">画像未設定</div>'}${g.cap ? `<figcaption>${esc(g.cap)}</figcaption>` : ''}</figure>`).join('')}</div></div></section>`;
      },
      cardGrid(p) {
        const card = (c) => {
          const href = c.url === 'consult' ? consult : c.url === 'contact' ? contact : c.url;
          const inner = `<div class="blk-card-img">${c.img ? `<img src="${esc(c.img)}" alt="${esc(c.title)}">` : '<div class="blk-img-empty small">画像未設定</div>'}</div><div class="blk-card-body">${c.title ? `<h3>${esc(c.title)}</h3>` : ''}${c.body ? `<p class="blk-rich">${rich(c.body)}</p>` : ''}${href ? '<span class="more">READ MORE ›</span>' : ''}</div>`;
          return href ? `<a class="blk-card is-link" href="${esc(href)}">${inner}</a>` : `<div class="blk-card">${inner}</div>`;
        };
        return `<section class="blk-sec"><div class="container"><div class="blk-cards cols-${p.cols || 3}">${(p.items || []).map(card).join('')}</div></div></section>`;
      },
      postList(p) {
        return `<section class="blk-sec"><div class="container"><div class="column-grid">${posts.slice(0, Number(p.count) || 3).map((post) => `<a class="column-card" href="/blog/${post.id}/"><div class="column-meta"><time datetime="${post.date}">${fmtD(post.date)}</time><span class="column-cat">${esc(post.category)}</span></div><h3>${esc(post.title)}</h3><p>${esc(post.description)}</p><span class="more">READ MORE ›</span></a>`).join('')}</div>${p.more_label ? `<div class="column-more"><a class="btn btn-black" href="/blog/">${esc(p.more_label)}</a></div>` : ''}</div></section>`;
      },
      image(p) {
        return `<section class="blk-sec"><div class="container"><figure class="blk-img ${p.align === 'center' ? 'is-center' : ''}" style="--w:${p.width || 100}%">${p.src ? `<img src="${esc(p.src)}" alt="${esc(p.alt)}">` : '<div class="blk-img-empty">画像未設定（左のパネルでアップロード）</div>'}${p.caption ? `<figcaption>${esc(p.caption)}</figcaption>` : ''}</figure></div></section>`;
      },
      buttons(p) {
        return `<section class="blk-sec"><div class="container"><div class="blk-btns ${p.align === 'center' ? 'is-center' : ''}">${(p.items || []).map((b) => `<a class="btn ${b.style === 'outline' ? 'btn-white' : b.style === 'dark' ? 'btn-black' : 'btn-green'}" href="${b.url === 'consult' ? consult : b.url === 'contact' ? contact : esc(b.url)}">${esc(b.label)}</a>`).join('')}</div></div></section>`;
      },
      spacer(p) {
        return `<div class="blk-spacer is-${p.size || 'm'}" aria-hidden="true"></div>`;
      },
      // ジグザグ2カラム（本番 Block.astro の t === 'zigzag' と同一構造）
      contact(p) {
        const eyebrow = p.en ? `<p class="zz-eyebrow cform-eyebrow"><i></i><span>${esc(p.en)}</span></p>` : '';
        return `<section class="cform" id="contact"><div class="container cform-wrap"><div class="cform-head">${eyebrow}${p.title ? `<h2 class="cform-title">${rich(p.title)}</h2>` : ''}${p.lead ? `<p class="cform-lead">${rich(p.lead)}</p>` : ''}<div class="cform-linelane"><a class="btn btn-line cform-linebtn" href="${esc(consult)}"><svg viewBox="0 0 24 24" aria-hidden="true" style="width:1.2em;height:1.2em"><path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11c0 3.9 3.5 7.2 8.2 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5 1.1-.4 5.8-3.4 7.9-5.8 1.4-1.6 2.2-3.2 2.2-5C22 6.6 17.5 3 12 3z"/></svg>LINEで相談する（一番かんたん）</a><p class="cform-or"><span>LINEを使っていない場合は、メールフォームからどうぞ。</span></p></div></div><form class="cform-form" onsubmit="return false"><div class="cform-grid"><label>お名前 <span class="req">必須</span><input type="text" placeholder="山田 太郎" /></label><label>会社名・屋号<input type="text" placeholder="株式会社◯◯（任意）" /></label><label>メールアドレス <span class="req">必須</span><input type="email" placeholder="you@example.com" /></label><label>ご相談内容<select><option>無料相談の予約（オンライン30分）</option></select></label></div><label class="cform-msg">お問い合わせ内容 <span class="req">必須</span><textarea rows="6" placeholder="現状のLINEの運用状況や、相談したいことをご記入ください。"></textarea></label><div class="cform-foot"><p class="cform-note">通常1営業日以内にご返信します。この段階での売り込みは行いません。</p><button class="btn btn-green zz-btn cform-submit" type="button">送信する${zzArrow}</button></div></form></div></section>`;
      },
      zigzag(p) {
        const d = zzWave(p.tint);
        const wave = p.wave
          ? `<div class="zz-wave" aria-hidden="true"><svg viewBox="0 0 1440 120" preserveAspectRatio="none" focusable="false"><path d="${d} L1440,0 L0,0 Z" fill="currentColor"/><path d="${d}" fill="none" stroke="rgba(15,158,150,.30)" stroke-width="1.5" vector-effect="non-scaling-stroke"/></svg></div>`
          : '';
        const eyebrow = p.eyebrow ? `<p class="zz-eyebrow"><i></i><span>${esc(p.eyebrow)}</span></p>` : '';
        const title = p.title ? `<h2 class="zz-title">${rich(p.title)}</h2>` : '';
        const lead = p.lead ? `<div class="zz-lead blk-rich">${rich(p.lead)}</div>` : '';
        const steps = (p.steps || []).length
          ? `<ol class="zz-steps reveal is-visible">${p.steps.map((s, i) => `<li class="zz-step"><span class="zz-step-n" aria-hidden="true">${i + 1}</span><div class="zz-step-b"><strong class="zz-step-t">${esc(s.t)}</strong>${s.d ? `<p class="zz-step-d">${rich(s.d)}</p>` : ''}</div></li>`).join('')}</ol>`
          : '';
        const pts = (p.points || []).length
          ? `<ul class="zz-points">${p.points.map((it) => `<li>${zzCheck}<span>${rich(it)}</span></li>`).join('')}</ul>`
          : '';
        const btn = p.btn_label
          ? `<a class="btn btn-green zz-btn" href="${p.btn_url === 'consult' ? consult : p.btn_url === 'contact' ? contact : esc(p.btn_url || '#')}">${esc(p.btn_label)}${zzArrow}</a>`
          : '';
        const fig = (p.iso && ISO[p.iso])
          ? `<div class="zz-fig" aria-hidden="true"><span class="zz-blob"></span>${ISO[p.iso]}</div>`
          : '';
        return `<section class="zz ${p.tint ? 'is-tint' : ''}"${p.anchor ? ` id="${esc(p.anchor)}"` : ''}>${wave}<div class="container zz-row is-${p.side === 'right' ? 'right' : 'left'}"><div class="zz-txt">${eyebrow}${title}${lead}${steps}${pts}${btn}</div>${fig}</div></section>`;
      },
    };

    const root = document.getElementById('pv-root');
    function render(blocks) {
      root.innerHTML = blocks.map((b) => {
        try {
          const html = R[b.type] ? R[b.type](b.p) : '';
          const fs = Number(b.p && b.p._fs) || 1;
          return fs !== 1 ? `<div style="--fs:${fs}">${html}</div>` : html;
        } catch (e) { return `<p style="color:red;padding:20px">ブロック描画エラー(${b.type}): ${esc(e.message)}</p>`; }
      }).join('');
      root.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
    }

    window.addEventListener('message', (e) => {
      if (e.origin !== location.origin) return;
      const d = e.data;
      if (!d || d.type !== 'layr-blocks') return;
      if (d.vars) for (const k in d.vars) document.documentElement.style.setProperty(k, d.vars[k]);
      if (d.fontHref) {
        let l = document.getElementById('pv-font');
        if (!l) { l = document.createElement('link'); l.id = 'pv-font'; l.rel = 'stylesheet'; document.head.appendChild(l); }
        if (l.href !== d.fontHref) l.href = d.fontHref;
      }
      if (typeof d.css === 'string') {
        let s = document.getElementById('layr-custom-css');
        if (!s) { s = document.createElement('style'); s.id = 'layr-custom-css'; document.head.appendChild(s); }
        s.textContent = d.css;
      }
      if (Array.isArray(d.blocks)) render(d.blocks);
      // ブロックへスクロール（エディタで選択されたブロックに追従）
      if (typeof d.scrollTo === 'number' && root.children[d.scrollTo]) {
        root.children[d.scrollTo].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // 親に準備完了を通知
    if (window.parent !== window) window.parent.postMessage({ type: 'layr-preview-ready' }, location.origin);
  </script>
</Base>
