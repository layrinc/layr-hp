  // ================= デザイン・基本設定 =================
  const $ = (id) => document.getElementById(id);
  ['accent', 'accent_dark', 'base_black', 'bg_tint'].forEach((k) => { $('f-' + k).value = state.theme[k]; $('f-' + k).addEventListener('input', (e) => { state.theme[k] = e.target.value; send(); }); });
  $('f-radius').value = state.theme.radius; $('radiusOut').textContent = state.theme.radius + 'px';
  $('f-radius').addEventListener('input', (e) => { state.theme.radius = Number(e.target.value); $('radiusOut').textContent = e.target.value + 'px'; send(); });
  $('f-font_en').value = state.theme.font_en;
  $('f-font_en').addEventListener('input', (e) => { state.theme.font_en = e.target.value; send(); });
  $('f-custom_css').value = state.theme.custom_css || '';
  $('f-custom_css').addEventListener('input', (e) => { state.theme.custom_css = e.target.value; send(); });
  $('f-email').value = state.settings.email;
  $('f-email').addEventListener('input', (e) => { state.settings.email = e.target.value; });
  $('f-line_url').value = state.settings.line_url || '';
  $('f-line_url').addEventListener('input', (e) => { state.settings.line_url = e.target.value; });
  $('f-tagline').value = state.settings.tagline;
  $('f-tagline').addEventListener('input', (e) => { state.settings.tagline = e.target.value; });

  // ================= ライブ反映 =================
  let timer = null, ready = false;
  function send(scrollTo) {
    clearTimeout(timer);
    timer = setTimeout(() => sendNow(scrollTo), 80);
  }
  function sendNow(scrollTo) {
    const t = state.theme;
    const gf = fontMap[t.font_en] || fontMap.Montserrat;
    frame.contentWindow?.postMessage({
      type: 'layr-blocks',
      blocks: state.page.blocks,
      vars: { '--green': t.accent, '--green-dark': t.accent_dark, '--black': t.base_black, '--bg': t.bg_tint, '--radius': t.radius + 'px', '--font-en': `'${t.font_en}','Noto Sans JP',sans-serif` },
      fontHref: `https://fonts.googleapis.com/css2?family=${gf}&display=swap`,
      css: t.custom_css || '',
      ...(typeof scrollTo === 'number' ? { scrollTo } : {}),
    }, location.origin);
  }
  window.addEventListener('message', (e) => {
    if (e.origin !== location.origin) return;
    if (e.data && e.data.type === 'layr-preview-ready') { ready = true; sendNow(); }
  });
  frame.addEventListener('load', () => setTimeout(() => sendNow(), 250));

  // ================= デバイス切替・リセット =================
  document.querySelectorAll('.cz-dev').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.cz-dev').forEach((x) => x.classList.remove('is-active'));
      b.classList.add('is-active');
      frame.style.width = b.dataset.w || '100%';
    });
  });
  document.getElementById('czReset').addEventListener('click', () => { if (confirm('未保存の変更を破棄して読み込み直しますか？')) location.reload(); });

  // ================= 保存 =================
  const REPO = 'layrinc/company-brain';
  const BASE = '株式会社LAYR/layr-hp/';
  const TOKEN_KEY = 'layrGhToken';
  const modal = $('czModal');

  function getToken() {
    return new Promise((resolve) => {
      const saved = localStorage.getItem(TOKEN_KEY);
      if (saved) return resolve(saved);
      try {
        const cms = JSON.parse(localStorage.getItem('sveltia-cms.user') || '{}');
        if (cms && cms.token) { localStorage.setItem(TOKEN_KEY, cms.token); return resolve(cms.token); }
      } catch (_) { /* モーダルへ */ }
      modal.hidden = false;
      $('czTokenOk').onclick = () => { const v = $('czToken').value.trim(); if (!v) return; localStorage.setItem(TOKEN_KEY, v); modal.hidden = true; resolve(v); };
      $('czTokenCancel').onclick = () => { modal.hidden = true; resolve(null); };
    });
  }

  async function gh(path, opt = {}, token) {
    const res = await fetch('https://api.github.com' + path, { ...opt, headers: { Authorization: 'Bearer ' + token, Accept: 'application/vnd.github+json', ...(opt.body ? { 'Content-Type': 'application/json' } : {}) } });
    if (res.status === 401 || res.status === 403) { localStorage.removeItem(TOKEN_KEY); throw new Error('認証エラー。トークンを確認してください（再度保存するとトークン入力が出ます）'); }
    if (!res.ok) { const j = await res.json().catch(() => ({})); throw new Error('GitHub APIエラー: ' + res.status + (j.message ? '（' + j.message + '）' : '')); }
    return res.json();
  }

  document.getElementById('czSave').addEventListener('click', async () => {
    const token = await getToken();
    if (!token) return;
    const btn = document.getElementById('czSave');
    btn.disabled = true;
    statusEl.textContent = '保存中…';
    try {
      // 1) 画像（dataURL）をアップロード用に抽出し、保存用クローンではパスに置換
      const pageClone = JSON.parse(JSON.stringify(state.page));
      const uploads = [];
      pageClone.blocks.forEach((b) => {
        ['photo', 'src', 'avatar'].forEach((key) => {
          const v = b.p && b.p[key];
          if (typeof v === 'string' && v.startsWith('data:')) {
            const m = v.match(/^data:image\/(png|jpe?g|gif|webp|svg\+xml);base64,(.+)$/);
            if (!m) return;
            const ext = m[1] === 'jpeg' ? 'jpg' : m[1].replace('+xml', '');
            const name = `up-${Date.now()}-${uploads.length}.${ext}`;
            uploads.push({ name, b64: m[2] });
            b.p[key] = '/uploads/' + name;
          }
        });
      });

      let lastErr = null;
      for (let attempt = 1; attempt <= 3; attempt++) {
        try {
          // 2) 画像blobを作成
          const treeEntries = [];
          for (const u of uploads) {
            const blob = await gh(`/repos/${REPO}/git/blobs`, { method: 'POST', body: JSON.stringify({ content: u.b64, encoding: 'base64' }) }, token);
            treeEntries.push({ path: BASE + 'public/uploads/' + u.name, mode: '100644', type: 'blob', sha: blob.sha });
          }
          // 3) JSON3点
          treeEntries.push({ path: BASE + 'src/data/page-home.json', mode: '100644', type: 'blob', content: JSON.stringify(pageClone, null, 2) + '\n' });
          treeEntries.push({ path: BASE + 'src/data/theme.json', mode: '100644', type: 'blob', content: JSON.stringify(state.theme, null, 2) + '\n' });
          treeEntries.push({ path: BASE + 'src/data/settings.json', mode: '100644', type: 'blob', content: JSON.stringify(state.settings, null, 2) + '\n' });
          // 4) コミット
          const ref = await gh(`/repos/${REPO}/git/ref/heads/main`, {}, token);
          const parentSha = ref.object.sha;
          const parent = await gh(`/repos/${REPO}/git/commits/${parentSha}`, {}, token);
          const tree = await gh(`/repos/${REPO}/git/trees`, { method: 'POST', body: JSON.stringify({ base_tree: parent.tree.sha, tree: treeEntries }) }, token);
          const commit = await gh(`/repos/${REPO}/git/commits`, { method: 'POST', body: JSON.stringify({ message: 'layr-hp: ページビルダーから更新', tree: tree.sha, parents: [parentSha] }) }, token);
          await gh(`/repos/${REPO}/git/refs/heads/main`, { method: 'PATCH', body: JSON.stringify({ sha: commit.sha }) }, token);
          lastErr = null;
          break;
        } catch (e) {
          lastErr = e;
          if (String(e.message).includes('422') && attempt < 3) {
            statusEl.textContent = `他の更新と競合したため再試行中…（${attempt}回目）`;
            await new Promise((r) => setTimeout(r, 1200));
            continue;
          }
          throw e;
        }
      }
      if (lastErr) throw lastErr;
      statusEl.textContent = '✅ 保存しました。約1分で本番に反映されます';
    } catch (err) {
      statusEl.textContent = '❌ ' + (err.message || '保存に失敗しました') + '｜再読み込みして再試行してください';
    } finally {
      btn.disabled = false;
    }
  });

  // 初期描画
  renderBlocks();
</script>

<style is:global>
