---
/**
 * ブロックエディタ（WordPressのブロックエディタ＋カスタマイザー相当）。
 * ページ＝ブロックの積み重ね。追加・並べ替え・複製・削除・項目の増減・画像挿入が全部ここでできる。
 * 右のプレビュー（/admin/preview/）に即時反映し、「保存して公開」でGitHubへコミット→自動デプロイ。
 */
import page from '../../data/page-home.json';
import theme from '../../data/theme.json';
import settings from '../../data/settings.json';

const initial = { page, theme, settings };
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>ページビルダー｜LAYR CMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
</head>
<body class="cz-body">

  <header class="cz-bar">
    <a class="cz-back" href="/admin/">‹ 管理ホーム</a>
    <p class="cz-title">🧱 ページビルダー</p>
    <div class="cz-tabs" role="tablist">
      <button class="cz-tab is-active" data-tab="blocks">ページ構成</button>
      <button class="cz-tab" data-tab="design">デザイン・全体設定</button>
    </div>
    <div class="cz-bar-actions">
      <span class="cz-status" id="czStatus"></span>
      <button class="cz-btn ghost" id="czReset">リセット</button>
      <button class="cz-btn primary" id="czSave">保存して公開</button>
    </div>
  </header>

  <div class="cz-main">
    <aside class="cz-panel">

      <div class="cz-pane" id="pane-blocks">
        <div class="cz-panel-head">
          <p>ブロックをクリックして編集。<b>↑↓</b>で並べ替え、<b>＋</b>で好きな場所に追加。本文は文字を選択して<b>太字・マーカー・文字色・リンク</b>を付けられます。</p>
        </div>
        <div id="blockList"></div>
        <button class="cz-add-main" id="addAtEnd">＋ ブロックを追加</button>
      </div>

      <div class="cz-pane" id="pane-design" hidden>
        <div class="cz-group-static">
          <h3>🎨 テーマ（サイト全体の見た目）</h3>
          <div class="cz-fields">
            <label class="cz-color">メインカラー<input type="color" id="f-accent" /></label>
            <label class="cz-color">メインカラー（濃）<input type="color" id="f-accent_dark" /></label>
            <label class="cz-color">締めの深色<input type="color" id="f-base_black" /></label>
            <label class="cz-color">薄い背景色<input type="color" id="f-bg_tint" /></label>
            <label>角丸の大きさ <output id="radiusOut"></output><input type="range" id="f-radius" min="0" max="28" step="1" /></label>
            <label>英字フォント<select id="f-font_en"><option>Montserrat</option><option>Archivo</option><option>Poppins</option></select></label>
          </div>
        </div>
        <div class="cz-group-static">
          <h3>⚙️ 基本設定</h3>
          <div class="cz-fields">
            <label>問い合わせメールアドレス<input type="text" id="f-email" /></label>
            <label>LINE友だち追加URL（空欄ならメールCTA）<input type="text" id="f-line_url" placeholder="https://lin.ee/xxxx" /></label>
            <label>フッターのひとこと（改行可）<textarea id="f-tagline" rows="3"></textarea></label>
          </div>
        </div>
        <div class="cz-group-static">
          <h3>🧩 追加CSS（上級者向け）</h3>
          <div class="cz-fields">
            <p class="cz-hint">WordPressの「追加CSS」相当。サイト全体に適用され、プレビューに即時反映。</p>
            <textarea id="f-custom_css" class="cz-css" rows="14" spellcheck="false" placeholder="/* 例: .hero h1 { letter-spacing: .04em } */"></textarea>
          </div>
        </div>
        <p class="cz-note">記事の執筆・画像ライブラリは <a href="/admin/cms/">編集画面（CMS）</a> から。</p>
      </div>

    </aside>

    <section class="cz-stage">
      <div class="cz-devices">
        <button class="cz-dev is-active" data-w="">🖥 PC</button>
        <button class="cz-dev" data-w="768px">📱 タブレット</button>
        <button class="cz-dev" data-w="390px">📱 スマホ</button>
      </div>
      <div class="cz-frame-wrap"><iframe id="czFrame" src="/admin/preview/" title="サイトプレビュー"></iframe></div>
    </section>
  </div>

  <!-- ブロック追加ピッカー -->
  <div class="cz-modal" id="pickerModal" hidden>
    <div class="cz-modal-card cz-picker">
      <div class="cz-picker-head"><h2>ブロックを追加</h2><button class="cz-x" id="pickerClose">✕</button></div>
      <p class="cz-picker-cat">🔤 基本パーツ（見出し・文章・画像・ボタン）</p>
      <div class="cz-picker-grid" id="pickParts"></div>
      <p class="cz-picker-cat">✨ 装飾パーツ（WPテーマ風の記事装飾）</p>
      <div class="cz-picker-grid" id="pickDeco"></div>
      <p class="cz-picker-cat">📦 完成セクション（デザイン済みの大きな部品）</p>
      <div class="cz-picker-grid" id="pickSections"></div>
    </div>
  </div>

  <!-- トークン入力モーダル -->
  <div class="cz-modal" id="czModal" hidden>
    <div class="cz-modal-card">
      <h2>GitHubアクセストークン</h2>
      <p>保存にはCMSログインと同じGitHubトークン（github_pat_…）が必要です。この端末に記憶されます。</p>
      <input type="password" id="czToken" placeholder="github_pat_..." autocomplete="off" />
      <div class="cz-modal-actions">
        <button class="cz-btn ghost" id="czTokenCancel">キャンセル</button>
        <button class="cz-btn primary" id="czTokenOk">保存を続行</button>
      </div>
    </div>
  </div>

<script define:vars={{ initial }} is:inline>
  // ================= 状態 =================
  const state = JSON.parse(JSON.stringify(initial));
  const frame = document.getElementById('czFrame');
  const statusEl = document.getElementById('czStatus');
  const uid = () => 'b' + Math.random().toString(36).slice(2, 9);
  const fontMap = { Montserrat: 'Montserrat:wght@700;800', Archivo: 'Archivo:wght@700;800', Poppins: 'Poppins:wght@700;800' };
  const openSet = new Set();

  // ================= ブロック定義 =================
  // kind: t=1行 / ta=複数行 / flag=ON,OFF / pct=0〜100 / sel=選択 / img=画像 / strs=文字列リスト / arr=項目リスト
  const DEFS = {
    hero: { name: 'ヒーロー', emoji: '🚀', cat: 'section', desc: '最上部の大見出し＋スマホモック',
      fields: [
        ['eyebrow', 'キャッチ上の帯', 't'], ['catch_line1', 'キャッチ 1行目', 't'], ['catch_line2', 'キャッチ 2行目（マーカー）', 't'], ['catch_line3', 'キャッチ 3行目（空欄可）', 't'],
        ['sub', 'サブコピー', 'ta'], ['cta_primary', '緑ボタン', 't'], ['cta_secondary', '白ボタン', 't'],
        ['badge_line1', '丸バッジ上段', 't'], ['badge_line2', '丸バッジ下段', 't'],
        ['chips', '下部チップ', 'strs', { itemLabel: 'チップ' }],
        ['float_chips', 'スマホ横の数値チップ', 'arr', { itemLabel: 'チップ', itemFields: [['label', 'ラベル', 't'], ['value', '数値', 't']], itemDefault: { label: 'ラベル', value: '+100%' } }],
      ],
      defaults: { eyebrow: '帯コピー', catch_line1: 'キャッチコピー', catch_line2: 'マーカー部分', catch_line3: '', sub: 'サブコピー', cta_primary: '無料相談に申し込む', cta_secondary: 'サービスを見る', badge_line1: '初回相談', badge_line2: '無料', chips: ['チップ1'], float_chips: [] } },
    stats: { name: '実績数値', emoji: '📊', cat: 'section', desc: '数字で見る成果カード',
      fields: [
        ['show_edit_note', '【要編集】注意帯を表示', 'flag'], ['title_before', '見出し・前半', 't'], ['title_marker', '見出し・マーカー', 't'],
        ['items', 'カード', 'arr', { itemLabel: 'カード', itemFields: [['tag', '業種タグ', 't'], ['arrow', '▲を表示', 'flag'], ['number', '数値', 't'], ['unit', '単位', 't'], ['desc', '説明（改行可）', 'ta']], itemDefault: { tag: '業種', arrow: true, number: '2.0', unit: '倍', desc: '説明' } }],
      ],
      defaults: { show_edit_note: false, title_before: '数字で見る、', title_marker: '支援成果', items: [] } },
    problem: { name: 'お悩み', emoji: '😟', cat: 'section', desc: 'チェックリスト＋回答',
      fields: [
        ['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'],
        ['items', 'お悩みリスト', 'strs', { itemLabel: 'お悩み' }],
        ['answer_lead', '回答・マーカー前', 't'], ['answer_marker', '回答・マーカー', 't'], ['answer_tail', '回答・マーカー後', 't'], ['answer_body', '回答・本文', 'ta'],
      ],
      defaults: { en: 'PROBLEM', title_jp: 'こんなお悩みはありませんか？', items: ['お悩み1'], answer_lead: '', answer_marker: '', answer_tail: '', answer_body: '' } },
    ctaBand: { name: 'CTAバナー（緑）', emoji: '🟩', cat: 'section', desc: '中間の相談誘導バナー',
      fields: [['title_before', '見出し・前', 't'], ['title_em', '見出し・強調', 't'], ['title_after', '見出し・後', 't'], ['desc', '説明', 'ta'], ['btn_primary', '緑ボタン', 't'], ['btn_secondary', '白ボタン', 't']],
      defaults: { title_before: '無料相談、', title_em: '受付中', title_after: 'です。', desc: '', btn_primary: '無料相談に申し込む', btn_secondary: 'メールで問い合わせる' } },
    service: { name: '事業内容', emoji: '🛠', cat: 'section', desc: 'サービスカード一覧',
      fields: [
        ['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['lead', 'リード文', 'ta'], ['note', '注釈（※）', 't'],
        ['items', 'サービス', 'arr', { itemLabel: 'サービス', itemFields: [['featured', '主力（横長で大きく表示）', 'flag'], ['badge', 'バッジ', 't'], ['number', '番号ラベル', 't'], ['title', '名称', 't'], ['desc', '説明', 'ta'], ['tags', 'タグ', 'strs', { itemLabel: 'タグ' }]], itemDefault: { featured: false, badge: '', number: 'SERVICE 00', title: '新サービス', desc: '説明', tags: [] } }],
      ],
      defaults: { en: 'SERVICE', title_jp: '事業内容', lead: '', note: '', items: [] } },
    reason: { name: '選ばれる理由', emoji: '💡', cat: 'section', desc: '番号付き理由カード',
      fields: [['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['items', '理由', 'arr', { itemLabel: '理由', itemFields: [['title', '見出し', 't'], ['desc', '説明', 'ta']], itemDefault: { title: '理由', desc: '説明' } }]],
      defaults: { en: 'REASON', title_jp: '選ばれる理由', items: [] } },
    cases: { name: '支援実績（CASE）', emoji: '📈', cat: 'section', desc: 'Before/Afterグラフ付き事例',
      fields: [
        ['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['show_edit_note', '【要編集】注意帯を表示', 'flag'],
        ['items', '事例', 'arr', { itemLabel: '事例', itemFields: [['tag', '業種タグ', 't'], ['title', 'タイトル', 'ta'], ['problem', '課題', 'ta'], ['action', '施策', 'ta'], ['metric_label', '指標名', 't'], ['before', 'Before値', 't'], ['after_number', 'After数値', 't'], ['after_unit', 'After単位', 't'], ['graph_before', 'グラフ左%', 'pct'], ['graph_after', 'グラフ右%', 'pct']], itemDefault: { tag: '業種', title: '事例タイトル', problem: '', action: '', metric_label: '', before: '', after_number: '', after_unit: '', graph_before: 40, graph_after: 90 } }],
      ],
      defaults: { en: 'CASE', title_jp: '支援実績', show_edit_note: false, items: [] } },
    column: { name: 'コラム（最新3件）', emoji: '📰', cat: 'section', desc: '最新記事が自動で並ぶ',
      fields: [['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['lead', 'リード文', 'ta']],
      defaults: { en: 'COLUMN', title_jp: 'コラム', lead: '' } },
    promise: { name: 'お約束', emoji: '🤝', cat: 'section', desc: '○×の約束リスト',
      fields: [
        ['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'],
        ['yes_items', '○できること', 'arr', { itemLabel: '約束', itemFields: [['title', '見出し', 't'], ['desc', '説明', 'ta']], itemDefault: { title: '', desc: '' } }],
        ['no_items', '×できないこと', 'arr', { itemLabel: '項目', itemFields: [['title', '見出し', 't'], ['desc', '説明', 'ta']], itemDefault: { title: '', desc: '' } }],
        ['close_before', '締め・1行目', 't'], ['close_mid', '締め・マーカー前', 't'], ['close_marker', '締め・マーカー', 't'], ['close_after', '締め・マーカー後', 't'],
      ],
      defaults: { en: 'PROMISE', title_jp: 'お約束', yes_items: [], no_items: [], close_before: '', close_mid: '', close_marker: '', close_after: '' } },
    message: { name: '代表挨拶', emoji: '👤', cat: 'section', desc: '写真＋メッセージ',
      fields: [
        ['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['photo', '代表写真', 'img'],
        ['paragraphs', '本文（段落）', 'strs', { itemLabel: '段落', ta: true }],
        ['sign_title', '署名・肩書き', 't'], ['sign_name', '署名・名前', 't'],
      ],
      defaults: { en: 'MESSAGE', title_jp: '代表挨拶', photo: '', paragraphs: ['本文'], sign_title: '', sign_name: '' } },
    faq: { name: 'よくあるご質問', emoji: '❓', cat: 'section', desc: 'アコーディオンQ&A',
      fields: [['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['items', 'Q&A', 'arr', { itemLabel: 'Q&A', itemFields: [['q', '質問', 'ta'], ['a', '回答', 'ta']], itemDefault: { q: '質問', a: '回答' } }]],
      defaults: { en: 'FAQ', title_jp: 'よくあるご質問', items: [] } },
    company: { name: '会社概要', emoji: '🏢', cat: 'section', desc: '会社情報テーブル',
      fields: [['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['name', '会社名', 't'], ['representative', '代表者', 't'], ['address', '所在地', 't'], ['founded', '設立', 't'], ['business', '事業内容', 'strs', { itemLabel: '事業' }]],
      defaults: { en: 'COMPANY', title_jp: '会社概要', name: '', representative: '', address: '', founded: '', business: [] } },
    ctaFinal: { name: '最終CTA（深緑）', emoji: '🌑', cat: 'section', desc: '最下部のお問い合わせ誘導',
      fields: [['en', '英字ラベル', 't'], ['title_line1', '見出し1行目', 't'], ['title_before', '2行目・前', 't'], ['title_em', '2行目・強調', 't'], ['title_after', '2行目・後', 't'], ['desc', '説明（改行可）', 'ta'], ['btn', 'ボタン', 't']],
      defaults: { en: 'CONTACT', title_line1: 'まずは', title_before: '', title_em: '無料相談', title_after: 'から。', desc: '', btn: '無料相談に申し込む' } },
    heading: { name: '見出し', emoji: '🔠', cat: 'part', desc: '見出し2/3/4を1本',
      fields: [['text', 'テキスト', 't'], ['level', '見出しレベル', 'sel', { options: [[2, '見出し2（下線・大）'], [3, '見出し3（緑バー）'], [4, '見出し4（緑文字）']] }], ['align', '配置', 'sel', { options: [['left', '左寄せ'], ['center', '中央']] }]],
      defaults: { text: '見出しテキスト', level: 2, align: 'left' } },
    text: { name: 'テキスト', emoji: '📝', cat: 'part', desc: '本文の段落（太字・マーカー可）',
      fields: [['body', '本文（選択して装飾できます）', 'rich'], ['align', '配置', 'sel', { options: [['left', '左寄せ'], ['center', '中央']] }]],
      defaults: { body: '本文テキスト', align: 'left' } },
    box: { name: 'ボックス', emoji: '🧊', cat: 'part', desc: '枠で囲んだ注目エリア',
      fields: [['style', 'スタイル', 'sel', { options: [['plain', 'ノーマル（薄グレー）'], ['green', 'グリーン（ポイント）'], ['warn', '注意（黄）']] }], ['title', 'タイトル（空欄可）', 't'], ['body', '本文', 'rich']],
      defaults: { style: 'green', title: 'ポイント', body: '本文' } },
    sectionHead: { name: 'セクション見出し', emoji: '🏷', cat: 'part', desc: '英字ラベル＋大見出し（LPと同デザイン）',
      fields: [['en', '英字ラベル（例: COLUMN）', 't'], ['title_jp', '見出し', 't'], ['lead', 'リード文（空欄可）', 'ta'], ['align', '配置', 'sel', { options: [['left', '左寄せ'], ['center', '中央']] }]],
      defaults: { en: 'SECTION', title_jp: '見出しテキスト', lead: '', align: 'left' } },
    capBox: { name: 'キャプションボックス', emoji: '📦', cat: 'deco', desc: '色付きタイトルバー＋本文',
      fields: [['color', 'カラー', 'sel', { options: [['green', 'グリーン'], ['dark', 'ダーク'], ['red', 'レッド'], ['gray', 'グレー']] }], ['title', 'タイトル', 't'], ['body', '本文', 'rich']],
      defaults: { color: 'green', title: 'タイトル', body: '本文' } },
    iconBox: { name: 'アイコンボックス', emoji: '💡', cat: 'deco', desc: 'ポイント・注意・メモ・チェック',
      fields: [['type', '種類', 'sel', { options: [['point', '💡 ポイント（緑）'], ['warn', '⚠️ 注意（赤）'], ['memo', '📝 メモ（グレー）'], ['check', '✅ チェック（緑枠）']] }], ['title', 'タイトル（空欄可）', 't'], ['body', '本文', 'rich']],
      defaults: { type: 'point', title: 'ポイント', body: '本文' } },
    speech: { name: '吹き出し', emoji: '💬', cat: 'deco', desc: '会話風の吹き出し＋顔アイコン',
      fields: [['side', '向き', 'sel', { options: [['left', '左（アイコンが左）'], ['right', '右（アイコンが右）']] }], ['color', '吹き出しの色', 'sel', { options: [['gray', 'グレー'], ['green', 'グリーン']] }], ['avatar', '顔アイコン画像', 'img'], ['name', '名前（空欄可）', 't'], ['body', 'セリフ', 'rich']],
      defaults: { side: 'left', color: 'gray', avatar: '', name: '', body: 'セリフを入力' } },
    list: { name: 'リスト', emoji: '✅', cat: 'deco', desc: 'チェック・番号・矢印リスト',
      fields: [['style', 'スタイル', 'sel', { options: [['check', '✓ チェック'], ['num', '① 番号'], ['arrow', '› 矢印'], ['dot', '・ ドット']] }], ['items', '項目', 'strs', { itemLabel: '項目' }]],
      defaults: { style: 'check', items: ['項目1', '項目2'] } },
    steps: { name: 'ステップ', emoji: '🪜', cat: 'deco', desc: '手順をSTEP形式で表示',
      fields: [['items', 'ステップ', 'arr', { itemLabel: 'STEP', itemFields: [['title', 'タイトル', 't'], ['body', '説明（空欄可）', 'rich']], itemDefault: { title: 'ステップ', body: '' } }]],
      defaults: { items: [{ title: 'お問い合わせ', body: '' }, { title: 'ヒアリング', body: '' }] } },
    accordion: { name: 'アコーディオン', emoji: '🔽', cat: 'deco', desc: 'クリックで開閉するQ&A',
      fields: [['items', '項目', 'arr', { itemLabel: '項目', itemFields: [['q', '見出し（質問）', 't'], ['a', '中身（回答）', 'rich']], itemDefault: { q: '質問', a: '回答' } }]],
      defaults: { items: [{ q: '質問', a: '回答' }] } },
    quote: { name: '引用', emoji: '❝', cat: 'deco', desc: '引用文＋出典',
      fields: [['body', '引用文', 'ta'], ['cite', '出典（空欄可）', 't']],
      defaults: { body: '引用文', cite: '' } },
    cols2: { name: '2カラム', emoji: '🀫', cat: 'deco', desc: '左右2列のボックス',
      fields: [['left_title', '左タイトル（空欄可）', 't'], ['left_body', '左本文', 'rich'], ['right_title', '右タイトル（空欄可）', 't'], ['right_body', '右本文', 'rich']],
      defaults: { left_title: '', left_body: '左の本文', right_title: '', right_body: '右の本文' } },
    postList: { name: '記事リスト', emoji: '📰', cat: 'deco', desc: '最新コラムをカードで表示',
      fields: [['count', '表示件数', 'sel', { options: [[3, '3件'], [6, '6件'], [9, '9件']] }], ['more_label', '一覧ボタンの文言（空欄で非表示）', 't']],
      defaults: { count: 3, more_label: 'コラム一覧を見る' } },
    image: { name: '画像', emoji: '🖼', cat: 'part', desc: '画像＋キャプション',
      fields: [['src', '画像', 'img'], ['alt', '代替テキスト（SEO）', 't'], ['caption', 'キャプション（空欄可）', 't'], ['width', '幅%', 'pct'], ['align', '配置', 'sel', { options: [['left', '左寄せ'], ['center', '中央']] }]],
      defaults: { src: '', alt: '', caption: '', width: 100, align: 'center' } },
    buttons: { name: 'ボタン', emoji: '🔘', cat: 'part', desc: 'CTAボタンの列',
      fields: [['align', '配置', 'sel', { options: [['left', '左寄せ'], ['center', '中央']] }], ['items', 'ボタン', 'arr', { itemLabel: 'ボタン', itemFields: [['label', 'ラベル', 't'], ['url', 'リンク先（consult=相談 / contact=メール / URL）', 't'], ['style', '見た目', 'sel', { options: [['green', '緑'], ['outline', '白枠'], ['dark', '黒']] }]], itemDefault: { label: 'ボタン', url: 'consult', style: 'green' } }]],
      defaults: { align: 'center', items: [{ label: '無料相談に申し込む', url: 'consult', style: 'green' }] } },
    spacer: { name: '余白', emoji: '↕️', cat: 'part', desc: 'ブロック間のスペース',
      fields: [['size', '大きさ', 'sel', { options: [['s', '小（28px）'], ['m', '中（64px）'], ['l', '大（120px）']] }]],
      defaults: { size: 'm' } },
  };

  // ================= フィールド生成 =================
  function makeInput(kind, value, onChange, opts = {}) {
    if (kind === 'flag') {
      const w = document.createElement('label'); w.className = 'cz-flag';
      const i = document.createElement('input'); i.type = 'checkbox'; i.checked = !!value;
      i.addEventListener('input', () => onChange(i.checked));
      w.appendChild(i); w.appendChild(document.createTextNode(opts.label || ''));
      return { el: w, standalone: true };
    }
    let i;
    if (kind === 'ta') { i = document.createElement('textarea'); i.rows = 3; i.value = value ?? ''; }
    else if (kind === 'sel') {
      i = document.createElement('select');
      (opts.options || []).forEach(([v, l]) => { const o = document.createElement('option'); o.value = v; o.textContent = l; i.appendChild(o); });
      i.value = String(value ?? '');
    }
    else if (kind === 'pct') { i = document.createElement('input'); i.type = 'number'; i.min = 0; i.max = 100; i.value = value ?? 100; }
    else { i = document.createElement('input'); i.type = 'text'; i.value = value ?? ''; }
    i.addEventListener('input', () => onChange(kind === 'pct' ? Number(i.value) || 0 : kind === 'sel' && /^\d+$/.test(i.value) ? Number(i.value) : i.value));
    return { el: i };
  }

  function makeImgField(obj, key, onChange) {
    const w = document.createElement('div'); w.className = 'cz-imgfield';
    const thumb = document.createElement('div'); thumb.className = 'cz-imgthumb';
    const setThumb = () => { thumb.style.backgroundImage = obj[key] ? `url("${obj[key]}")` : 'none'; thumb.textContent = obj[key] ? '' : '未設定'; };
    setThumb();
    const btns = document.createElement('div'); btns.className = 'cz-imgbtns';
    const up = document.createElement('button'); up.type = 'button'; up.className = 'cz-mini'; up.textContent = '📁 画像を選ぶ';
    const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'cz-mini danger'; rm.textContent = '削除';
    const file = document.createElement('input'); file.type = 'file'; file.accept = 'image/*'; file.hidden = true;
    up.addEventListener('click', () => file.click());
    file.addEventListener('change', () => {
      const f = file.files[0]; if (!f) return;
      if (f.size > 4 * 1024 * 1024) { alert('4MB以下の画像にしてください'); return; }
      const r = new FileReader();
      r.onload = () => { obj[key] = r.result; setThumb(); onChange(); };
      r.readAsDataURL(f);
    });
    rm.addEventListener('click', () => { obj[key] = ''; setThumb(); onChange(); });
    btns.appendChild(up); btns.appendChild(rm);
    w.appendChild(thumb); w.appendChild(btns);
    return w;
  }

  // ============ リッチテキスト編集（太字・マーカー・文字色・リンク） ============
  // 保存形式は正規形HTML: <strong>/<em>/<mark class="mk-g|mk-y">/<span class="tc-g|tc-r">/<a href>、改行は \n
  const escR = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const richToDom = (s) => escR(s)
    .replace(/&lt;(\/?)(strong|em)&gt;/g, '<$1$2>')
    .replace(/&lt;mark class=&quot;(mk-[gy])&quot;&gt;/g, '<mark class="$1">')
    .replace(/&lt;\/mark&gt;/g, '</mark>')
    .replace(/&lt;span class=&quot;(tc-[gr])&quot;&gt;/g, '<span class="$1">')
    .replace(/&lt;\/span&gt;/g, '</span>')
    .replace(/&lt;a href=&quot;((?:https?:\/\/|\/|#|mailto:)[^\s]*?)&quot;&gt;/g, '<a href="$1">')
    .replace(/&lt;\/a&gt;/g, '</a>')
    .replace(/\n/g, '<br>');
  function serializeRich(node) {
    let out = '';
    node.childNodes.forEach((n) => {
      if (n.nodeType === 3) { out += n.nodeValue.replace(/ /g, ' '); return; }
      if (n.nodeType !== 1) return;
      const tag = n.tagName;
      if (tag === 'BR') { out += '\n'; return; }
      const inner = serializeRich(n);
      if (tag === 'B' || tag === 'STRONG') out += inner ? `<strong>${inner}</strong>` : '';
      else if (tag === 'I' || tag === 'EM') out += inner ? `<em>${inner}</em>` : '';
      else if (tag === 'MARK' && /^mk-[gy]$/.test(n.className)) out += inner ? `<mark class="${n.className}">${inner}</mark>` : '';
      else if (tag === 'SPAN' && /^tc-[gr]$/.test(n.className)) out += inner ? `<span class="${n.className}">${inner}</span>` : '';
      else if (tag === 'A' && /^(https?:\/\/|\/|#|mailto:)/.test(n.getAttribute('href') || '')) out += inner ? `<a href="${n.getAttribute('href')}">${inner}</a>` : '';
      else if (tag === 'DIV' || tag === 'P') out += (out && !out.endsWith('\n') ? '\n' : '') + inner;
      else out += inner;
    });
    return out;
  }
  function wrapSel(ed, tag, cls, href) {
    const sel = window.getSelection();
    if (!sel.rangeCount) return;
    const range = sel.getRangeAt(0);
    if (range.collapsed || !ed.contains(range.commonAncestorContainer)) return;
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    if (href) el.setAttribute('href', href);
    try { range.surroundContents(el); }
    catch (_) { el.appendChild(range.extractContents()); range.insertNode(el); }
    sel.removeAllRanges();
    ed.dispatchEvent(new Event('input'));
  }
  function clearSel(ed) {
    const sel = window.getSelection();
    if (!sel.rangeCount) return;
    const range = sel.getRangeAt(0);
    if (range.collapsed || !ed.contains(range.commonAncestorContainer)) return;
    const txt = range.toString();
    range.deleteContents();
    range.insertNode(document.createTextNode(txt));
    ed.dispatchEvent(new Event('input'));
  }
  function makeRichField(value, onChange) {
    const wrap = document.createElement('div'); wrap.className = 'cz-richwrap';
    const bar = document.createElement('div'); bar.className = 'cz-rt';
    const ed = document.createElement('div'); ed.className = 'cz-rich'; ed.contentEditable = 'true'; ed.spellcheck = false;
    ed.innerHTML = richToDom(value);
    const btn = (html, title, fn) => {
      const b = document.createElement('button'); b.type = 'button'; b.className = 'cz-rtb'; b.innerHTML = html; b.title = title;
      b.addEventListener('mousedown', (e) => e.preventDefault());
      b.addEventListener('click', fn);
      bar.appendChild(b);
    };
    btn('<b>B</b>', '太字', () => wrapSel(ed, 'strong'));
    btn('<mark class="mk-g">マ</mark>', '緑マーカー', () => wrapSel(ed, 'mark', 'mk-g'));
    btn('<mark class="mk-y">マ</mark>', '黄マーカー', () => wrapSel(ed, 'mark', 'mk-y'));
    btn('<span class="tc-g">A</span>', '緑文字', () => wrapSel(ed, 'span', 'tc-g'));
    btn('<span class="tc-r">A</span>', '赤文字', () => wrapSel(ed, 'span', 'tc-r'));
    btn('🔗', 'リンク', () => {
      const u = prompt('リンク先URL（https://… / /blog/ / #service / mailto:）');
      if (u && /^(https?:\/\/|\/|#|mailto:)/.test(u.trim())) wrapSel(ed, 'a', null, u.trim());
      else if (u) alert('URLは https:// か / か # か mailto: で始めてください');
    });
    btn('⌫', '選択部分の装飾を解除', () => clearSel(ed));
    ed.addEventListener('input', () => onChange(serializeRich(ed)));
    ed.addEventListener('paste', (e) => {
      e.preventDefault();
      document.execCommand('insertText', false, (e.clipboardData || window.clipboardData).getData('text/plain'));
    });
    ed.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); document.execCommand('insertLineBreak'); } });
    wrap.appendChild(bar); wrap.appendChild(ed);
    return wrap;
  }

  function buildFields(container, obj, fields, onChange) {
    fields.forEach(([key, label, kind, opts]) => {
      if (kind === 'rich') {
        const lab = document.createElement('label'); lab.textContent = label;
        lab.appendChild(makeRichField(obj[key], (v) => { obj[key] = v; onChange(); }));
        container.appendChild(lab); return;
      }
      if (kind === 'img') {
        const lab = document.createElement('label'); lab.textContent = label;
        lab.appendChild(makeImgField(obj, key, onChange));
        container.appendChild(lab); return;
      }
      if (kind === 'strs') {
        const wrap = document.createElement('div'); wrap.className = 'cz-arr';
        const head = document.createElement('p'); head.className = 'cz-arr-label'; head.textContent = label;
        wrap.appendChild(head);
        const listEl = document.createElement('div');
        const renderList = () => {
          listEl.innerHTML = '';
          (obj[key] || []).forEach((v, idx) => {
            const row = document.createElement('div'); row.className = 'cz-strrow';
            const i = (opts && opts.ta) ? document.createElement('textarea') : document.createElement('input');
            if (opts && opts.ta) i.rows = 3; else i.type = 'text';
            i.value = v;
            i.addEventListener('input', () => { obj[key][idx] = i.value; onChange(); });
            const del = document.createElement('button'); del.type = 'button'; del.className = 'cz-mini danger'; del.textContent = '✕';
            del.title = '削除';
            del.addEventListener('click', () => { obj[key].splice(idx, 1); renderList(); onChange(); });
            row.appendChild(i); row.appendChild(del);
            listEl.appendChild(row);
          });
        };
        renderList();
        const add = document.createElement('button'); add.type = 'button'; add.className = 'cz-mini add'; add.textContent = `＋ ${opts?.itemLabel || '項目'}を追加`;
        add.addEventListener('click', () => { (obj[key] = obj[key] || []).push(''); renderList(); onChange(); });
        wrap.appendChild(listEl); wrap.appendChild(add);
        container.appendChild(wrap); return;
      }
      if (kind === 'arr') {
        const wrap = document.createElement('div'); wrap.className = 'cz-arr';
        const head = document.createElement('p'); head.className = 'cz-arr-label'; head.textContent = label;
        wrap.appendChild(head);
        const listEl = document.createElement('div');
        const renderList = () => {
          listEl.innerHTML = '';
          (obj[key] || []).forEach((item, idx) => {
            const card = document.createElement('div'); card.className = 'cz-itemcard';
            const bar = document.createElement('div'); bar.className = 'cz-itembar';
            bar.innerHTML = `<span>${opts.itemLabel || '項目'} ${idx + 1}</span>`;
            const del = document.createElement('button'); del.type = 'button'; del.className = 'cz-mini danger'; del.textContent = '削除';
            del.addEventListener('click', () => { obj[key].splice(idx, 1); renderList(); onChange(); });
            bar.appendChild(del);
            card.appendChild(bar);
            const inner = document.createElement('div'); inner.className = 'cz-fields tight';
            buildFields(inner, item, opts.itemFields, onChange);
            card.appendChild(inner);
            listEl.appendChild(card);
          });
        };
        renderList();
        const add = document.createElement('button'); add.type = 'button'; add.className = 'cz-mini add'; add.textContent = `＋ ${opts.itemLabel || '項目'}を追加`;
        add.addEventListener('click', () => { (obj[key] = obj[key] || []).push(JSON.parse(JSON.stringify(opts.itemDefault))); renderList(); onChange(); });
        wrap.appendChild(listEl); wrap.appendChild(add);
        container.appendChild(wrap); return;
      }
      if (kind === 'flag') {
        const { el } = makeInput('flag', obj[key], (v) => { obj[key] = v; onChange(); }, { label });
        container.appendChild(el); return;
      }
      const lab = document.createElement('label'); lab.textContent = label;
      const { el } = makeInput(kind, obj[key], (v) => { obj[key] = v; onChange(); }, opts);
      lab.appendChild(el);
      container.appendChild(lab);
    });
  }

  // ================= ブロックリスト =================
  const listEl = document.getElementById('blockList');
  function snippet(b) {
    const p = b.p;
    const first = Array.isArray(p.items) && p.items[0] ? (p.items[0].q || p.items[0].title || p.items[0].label || p.items[0]) : '';
    const s = p.title_jp || p.catch_line1 || p.text || p.title || p.title_before || p.body || p.name || p.title_line1 || p.left_body || first || '';
    return String(s).replace(/<[^>]+>/g, '').slice(0, 22);
  }
  function renderBlocks() {
    listEl.innerHTML = '';
    state.page.blocks.forEach((b, i) => {
      const def = DEFS[b.type] || { name: b.type, emoji: '❔', fields: [] };
      const card = document.createElement('div'); card.className = 'cz-block';
      const head = document.createElement('div'); head.className = 'cz-block-head';
      head.innerHTML = `<span class="cz-block-ico">${def.emoji}</span><span class="cz-block-name">${def.name}</span><span class="cz-block-snip">${snippet(b)}</span>`;
      const ctrl = document.createElement('div'); ctrl.className = 'cz-block-ctrl';
      const mk = (txt, title, fn, cls = '') => { const bt = document.createElement('button'); bt.type = 'button'; bt.className = 'cz-ctrl ' + cls; bt.textContent = txt; bt.title = title; bt.addEventListener('click', (e) => { e.stopPropagation(); fn(); }); return bt; };
      ctrl.appendChild(mk('↑', '上へ', () => move(i, -1)));
      ctrl.appendChild(mk('↓', '下へ', () => move(i, 1)));
      ctrl.appendChild(mk('⧉', '複製', () => dup(i)));
      ctrl.appendChild(mk('＋', 'この下に追加', () => openPicker(i + 1)));
      ctrl.appendChild(mk('🗑', '削除', () => del(i), 'danger'));
      head.appendChild(ctrl);
      head.addEventListener('click', () => {
        if (openSet.has(b.id)) openSet.delete(b.id); else openSet.add(b.id);
        renderBlocks();
        send(i);
      });
      card.appendChild(head);
      if (openSet.has(b.id)) {
        card.classList.add('is-open');
        const body = document.createElement('div'); body.className = 'cz-fields';
        // 全ブロック共通: 文字サイズ倍率（--fs としてブロック全体に適用）
        if (b.p._fs == null) b.p._fs = '1';
        const fieldsWithFs = def.fields.concat([[
          '_fs', '文字サイズ（このブロック全体）', 'sel',
          { options: [['0.9', '小（90%）'], ['1', '標準'], ['1.12', '大（112%）'], ['1.25', '特大（125%）']] },
        ]]);
        buildFields(body, b.p, fieldsWithFs, () => send());
        card.appendChild(body);
      }
      listEl.appendChild(card);
    });
  }
  function move(i, d) {
    const j = i + d; if (j < 0 || j >= state.page.blocks.length) return;
    const [b] = state.page.blocks.splice(i, 1);
    state.page.blocks.splice(j, 0, b);
    renderBlocks(); send(j);
  }
  function dup(i) {
    const c = JSON.parse(JSON.stringify(state.page.blocks[i])); c.id = uid();
    state.page.blocks.splice(i + 1, 0, c);
    renderBlocks(); send(i + 1);
  }
  function del(i) {
    const def = DEFS[state.page.blocks[i].type];
    if (!confirm(`「${def ? def.name : ''}」ブロックを削除しますか？（保存するまで本番には影響しません）`)) return;
    state.page.blocks.splice(i, 1);
    renderBlocks(); send();
  }

  // ================= ピッカー =================
  const picker = document.getElementById('pickerModal');
  let insertAt = null;
  function openPicker(pos) { insertAt = pos; picker.hidden = false; }
  document.getElementById('pickerClose').addEventListener('click', () => { picker.hidden = true; });
  picker.addEventListener('click', (e) => { if (e.target === picker) picker.hidden = true; });
  document.getElementById('addAtEnd').addEventListener('click', () => openPicker(state.page.blocks.length));
  (function buildPicker() {
    const cats = { section: document.getElementById('pickSections'), part: document.getElementById('pickParts'), deco: document.getElementById('pickDeco') };
    Object.entries(DEFS).forEach(([type, def]) => {
      const tile = document.createElement('button'); tile.type = 'button'; tile.className = 'cz-tile';
      tile.innerHTML = `<span class="cz-tile-ico">${def.emoji}</span><span class="cz-tile-name">${def.name}</span><span class="cz-tile-desc">${def.desc}</span>`;
      tile.addEventListener('click', () => {
        const b = { id: uid(), type, p: JSON.parse(JSON.stringify(def.defaults)) };
        state.page.blocks.splice(insertAt ?? state.page.blocks.length, 0, b);
        openSet.add(b.id);
        picker.hidden = true;
        renderBlocks(); send(insertAt ?? state.page.blocks.length - 1);
      });
      (cats[def.cat] || cats.part).appendChild(tile);
    });
  })();

  // ================= タブ =================
  document.querySelectorAll('.cz-tab').forEach((t) => {
    t.addEventListener('click', () => {
      document.querySelectorAll('.cz-tab').forEach((x) => x.classList.remove('is-active'));
      t.classList.add('is-active');
      document.getElementById('pane-blocks').hidden = t.dataset.tab !== 'blocks';
      document.getElementById('pane-design').hidden = t.dataset.tab !== 'design';
    });
