---
/**
 * ブロックエディタ（WordPressのブロックエディタ＋カスタマイザー相当）。
 * ページ＝ブロックの積み重ね。追加・並べ替え・複製・削除・項目の増減・画像挿入が全部ここでできる。
 * 右のプレビュー（/admin/preview/）に即時反映し、「保存して公開」でGitHubへコミット→自動デプロイ。
 */
import page from '../../data/page-home.json';
import theme from '../../data/theme.json';
import settings from '../../data/settings.json';

// 下層ページ（src/data/pages/*.json）。ビルダーの「＋新規ページ」で増える
const subMods = import.meta.glob('../../data/pages/*.json', { eager: true });
const subPages: Record<string, any> = {};
for (const [path, mod] of Object.entries(subMods)) {
  const slug = path.split('/').pop()!.replace('.json', '');
  subPages[slug] = (mod as any).default;
}

const initial = { page, theme, settings, subPages };
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>ページビルダー｜LAYR CMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
</head>
<body class="cz-body">

  <header class="cz-bar">
    <a class="cz-back" href="/admin/">‹ 管理ホーム</a>
    <p class="cz-title">🧱 ページビルダー</p>
    <div class="cz-tabs" role="tablist">
      <button class="cz-tab is-active" data-tab="blocks">ページ構成</button>
      <button class="cz-tab" data-tab="design">デザイン・全体設定</button>
    </div>
    <div class="cz-bar-actions">
      <span class="cz-status" id="czStatus"></span>
      <button class="cz-btn ghost" id="czReset">リセット</button>
      <button class="cz-btn primary" id="czSave">保存して公開</button>
    </div>
  </header>

  <div class="cz-main">
    <aside class="cz-panel">

      <div class="cz-pane" id="pane-blocks">
        <div class="cz-pagebar">
          <select id="pageSel" title="編集するページを切り替え"></select>
          <button class="cz-mini" id="pageAdd" title="新しいページを作る">＋ 新規</button>
          <button class="cz-mini" id="pageSet" title="このページの設定">⚙</button>
        </div>
        <p class="cz-pageurl" id="pageUrl"></p>
        <div class="cz-panel-head">
          <p>ブロックは<b>⠿をドラッグ</b>して並べ替え（↑↓でも可）。クリックで編集、<b>＋</b>で追加。本文は文字を選択して<b>太字・マーカー・文字色・リンク</b>を付けられます。</p>
        </div>
        <div id="blockList"></div>
        <button class="cz-add-main" id="addAtEnd">＋ ブロックを追加</button>
      </div>

      <div class="cz-pane" id="pane-design" hidden>
        <div class="cz-group-static">
          <h3>🎨 テーマ（サイト全体の見た目）</h3>
          <div class="cz-fields">
            <label class="cz-color">メインカラー<input type="color" id="f-accent" /></label>
            <label class="cz-color">メインカラー（濃）<input type="color" id="f-accent_dark" /></label>
            <label class="cz-color">締めの深色<input type="color" id="f-base_black" /></label>
            <label class="cz-color">薄い背景色<input type="color" id="f-bg_tint" /></label>
            <label>角丸の強さ（0〜28） <output id="radiusOut"></output><input type="range" id="f-radius" min="0" max="28" step="1" /></label>
            <label>英字フォント<select id="f-font_en"><option>Montserrat</option><option>Archivo</option><option>Poppins</option></select></label>
          </div>
        </div>
        <div class="cz-group-static">
          <h3>⚙️ 基本設定</h3>
          <div class="cz-fields">
            <label>問い合わせメールアドレス<input type="text" id="f-email" /></label>
            <label>LINE友だち追加URL（空欄ならメールCTA）<input type="text" id="f-line_url" placeholder="https://lin.ee/xxxx" /></label>
            <label>フッターのひとこと（改行可）<textarea id="f-tagline" rows="3"></textarea></label>
          </div>
        </div>
        <div class="cz-group-static">
          <h3>🧩 追加CSS（上級者向け）</h3>
          <div class="cz-fields">
            <p class="cz-hint">WordPressの「追加CSS」相当。サイト全体に適用され、プレビューに即時反映。</p>
            <textarea id="f-custom_css" class="cz-css" rows="14" spellcheck="false" placeholder="/* 例: .hero h1 { letter-spacing: .04em } */"></textarea>
          </div>
        </div>
        <p class="cz-note">記事の執筆・画像ライブラリは <a href="/admin/cms/">編集画面（CMS）</a> から。</p>
      </div>

    </aside>

    <section class="cz-stage">
      <div class="cz-devices">
        <button class="cz-dev is-active" data-w="">🖥 PC</button>
        <button class="cz-dev" data-w="768px">📱 タブレット</button>
        <button class="cz-dev" data-w="390px">📱 スマホ</button>
      </div>
      <div class="cz-frame-wrap"><iframe id="czFrame" src="/admin/preview/" title="サイトプレビュー"></iframe></div>
    </section>
  </div>

  <!-- ブロック追加ピッカー -->
  <div class="cz-modal" id="pickerModal" hidden>
    <div class="cz-modal-card cz-picker">
      <div class="cz-picker-head"><h2>ブロックを追加</h2><button class="cz-x" id="pickerClose">✕</button></div>
      <p class="cz-picker-cat">🔤 基本パーツ（見出し・文章・画像・ボタン）</p>
      <div class="cz-picker-grid" id="pickParts"></div>
      <p class="cz-picker-cat">✨ 装飾パーツ（WPテーマ風の記事装飾）</p>
      <div class="cz-picker-grid" id="pickDeco"></div>
      <p class="cz-picker-cat">📦 完成セクション（デザイン済みの大きな部品）</p>
      <div class="cz-picker-grid" id="pickSections"></div>
    </div>
  </div>

  <!-- 新規ページ作成モーダル -->
  <div class="cz-modal" id="pageModal" hidden>
    <div class="cz-modal-card">
      <h2>新しいページを作る</h2>
      <label class="cz-mlabel">ページ名<input type="text" id="npTitle" placeholder="例: サービス詳細" /></label>
      <label class="cz-mlabel">URL（英小文字・数字・ハイフン）<input type="text" id="npSlug" placeholder="例: service-line" /></label>
      <label class="cz-mlabel">説明（SEO・検索結果に出る文。空欄可）<textarea id="npDesc" rows="2"></textarea></label>
      <p>作成すると layr.co.jp/<b id="npSlugEcho">…</b>/ になります（公開されるのは「保存して公開」後）。</p>
      <div class="cz-modal-actions">
        <button class="cz-btn ghost" id="npCancel">キャンセル</button>
        <button class="cz-btn primary" id="npOk">作成</button>
      </div>
    </div>
  </div>

  <!-- ページ設定モーダル -->
  <div class="cz-modal" id="pageSetModal" hidden>
    <div class="cz-modal-card">
      <h2>ページ設定</h2>
      <div id="psBody"></div>
      <div class="cz-modal-actions">
        <button class="cz-btn danger-ghost" id="psDelete">🗑 このページを削除</button>
        <button class="cz-btn primary" id="psClose">閉じる</button>
      </div>
    </div>
  </div>

  <!-- トークン入力モーダル -->
  <div class="cz-modal" id="czModal" hidden>
    <div class="cz-modal-card">
      <h2>GitHubアクセストークン</h2>
      <p>保存にはCMSログインと同じGitHubトークン（github_pat_…）が必要です。この端末に記憶されます。</p>
      <input type="password" id="czToken" placeholder="github_pat_..." autocomplete="off" />
      <div class="cz-modal-actions">
        <button class="cz-btn ghost" id="czTokenCancel">キャンセル</button>
        <button class="cz-btn primary" id="czTokenOk">保存を続行</button>
      </div>
    </div>
  </div>

<script define:vars={{ initial }} is:inline>
  // ================= 状態 =================
  const state = JSON.parse(JSON.stringify(initial));
  const frame = document.getElementById('czFrame');
  const statusEl = document.getElementById('czStatus');
  const uid = () => 'b' + Math.random().toString(36).slice(2, 9);
  const fontMap = { Montserrat: 'Montserrat:wght@700;800', Archivo: 'Archivo:wght@700;800', Poppins: 'Poppins:wght@700;800' };
  const openSet = new Set();

  // ================= ページ（トップ＋下層） =================
  // home の blocks は state.page.blocks と同じ配列を共有（splice等は全てin-placeなので同期が保たれる）
  const pages = { home: { title: 'トップページ', description: '', blocks: state.page.blocks, fixed: true } };
  Object.entries(state.subPages || {}).forEach(([slug, pg]) => {
    pages[slug] = { title: pg.title || slug, description: pg.description || '', blocks: pg.blocks || [] };
  });
  const deletedPages = new Set();
  const RESERVED = ['home', 'index', 'blog', 'admin', 'document', 'privacy', 'dashboard', 'uploads', 'api', 'assets'];
  let cur = 'home';
  const qp = new URLSearchParams(location.search).get('page');
  if (qp && pages[qp]) cur = qp;
  const curBlocks = () => pages[cur].blocks;

  const pageSel = document.getElementById('pageSel');
  function renderPageBar() {
    pageSel.innerHTML = '';
    Object.entries(pages).forEach(([slug, pg]) => {
      const o = document.createElement('option');
      o.value = slug;
      o.textContent = (slug === 'home' ? '🏠 ' : '📄 ') + pg.title;
      pageSel.appendChild(o);
    });
    pageSel.value = cur;
    document.getElementById('pageUrl').textContent = cur === 'home' ? 'URL: layr.co.jp/' : `URL: layr.co.jp/${cur}/`;
  }
  function switchPage(slug) {
    cur = slug;
    openSet.clear();
    renderPageBar();
    renderBlocks();
    send();
  }
  pageSel.addEventListener('change', () => switchPage(pageSel.value));

  // --- 新規ページ ---
  const pageModal = document.getElementById('pageModal');
  const npSlug = document.getElementById('npSlug');
  npSlug.addEventListener('input', () => { document.getElementById('npSlugEcho').textContent = npSlug.value || '…'; });
  document.getElementById('pageAdd').addEventListener('click', () => {
    document.getElementById('npTitle').value = '';
    npSlug.value = '';
    document.getElementById('npDesc').value = '';
    document.getElementById('npSlugEcho').textContent = '…';
    pageModal.hidden = false;
  });
  document.getElementById('npCancel').addEventListener('click', () => { pageModal.hidden = true; });
  document.getElementById('npOk').addEventListener('click', () => {
    const title = document.getElementById('npTitle').value.trim();
    const slug = npSlug.value.trim().toLowerCase();
    if (!title) { alert('ページ名を入力してください'); return; }
    if (!/^[a-z0-9][a-z0-9-]{0,39}$/.test(slug)) { alert('URLは英小文字・数字・ハイフンで入力してください（例: service-line）'); return; }
    if (RESERVED.includes(slug)) { alert(`「${slug}」はシステムで使用中のため使えません`); return; }
    if (pages[slug]) { alert('そのURLのページは既にあります'); return; }
    pages[slug] = {
      title,
      description: document.getElementById('npDesc').value.trim(),
      blocks: [
        { id: uid(), type: 'sectionHead', p: { en: 'PAGE', title_jp: title, lead: '', align: 'left' } },
        { id: uid(), type: 'text', p: { body: 'ここに本文を書きます。「＋ ブロックを追加」で自由に組み立ててください。', align: 'left' } },
      ],
    };
    deletedPages.delete(slug);
    pageModal.hidden = true;
    switchPage(slug);
  });

  // --- ページ設定・削除 ---
  const pageSetModal = document.getElementById('pageSetModal');
  document.getElementById('pageSet').addEventListener('click', () => {
    const pg = pages[cur];
    const body = document.getElementById('psBody');
    body.innerHTML = '';
    if (pg.fixed) {
      body.innerHTML = '<p>トップページのタイトル・説明文はSEO最適化済みの固定設定です（変更したい時はレイに指示）。</p>';
    } else {
      const mk = (label, value, key, ta) => {
        const lab = document.createElement('label'); lab.className = 'cz-mlabel'; lab.textContent = label;
        const i = document.createElement(ta ? 'textarea' : 'input');
        if (ta) i.rows = 2; else i.type = 'text';
        i.value = value;
        i.addEventListener('input', () => { pg[key] = i.value; if (key === 'title') renderPageBar(); });
        lab.appendChild(i); body.appendChild(lab);
      };
      mk('ページ名', pg.title, 'title');
      mk('説明（SEO）', pg.description, 'description', true);
      const p = document.createElement('p'); p.innerHTML = `URL: <b>layr.co.jp/${cur}/</b>（URLの変更は作り直しで対応）`;
      body.appendChild(p);
    }
    document.getElementById('psDelete').style.display = pg.fixed ? 'none' : '';
    pageSetModal.hidden = false;
  });
  document.getElementById('psClose').addEventListener('click', () => { pageSetModal.hidden = true; });
  document.getElementById('psDelete').addEventListener('click', () => {
    if (!confirm(`ページ「${pages[cur].title}」（/${cur}/）を削除しますか？\n「保存して公開」した時点で本番からも消えます。`)) return;
    deletedPages.add(cur);
    delete pages[cur];
    pageSetModal.hidden = true;
    switchPage('home');
  });

  // ================= ブロック定義 =================
  // kind: t=1行 / ta=複数行 / flag=ON,OFF / pct=0〜100 / sel=選択 / img=画像 / strs=文字列リスト / arr=項目リスト
  const DEFS = {
    hero: { name: 'ヒーロー', emoji: '🚀', cat: 'section', desc: '最上部の大見出し＋スマホモック',
      fields: [
        ['eyebrow', 'キャッチ上の帯', 't'], ['catch_line1', 'キャッチ 1行目', 't'], ['catch_line2', 'キャッチ 2行目（マーカー）', 't'], ['catch_line3', 'キャッチ 3行目（空欄可）', 't'],
        ['sub', 'サブコピー', 'ta'], ['cta_primary', '緑ボタン', 't'], ['cta_secondary', '白ボタン', 't'],
        ['badge_line1', '丸バッジ上段', 't'], ['badge_line2', '丸バッジ下段', 't'],
        ['chips', '下部チップ', 'strs', { itemLabel: 'チップ' }],
        ['float_chips', 'スマホ横の数値チップ', 'arr', { itemLabel: 'チップ', itemFields: [['label', 'ラベル', 't'], ['value', '数値', 't']], itemDefault: { label: 'ラベル', value: '+100%' } }],
      ],
      defaults: { eyebrow: '帯コピー', catch_line1: 'キャッチコピー', catch_line2: 'マーカー部分', catch_line3: '', sub: 'サブコピー', cta_primary: '無料相談に申し込む', cta_secondary: 'サービスを見る', badge_line1: '初回相談', badge_line2: '無料', chips: ['チップ1'], float_chips: [] } },
    heroText: { name: 'ヒーロー（画像なし）', emoji: '✍️', cat: 'section', desc: 'テキストだけの静かなファーストビュー',
      fields: [
        ['eyebrow', '小さな上帯（空欄可）', 't'], ['line1', '見出し 1行目', 't'], ['line2', '見出し 2行目（空欄可）', 't'],
        ['marker', '2行目にマーカーを引く', 'flag'], ['line3', '見出し 3行目（空欄可）', 't'],
        ['sub', 'サブコピー', 'rich'],
        ['cta_primary', '緑ボタン（空欄で非表示）', 't'], ['cta_secondary', '白ボタン（空欄で非表示）', 't'], ['cta_secondary_url', '白ボタンのリンク先', 't'],
        ['scene', '3Dイラストの3シーン（店舗→スマホ→賑わう店）を表示', 'flag'],
        ['points', '下の要点リスト', 'strs', { itemLabel: '要点' }],
        ['badge_top', '円バッジ・上段（空欄で非表示）', 't'], ['badge_num', '円バッジ・数値', 't'], ['badge_unit', '円バッジ・単位', 't'],
      ],
      defaults: { eyebrow: '', line1: '見出し1行目', line2: '見出し2行目', marker: true, line3: '', sub: 'サブコピー', cta_primary: '無料相談に申し込む', cta_secondary: 'サービスを見る', cta_secondary_url: '#service', scene: false, points: [], badge_top: '', badge_num: '', badge_unit: '' } },
    pricing: { name: '料金', emoji: '💰', cat: 'section', desc: '料金プランのカード',
      fields: [
        ['items', 'プラン', 'arr', { itemLabel: 'プラン', itemFields: [['featured', '目立たせる', 'flag'], ['tag', '小ラベル', 't'], ['name', 'プラン名', 't'], ['amount', '金額', 't'], ['unit', '単位（円〜 など）', 't'], ['note', '補足', 't'], ['items', '含まれるもの', 'strs', { itemLabel: '項目' }]], itemDefault: { featured: false, tag: '', name: 'プラン名', amount: '00', unit: '万円〜', note: '', items: [] } }],
        ['note', '注釈（※）', 'ta'],
      ],
      defaults: { items: [], note: '' } },
    stats: { name: '実績数値', emoji: '📊', cat: 'section', desc: '数字で見る成果カード',
      fields: [
        ['show_edit_note', '【要編集】注意帯を表示', 'flag'], ['title_before', '見出し・前半', 't'], ['title_marker', '見出し・マーカー', 't'],
        ['items', 'カード', 'arr', { itemLabel: 'カード', itemFields: [['tag', '業種タグ', 't'], ['arrow', '▲を表示', 'flag'], ['number', '数値', 't'], ['unit', '単位', 't'], ['desc', '説明（改行可）', 'ta']], itemDefault: { tag: '業種', arrow: true, number: '2.0', unit: '倍', desc: '説明' } }],
      ],
      defaults: { show_edit_note: false, title_before: '数字で見る、', title_marker: '支援成果', items: [] } },
    problem: { name: 'お悩み', emoji: '😟', cat: 'section', desc: 'チェックリスト＋回答',
      fields: [
        ['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'],
        ['items', 'お悩みリスト', 'strs', { itemLabel: 'お悩み' }],
        ['answer_lead', '回答・マーカー前', 't'], ['answer_marker', '回答・マーカー', 't'], ['answer_tail', '回答・マーカー後', 't'], ['answer_body', '回答・本文', 'ta'],
      ],
      defaults: { en: 'PROBLEM', title_jp: 'こんなお悩みはありませんか？', items: ['お悩み1'], answer_lead: '', answer_marker: '', answer_tail: '', answer_body: '' } },
    ctaBand: { name: 'CTAバナー（緑）', emoji: '🟩', cat: 'section', desc: '中間の相談誘導バナー',
      fields: [['title_before', '見出し・前', 't'], ['title_em', '見出し・強調', 't'], ['title_after', '見出し・後', 't'], ['desc', '説明', 'ta'], ['btn_primary', '緑ボタン', 't'], ['btn_secondary', '白ボタン', 't']],
      defaults: { title_before: '無料相談、', title_em: '受付中', title_after: 'です。', desc: '', btn_primary: '無料相談に申し込む', btn_secondary: 'メールで問い合わせる' } },
    marquee: { name: '流れる帯', emoji: '🎞', cat: 'section', desc: '緑の帯を短いコピーが横に流れ続ける',
      fields: [
        ['items', '流すコピー', 'strs', { itemLabel: 'コピー' }],
        ['speed', '一周の秒数（既定28）', 't'],
      ],
      defaults: { items: ['コピー1', 'コピー2', 'コピー3'], speed: 28 } },
    service: { name: '事業内容', emoji: '🛠', cat: 'section', desc: 'サービスカード一覧',
      fields: [
        ['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['lead', 'リード文', 'ta'], ['note', '注釈（※）', 't'],
        ['items', 'サービス', 'arr', { itemLabel: 'サービス', itemFields: [['featured', '主力（横長で大きく表示）', 'flag'], ['badge', 'バッジ', 't'], ['number', '番号ラベル', 't'], ['title', '名称', 't'], ['desc', '説明', 'ta'], ['tags', 'タグ', 'strs', { itemLabel: 'タグ' }]], itemDefault: { featured: false, badge: '', number: 'SERVICE 00', title: '新サービス', desc: '説明', tags: [] } }],
      ],
      defaults: { en: 'SERVICE', title_jp: '事業内容', lead: '', note: '', items: [] } },
    reason: { name: '選ばれる理由', emoji: '💡', cat: 'section', desc: '番号付き理由カード',
      fields: [['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['items', '理由', 'arr', { itemLabel: '理由', itemFields: [['title', '見出し', 't'], ['desc', '説明', 'ta']], itemDefault: { title: '理由', desc: '説明' } }]],
      defaults: { en: 'REASON', title_jp: '選ばれる理由', items: [] } },
    cases: { name: '支援実績（CASE）', emoji: '📈', cat: 'section', desc: 'Before/Afterグラフ付き事例',
      fields: [
        ['en', '英字ラベル', 't'], ['title_jp', '見出し', 't'], ['show_edit_note', '【要編集】注意帯を表示', 'flag'],
        ['items', '事例', 'arr', { itemLabel: '事例', itemFields: [['tag', '業種タグ', 't'], ['title', 'タイトル', 'ta'], ['problem', '課題', 'ta'], ['action', '施策', 'ta'], ['metric_label', '指標名', 't'], ['before', 'Before値', 't'], ['after_number', 'After数値', 't'], ['after_unit', 'After単位', 't'], ['graph_before', 'グラフ左%', 'pct'], ['graph_after', 'グラフ右%', 'pct']], itemDefault: { tag: '業種', title: '事例タイトル', problem: '', action: '', metric_label: '', before: '', after_number: '', after_unit: '', graph_before: 40, graph_after: 90 } }],
      ],
      defaults: { en: 'CASE', title_jp: '支援実績', show_edit_note: false, items: [] } },
