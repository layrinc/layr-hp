  // ================= フィールド生成 =================
  function makeInput(kind, value, onChange, opts = {}) {
    if (kind === 'flag') {
      const w = document.createElement('label'); w.className = 'cz-flag';
      const i = document.createElement('input'); i.type = 'checkbox'; i.checked = !!value;
      i.addEventListener('input', () => onChange(i.checked));
      w.appendChild(i); w.appendChild(document.createTextNode(opts.label || ''));
      return { el: w, standalone: true };
    }
    let i;
    if (kind === 'ta') { i = document.createElement('textarea'); i.rows = 3; i.value = value ?? ''; }
    else if (kind === 'sel') {
      i = document.createElement('select');
      (opts.options || []).forEach(([v, l]) => { const o = document.createElement('option'); o.value = v; o.textContent = l; i.appendChild(o); });
      i.value = String(value ?? '');
    }
    else if (kind === 'pct') { i = document.createElement('input'); i.type = 'number'; i.min = 0; i.max = 100; i.value = value ?? 100; }
    else { i = document.createElement('input'); i.type = 'text'; i.value = value ?? ''; }
    i.addEventListener('input', () => onChange(kind === 'pct' ? Number(i.value) || 0 : kind === 'sel' && /^\d+$/.test(i.value) ? Number(i.value) : i.value));
    return { el: i };
  }

  function makeImgField(obj, key, onChange) {
    const w = document.createElement('div'); w.className = 'cz-imgfield';
    const thumb = document.createElement('div'); thumb.className = 'cz-imgthumb';
    const setThumb = () => { thumb.style.backgroundImage = obj[key] ? `url("${obj[key]}")` : 'none'; thumb.textContent = obj[key] ? '' : '未設定'; };
    setThumb();
    const btns = document.createElement('div'); btns.className = 'cz-imgbtns';
    const up = document.createElement('button'); up.type = 'button'; up.className = 'cz-mini'; up.textContent = '📁 画像を選ぶ';
    const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'cz-mini danger'; rm.textContent = '削除';
    const file = document.createElement('input'); file.type = 'file'; file.accept = 'image/*'; file.hidden = true;
    up.addEventListener('click', () => file.click());
    file.addEventListener('change', () => {
      const f = file.files[0]; if (!f) return;
      if (f.size > 4 * 1024 * 1024) { alert('4MB以下の画像にしてください'); return; }
      const r = new FileReader();
      r.onload = () => { obj[key] = r.result; setThumb(); onChange(); };
      r.readAsDataURL(f);
    });
    rm.addEventListener('click', () => { obj[key] = ''; setThumb(); onChange(); });
    btns.appendChild(up); btns.appendChild(rm);
    w.appendChild(thumb); w.appendChild(btns);
    return w;
  }

  // ============ リッチテキスト編集（太字・マーカー・文字色・リンク） ============
  // 保存形式は正規形HTML: <strong>/<em>/<mark class="mk-g|mk-y">/<span class="tc-g|tc-r">/<a href>、改行は \n
  const escR = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const richToDom = (s) => escR(s)
    .replace(/&lt;(\/?)(strong|em)&gt;/g, '<$1$2>')
    .replace(/&lt;mark class=&quot;(mk-[gy])&quot;&gt;/g, '<mark class="$1">')
    .replace(/&lt;\/mark&gt;/g, '</mark>')
    .replace(/&lt;span class=&quot;(tc-[gr])&quot;&gt;/g, '<span class="$1">')
    .replace(/&lt;\/span&gt;/g, '</span>')
    .replace(/&lt;a href=&quot;((?:https?:\/\/|\/|#|mailto:)[^\s]*?)&quot;&gt;/g, '<a href="$1">')
    .replace(/&lt;\/a&gt;/g, '</a>')
    .replace(/\n/g, '<br>');
  function serializeRich(node) {
    let out = '';
    node.childNodes.forEach((n) => {
      if (n.nodeType === 3) { out += n.nodeValue.replace(/ /g, ' '); return; }
      if (n.nodeType !== 1) return;
      const tag = n.tagName;
      if (tag === 'BR') { out += '\n'; return; }
      const inner = serializeRich(n);
      if (tag === 'B' || tag === 'STRONG') out += inner ? `<strong>${inner}</strong>` : '';
      else if (tag === 'I' || tag === 'EM') out += inner ? `<em>${inner}</em>` : '';
      else if (tag === 'MARK' && /^mk-[gy]$/.test(n.className)) out += inner ? `<mark class="${n.className}">${inner}</mark>` : '';
      else if (tag === 'SPAN' && /^tc-[gr]$/.test(n.className)) out += inner ? `<span class="${n.className}">${inner}</span>` : '';
      else if (tag === 'A' && /^(https?:\/\/|\/|#|mailto:)/.test(n.getAttribute('href') || '')) out += inner ? `<a href="${n.getAttribute('href')}">${inner}</a>` : '';
      else if (tag === 'DIV' || tag === 'P') out += (out && !out.endsWith('\n') ? '\n' : '') + inner;
      else out += inner;
    });
    return out;
  }
  function wrapSel(ed, tag, cls, href) {
    const sel = window.getSelection();
    if (!sel.rangeCount) return;
    const range = sel.getRangeAt(0);
    if (range.collapsed || !ed.contains(range.commonAncestorContainer)) return;
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    if (href) el.setAttribute('href', href);
    try { range.surroundContents(el); }
    catch (_) { el.appendChild(range.extractContents()); range.insertNode(el); }
    sel.removeAllRanges();
    ed.dispatchEvent(new Event('input'));
  }
  function clearSel(ed) {
    const sel = window.getSelection();
    if (!sel.rangeCount) return;
    const range = sel.getRangeAt(0);
    if (range.collapsed || !ed.contains(range.commonAncestorContainer)) return;
    const txt = range.toString();
    range.deleteContents();
    range.insertNode(document.createTextNode(txt));
    ed.dispatchEvent(new Event('input'));
  }
  function makeRichField(value, onChange) {
    const wrap = document.createElement('div'); wrap.className = 'cz-richwrap';
    const bar = document.createElement('div'); bar.className = 'cz-rt';
    const ed = document.createElement('div'); ed.className = 'cz-rich'; ed.contentEditable = 'true'; ed.spellcheck = false;
    ed.innerHTML = richToDom(value);
    const btn = (html, title, fn) => {
      const b = document.createElement('button'); b.type = 'button'; b.className = 'cz-rtb'; b.innerHTML = html; b.title = title;
      b.addEventListener('mousedown', (e) => e.preventDefault());
      b.addEventListener('click', fn);
      bar.appendChild(b);
    };
    btn('<b>B</b>', '太字', () => wrapSel(ed, 'strong'));
    btn('<mark class="mk-g">マ</mark>', '緑マーカー', () => wrapSel(ed, 'mark', 'mk-g'));
    btn('<mark class="mk-y">マ</mark>', '黄マーカー', () => wrapSel(ed, 'mark', 'mk-y'));
    btn('<span class="tc-g">A</span>', '緑文字', () => wrapSel(ed, 'span', 'tc-g'));
    btn('<span class="tc-r">A</span>', '赤文字', () => wrapSel(ed, 'span', 'tc-r'));
    btn('🔗', 'リンク', () => {
      const u = prompt('リンク先URL（https://… / /blog/ / #service / mailto:）');
      if (u && /^(https?:\/\/|\/|#|mailto:)/.test(u.trim())) wrapSel(ed, 'a', null, u.trim());
      else if (u) alert('URLは https:// か / か # か mailto: で始めてください');
    });
    btn('⌫', '選択部分の装飾を解除', () => clearSel(ed));
    ed.addEventListener('input', () => onChange(serializeRich(ed)));
    ed.addEventListener('paste', (e) => {
      e.preventDefault();
      document.execCommand('insertText', false, (e.clipboardData || window.clipboardData).getData('text/plain'));
    });
    ed.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); document.execCommand('insertLineBreak'); } });
    wrap.appendChild(bar); wrap.appendChild(ed);
    return wrap;
  }

  // 複数画像フィールド（ギャラリー用）: サムネイル一覧＋まとめてアップロード
  function makeImgsField(obj, key, onChange) {
    const wrap = document.createElement('div'); wrap.className = 'cz-imgs';
    const grid = document.createElement('div'); grid.className = 'cz-imgs-grid';
    const renderGrid = () => {
      grid.innerHTML = '';
      (obj[key] = obj[key] || []).forEach((item, idx) => {
        const cell = document.createElement('div'); cell.className = 'cz-imgs-cell';
        const th = document.createElement('div'); th.className = 'cz-imgs-thumb';
        th.style.backgroundImage = item.src ? `url("${item.src}")` : 'none';
        const del = document.createElement('button'); del.type = 'button'; del.className = 'cz-imgs-x'; del.textContent = '✕'; del.title = 'この写真を外す';
        del.addEventListener('click', () => { obj[key].splice(idx, 1); renderGrid(); onChange(); });
        const cap = document.createElement('input'); cap.type = 'text'; cap.placeholder = 'キャプション'; cap.value = item.cap || '';
        cap.addEventListener('input', () => { item.cap = cap.value; onChange(); });
        th.appendChild(del);
        cell.appendChild(th); cell.appendChild(cap);
        grid.appendChild(cell);
      });
    };
    renderGrid();
    const add = document.createElement('button'); add.type = 'button'; add.className = 'cz-mini add'; add.textContent = '📁 写真を追加（複数選択OK）';
    const file = document.createElement('input'); file.type = 'file'; file.accept = 'image/*'; file.multiple = true; file.hidden = true;
    add.addEventListener('click', () => file.click());
    file.addEventListener('change', () => {
      const files = [...file.files].slice(0, 12);
      let pending = files.length;
      if (!pending) return;
      files.forEach((f) => {
        if (f.size > 4 * 1024 * 1024) { alert(`${f.name} は4MB超のためスキップしました`); if (--pending === 0) { renderGrid(); onChange(); } return; }
        const r = new FileReader();
        r.onload = () => { obj[key].push({ src: r.result, cap: '' }); if (--pending === 0) { renderGrid(); onChange(); } };
        r.readAsDataURL(f);
      });
      file.value = '';
    });
    wrap.appendChild(grid); wrap.appendChild(add); wrap.appendChild(file);
    return wrap;
  }

  function buildFields(container, obj, fields, onChange) {
    fields.forEach(([key, label, kind, opts]) => {
      if (kind === 'imgs') {
        const head = document.createElement('p'); head.className = 'cz-arr-label'; head.textContent = label;
        container.appendChild(head);
        container.appendChild(makeImgsField(obj, key, onChange));
        return;
      }
      if (kind === 'rich') {
        const lab = document.createElement('label'); lab.textContent = label;
        lab.appendChild(makeRichField(obj[key], (v) => { obj[key] = v; onChange(); }));
        container.appendChild(lab); return;
      }
      if (kind === 'img') {
        const lab = document.createElement('label'); lab.textContent = label;
        lab.appendChild(makeImgField(obj, key, onChange));
        container.appendChild(lab); return;
      }
      if (kind === 'strs') {
        const wrap = document.createElement('div'); wrap.className = 'cz-arr';
        const head = document.createElement('p'); head.className = 'cz-arr-label'; head.textContent = label;
        wrap.appendChild(head);
        const listEl = document.createElement('div');
        const renderList = () => {
          listEl.innerHTML = '';
          (obj[key] || []).forEach((v, idx) => {
            const row = document.createElement('div'); row.className = 'cz-strrow';
            const i = (opts && opts.ta) ? document.createElement('textarea') : document.createElement('input');
            if (opts && opts.ta) i.rows = 3; else i.type = 'text';
            i.value = v;
            i.addEventListener('input', () => { obj[key][idx] = i.value; onChange(); });
            const del = document.createElement('button'); del.type = 'button'; del.className = 'cz-mini danger'; del.textContent = '✕';
            del.title = '削除';
            del.addEventListener('click', () => { obj[key].splice(idx, 1); renderList(); onChange(); });
            row.appendChild(i); row.appendChild(del);
            listEl.appendChild(row);
          });
        };
        renderList();
        const add = document.createElement('button'); add.type = 'button'; add.className = 'cz-mini add'; add.textContent = `＋ ${opts?.itemLabel || '項目'}を追加`;
        add.addEventListener('click', () => { (obj[key] = obj[key] || []).push(''); renderList(); onChange(); });
        wrap.appendChild(listEl); wrap.appendChild(add);
        container.appendChild(wrap); return;
      }
      if (kind === 'arr') {
        const wrap = document.createElement('div'); wrap.className = 'cz-arr';
        const head = document.createElement('p'); head.className = 'cz-arr-label'; head.textContent = label;
        wrap.appendChild(head);
        const listEl = document.createElement('div');
        const renderList = () => {
          listEl.innerHTML = '';
          (obj[key] || []).forEach((item, idx) => {
            const card = document.createElement('div'); card.className = 'cz-itemcard';
            const bar = document.createElement('div'); bar.className = 'cz-itembar';
            bar.innerHTML = `<span>${opts.itemLabel || '項目'} ${idx + 1}</span>`;
            const del = document.createElement('button'); del.type = 'button'; del.className = 'cz-mini danger'; del.textContent = '削除';
            del.addEventListener('click', () => { obj[key].splice(idx, 1); renderList(); onChange(); });
            bar.appendChild(del);
            card.appendChild(bar);
            const inner = document.createElement('div'); inner.className = 'cz-fields tight';
            buildFields(inner, item, opts.itemFields, onChange);
            card.appendChild(inner);
            listEl.appendChild(card);
          });
        };
        renderList();
        const add = document.createElement('button'); add.type = 'button'; add.className = 'cz-mini add'; add.textContent = `＋ ${opts.itemLabel || '項目'}を追加`;
        add.addEventListener('click', () => { (obj[key] = obj[key] || []).push(JSON.parse(JSON.stringify(opts.itemDefault))); renderList(); onChange(); });
        wrap.appendChild(listEl); wrap.appendChild(add);
        container.appendChild(wrap); return;
      }
      if (kind === 'flag') {
        const { el } = makeInput('flag', obj[key], (v) => { obj[key] = v; onChange(); }, { label });
        container.appendChild(el); return;
      }
      const lab = document.createElement('label'); lab.textContent = label;
      const { el } = makeInput(kind, obj[key], (v) => { obj[key] = v; onChange(); }, opts);
      lab.appendChild(el);
      container.appendChild(lab);
    });
  }

  // ================= ブロックリスト =================
  const listEl = document.getElementById('blockList');
  function snippet(b) {
    const p = b.p;
    const first = Array.isArray(p.items) && p.items[0] ? (p.items[0].q || p.items[0].title || p.items[0].label || p.items[0]) : '';
    const s = p.title_jp || p.catch_line1 || p.text || p.title || p.title_before || p.body || p.name || p.title_line1 || p.left_body || first || '';
    return String(s).replace(/<[^>]+>/g, '').slice(0, 22);
  }
  let dragIdx = null;
  function renderBlocks() {
    listEl.innerHTML = '';
    curBlocks().forEach((b, i) => {
      const def = DEFS[b.type] || { name: b.type, emoji: '❔', fields: [] };
      const card = document.createElement('div'); card.className = 'cz-block';
      const head = document.createElement('div'); head.className = 'cz-block-head';
      head.innerHTML = `<span class="cz-drag" title="ドラッグで並べ替え">⠿</span><span class="cz-block-ico">${def.emoji}</span><span class="cz-block-name">${def.name}</span><span class="cz-block-snip">${snippet(b)}</span>`;
      const ctrl = document.createElement('div'); ctrl.className = 'cz-block-ctrl';
      const mk = (txt, title, fn, cls = '') => { const bt = document.createElement('button'); bt.type = 'button'; bt.className = 'cz-ctrl ' + cls; bt.textContent = txt; bt.title = title; bt.addEventListener('click', (e) => { e.stopPropagation(); fn(); }); return bt; };
      ctrl.appendChild(mk('↑', '上へ', () => move(i, -1)));
      ctrl.appendChild(mk('↓', '下へ', () => move(i, 1)));
      ctrl.appendChild(mk('⧉', '複製', () => dup(i)));
      ctrl.appendChild(mk('＋', 'この下に追加', () => openPicker(i + 1)));
      ctrl.appendChild(mk('🗑', '削除', () => del(i), 'danger'));
      head.appendChild(ctrl);
      head.addEventListener('click', () => {
        if (openSet.has(b.id)) openSet.delete(b.id); else openSet.add(b.id);
        renderBlocks();
        send(i);
      });
      // ---- ドラッグ&ドロップ並べ替え（ヘッダー行が持ち手） ----
      head.draggable = true;
      head.addEventListener('dragstart', (e) => {
        dragIdx = i;
        card.classList.add('is-dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', String(i));
      });
      head.addEventListener('dragend', () => {
        dragIdx = null;
        listEl.querySelectorAll('.cz-block').forEach((c) => c.classList.remove('is-dragging', 'drop-above', 'drop-below'));
      });
      card.addEventListener('dragover', (e) => {
        if (dragIdx === null || dragIdx === i) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        const r = card.getBoundingClientRect();
        const above = e.clientY < r.top + r.height / 2;
        card.classList.toggle('drop-above', above);
        card.classList.toggle('drop-below', !above);
      });
      card.addEventListener('dragleave', () => card.classList.remove('drop-above', 'drop-below'));
      card.addEventListener('drop', (e) => {
        if (dragIdx === null || dragIdx === i) return;
        e.preventDefault();
        const r = card.getBoundingClientRect();
        const above = e.clientY < r.top + r.height / 2;
        let to = above ? i : i + 1;
        if (dragIdx < to) to -= 1;
        const arr = curBlocks();
        const [moved] = arr.splice(dragIdx, 1);
        arr.splice(to, 0, moved);
        dragIdx = null;
        renderBlocks(); send(to);
      });
      card.appendChild(head);
      if (openSet.has(b.id)) {
        card.classList.add('is-open');
        const body = document.createElement('div'); body.className = 'cz-fields';
        // 全ブロック共通: 文字サイズ倍率（--fs としてブロック全体に適用）
        if (b.p._fs == null) b.p._fs = '1';
        const fieldsWithFs = def.fields.concat([[
          '_fs', '文字サイズ（このブロック全体）', 'sel',
          { options: [['0.9', '小（90%）'], ['1', '標準'], ['1.12', '大（112%）'], ['1.25', '特大（125%）']] },
        ]]);
        buildFields(body, b.p, fieldsWithFs, () => send());
        card.appendChild(body);
      }
      listEl.appendChild(card);
    });
  }
  function move(i, d) {
    const arr = curBlocks();
    const j = i + d; if (j < 0 || j >= arr.length) return;
    const [b] = arr.splice(i, 1);
    arr.splice(j, 0, b);
    renderBlocks(); send(j);
  }
  function dup(i) {
    const arr = curBlocks();
    const c = JSON.parse(JSON.stringify(arr[i])); c.id = uid();
    arr.splice(i + 1, 0, c);
    renderBlocks(); send(i + 1);
  }
  function del(i) {
    const arr = curBlocks();
    const def = DEFS[arr[i].type];
    if (!confirm(`「${def ? def.name : ''}」ブロックを削除しますか？（保存するまで本番には影響しません）`)) return;
    arr.splice(i, 1);
    renderBlocks(); send();
  }

  // ================= ピッカー =================
  const picker = document.getElementById('pickerModal');
  let insertAt = null;
  function openPicker(pos) { insertAt = pos; picker.hidden = false; }
  document.getElementById('pickerClose').addEventListener('click', () => { picker.hidden = true; });
  picker.addEventListener('click', (e) => { if (e.target === picker) picker.hidden = true; });
  document.getElementById('addAtEnd').addEventListener('click', () => openPicker(curBlocks().length));
  (function buildPicker() {
    const cats = { section: document.getElementById('pickSections'), part: document.getElementById('pickParts'), deco: document.getElementById('pickDeco') };
    Object.entries(DEFS).forEach(([type, def]) => {
      const tile = document.createElement('button'); tile.type = 'button'; tile.className = 'cz-tile';
      tile.innerHTML = `<span class="cz-tile-ico">${def.emoji}</span><span class="cz-tile-name">${def.name}</span><span class="cz-tile-desc">${def.desc}</span>`;
      tile.addEventListener('click', () => {
        const b = { id: uid(), type, p: JSON.parse(JSON.stringify(def.defaults)) };
        const arr = curBlocks();
        arr.splice(insertAt ?? arr.length, 0, b);
        openSet.add(b.id);
        picker.hidden = true;
        renderBlocks(); send(insertAt ?? arr.length - 1);
      });
      (cats[def.cat] || cats.part).appendChild(tile);
    });
  })();

  // ================= タブ =================
  document.querySelectorAll('.cz-tab').forEach((t) => {
    t.addEventListener('click', () => {
      document.querySelectorAll('.cz-tab').forEach((x) => x.classList.remove('is-active'));
      t.classList.add('is-active');
      document.getElementById('pane-blocks').hidden = t.dataset.tab !== 'blocks';
      document.getElementById('pane-design').hidden = t.dataset.tab !== 'design';
    });
  });

  // ================= デザイン・基本設定 =================
  const $ = (id) => document.getElementById(id);
  ['accent', 'accent_dark', 'base_black', 'bg_tint'].forEach((k) => { $('f-' + k).value = state.theme[k]; $('f-' + k).addEventListener('input', (e) => { state.theme[k] = e.target.value; send(); }); });
  $('f-radius').value = state.theme.radius; $('radiusOut').textContent = state.theme.radius;
  $('f-radius').addEventListener('input', (e) => { state.theme.radius = Number(e.target.value); $('radiusOut').textContent = e.target.value; send(); });
  $('f-font_en').value = state.theme.font_en;
  $('f-font_en').addEventListener('input', (e) => { state.theme.font_en = e.target.value; send(); });
  $('f-custom_css').value = state.theme.custom_css || '';
  $('f-custom_css').addEventListener('input', (e) => { state.theme.custom_css = e.target.value; send(); });
  $('f-email').value = state.settings.email;
  $('f-email').addEventListener('input', (e) => { state.settings.email = e.target.value; });
  $('f-line_url').value = state.settings.line_url || '';
  $('f-line_url').addEventListener('input', (e) => { state.settings.line_url = e.target.value; });
  $('f-tagline').value = state.settings.tagline;
  $('f-tagline').addEventListener('input', (e) => { state.settings.tagline = e.target.value; });

  // ================= ライブ反映 =================
  let timer = null, ready = false;
  function send(scrollTo) {
    clearTimeout(timer);
    timer = setTimeout(() => sendNow(scrollTo), 80);
  }
  function sendNow(scrollTo) {
    const t = state.theme;
    const gf = fontMap[t.font_en] || fontMap.Montserrat;
    frame.contentWindow?.postMessage({
      type: 'layr-blocks',
      blocks: curBlocks(),
      vars: { '--green': t.accent, '--green-dark': t.accent_dark, '--black': t.base_black, '--bg': t.bg_tint, '--radius': t.radius + 'px', '--font-en': `'${t.font_en}','Noto Sans JP',sans-serif` },
      fontHref: `https://fonts.googleapis.com/css2?family=${gf}&display=swap`,
      css: t.custom_css || '',
      ...(typeof scrollTo === 'number' ? { scrollTo } : {}),
    }, location.origin);
  }
  window.addEventListener('message', (e) => {
    if (e.origin !== location.origin) return;
    if (e.data && e.data.type === 'layr-preview-ready') { ready = true; sendNow(); }
  });
  frame.addEventListener('load', () => setTimeout(() => sendNow(), 250));

  // ================= デバイス切替・リセット =================
  document.querySelectorAll('.cz-dev').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.cz-dev').forEach((x) => x.classList.remove('is-active'));
      b.classList.add('is-active');
      frame.style.width = b.dataset.w || '100%';
    });
  });
  document.getElementById('czReset').addEventListener('click', () => { if (confirm('未保存の変更を破棄して読み込み直しますか？')) location.reload(); });

  // ================= 保存 =================
  const REPO = 'layrinc/company-brain';
  const BASE = '株式会社LAYR/layr-hp/';
  const TOKEN_KEY = 'layrGhToken';
  const modal = $('czModal');

  function getToken() {
    return new Promise((resolve) => {
      const saved = localStorage.getItem(TOKEN_KEY);
      if (saved) return resolve(saved);
      try {
        const cms = JSON.parse(localStorage.getItem('sveltia-cms.user') || '{}');
        if (cms && cms.token) { localStorage.setItem(TOKEN_KEY, cms.token); return resolve(cms.token); }
      } catch (_) { /* モーダルへ */ }
      modal.hidden = false;
      $('czTokenOk').onclick = () => { const v = $('czToken').value.trim(); if (!v) return; localStorage.setItem(TOKEN_KEY, v); modal.hidden = true; resolve(v); };
      $('czTokenCancel').onclick = () => { modal.hidden = true; resolve(null); };
    });
  }

  async function gh(path, opt = {}, token) {
    const res = await fetch('https://api.github.com' + path, { ...opt, headers: { Authorization: 'Bearer ' + token, Accept: 'application/vnd.github+json', ...(opt.body ? { 'Content-Type': 'application/json' } : {}) } });
    if (res.status === 401 || res.status === 403) { localStorage.removeItem(TOKEN_KEY); throw new Error('認証エラー。トークンを確認してください（再度保存するとトークン入力が出ます）'); }
    if (!res.ok) { const j = await res.json().catch(() => ({})); throw new Error('GitHub APIエラー: ' + res.status + (j.message ? '（' + j.message + '）' : '')); }
    return res.json();
  }

  document.getElementById('czSave').addEventListener('click', async () => {
    const token = await getToken();
    if (!token) return;
    const btn = document.getElementById('czSave');
    btn.disabled = true;
    statusEl.textContent = '保存中…';
    try {
      // 1) 全ページの画像（dataURL）をアップロード用に抽出し、保存用クローンではパスに置換
      const uploads = [];
      const IMG_KEYS = ['photo', 'src', 'avatar', 'img'];
      // ブロック内を再帰的に走査し、dataURL画像を全部アップロード対象に差し替える
      // （ギャラリーitems・画像カードitems等、入れ子の画像も拾う）
      const walkUploads = (node) => {
        if (Array.isArray(node)) { node.forEach(walkUploads); return; }
        if (!node || typeof node !== 'object') return;
        Object.entries(node).forEach(([key, v]) => {
          if (IMG_KEYS.includes(key) && typeof v === 'string' && v.startsWith('data:')) {
            const m = v.match(/^data:image\/(png|jpe?g|gif|webp|svg\+xml);base64,(.+)$/);
            if (!m) return;
            const ext = m[1] === 'jpeg' ? 'jpg' : m[1].replace('+xml', '');
            const name = `up-${Date.now()}-${uploads.length}.${ext}`;
            uploads.push({ name, b64: m[2] });
            node[key] = '/uploads/' + name;
          } else if (v && typeof v === 'object') walkUploads(v);
        });
      };
      const collectUploads = (blocks) => walkUploads(blocks);
      const pageClone = JSON.parse(JSON.stringify(state.page));
      pageClone.blocks = JSON.parse(JSON.stringify(pages.home.blocks));
      collectUploads(pageClone.blocks);
      const subClones = {};
      Object.entries(pages).forEach(([slug, pg]) => {
        if (slug === 'home') return;
        subClones[slug] = { title: pg.title, description: pg.description, blocks: JSON.parse(JSON.stringify(pg.blocks)) };
        collectUploads(subClones[slug].blocks);
      });

      let lastErr = null;
      for (let attempt = 1; attempt <= 3; attempt++) {
        try {
          // 2) 画像blobを作成
          const treeEntries = [];
          for (const u of uploads) {
            const blob = await gh(`/repos/${REPO}/git/blobs`, { method: 'POST', body: JSON.stringify({ content: u.b64, encoding: 'base64' }) }, token);
            treeEntries.push({ path: BASE + 'public/uploads/' + u.name, mode: '100644', type: 'blob', sha: blob.sha });
          }
          // 3) トップ＋テーマ＋設定＋下層ページ（削除したページは sha:null で削除）
          treeEntries.push({ path: BASE + 'src/data/page-home.json', mode: '100644', type: 'blob', content: JSON.stringify(pageClone, null, 2) + '\n' });
          treeEntries.push({ path: BASE + 'src/data/theme.json', mode: '100644', type: 'blob', content: JSON.stringify(state.theme, null, 2) + '\n' });
          treeEntries.push({ path: BASE + 'src/data/settings.json', mode: '100644', type: 'blob', content: JSON.stringify(state.settings, null, 2) + '\n' });
          Object.entries(subClones).forEach(([slug, pg]) => {
            treeEntries.push({ path: BASE + `src/data/pages/${slug}.json`, mode: '100644', type: 'blob', content: JSON.stringify(pg, null, 2) + '\n' });
          });
          deletedPages.forEach((slug) => {
            if (state.subPages && state.subPages[slug]) treeEntries.push({ path: BASE + `src/data/pages/${slug}.json`, mode: '100644', type: 'blob', sha: null });
          });
          // 4) コミット
          const ref = await gh(`/repos/${REPO}/git/ref/heads/main`, {}, token);
          const parentSha = ref.object.sha;
          const parent = await gh(`/repos/${REPO}/git/commits/${parentSha}`, {}, token);
          const tree = await gh(`/repos/${REPO}/git/trees`, { method: 'POST', body: JSON.stringify({ base_tree: parent.tree.sha, tree: treeEntries }) }, token);
          const commit = await gh(`/repos/${REPO}/git/commits`, { method: 'POST', body: JSON.stringify({ message: 'layr-hp: ページビルダーから更新', tree: tree.sha, parents: [parentSha] }) }, token);
          await gh(`/repos/${REPO}/git/refs/heads/main`, { method: 'PATCH', body: JSON.stringify({ sha: commit.sha }) }, token);
          lastErr = null;
          break;
        } catch (e) {
          lastErr = e;
          if (String(e.message).includes('422') && attempt < 3) {
            statusEl.textContent = `他の更新と競合したため再試行中…（${attempt}回目）`;
            await new Promise((r) => setTimeout(r, 1200));
            continue;
          }
          throw e;
        }
      }
      if (lastErr) throw lastErr;
      deletedPages.forEach((slug) => { delete (state.subPages || {})[slug]; });
      deletedPages.clear();
      Object.keys(subClones).forEach((slug) => { (state.subPages = state.subPages || {})[slug] = subClones[slug]; });
      statusEl.textContent = '✅ 保存しました。約1分で本番に反映されます';
    } catch (err) {
      statusEl.textContent = '❌ ' + (err.message || '保存に失敗しました') + '｜再読み込みして再試行してください';
    } finally {
      btn.disabled = false;
    }
  });

  // 初期描画
  renderPageBar();
  renderBlocks();
</script>

<style is:global>
  *{margin:0;padding:0;box-sizing:border-box}
  .cz-body{font-family:"Noto Sans JP",-apple-system,sans-serif;background:#EDF1EE;height:100vh;display:flex;flex-direction:column;font-size:calc(14px * var(--fs,1));color:#17211B}
  .cz-bar{height:58px;background:#0F1613;color:#fff;display:flex;align-items:center;gap:20px;padding:0 20px;flex-shrink:0}
  .cz-back{color:rgba(255,255,255,.75);text-decoration:none;font-weight:700;font-size:calc(13px * var(--fs,1))}
  .cz-title{font-weight:900;font-size:calc(14.5px * var(--fs,1));white-space:nowrap}
  .cz-tabs{display:flex;gap:6px;background:rgba(255,255,255,.1);border-radius:999px;padding:4px}
  .cz-tab{border:none;background:transparent;color:rgba(255,255,255,.7);font-weight:800;font-size:calc(12.5px * var(--fs,1));padding:8px 18px;border-radius:999px;cursor:pointer;font-family:inherit}
  .cz-tab.is-active{background:#fff;color:#0F1613}
  .cz-bar-actions{margin-left:auto;display:flex;align-items:center;gap:12px}
  .cz-status{font-size:calc(12px * var(--fs,1));color:#8FE6B2;max-width:320px}
  .cz-btn{border:none;border-radius:999px;font-weight:800;font-size:calc(13px * var(--fs,1));padding:10px 22px;cursor:pointer;font-family:inherit}
  .cz-btn.primary{background:#06C755;color:#fff}
  .cz-btn.primary:hover{background:#04A245}
  .cz-btn.primary:disabled{opacity:.6}
  .cz-btn.ghost{background:rgba(255,255,255,.14);color:#fff}
  .cz-main{flex:1;display:flex;min-height:0}
  .cz-panel{width:400px;flex-shrink:0;background:#F7F9F8;overflow-y:auto;border-right:1px solid #E0E6E2;padding:18px 16px 40px}
  .cz-panel-head p{font-size:calc(12px * var(--fs,1));color:#5F6E66;line-height:1.8;padding:2px 4px 14px}
  .cz-panel-head b{color:#04A245}

  /* ページ切替バー */
  .cz-pagebar{display:flex;gap:8px;margin-bottom:6px}
  .cz-pagebar select{flex:1;font-family:inherit;font-weight:800;font-size:calc(13px * var(--fs,1));padding:10px 12px;border:1.5px solid #E0E6E2;border-radius:10px;background:#fff;color:#17211B;outline:none;cursor:pointer}
  .cz-pagebar select:focus{border-color:#06C755}
  .cz-pagebar .cz-mini{align-self:stretch;white-space:nowrap}
  .cz-pageurl{font-size:calc(11px * var(--fs,1));color:#8B978F;font-weight:700;padding:0 4px 10px;font-family:ui-monospace,Menlo,monospace}
  .cz-mlabel{display:flex;flex-direction:column;gap:6px;font-weight:800;font-size:calc(12px * var(--fs,1));color:#5F6E66}
  .cz-mlabel input,.cz-mlabel textarea{font-family:inherit;font-size:calc(13.5px * var(--fs,1));padding:11px 13px;border:1.5px solid #E0E6E2;border-radius:10px;outline:none}
  .cz-mlabel input:focus,.cz-mlabel textarea:focus{border-color:#06C755}
  .cz-btn.danger-ghost{background:transparent;color:#D64541;border:1.5px solid #F3C9C7;margin-right:auto}
  .cz-btn.danger-ghost:hover{background:#FDEEED}

  /* ドラッグ&ドロップ */
  .cz-drag{cursor:grab;color:#B4BEB8;font-size:calc(15px * var(--fs,1));letter-spacing:-1px;user-select:none;padding:0 2px}
  .cz-block-head:active .cz-drag{cursor:grabbing}
  .cz-block.is-dragging{opacity:.45}
  .cz-block.drop-above{box-shadow:0 -3px 0 0 #06C755, 0 6px 20px rgba(13,43,31,.10)}
  .cz-block.drop-below{box-shadow:0 3px 0 0 #06C755, 0 6px 20px rgba(13,43,31,.10)}

  /* ブロックカード */
  .cz-block{background:#fff;border:1px solid #E4EAE6;border-radius:14px;margin-bottom:10px;overflow:hidden;transition:box-shadow .15s}
  .cz-block:hover{box-shadow:0 4px 16px rgba(13,43,31,.08)}
  .cz-block.is-open{box-shadow:0 6px 20px rgba(13,43,31,.10);border-color:#06C755}
  .cz-block-head{display:flex;align-items:center;gap:10px;padding:14px 14px;cursor:pointer;user-select:none}
  .cz-block-ico{font-size:calc(17px * var(--fs,1))}
  .cz-block-name{font-weight:900;font-size:calc(13.5px * var(--fs,1));white-space:nowrap}
  .cz-block-snip{font-size:calc(11.5px * var(--fs,1));color:#8B978F;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
  .cz-block-ctrl{display:flex;gap:4px;opacity:.35;transition:opacity .15s}
  .cz-block:hover .cz-block-ctrl{opacity:1}
  .cz-ctrl{border:none;background:#F0F3F1;border-radius:7px;width:27px;height:27px;font-size:calc(12px * var(--fs,1));cursor:pointer;color:#3D4A43;font-family:inherit}
  .cz-ctrl:hover{background:#DFF3E7;color:#04A245}
  .cz-ctrl.danger:hover{background:#FDEEED;color:#D64541}
  .cz-add-main{width:100%;border:2px dashed #C9D4CD;background:transparent;border-radius:14px;padding:15px;font-weight:800;font-size:calc(13.5px * var(--fs,1));color:#5F6E66;cursor:pointer;font-family:inherit;margin-top:4px}
  .cz-add-main:hover{border-color:#06C755;color:#04A245;background:#F0FAF4}

  /* フィールド */
  .cz-fields{padding:4px 16px 18px;display:flex;flex-direction:column;gap:15px}
  .cz-fields.tight{padding:4px 12px 12px;gap:11px}
  .cz-fields label{display:flex;flex-direction:column;gap:6px;font-weight:800;font-size:calc(12px * var(--fs,1));color:#5F6E66}
  .cz-fields input[type="text"],.cz-fields input[type="number"],.cz-fields textarea,.cz-fields select{font-family:inherit;font-size:calc(13.5px * var(--fs,1));padding:11px 13px;border:1.5px solid #E0E6E2;border-radius:10px;background:#fff;color:#17211B;outline:none;line-height:1.7}
  .cz-fields input:focus,.cz-fields textarea:focus,.cz-fields select:focus{border-color:#06C755}
  .cz-color{flex-direction:row!important;align-items:center;justify-content:space-between}
  .cz-color input{width:56px;height:32px;border:1.5px solid #E0E6E2;border-radius:8px;background:#fff;padding:2px;cursor:pointer}
  .cz-flag{flex-direction:row!important;align-items:center;gap:10px!important;font-size:calc(13px * var(--fs,1))!important;color:#17211B!important;font-weight:700!important;cursor:pointer}
  .cz-flag input{width:17px;height:17px;accent-color:#06C755}
  .cz-arr{display:flex;flex-direction:column;gap:9px}
  .cz-arr-label{font-weight:800;font-size:calc(12px * var(--fs,1));color:#5F6E66}
  .cz-itemcard{background:#F7F9F8;border:1px solid #E4EAE6;border-radius:11px;overflow:hidden}
  .cz-itembar{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;font-weight:800;font-size:calc(11.5px * var(--fs,1));color:#5F6E66;background:#F0F3F1}
  .cz-strrow{display:flex;gap:7px;margin-bottom:7px}
  .cz-strrow input,.cz-strrow textarea{flex:1}
  .cz-mini{border:none;background:#EDF1EE;border-radius:8px;padding:8px 13px;font-weight:800;font-size:calc(12px * var(--fs,1));color:#3D4A43;cursor:pointer;font-family:inherit;align-self:flex-start}
  .cz-mini:hover{background:#DFF3E7;color:#04A245}
  .cz-mini.danger:hover{background:#FDEEED;color:#D64541}
  .cz-mini.add{width:100%;border:1.5px dashed #C9D4CD;background:transparent}
  /* リッチテキスト編集 */
  .cz-richwrap{display:flex;flex-direction:column;border:1.5px solid #E0E6E2;border-radius:10px;background:#fff;overflow:hidden}
  .cz-richwrap:focus-within{border-color:#06C755}
  .cz-rt{display:flex;gap:2px;padding:6px 8px;border-bottom:1px solid #EEF2EF;background:#FAFBFA}
  .cz-rtb{border:none;background:transparent;border-radius:6px;min-width:28px;height:26px;cursor:pointer;font-size:calc(12.5px * var(--fs,1));font-family:inherit;display:grid;place-items:center;padding:0 5px}
  .cz-rtb:hover{background:#EDF1EE}
  .cz-rtb b{font-weight:900}
  .cz-rich{padding:11px 13px;font-size:calc(13.5px * var(--fs,1));line-height:1.9;min-height:72px;outline:none;color:#17211B;font-weight:500;overflow-wrap:break-word}
  .cz-rich:empty::before{content:"本文を入力…";color:#B4BEB8}
  .cz-rich mark.mk-g,.cz-rtb mark.mk-g{background:linear-gradient(transparent 62%,rgba(6,199,85,.45) 62%);color:inherit}
  .cz-rich mark.mk-y,.cz-rtb mark.mk-y{background:linear-gradient(transparent 62%,#FFDF66 62%);color:inherit}
  .cz-rich .tc-g,.cz-rtb .tc-g{color:#04A245;font-weight:800}
  .cz-rich .tc-r,.cz-rtb .tc-r{color:#D64541;font-weight:800}
  .cz-rich a{color:#04A245;text-decoration:underline}
  .cz-rich strong{font-weight:900}
  .cz-imgfield{display:flex;gap:12px;align-items:center}
  .cz-imgs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:9px}
  .cz-imgs-cell{display:flex;flex-direction:column;gap:5px}
  .cz-imgs-thumb{position:relative;aspect-ratio:4/3;border-radius:9px;background:#EDF1EE center/cover no-repeat;border:1.5px solid #E0E6E2}
  .cz-imgs-x{position:absolute;top:4px;right:4px;border:none;background:rgba(15,22,19,.75);color:#fff;border-radius:6px;width:20px;height:20px;font-size:calc(10px * var(--fs,1));cursor:pointer}
  .cz-imgs-x:hover{background:#D64541}
  .cz-imgs-cell input{font-family:inherit;font-size:calc(11px * var(--fs,1));padding:6px 8px;border:1.5px solid #E0E6E2;border-radius:7px;outline:none}
  .cz-imgthumb{width:86px;height:64px;border-radius:10px;background:#EDF1EE center/cover no-repeat;border:1.5px solid #E0E6E2;display:grid;place-items:center;font-size:calc(10.5px * var(--fs,1));color:#8B978F;font-weight:700}
  .cz-imgbtns{display:flex;flex-direction:column;gap:6px}

  /* デザインタブ */
  .cz-group-static{background:#fff;border:1px solid #E4EAE6;border-radius:14px;margin-bottom:12px;padding-top:14px}
  .cz-group-static h3{font-size:calc(13.5px * var(--fs,1));font-weight:900;padding:0 16px 10px}
  .cz-css{font-family:ui-monospace,Menlo,monospace;font-size:calc(12.5px * var(--fs,1));line-height:1.7}
  .cz-hint{font-weight:500;font-size:calc(11.5px * var(--fs,1));color:#5F6E66;line-height:1.7}
  .cz-note{padding:10px 6px;font-size:calc(11.5px * var(--fs,1));color:#5F6E66;line-height:1.7}
  .cz-note a{color:#04A245;font-weight:700}

  /* ステージ */
  .cz-stage{flex:1;display:flex;flex-direction:column;min-width:0}
  .cz-devices{display:flex;gap:8px;justify-content:center;padding:12px}
  .cz-dev{border:1px solid #D5DDd7;background:#fff;border-radius:999px;font-size:calc(12px * var(--fs,1));font-weight:700;padding:8px 18px;cursor:pointer;color:#5F6E66;font-family:inherit}
  .cz-dev.is-active{background:#0F1613;color:#fff;border-color:#0F1613}
  .cz-frame-wrap{flex:1;display:flex;justify-content:center;overflow:hidden;padding:0 14px 14px}
  #czFrame{width:100%;height:100%;border:none;border-radius:14px;background:#fff;box-shadow:0 10px 30px rgba(13,43,31,.12);transition:width .3s ease;max-width:100%}

  /* モーダル */
  .cz-modal{position:fixed;inset:0;background:rgba(15,22,19,.55);display:grid;place-items:center;z-index:50}
  .cz-modal[hidden]{display:none}
  .cz-modal-card{background:#fff;border-radius:18px;padding:28px;width:min(440px,92vw);display:flex;flex-direction:column;gap:13px;max-height:86vh;overflow-y:auto}
  .cz-modal-card h2{font-size:calc(16.5px * var(--fs,1));font-weight:900}
  .cz-modal-card p{font-size:calc(12.5px * var(--fs,1));color:#5F6E66;line-height:1.7}
  .cz-modal-card input[type="password"]{font-family:inherit;font-size:calc(13px * var(--fs,1));padding:12px;border:1.5px solid #E0E6E2;border-radius:10px;outline:none}
  .cz-modal-actions{display:flex;justify-content:flex-end;gap:10px}
  .cz-picker{width:min(620px,94vw)}
  .cz-picker-head{display:flex;justify-content:space-between;align-items:center}
  .cz-x{border:none;background:#EDF1EE;border-radius:8px;width:30px;height:30px;cursor:pointer;font-size:calc(13px * var(--fs,1))}
  .cz-picker-cat{font-weight:900;font-size:calc(12.5px * var(--fs,1));color:#5F6E66;margin-top:6px}
  .cz-picker-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
  .cz-tile{border:1.5px solid #E4EAE6;background:#fff;border-radius:12px;padding:13px 11px;cursor:pointer;font-family:inherit;display:flex;flex-direction:column;gap:3px;text-align:left}
  .cz-tile:hover{border-color:#06C755;background:#F0FAF4}
  .cz-tile-ico{font-size:calc(19px * var(--fs,1))}
  .cz-tile-name{font-weight:900;font-size:calc(12.5px * var(--fs,1));color:#17211B}
  .cz-tile-desc{font-size:calc(10.5px * var(--fs,1));color:#8B978F;line-height:1.5}
  @media (max-width:980px){.cz-panel{width:320px}.cz-tabs{display:none}}
</style>
</body>
</html>
