---
/**
 * 支援実績一覧（/case/）— コラム一覧と同じカードグリッド型。
 * 1実績 = src/content/cases/<slug>.md（追加すれば自動で並ぶ）。
 */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const cases = (await getCollection('cases', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = '支援実績｜株式会社LAYR';
const description = 'LINEマーケティング支援の実績一覧。講座申込2.4倍、再来店率+38%、獲得コスト半減など、LINE構築・運用による事業改善の事例を課題・施策・成果つきで紹介します。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: '支援実績' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '支援実績',
    url: new URL('/case/', Astro.site).href,
    inLanguage: 'ja',
    isPartOf: { '@id': 'https://layr.co.jp/#website' },
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <header class="cs-hero">
    <div class="container">
      <nav class="cs-bc" aria-label="パンくず"><a href="/">トップ</a><span>／</span><em>支援実績</em></nav>
      <p class="cs-badge">LAYR CASE</p>
      <h1>支援実績</h1>
      <p class="cs-lead">課題・施策・成果まで、数字で紹介します。</p>
    </div>
    <span class="cs-wm" aria-hidden="true">CASE</span>
  </header>

  <div class="container cs-main">
    <div class="cs-grid">
      {cases.map((c) => (
        <a class="cs-card" href={`/case/${c.id}/`}>
          <div class="cs-thumb">
            <span class="cs-metric">
              <span class="b">{c.data.before}</span>
              <span class="arw">→</span>
              <span class="a">{c.data.after}</span>
            </span>
            <span class="cs-metric-l">{c.data.metric_label}</span>
            <span class="cs-tag">{c.data.industry}</span>
          </div>
          <div class="cs-body">
            <h2>{c.data.title}</h2>
            <p>{c.data.problem}</p>
            <span class="cs-more">事例を読む ›</span>
          </div>
        </a>
      ))}
    </div>
    <p class="cs-note">※ 掲載の成果は一例です。業種・条件により結果は異なります。</p>
  </div>

  <section class="cs-cta">
    <div class="container">
      <p class="t">同じような課題を、貴社でも。</p>
      <p class="s">現状のお困りごとを伺う無料相談（オンライン30分）と、料金・事例をまとめた資料をご用意しています。</p>
      <div class="row">
        <a class="btn btn-green btn-lg" href="/contact/">無料相談に申し込む</a>
        <a class="btn cs-btn-w btn-lg" href="/document/line-service/">サービス資料をダウンロード</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cs-hero{position:relative;background:linear-gradient(160deg,#F4FAF8 0%,#fff 55%,#EDF7F2 100%);padding:clamp(36px,5vw,64px) 0;overflow:hidden;border-bottom:1px solid var(--line)}
  .cs-bc{font-size:12px;color:var(--muted);margin-bottom:22px}
  .cs-bc a{color:var(--green-dark);font-weight:700;text-decoration:none}
  .cs-bc span{opacity:.4;margin:0 6px}
  .cs-bc em{font-style:normal}
  .cs-badge{display:inline-block;background:var(--black,#0E1A1C);color:#fff;font-family:var(--font-en);font-weight:800;font-size:12px;letter-spacing:.14em;border-radius:999px;padding:8px 22px;margin-bottom:18px}
  .cs-hero h1{font-size:clamp(30px,5.4vw,52px);font-weight:900;letter-spacing:-.01em;line-height:1.3;color:var(--black)}
  .cs-lead{font-size:14.5px;color:var(--muted);margin-top:14px}
  .cs-wm{position:absolute;right:-1%;bottom:-8%;font-family:var(--font-en);font-weight:800;font-size:clamp(90px,14vw,190px);color:var(--green-dark);opacity:.045;pointer-events:none;line-height:1}
  .cs-main{padding:clamp(34px,4.5vw,54px) var(--gutter) clamp(50px,6vw,80px)}
  .cs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,2.4vw,28px)}
  .cs-card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;transition:transform .18s,box-shadow .18s,border-color .18s}
  .cs-card:hover{transform:translateY(-5px);box-shadow:0 14px 34px rgba(14,26,28,.09);border-color:color-mix(in srgb,var(--green) 40%,#fff)}
  .cs-thumb{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,#0E4F44 0%,#17604F 60%,#1E6E56 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:18px}
  .cs-metric{display:flex;align-items:baseline;gap:10px;color:#fff}
  .cs-metric .b{font-family:var(--font-en);font-weight:700;font-size:20px;opacity:.65;text-decoration:line-through}
  .cs-metric .arw{color:#8FE3C9;font-weight:900;font-size:18px}
  .cs-metric .a{font-family:var(--font-en);font-weight:800;font-size:40px;color:#8FE3C9;letter-spacing:-.02em}
  .cs-metric-l{font-size:10.5px;color:rgba(255,255,255,.75);font-weight:700;text-align:center;line-height:1.6}
  .cs-tag{position:absolute;left:12px;top:12px;background:rgba(255,255,255,.92);color:var(--green-dark);font-size:11px;font-weight:800;border-radius:999px;padding:4px 14px}
  .cs-body{display:flex;flex-direction:column;gap:8px;padding:18px 20px 20px;flex:1}
  .cs-body h2{font-size:15.5px;font-weight:900;line-height:1.65;color:var(--black)}
  .cs-body p{font-size:12.5px;color:var(--muted);line-height:1.85}
  .cs-more{margin-top:auto;padding-top:10px;font-size:12.5px;font-weight:800;color:var(--green-dark)}
  .cs-card:hover .cs-more{text-decoration:underline;text-underline-offset:4px}
  .cs-note{font-size:11.5px;color:var(--muted);margin-top:20px}
  .cs-cta{background:var(--green-dark);color:#fff;text-align:center;padding:clamp(48px,6vw,72px) 0}
  .cs-cta .t{font-size:clamp(19px,3vw,26px);font-weight:900;margin-bottom:8px}
  .cs-cta .s{font-size:13.5px;opacity:.88;max-width:36em;margin:0 auto 24px;line-height:1.9}
  .cs-cta .row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  .cs-btn-w{background:#fff;color:var(--green-dark)}
  @media (max-width: 900px){.cs-grid{grid-template-columns:1fr 1fr}}
  @media (max-width: 600px){.cs-grid{grid-template-columns:1fr}}
</style>
