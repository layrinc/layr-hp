---
import '../../../styles/style.css';
import '../../../styles/seo-manager.css';
import WorkspaceNav from '../../../components/seo-manager/WorkspaceNav.astro';
import service from '../../../data/service-ltori.json';
import AnalyticsPanel from '../../../components/seo-manager/AnalyticsPanel.astro';
import {publicationFor} from '../../../lib/ltori-publication.mjs';
import {regionalAreas, prefectureAreas, eligibleAreas, municipalityAreas} from '../../../lib/ltori-seo.mjs';
import {catalogFromAreas, PATTERNS, STATUS, PRIORITY, INDEX} from '../../../lib/seo-manager/model.mjs';
const catalog=catalogFromAreas(regionalAreas).map((page,i)=>({...page,publication:publicationFor(regionalAreas[i])}));
const eligibleCount=eligibleAreas.length;
const liveCount=catalog.filter(page=>page.publication==='published').length;
const options=(record)=>Object.entries(record);
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="referrer" content="same-origin" />
  <title>全国SEOキーワード管理｜{service.name}｜LAYR</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="seo-app">
  <a class="kw-skip" href="#kw-main">管理一覧へ</a>
  <header class="kw-top"><a href="/" class="kw-brand">LAYR <span>SEO WORKSPACE</span></a><div class="kw-account"><span id="kw-save-state" role="status">データを読み込み中</span><span id="kw-identity" role="status">認証を確認中</span><a id="kw-logout" class="kw-button" href="/cdn-cgi/access/logout">ログアウト</a></div></header>
  <WorkspaceNav active="regional" />
  <div class="kw-shell">
    <aside class="kw-sidebar">
      <p class="kw-label">{service.name} / 採用LINE</p>
      <nav aria-label="管理メニュー" id="kw-tabs">
        <a class="kw-button" href="/growth/?type=city#documents">全国SEOの原稿・公開予約へ</a>
        <button type="button" data-view="pages" aria-current="page"><span>01</span>地域・ページ</button>
        <button type="button" data-view="keywords"><span>02</span>キーワード</button>
        <button type="button" data-view="tasks"><span>03</span>改善タスク</button>
        <button type="button" data-view="analytics"><span>04</span>アクセス・問い合わせ</button>
        <button type="button" data-view="published"><span>05</span>公開URL記事</button>
        <button type="button" data-view="data"><span>06</span>実績・入出力</button>
      </nav>
      <div class="kw-sidebar-note"><p>共通データベースに保存</p><p>同じメールでログインすると、別の端末でも作業を続けられます。</p><button type="button" class="kw-button" id="kw-backup">バックアップを保存</button><p id="kw-backup-date">まだバックアップしていません</p></div>
      <a class="kw-outlink" href="/media/">エルトリ採用ノート管理 →</a>
      <a class="kw-outlink" href="https://hub.layr.co.jp/" target="_blank" rel="noopener noreferrer">LAYR HUBへ ↗</a>
    </aside>
    <main id="kw-main" class="kw-main">
      <header class="kw-heading"><div><p class="kw-label">NATIONAL SEARCH MANAGEMENT</p><h1>全国SEOキーワード管理</h1><p>47都道府県・{municipalityAreas.length.toLocaleString('ja-JP')}市区町村・行政区の検索流入を育てる。</p></div><button class="kw-button kw-primary" type="button" id="kw-open-import">検索実績を取り込む</button></header>
      <noscript><p class="kw-notice">この管理ツールにはJavaScriptが必要です。ブラウザの設定で有効にしてください。</p></noscript>
      <p id="kw-message" role="status" class="kw-notice" hidden></p>
      <p id="kw-storage-error" role="alert" class="kw-notice" hidden></p>
      <dl class="kw-stats">
        <div><dt>登録LP</dt><dd id="kw-stat-pages">{eligibleCount.toLocaleString('ja-JP')}</dd><small>公開 {liveCount} ／ 下書き {eligibleCount-liveCount}</small></div>
        <div><dt>対策対象キーワード</dt><dd id="kw-stat-keywords">{(eligibleCount*PATTERNS.length).toLocaleString('ja-JP')}</dd><small>検索需要は未調査の候補</small></div>
        <div><dt>インデックス確認済み</dt><dd id="kw-stat-indexed">—</dd><small>手動で登録済みを記録</small></div>
        <div><dt>期限超過のタスク</dt><dd id="kw-stat-overdue">—</dd><small>対応済みを除く</small></div>
      </dl>
      <section id="kw-list-view" aria-labelledby="kw-view-title">
        <div class="kw-section-head"><div><h2 id="kw-view-title">地域・ページ</h2><p id="kw-view-hint">地域を選んで、対策キーワードと次の作業を管理します。</p></div><button type="button" id="kw-export" class="kw-button">表示対象をCSV出力</button></div>
        <div class="kw-filters">
          <label class="kw-search">地域・キーワード・メモを検索<input id="kw-search" type="search" placeholder="例：三重県、名張市、採用LINE" /></label>
          <label>都道府県<select id="kw-pref"><option value="">全国</option>{prefectureAreas.map(p=><option value={p.slug}>{p.name}</option>)}</select></label>
          <label>対応状況<select id="kw-status"><option value="">すべて</option>{options(STATUS).map(([value,label])=><option value={value}>{label}</option>)}</select></label>
          <label>優先度<select id="kw-priority"><option value="">すべて</option>{options(PRIORITY).map(([value,label])=><option value={value}>{label}</option>)}</select></label>
          <label>並び順<select id="kw-sort"><option value="area">地域順</option><option value="priority">優先度が高い順</option><option value="due">期限が近い順</option><option value="clicks">クリックが多い順</option><option value="impressions">表示回数が多い順</option><option value="position">掲載順位が高い順</option></select></label>
        </div>
        <div class="kw-subfilters"><label>表示する検索実績<select id="kw-report"><option value="">実績は未取り込み</option></select></label><label>公開区分<select id="kw-publication"><option value="">対象の都道府県・市区町村</option><option value="published" selected>公開中</option><option value="draft">下書き</option><option value="excluded">対象外（旧データ）</option></select></label><label id="kw-enabled-wrap" hidden>対策対象<select id="kw-enabled"><option value="">すべて</option><option value="active">対策対象</option><option value="paused">保留</option></select></label><button type="button" class="kw-button" id="kw-reset">条件をリセット</button></div>
        <p id="kw-scope" class="kw-help">未取り込みの数値は「—」で表示します。</p>
        <div id="kw-bulk" class="kw-bulk" hidden><strong id="kw-selected-count"></strong><label>対応状況<select id="kw-bulk-status"><option value="">変更しない</option>{options(STATUS).map(([v,l])=><option value={v}>{l}</option>)}</select></label><label>優先度<select id="kw-bulk-priority"><option value="">変更しない</option>{options(PRIORITY).map(([v,l])=><option value={v}>{l}</option>)}</select></label><button class="kw-button kw-primary" type="button" id="kw-bulk-apply">選択した地域に適用</button><button class="kw-button" type="button" id="kw-deselect">選択を解除</button></div>
        <div class="kw-table-wrap" tabindex="0" role="region" aria-label="管理一覧。横にスクロールできます"><table class="kw-table"><thead id="kw-thead"></thead><tbody id="kw-tbody"></tbody></table><p class="kw-empty" id="kw-empty" hidden>条件に一致するデータがありません。検索条件を変更してください。</p></div>
        <footer class="kw-pagination"><p id="kw-results" aria-live="polite">読み込み中</p><div><label>表示件数<select id="kw-size"><option value="25">25件</option><option value="50">50件</option><option value="100">100件</option></select></label><button id="kw-prev" class="kw-button" type="button">前へ</button><span id="kw-page"></span><button id="kw-next" class="kw-button" type="button">次へ</button></div></footer>
      </section>
      <AnalyticsPanel />
      <section id="kw-published-view" aria-labelledby="kw-published-title" hidden>
        <div class="kw-section-head"><div><h2 id="kw-published-title">公開URL記事</h2><p>公開中の地域LPを、北海道から沖縄まで都道府県ごとに一覧にします。</p></div><div class="kw-pub-actions"><button type="button" class="kw-button" id="kw-pub-copy">表示中のURLをコピー</button><button type="button" class="kw-button" id="kw-pub-export">表示中の一覧をCSV出力</button></div></div>
        <dl class="kw-stats"><div><dt>公開中のURL</dt><dd id="kw-pub-count">—</dd><small>都道府県LP・市区町村LP</small></div><div><dt>公開済みの都道府県</dt><dd id="kw-pub-prefs">—</dd><small>47都道府県のうち</small></div><div><dt>最新の公開日</dt><dd id="kw-pub-latest">—</dd><small>公開台帳の記録</small></div><div><dt>公開方式</dt><dd>1日1県</dd><small>県内の全市を同日に公開</small></div></dl>
        <div class="kw-filters"><label class="kw-search">地域・URLを検索<input id="kw-pub-search" type="search" placeholder="例：盛岡市、miyagi" /></label><label>都道府県<select id="kw-pub-pref"><option value="">全国</option>{prefectureAreas.map(p=><option value={p.slug}>{p.name}</option>)}</select></label></div>
        <p id="kw-pub-results" class="kw-help" aria-live="polite">公開状況を読み込み中です。</p>
        <p class="kw-empty" id="kw-pub-empty" hidden>公開中のURLはまだありません。条件を変更してください。</p>
        <div id="kw-pub-groups" class="kw-data-grid kw-pub-groups"></div>
        <p class="kw-help">公開日は公開台帳の記録です。以前からリポジトリで公開している一部の市は「—」になります。ここで表示を絞り込んでも、公開状態は変わりません。</p>
      </section>
      <section id="kw-data-view" aria-labelledby="kw-data-title" hidden>
        <div class="kw-section-head"><div><h2 id="kw-data-title">検索実績・データの入出力</h2><p>CSVを確認してから保存します。期間の異なる数値は合算しません。</p></div><a class="kw-button" href="https://search.google.com/search-console" target="_blank" rel="noopener noreferrer">Search Consoleを開く ↗</a></div>
        <div class="kw-data-grid">
          <section class="kw-panel"><h3>Search ConsoleのCSVを取り込む</h3><p class="kw-help">検索パフォーマンス → 期間・条件を設定 → エクスポート。ZIPは展開し「ページ.csv」または「クエリ.csv」を選びます。比較表示は解除してください。</p>
            <form id="kw-import-form">
              <label>CSVファイル（UTF-8・20MBまで）<input type="file" id="kw-import-file" accept=".csv,text/csv" required /></label>
              <div class="kw-form-grid"><label>集計開始日<input type="date" id="kw-import-start" required /></label><label>集計終了日<input type="date" id="kw-import-end" required /></label><label>検索タイプ<select id="kw-import-type"><option value="web">ウェブ</option><option value="image">画像</option><option value="video">動画</option><option value="news">ニュース</option></select></label><label>CSVの対象ページ（クエリ別のみ）<select id="kw-import-scope"><option value="">サイト全体（ページ絞り込みなし）</option></select></label></div>
              <label>国・デバイス・追加フィルタ<input id="kw-import-filter" maxlength="200" value="全デバイス・全ての国・追加フィルタなし" required /></label>
              <p class="kw-help">Search Consoleで指定した条件と揃えてください。サイト全体のクエリ実績から、特定LPの順位は判定しません。</p>
              <button type="submit" class="kw-button kw-primary">取り込み内容を確認</button><button type="button" class="kw-button" id="kw-sample">CSV書式をダウンロード</button>
            </form>
            <div id="kw-import-preview" class="kw-import-preview" hidden><h3>取り込み内容</h3><p id="kw-import-summary"></p><p id="kw-import-replace" class="kw-help"></p><ul id="kw-import-rejected"></ul><button id="kw-rejected-export" type="button" class="kw-button" hidden>対象外の行をCSV出力</button><div class="kw-table-wrap"><table class="kw-table"><thead><tr><th>ページ / クエリ</th><th>クリック</th><th>表示回数</th><th>平均順位</th></tr></thead><tbody id="kw-import-rows"></tbody></table></div><p class="kw-help">確認表は先頭5行です。</p><button type="button" id="kw-import-save" class="kw-button kw-primary">この実績を保存</button></div>
          </section>
          <section class="kw-panel"><h3>バックアップ・復元</h3><p>作業メモ、追加キーワード、検索・アクセス実績を1つのJSONファイルに保存します。</p><button type="button" id="kw-backup-data" class="kw-button">JSONバックアップを保存</button><p class="kw-help">編集データは認証付きの共通データベースに保存します。旧ブラウザのデータは共通データが空の場合に移行します。JSONバックアップも保存できます。</p>
            <p class="kw-help">以前の管理画面を使っていた場合は、<a href="https://layr.co.jp/tools/ltori-seo/" target="_blank" rel="noopener noreferrer">旧URLで移行用JSONを保存 ↗</a>し、ここで復元できます。保存した作業データは、同じメールでログインした別の端末でも読み込めます。共有端末では利用後にログアウトしてください。</p>
            <form id="kw-restore-form"><label>復元するJSONファイル<input type="file" id="kw-restore-file" accept=".json,application/json" required /></label><button type="submit" class="kw-button">復元内容を確認</button></form>
            <div id="kw-restore-preview" class="kw-import-preview" hidden><p id="kw-restore-summary"></p><p>現在の編集内容と検索実績を置き換えます。必要なデータを先にバックアップしてください。</p><button type="button" class="kw-button kw-primary" id="kw-restore-save">このバックアップを復元</button></div>
          </section>
        </div>
        <section class="kw-panel"><h3>保存した検索実績</h3><p class="kw-help">同じ期間・条件・集計軸の再取り込みは置換します。数値はCSV内の行の合計で、Search Consoleの画面合計と異なる場合があります。</p><div id="kw-report-history" class="kw-history"></div></section>
        <details class="kw-help-details"><summary>運用の進め方・数値の読み方</summary><ol><li>地域・ページから優先度、担当者、次の作業と期限を設定します。</li><li>標準5種類はキーワード候補です。地域ごとの需要を調べ、不要な候補は保留にし、実際の検索語を追加します。</li><li>公開後は同じ期間幅・条件でSearch Console CSVを取り込みます。平均掲載順位は集計値であり固定の順位ではありません。</li><li>表示回数があるのにクリックされないページ、改善中のページを絞り込み、本文や見出しを改善します。</li><li>このツールで対応済みと記録しても、LP本文や公開状態は変更されません。</li></ol><p>「アクセス・問い合わせ」でGoogleの読み取り専用接続またはGA4 CSVの取り込みを利用できます。インデックス状態は手動確認です。市・町・村・区を管理対象とし、既存の編集データを保持しています。下書きはサイトに公開されていません。全国市の自動公開は、北海道から沖縄まで1日1都道府県ずつ、確認済みの全市原稿を日本時間9:17から公開します。47日間の予定と未公開の市は原稿・成果の運用画面で確認できます。この画面の作業メモだけを変更しても公開されません。</p><a href="https://support.google.com/webmasters/answer/7576553?hl=ja" target="_blank" rel="noopener noreferrer">Googleの指標説明を読む ↗</a></details>
      </section>
    </main>
  </div>
  <dialog id="kw-editor" class="kw-dialog" aria-labelledby="kw-editor-title"><div class="kw-dialog-head"><div><p class="kw-label">PAGE & KEYWORDS</p><h2 id="kw-editor-title"></h2></div><button type="button" class="kw-button" id="kw-editor-close">閉じる</button></div><p id="kw-editor-links" class="kw-editor-links"></p><p class="kw-help" id="kw-editor-path"></p>
    <form id="kw-editor-form"><div class="kw-form-grid"><label>対応状況<select id="kw-edit-status">{options(STATUS).map(([v,l])=><option value={v}>{l}</option>)}</select></label><label>優先度<select id="kw-edit-priority">{options(PRIORITY).map(([v,l])=><option value={v}>{l}</option>)}</select></label><label>インデックス状態（手動確認）<select id="kw-edit-index">{options(INDEX).map(([v,l])=><option value={v}>{l}</option>)}</select></label><label>担当者<input id="kw-edit-owner" maxlength="100" /></label><label>次回対応の期限<input id="kw-edit-due" type="date" /></label></div>
      <label>次にやること<input id="kw-edit-action" maxlength="300" placeholder="例：採用担当者向けFAQを追加する" /></label><label>メモ<textarea id="kw-edit-notes" rows="4" maxlength="5000" placeholder="調査結果・改善内容・確認事項を記録"></textarea></label>
      <fieldset class="kw-keyword-field"><legend>対策キーワード</legend><p class="kw-help">チェックを外すと保留になります。追加・保留の変更も「変更を保存」で確定します。</p><ul id="kw-editor-keywords"></ul><label>キーワードを追加<input id="kw-new-query" maxlength="200" placeholder="例：名張市 LINE採用" /></label><button type="button" class="kw-button" id="kw-add-query">キーワードを追加</button></fieldset>
      <p id="kw-editor-error" class="kw-notice" role="alert" hidden></p><footer class="kw-dialog-foot"><p>LP本文や公開設定への反映は行いません。</p><button type="submit" class="kw-button kw-primary" id="kw-editor-save">変更を保存</button></footer>
    </form>
  </dialog>
  <dialog id="kw-report-dialog" class="kw-dialog kw-report-dialog" aria-labelledby="kw-report-title"><div class="kw-dialog-head"><h2 id="kw-report-title">取り込み済み実績</h2><button type="button" class="kw-button" id="kw-report-close">閉じる</button></div><p id="kw-report-detail"></p><label>実績内を検索<input type="search" id="kw-report-search" placeholder="地域名やクエリで検索" /></label><div class="kw-table-wrap" tabindex="0" role="region" aria-label="検索実績"><table class="kw-table"><thead><tr><th>地域 / クエリ</th><th>クリック</th><th>表示回数</th><th>CTR</th><th>平均順位</th></tr></thead><tbody id="kw-report-rows"></tbody></table></div><footer class="kw-pagination"><p id="kw-report-count"></p><div><button type="button" class="kw-button" id="kw-report-prev">前へ</button><button type="button" class="kw-button" id="kw-report-next">次へ</button></div></footer></dialog>
  <script is:inline type="application/json" id="kw-catalog" set:html={JSON.stringify(catalog).replaceAll('<','\\u003c')}></script>
  <script>
    import {startAccessSession} from '../../../lib/seo-manager/session.mjs';
    if (await startAccessSession()) await import('../../../lib/seo-manager/app.mjs');
  </script>
</body>
</html>
