---
import SeoWorkspace from '../../../layouts/SeoWorkspace.astro';
import KijiWorkbench from '../../../components/seo-manager/KijiWorkbench.astro';
import catalog from '../../../data/seo-corporate-catalog.json';
import {CORPORATE_STATUS, CORPORATE_PRIORITY} from '../../../lib/seo-manager/corporate-model.mjs';
const serialized = JSON.stringify(catalog).replace(/</g, '\\u003c');
---
<SeoWorkspace title="LAYR公式メディアの記事制作・公開・改善" active="corporate">
  <header class="kw-heading"><div class="workspace-intro"><p class="workspace-eyebrow">LAYR / MEDIA</p><h1>公式メディアの記事制作・公開・改善</h1><p>キーワードの選定から原稿の確認、公開後の改善までを管理します。</p></div></header>
  <KijiWorkbench />
  <section id="kiji-panel-improve" role="tabpanel" aria-labelledby="kiji-tab-improve" data-kiji-panel="improve" hidden>
  <header class="kw-heading"><div class="workspace-intro"><p class="workspace-eyebrow">LAYR / MEDIA</p><h2>公開記事の改善</h2><p>公開済みの記事と検索・アクセス実績を確認し、次の改善を記録します。</p></div><button class="kw-button" id="cp-refresh" type="button">最新の情報に更新</button></header>
  <p id="cp-message" class="kw-notice" role="status" hidden></p>
  <p id="cp-saved" class="kw-help" role="status">共有する改善メモを読み込み中です。</p>
  <dl class="kw-stats"><div><dt>管理対象の公開記事</dt><dd>{catalog.length}</dd><small>公開サイトの原稿から作成</small></div><div><dt>ページ表示数（PV）</dt><dd id="cp-views">—</dd><small>公式メディアの取得済みページ</small></div><div><dt>検索クリック</dt><dd id="cp-clicks">—</dd><small>Search Console</small></div><div><dt>調査・改善・確認中</dt><dd id="cp-active">—</dd><small>共有した改善状況</small></div></dl>
  <section aria-labelledby="cp-articles-title">
    <div class="kw-section-head"><div><h2 id="cp-articles-title">記事と改善メモ</h2><p>ここで保存するのは管理用のメモです。公開記事の本文・公開状態は変わりません。</p></div><button class="kw-button" id="cp-export" type="button" disabled>一覧をCSVで保存</button></div>
    <div class="workspace-filter"><label>記事・キーワードを検索<input id="cp-search" type="search" placeholder="タイトル・キーワードで検索" /></label><label>改善状況<select id="cp-status"><option value="">すべて</option>{Object.entries(CORPORATE_STATUS).map(([value, label]) => <option value={value}>{label}</option>)}</select></label><label>カテゴリー<select id="cp-category"><option value="">すべて</option>{[...new Set(catalog.map(article => article.category))].sort().map(category => <option value={category}>{category}</option>)}</select></label><label>並び順<select id="cp-sort"><option value="priority">優先度順</option><option value="newest">公開日の新しい順</option><option value="views">PVの多い順</option><option value="clicks">検索クリックの多い順</option></select></label></div>
    <div class="kw-table-wrap" role="region" aria-label="公式メディアの記事。横にスクロールできます" tabindex="0"><table class="kw-table workspace-table"><thead><tr><th scope="col">公開記事・主キーワード</th><th scope="col">優先度</th><th scope="col">改善状況</th><th scope="col">PV</th><th scope="col">検索クリック</th><th scope="col">検索表示</th><th scope="col">平均順位</th><th scope="col">操作</th></tr></thead><tbody id="cp-rows"></tbody></table><p id="cp-empty" class="growth-empty" hidden>条件に合う記事がありません。</p></div>
    <div class="kw-pagination"><p class="kw-help" id="cp-count">記事一覧を準備しています。</p><div><button class="kw-button" id="cp-prev" type="button">前へ</button><span id="cp-page">1 / 1</span><button class="kw-button" id="cp-next" type="button">次へ</button></div></div>
  </section>
  <section class="kw-panel"><h2>取得範囲とデータの見方</h2><p class="kw-help" id="cp-period">GA4・Search Consoleの取得状況を確認しています。</p><ul class="workspace-notes"><li>対象は layr.co.jp/media/ 配下です。エルトリ採用ノートの記事は「採用ノート」で管理します。</li><li>取得できなかった指標は「—」です。初回同期前や反映待ちを0件として扱いません。</li><li>公式メディアからの問い合わせ完了は、現在の記事別計測には含まれていません。</li><li>優先度・改善状況・根拠・メモはサーバー共有です。検索ボリュームの自動調査は、別途取得元の接続が必要です。</li></ul><div class="workspace-actions"><a class="kw-button" href="https://layr.co.jp/media/" target="_blank" rel="noopener noreferrer">公開メディアを開く ↗</a><a class="kw-button" href="/strategy/">記事の選定基準を確認</a></div></section>
  <dialog id="cp-editor" class="workspace-dialog" aria-labelledby="cp-editor-title"><header class="kw-section-head"><h2 id="cp-editor-title">記事の改善メモ</h2><button class="kw-button" id="cp-close" type="button">閉じる</button></header><p id="cp-editor-article"></p><form id="cp-form"><p id="cp-editor-message" class="kw-notice" role="alert" hidden></p><div class="kw-form-grid"><label>優先度<select id="cp-edit-priority">{Object.entries(CORPORATE_PRIORITY).map(([value, label]) => <option value={value}>{label}</option>)}</select></label><label>改善状況<select id="cp-edit-status">{Object.entries(CORPORATE_STATUS).map(([value, label]) => <option value={value}>{label}</option>)}</select></label></div><label>管理用の主キーワード<input id="cp-edit-keyword" maxlength="200" /><span class="kw-help">公開記事のキーワード設定は変更しません。</span></label><label>追加する一次情報・根拠<textarea id="cp-edit-evidence" rows="4" maxlength="2000" placeholder="実際の運用手順、確認した資料のURL、取材が必要な内容など"></textarea></label><label>次の作業・改善メモ<textarea id="cp-edit-notes" rows="5" maxlength="4000"></textarea></label><button class="kw-button kw-primary" id="cp-save" type="submit">改善メモを共有保存</button></form></dialog>
  </section>
  <script id="cp-catalog" type="application/json" set:html={serialized}></script>
  <script>import '../../../lib/seo-manager/kiji-app.mjs';</script>
</SeoWorkspace>
