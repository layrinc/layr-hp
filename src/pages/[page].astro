---
/**
 * 下層ページ（ページビルダーで作成した src/data/pages/<slug>.json を描画する動的ルート）。
 * トップページ（index.astro / page-home.json）と同じブロック機構をそのまま使う。
 * blog / admin などの静的ルートが優先されるので衝突しない（エディタ側でも予約語を弾く）。
 */
import Base from '../layouts/Base.astro';
import Block from '../components/Block.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const mods = import.meta.glob('../data/pages/*.json', { eager: true });
  return Object.entries(mods).map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace('.json', '');
    return { params: { page: slug }, props: { pageData: (mod as any).default } };
  });
}

const { pageData } = Astro.props;

// コラム系ブロック（postList / column）用に最新記事を渡す
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = `${pageData.title}｜株式会社LAYR`;
const description = pageData.description || `株式会社LAYRの${pageData.title}のページです。`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: pageData.title },
  ],
};
---
<Base title={title} description={description} jsonLd={[breadcrumbJsonLd]}>
  <div class="subpage-pad"></div>
  {pageData.blocks.map((block: any) => {
    const fs = Number(block.p?._fs) || 1;
    return fs !== 1
      ? <div style={`--fs:${fs}`}><Block block={block} posts={posts} /></div>
      : <Block block={block} posts={posts} />;
  })}
</Base>
