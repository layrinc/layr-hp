---
/**
 * お問い合わせ専用ページ。
 * ①LINEで問い合わせる（おすすめ・最短） ②メールフォーム の2択構成。
 * フォームはトップの contact ブロックと同じ FormSubmit AJAX＋メール下書きフォールバック。
 */
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';

const title = 'LINE運用のご相談・お問い合わせ｜株式会社LAYR';
const description = 'LINE公式アカウントの構築代行・運用代行に関するご相談はこちら。LINEトークまたはメールフォームから、通常1営業日以内にご返信します。無料相談はオンライン30分、この段階での売り込みは行いません。';

const lineHref = settings.line_url?.trim()
  ? settings.line_url
  : `mailto:${settings.email}?subject=${encodeURIComponent('【無料相談】LINE活用について')}`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://layr.co.jp/' },
    { '@type': 'ListItem', position: 2, name: 'お問い合わせ' },
  ],
};
---
<Base title={title} description={description} jsonLd={[breadcrumbJsonLd]}>
  <section class="ct">
    <div class="container ct-wrap">
      <p class="ct-eyebrow"><i></i><span>CONTACT</span></p>
      <h1 class="ct-title">お問い合わせ</h1>
      <p class="ct-lead">無料相談のご予約も、ざっくりしたご質問も歓迎です。通常1営業日以内にご返信します。この段階での売り込みは行いません。</p>

      <!-- ① LINEで相談する -->
      <div class="ct-card is-line">
        <span class="ct-badge">一番かんたん</span>
        <h2>LINEで相談する</h2>
        <p>友だち追加のあと、トーク画面にご相談内容をひと言送るだけ。<br />かしこまった文面は不要です。</p>
        <a class="ct-linebtn" href={lineHref}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11c0 3.9 3.5 7.2 8.2 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5 1.1-.4 5.8-3.4 7.9-5.8 1.4-1.6 2.2-3.2 2.2-5C22 6.6 17.5 3 12 3z"/></svg>
          友だち追加して相談する
          <svg class="ct-ar" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h15M11 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>

      <p class="ct-divider"><span>LINEを使っていない場合は、下のメールフォームからご連絡ください。</span></p>

      <!-- ② メールで問い合わせる -->
      <div class="ct-card is-mail">
        <h2>メールで問い合わせる</h2>
        <form class="ct-form" id="ctForm" action={`https://formsubmit.co/${settings.email}`} method="POST">
          <input type="hidden" name="_subject" value="【LAYRサイト】お問い合わせ" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <div class="ct-grid">
            <label>お名前 <span class="req">必須</span>
              <input type="text" name="お名前" required placeholder="山田 太郎" autocomplete="name" />
            </label>
            <label>会社名・屋号
              <input type="text" name="会社名" placeholder="株式会社◯◯（任意）" autocomplete="organization" />
            </label>
            <label>メールアドレス <span class="req">必須</span>
              <input type="email" name="メールアドレス" required placeholder="you@example.com" autocomplete="email" />
            </label>
            <label>ご相談内容
              <select name="ご相談内容">
                <option>無料相談の予約（オンライン30分）</option>
                <option>LINE公式アカウント構築について</option>
                <option>LINE運用支援について</option>
                <option>その他</option>
              </select>
            </label>
          </div>
          <label class="ct-msg">お問い合わせ内容 <span class="req">必須</span>
            <textarea name="お問い合わせ内容" rows="6" required placeholder="現状のLINEの運用状況や、相談したいことをご記入ください。"></textarea>
          </label>
          <button class="ct-submit" type="submit" id="ctSubmit">
            送信する
            <svg class="ct-ar" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h15M11 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <p class="ct-ok" id="ctOk" hidden>✅ 送信しました。通常1営業日以内にご返信します。</p>
          <div class="ct-fb" id="ctFb" hidden>
            <p>送信システムに接続できませんでした。お手数ですが、下のボタンからメールでお送りください（内容は自動でセットされます）。</p>
            <a class="ct-fbbtn" id="ctMailto" href="#">メールで送る</a>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ ctEmail: settings.email }}>
    (function () {
      const form = document.getElementById('ctForm');
      if (!form || form.dataset.bound) return;
      form.dataset.bound = '1';
      const btn = document.getElementById('ctSubmit');
      const ok = document.getElementById('ctOk');
      const fb = document.getElementById('ctFb');
      const ml = document.getElementById('ctMailto');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (form.querySelector('[name="_honey"]').value) return;
        btn.disabled = true;
        const prev = btn.firstChild.textContent;
        btn.firstChild.textContent = '送信中… ';
        const data = new FormData(form);
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 8000);
        try {
          const res = await fetch(form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/'), {
            method: 'POST', body: data, headers: { Accept: 'application/json' }, signal: ctrl.signal,
          });
          clearTimeout(timer);
          if (!res.ok) throw new Error('http ' + res.status);
          form.querySelectorAll('input:not([type="hidden"]), textarea').forEach((el) => { el.value = ''; });
          ok.hidden = false; fb.hidden = true;
          ok.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } catch (_) {
          clearTimeout(timer);
          const g = (n) => String(data.get(n) || '');
          const body = 'お名前: ' + g('お名前') + '\n会社名: ' + g('会社名') + '\nメール: ' + g('メールアドレス') + '\nご相談内容: ' + g('ご相談内容') + '\n\n' + g('お問い合わせ内容');
          ml.href = 'mailto:' + ctEmail + '?subject=' + encodeURIComponent('【お問い合わせ】LAYRサイトより') + '&body=' + encodeURIComponent(body);
          fb.hidden = false;
          fb.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } finally {
          btn.disabled = false;
          btn.firstChild.textContent = prev;
        }
      });
    })();
  </script>

  <style>
    .ct{padding:150px 0 110px}
    .ct-wrap{max-width:820px}
    .ct-eyebrow{display:flex;align-items:center;gap:12px;font-family:var(--font-en);font-weight:800;font-size:12px;letter-spacing:.22em;color:var(--green-dark);margin-bottom:14px}
    .ct-eyebrow i{display:block;width:30px;height:1.5px;background:var(--green-dark)}
    .ct-title{font-size:clamp(28px,4vw,40px);font-weight:900;letter-spacing:-.015em;color:#0E1A1C;margin:0 0 14px}
    .ct-lead{font-size:15px;line-height:2;color:#1B2A2E;max-width:40em;margin:0 0 42px}

    .ct-card{border-radius:22px;padding:clamp(26px,4vw,40px);margin:0 0 8px}
    .ct-card h2{font-size:clamp(20px,2.6vw,26px);font-weight:900;color:#0E1A1C;margin:0 0 12px;letter-spacing:-.01em}
    .ct-card > p{font-size:14.5px;line-height:2;color:#1B2A2E;margin:0 0 22px}

    .ct-card.is-line{background:color-mix(in srgb, #06C755 6%, #fff);border:2px solid var(--green)}
    .ct-badge{display:inline-block;background:var(--green);color:#fff;font-weight:800;font-size:12px;letter-spacing:.06em;border-radius:999px;padding:7px 18px;margin-bottom:16px}
    .ct-linebtn{
      display:flex;align-items:center;justify-content:center;gap:10px;width:100%;
      background:#06C755;color:#fff;font-weight:800;font-size:16px;
      border-radius:14px;padding:19px 24px;transition:background .2s,transform .2s;
    }
    .ct-linebtn:hover{background:#05B34C;transform:translateY(-2px)}
    .ct-linebtn svg:first-child{width:22px;height:22px}

    .ct-divider{display:flex;align-items:center;gap:16px;margin:34px 0;color:#1B2A2E;font-size:13.5px;font-weight:600;line-height:1.8}
    .ct-divider::before,.ct-divider::after{content:"";flex:1;height:1px;background:#D8E3E5}

    .ct-card.is-mail{background:#fff;border:2px solid #0E1A1C}
    .ct-form label{display:flex;flex-direction:column;gap:7px;font-weight:800;font-size:13px;color:#0E1A1C;position:relative}
    .ct-form .req{position:absolute;right:0;top:0;font-size:10px;font-weight:800;color:#fff;background:var(--green);border-radius:4px;padding:1.5px 7px}
    .ct-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px 18px;margin-bottom:16px}
    .ct-form input,.ct-form select,.ct-form textarea{
      font-family:inherit;font-size:14.5px;padding:12px 14px;
      border:1.5px solid #C7D5D7;border-radius:10px;background:#fff;color:#0E1A1C;
      outline:none;line-height:1.7;width:100%;transition:border-color .2s,box-shadow .2s;
    }
    .ct-form input::placeholder,.ct-form textarea::placeholder{color:#8FA0A3}
    .ct-form input:focus,.ct-form select:focus,.ct-form textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px color-mix(in srgb, var(--green) 14%, transparent)}
    .ct-msg{margin-bottom:18px}
    .ct-submit{
      display:flex;align-items:center;justify-content:center;gap:10px;width:100%;
      background:#0E1A1C;color:#fff;font-family:inherit;font-weight:800;font-size:15.5px;
      border:none;border-radius:14px;padding:18px 24px;cursor:pointer;transition:opacity .2s,transform .2s;
    }
    .ct-submit:hover{opacity:.88;transform:translateY(-2px)}
    .ct-submit:disabled{opacity:.6}
    .ct-ar{width:16px;height:10px}
    .ct-ok{margin:16px 0 0;font-weight:800;font-size:14px;color:var(--green-dark)}
    .ct-ok[hidden],.ct-fb[hidden]{display:none!important}
    .ct-fb{margin:16px 0 0;background:#FBF6E8;border:1.5px dashed #C9A53A;border-radius:10px;padding:14px 16px}
    .ct-fb p{font-size:13px;line-height:1.9;color:#5C4A12;margin:0 0 10px;font-weight:600}
    .ct-fbbtn{display:inline-block;background:#0E1A1C;color:#fff;font-weight:800;font-size:13.5px;border-radius:999px;padding:11px 26px}

    @media (max-width:640px){
      .ct{padding:120px 0 80px}
      .ct-grid{grid-template-columns:1fr}
    }
  </style>
</Base>
