<script is:inline>
  // カテゴリ×キーワードのクライアントサイド絞り込み。
  // 検索窓はページ最下部、結果（カード一覧）は上。明示的な検索実行のときだけ結果までスクロールする。
  (function () {
    var grid = document.getElementById('bjGrid');
    if (!grid || grid.dataset.bound) return;
    var input = document.getElementById('bjSearch');
    var btn = document.getElementById('bjSearchBtn');
    var empty = document.getElementById('bjEmpty');
    var count = document.getElementById('bjCount');
    var live = document.getElementById('bjLive');
    if (!input || !btn || !empty || !count || !live) return;
    grid.dataset.bound = '1';
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.bj-card'));
    var total = cards.length;
    var cat = '';
    var countTimer = null;

    function updateCount(raw, shown) {
      count.textContent = raw
        ? '「' + raw + '」の検索結果：' + shown + '件'
        : 'カテゴリで絞り込む（' + (shown === total ? '全' : '') + shown + '本）';
      // 見出しは即時更新。読み上げだけ遅らせて連呼を防ぐ。
      if (countTimer) clearTimeout(countTimer);
      countTimer = setTimeout(function () { live.textContent = count.textContent; }, 400);
    }

    function apply(opts) {
      var raw = (input.value || '').trim();
      var q = raw.toLowerCase();
      var shown = 0;
      cards.forEach(function (c) {
        var ok = (!cat || c.dataset.cat === cat) && (!q || c.dataset.text.indexOf(q) !== -1);
        c.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      empty.hidden = shown > 0;
      updateCount(raw, shown);
      if (opts && opts.scroll) {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        count.scrollIntoView({ block: 'start', behavior: reduce ? 'instant' : 'smooth' });
        // 検索窓は最下部。スクロールだけだとフォーカスが画面外に取り残されるので、
        // 明示実行（Enter／検索ボタン）のときだけ結果の見出しへフォーカスを移す。
        count.focus({ preventScroll: true });
      }
    }

    document.querySelectorAll('.bj-cat').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('.bj-cat').forEach(function (x) { x.classList.remove('on'); x.setAttribute('aria-pressed', 'false'); });
        b.classList.add('on');
        b.setAttribute('aria-pressed', 'true');
        cat = b.dataset.cat || '';
        apply();
      });
    });
    // 1打鍵ごとにページが飛ぶとモバイルで操作できなくなるので、逐次入力ではスクロールしない
    input.addEventListener('input', function () { apply(); });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); apply({ scroll: true }); }
    });
    btn.addEventListener('click', function () { apply({ scroll: true }); });
  })();

  // タブ（業種別／課題別）の共通コントローラ。data-find でグループを識別する。
  // ハッシュ文法は #<グループ名>-<key>（#industry-beauty / #issue-start）。
  // 業種CTAのリンク先は /case/ 側の文法（接頭辞なしの業種key）。こちらとは混ぜない。
  // ハッシュが表すのは「最後に触ったタブ1つ」だけ。2グループの状態を同時に符号化はしない。
  (function () {
    var sections = Array.prototype.slice.call(document.querySelectorAll('[data-find]'));
    if (!sections.length) return;
    var RE = /^#([a-z]+)-([a-z]+)$/;

    var reg = sections.map(function (sec) {
      return {
        name: sec.getAttribute('data-find'),
        sec: sec,
        // 必ずセクションでスコープする。document 全体から拾うと、
        // 業種タブの末尾で ArrowRight したときフォーカスが課題タブへ飛ぶ。
        tabs: Array.prototype.slice.call(sec.querySelectorAll('.bj-find-tab')),
        panels: Array.prototype.slice.call(sec.querySelectorAll('.bj-find-panel')),
      };
    });

    function idxOf(g, key) {
      for (var i = 0; i < g.tabs.length; i++) {
        if (g.tabs[i].getAttribute('data-key') === key) return i;
      }
      return -1;
    }

    function select(g, key, opts) {
      var idx = idxOf(g, key);
      if (idx < 0) return false;
      opts = opts || {};
      g.tabs.forEach(function (t, i) {
        var on = i === idx;
        if (on) { t.classList.add('is-on'); } else { t.classList.remove('is-on'); }
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      g.panels.forEach(function (p) { p.hidden = p.getAttribute('data-key') !== key; });
      if (opts.focus) {
        g.tabs[idx].focus();
        // 横スクロールのタブ行で、選択が可視域外に残らないようにする
        g.tabs[idx].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
      if (opts.hash) { try { history.replaceState(null, '', '#' + g.name + '-' + key); } catch (e) {} }
      if (opts.track && typeof gtag === 'function') {
        gtag('event', 'select_content', { content_type: 'media_' + g.name + '_tab', item_id: key });
      }
      return true;
    }

    reg.forEach(function (g) {
      g.tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          // クリック由来では focus を動かさない（focus ringとスクロールの副作用を避ける）
          select(g, t.getAttribute('data-key'), { hash: true, track: true });
        });
        t.addEventListener('keydown', function (e) {
          var cur = idxOf(g, t.getAttribute('data-key'));
          var next = -1;
          if (e.key === 'ArrowRight') next = (cur + 1) % g.tabs.length;
          else if (e.key === 'ArrowLeft') next = (cur - 1 + g.tabs.length) % g.tabs.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = g.tabs.length - 1;
          if (next < 0) return;
          e.preventDefault();
          select(g, g.tabs[next].getAttribute('data-key'), { focus: true, hash: true, track: true });
        });
      });
    });

    function route(hash, scroll) {
      var m = RE.exec(hash || '');
      if (!m) return;
      for (var i = 0; i < reg.length; i++) {
        if (reg[i].name !== m[1]) continue;
        if (!select(reg[i], m[2], {})) return;
        if (!scroll) return;
        var sec = reg[i].sec;
        // html{scroll-behavior:smooth} は behavior:'auto' を smooth 化し、
        // フラグメント遷移のスクロールリセットに打ち消される。'instant' で確実に飛ばす。
        var jump = function () { sec.scrollIntoView({ block: 'start', behavior: 'instant' }); };
        if (document.readyState === 'complete') jump();
        else window.addEventListener('load', jump, { once: true });
        return;
      }
    }

    route(location.hash, true);
    window.addEventListener('hashchange', function () { route(location.hash, false); });
  })();
</script>
