---
/**
 * LAYR公式メディア一覧（/media/）— WordPress風ブログUI。
 * 構成: ヒーロー → 業種別に探す → 課題から探す → カテゴリ絞り込み＋3列カードグリッド → キーワード検索。
 * サムネイルは記事画像が無い場合、カテゴリ別のアイソメトリックイラストで自動生成。
 */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import industries from '../../data/industries.json';
import { ISO } from '../../lib/iso-illusts.mjs';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const iso = (d: Date) => d.toISOString().slice(0, 10);

// カテゴリ一覧（件数つき）
const cats = [...new Set(posts.map((p) => p.data.category))];
const catCount = (c: string) => posts.filter((p) => p.data.category === c).length;

// カテゴリ→サムネイル用イラスト
const CAT_ISO: Record<string, string> = {
  'LINEマーケティング': ISO.phone,
  'LINE運用': ISO.chart,
  '事例': ISO.report,
};
const thumbOf = (c: string) => CAT_ISO[c] || ISO.build;

// slug → 記事。存在しないslugを書いたらビルドを失敗させる。
const byId = new Map(posts.map((p) => [p.id, p]));

type FindCta = { question: string; linkLabel: string; href: string; note: string };
type FindSrc = { key: string; label: string; lead: string; slugs: string[]; cta: FindCta };
// 業種CTAのhrefは省略可。省略時は /case/#<業種key> を自動で組む（下のINDUSTRIES生成を参照）。
type IndustryCta = Omit<FindCta, 'href'> & { href?: string };

// slugを記事タイトルへ解決する。タイトルはfrontmatterから引くので、
// 記事側を直せばここも自動で追従する（表記の乖離が起きない）。
const resolve = (where: string, slugs: string[]) =>
  slugs.map((sl) => {
    const post = byId.get(sl);
    if (!post) throw new Error(`${where}: 記事 "${sl}" が見つかりません（src/content/blog/${sl}.md）`);
    return { slug: sl, title: post.data.title };
  });

// 業種別に探すタブ（8業種×3記事）。
// label・key・並び順は src/data/industries.json（/case/ と共有の正本）から引く。表記の乖離を作らない。
// ここは「その業種の方が読むと役に立つ3本」の編集キュレーションであって、業種専用記事の一覧ではない。
// （記事19本のうち業種名が明示されているのは line-meo-restaurant と apparel-sale-line-notice の2本だけ）
// industries.json の pain を書き換えたときは、下の lead も合わせて見直すこと。
const INDUSTRY_COPY: Record<string, { lead: string; slugs: string[]; cta: IndustryCta }> = {
  beauty: {
    lead: '施術中に取りこぼす予約と、間隔が空いていく再来店。手を打つ順番は、店頭の導線づくりと、配信の出し分けです。サロンの現場で判断材料になる3本を選びました。',
    slugs: ['line-friends-growth', 'line-block-rate', 'line-operation-cost'],
    cta: {
      question: 'サロンだと、どこから手をつけますか？',
      linkLabel: '美容サロンの使い方を見る →',
      note: '※記事3本は業種を限定した内容ではありません。美容サロン向けの使い方と来店までの流れは、支援実績ページ内の「業種別の、おすすめの使い方」にまとめています。',
    },
  },
  seitai: {
    lead: '1件の問い合わせにいくらかかっているのか読めない。その計算の土台になる指標の言葉と、広告に頼る前に埋めておきたい導線の話を集めた3本です。広告費を続けるかの判断材料に。',
    slugs: ['ad-line-funnel', 'line-friends-growth', 'line-glossary-metrics'],
    cta: {
      question: '治療院では、どんな流れになりますか？',
      linkLabel: '整体院・治療院の使い方を見る →',
      note: '※記事は業種横断の内容です。整体院・治療院向けの使い方3つと来院までの流れは、支援実績ページ内の業種別セクションに載せています。',
    },
  },
  clinic: {
    lead: '受付に集まる予約変更の電話と、反応の薄い検診案内。どこまで自動化できるかは、機能の名前と、配信の分け方を知るところからです。院内の体制づくりに使える3本を選びました。',
    slugs: ['line-glossary-basic', 'line-block-rate', 'line-inhouse-vs-outsource'],
    cta: {
      question: '受付の負担は、どこまで減らせますか？',
      linkLabel: 'クリニック・歯科の使い方を見る →',
      note: '※支援実績ページ内の「業種別の、おすすめの使い方」で、クリニック・歯科の使い方3つと、登録から次の検診までの流れを見られます。',
    },
  },
  restaurant: {
    lead: '掲載サイトを通さず、来店したお客様と直接つながる導線をどう作るか。店内のQRから口コミとLINEを同時に積む話を軸に、飲食の現場で確かめられる3本を集めました。',
    slugs: ['line-meo-restaurant', 'line-friends-growth', 'line-glossary-basic'],
    cta: {
      question: '自店の来店数だと、どこまで積み上がりますか？',
      linkLabel: '飲食店の使い方を見る →',
      note: '※リンク先は支援実績ページ内の業種別セクションです。飲食店の使い方3つと、QRからの登録・再来店までの流れを載せています。',
    },
  },
  school: {
    lead: '体験には来るのに、その後の検討期間が埋められない。順番に届く配信の考え方と、メールとの使い分けを扱った記事を選びました。在校生と検討中の方を分ける話も入っています。',
    slugs: ['line-vs-mail', 'line-glossary-delivery', 'line-block-rate'],
    cta: {
      question: '体験のあとは、何をいつ送りますか？',
      linkLabel: 'スクール・教室の使い方を見る →',
      note: '※支援実績ページ内の業種別セクションに、体験申込から入会までのお客様の動きと、期待できる変化を載せています。',
    },
  },
  shigyo: {
    lead: '紹介が途切れたときに、連絡できる相手が手元に残っているか。すぐには動かない見込み客との接点の残し方と、メールとLINEの線引きを扱った3本です。',
    slugs: ['ad-line-funnel', 'line-vs-mail', 'line-friends-growth'],
    cta: {
      question: 'うちの相談導線は、どこが抜けていますか？',
      linkLabel: '無料相談で現状を見てもらう →',
      href: '/contact/',
      note: '※現状のお困りごとを伺う、オンライン30分の無料相談です。',
    },
  },
  realestate: {
    lead: '希望条件の聞き取りと、すぐ決めない方の追いかけ。この2つを人の手から仕組みへ移すために、タグ・フォーム・リマインドまわりを扱った記事を集めました。',
    slugs: ['ad-line-funnel', 'line-block-rate', 'line-glossary-lstep'],
    cta: {
      question: '条件のヒアリングは、どこまでLINEでできますか？',
      linkLabel: '不動産の使い方を見る →',
      note: '※支援実績ページ内の業種別セクションに、問い合わせから内見までの流れと、不動産での使い方3つを載せています。',
    },
  },
  retail: {
    lead: 'メルマガが開かれない。セールのたびに広告費で新規を集め直している。その構造を見直すための3本を、アパレルのセール告知の型を含めて選びました。',
    slugs: ['apparel-sale-line-notice', 'line-vs-mail', 'ad-line-funnel'],
    cta: {
      question: 'うちの規模だと、いくらになりますか？',
      linkLabel: '料金と作業範囲を確認する →',
      href: '/service/line/',
      note: '※構築と運用の3プランを公開しています。ページ内に、30秒で目安が出る料金シミュレーションがあります。',
    },
  },
};

// industries.json に無いkeyを書いたらビルドを失敗させる（/case/ との業種セットのズレ検知）
const INDUSTRY_KEYS = new Set(industries.map((iv) => iv.key));
for (const k of Object.keys(INDUSTRY_COPY)) {
  if (!INDUSTRY_KEYS.has(k)) {
    throw new Error(`業種タブ: key "${k}" は src/data/industries.json に存在しません`);
  }
}

const INDUSTRIES = industries.map((iv) => {
  const copy = INDUSTRY_COPY[iv.key];
  if (!copy) throw new Error(`業種タブ: industries.json の key "${iv.key}" に対応するコピーがありません`);
  return {
    key: iv.key,
    label: iv.label,
    lead: copy.lead,
    // 「クリニック・歯科の使い方を見る」の着地先は、必ずその業種のタブが開いた状態にする。
    // /case/ 側は接頭辞なしの業種key（#clinic）でタブを開き #industry へスクロールする。
    // '/case/#industry' 固定だと文言と関係なく先頭の美容サロンが開いてしまう。
    cta: { ...copy.cta, href: copy.cta.href ?? `/case/#${iv.key}` },
    articles: resolve(`業種タブ(${iv.key})`, copy.slugs),
  };
});

// 課題から探すタブ（4課題×3記事）
const ISSUES_SRC: FindSrc[] = [
  {
    key: 'start',
    label: 'LINEを始めたい',
    lead: 'LINE公式アカウントをこれから立ち上げる段階の記事です。友だちをどこから集めるか、店舗ならどう導線を作るか、社内で話すための基本用語までをまとめました。',
    slugs: ['line-friends-growth', 'line-meo-restaurant', 'line-glossary-basic'],
    cta: {
      question: '何から始めるか、支援内容と料金を見て決めますか。',
      linkLabel: 'LINE構築・運用のサービス詳細と料金を見る →',
      href: '/service/line/',
      note: '※支援範囲と料金を掲載しているページです。',
    },
  },
  {
    key: 'delivery',
    label: '配信が読まれない',
    lead: '配信しても開かれない、ブロックされてしまう。その原因を配信設計の側から確認できます。メールとの届き方の違いと、シナリオを組むときに必要な用語もまとめました。',
    slugs: ['line-block-rate', 'line-vs-mail', 'line-glossary-delivery'],
    cta: {
      question: '自分の業種ではどう配信するのか、使い方の例から確認しますか。',
      linkLabel: '業種別のおすすめの使い方を見る →',
      href: '/case/#industry',
      note: '※業種ごとの活用例をまとめたページです。',
    },
  },
  {
    key: 'revenue',
    label: '売上につながらない',
    lead: '友だちは増えたのに売上が動かないとき、どこで止まっているかを確認できます。広告費を回収する考え方、セール時に初日から売る配信の型、見るべき指標の読み方を扱います。',
    slugs: ['ad-line-funnel', 'apparel-sale-line-notice', 'line-glossary-metrics'],
    cta: {
      question: 'どこで止まっているか、現状を見ながら相談しますか。',
      linkLabel: '無料相談を申し込む →',
      href: '/contact/',
      note: '※無料相談のフォームです。費用は発生しません。',
    },
  },
  {
    key: 'outsource',
    label: '運用を外注したい',
    lead: '自社で続けるか外注するかの判断材料と、代行会社を選ぶときの比較軸、費用が会社ごとに大きく変わる理由をまとめました。発注前の見積もり比較に使えます。',
    slugs: ['line-inhouse-vs-outsource', 'line-operation-agency', 'line-operation-cost'],
    cta: {
      question: '比較検討用に、支援範囲と料金をまとめた資料が必要ですか。',
      linkLabel: 'LINE構築・運用サービス資料をダウンロード →',
      href: '/document/line-service/',
      note: '※フォーム送信後、その場でPDFをダウンロードいただけます。費用はかかりません。',
    },
  },
];

const ISSUES = ISSUES_SRC.map((t) => ({
  ...t,
  articles: resolve('課題タブ', t.slugs),
}));

const title = 'LAYR公式メディア｜LINEマーケティング運用コラム';
const description = 'LINE公式アカウントの構築・運用の現場から、ブロック率の下げ方、ステップ配信の設計、メルマガとの使い分けなど、地方中小企業・スクール・店舗がすぐ使えるLINEマーケティングの実務ノウハウを発信しています。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'LAYR公式メディア' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'LAYR公式メディア｜LINEマーケティング運用コラム',
    url: new URL('/media/', Astro.site).href,
    inLanguage: 'ja',
    isPartOf: { '@id': 'https://layr.co.jp/#website' },
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- ヒーロー -->
  <header class="bj-hero">
    <div class="container">
      <nav class="bj-bc" aria-label="パンくず"><a href="/">トップ</a><span>／</span><em>LAYR公式メディア</em></nav>
      <p class="bj-badge">LAYR MEDIA</p>
      <h1>LAYR公式メディア<br class="sp" /><span class="bj-h1-sub">LINEマーケティング運用コラム</span></h1>
      <p class="bj-lead">LINE公式アカウントの構築・運用の現場から、地方の店舗・スクール・BtoBがそのまま使える手順を公開しています。</p>
    </div>
    <span class="bj-wm" aria-hidden="true">COLUMN</span>
  </header>

  <!-- 業種別に探す（8業種→3本の編集キュレーション。グリッドの絞り込みとは独立） -->
  <section class="bj-find bj-find--industry" id="bjFindIndustry" data-find="industry">
    <div class="container">
      <div class="sec-head">
        <p class="sec-en">FIND BY INDUSTRY</p>
        <h2 class="sec-jp" id="bj-find-h-industry">業種別に探す</h2>
      </div>

      <p class="bj-find-intro">同じLINEでも、業種が違えば最初に手をつける場所が変わります。近い業種を選ぶと、その業種の方が読んで役に立つ3本をお出しします。</p>
      <small class="bj-find-note">※ 業種専用の記事ではありません。どの記事も、他の業種の方が読んでも通用する内容です。</small>

      <div class="bj-find-tabs" role="tablist" aria-labelledby="bj-find-h-industry">
        {INDUSTRIES.map((t, i) => (
          <button
            type="button"
            role="tab"
            class={`bj-find-tab${i === 0 ? ' is-on' : ''}`}
            id={`bj-industry-tab-${t.key}`}
            aria-controls={`bj-industry-panel-${t.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-key={t.key}
          >{t.label}</button>
        ))}
      </div>

      <div class="bj-find-panels">
        {INDUSTRIES.map((t, i) => (
          <div
            class="bj-find-panel"
            role="tabpanel"
            id={`bj-industry-panel-${t.key}`}
            aria-labelledby={`bj-industry-tab-${t.key}`}
            tabindex="0"
            data-key={t.key}
            hidden={i !== 0}
          >
            <p class="bj-find-lead">{t.lead}</p>
            <ul class="bj-find-list">
              {t.articles.map((a) => (
                <li><a class="bj-find-link" href={`/media/${a.slug}/`}>{a.title}</a></li>
              ))}
            </ul>
            <div class="bj-find-cta">
              <p class="bj-find-ask">{t.cta.question}</p>
              <a class="bj-find-go" href={t.cta.href}>{t.cta.linkLabel}</a>
              <small class="bj-find-note">{t.cta.note}</small>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 課題から探す（19本→3本の編集キュレーション。グリッドの絞り込みとは独立） -->
  <section class="bj-find bj-find--issue" id="bjIssue" data-find="issue">
    <div class="container">
      <div class="sec-head">
        <p class="sec-en">FIND BY ISSUE</p>
        <h2 class="sec-jp" id="bj-find-h-issue">課題から探す</h2>
      </div>

      <p class="bj-find-intro">業種が違っても、つまずく場所は同じです。いま止まっているところから選んでください。</p>

      <div class="bj-find-tabs" role="tablist" aria-labelledby="bj-find-h-issue">
        {ISSUES.map((t, i) => (
          <button
            type="button"
            role="tab"
            class={`bj-find-tab${i === 0 ? ' is-on' : ''}`}
            id={`bj-issue-tab-${t.key}`}
            aria-controls={`bj-issue-panel-${t.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-key={t.key}
          >{t.label}</button>
        ))}
      </div>

      <div class="bj-find-panels">
        {ISSUES.map((t, i) => (
          <div
            class="bj-find-panel"
            role="tabpanel"
            id={`bj-issue-panel-${t.key}`}
            aria-labelledby={`bj-issue-tab-${t.key}`}
            tabindex="0"
            data-key={t.key}
            hidden={i !== 0}
          >
            <p class="bj-find-lead">{t.lead}</p>
            <ul class="bj-find-list">
              {t.articles.map((a) => (
                <li><a class="bj-find-link" href={`/media/${a.slug}/`}>{a.title}</a></li>
              ))}
            </ul>
            <div class="bj-find-cta">
              <p class="bj-find-ask">{t.cta.question}</p>
              <a class="bj-find-go" href={t.cta.href}>{t.cta.linkLabel}</a>
              <small class="bj-find-note">{t.cta.note}</small>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container bj-main">
    <!-- カテゴリチップ（tablistではなくトグルボタン群。課題タブと役割を分ける） -->
    <!-- 見出し＝一覧の開始位置。検索実行時のスクロール着地点とフォーカス移動先も兼ねる（検索窓はページ最下部）。
         読み上げ用のライブリージョンは別要素に分ける。1要素で兼ねると、検索したとき
         絞り込みUIの可視ラベルが件数表示に置き換わって消えてしまう。 -->
    <h2 class="bj-cats-label" id="bjCount" tabindex="-1">カテゴリで絞り込む（全{posts.length}本）</h2>
    <p class="bj-live" id="bjLive" role="status"></p>
    <div class="bj-cats" role="group" aria-label="カテゴリで絞り込み">
      <button type="button" class="bj-cat on" data-cat="" aria-pressed="true">すべて</button>
      {cats.map((c) => (
        <button type="button" class="bj-cat" data-cat={c} aria-pressed="false">{c}<i>{catCount(c)}</i></button>
      ))}
    </div>

    <!-- 3列カードグリッド -->
    <div class="bj-grid" id="bjGrid">
      {posts.map((post) => (
        <a
          class="bj-card"
          href={`/media/${post.id}/`}
          data-cat={post.data.category}
          data-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
        >
          <div class="bj-thumb">
            <span class="bj-thumb-iso" set:html={thumbOf(post.data.category)} />
            <span class="bj-thumb-cat">{post.data.category}</span>
          </div>
          <div class="bj-body">
            <time datetime={iso(post.data.date)}>{fmt(post.data.date)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="bj-more">続きを読む ›</span>
          </div>
        </a>
      ))}
    </div>
    <p class="bj-empty" id="bjEmpty" hidden>該当する記事が見つかりませんでした。条件を変えてお試しください。</p>
  </div>

  <!-- キーワード検索（結果は上のカード一覧に反映される） -->
  <section class="bj-search-sec" id="bjSearchSec" aria-labelledby="bj-search-h">
    <div class="container">
      <div class="sec-head">
        <p class="sec-en">SEARCH</p>
        <h2 class="sec-jp" id="bj-search-h">キーワードで探す</h2>
      </div>
      <p class="bj-find-intro">記事のタイトルと概要から探します。結果はページ上部の一覧に表示されます。</p>
      <div class="bj-search" role="search" aria-label="記事をキーワードで検索">
        <input type="search" id="bjSearch" aria-controls="bjGrid" placeholder="キーワードで記事を検索" aria-label="記事を検索" />
        <button type="button" id="bjSearchBtn" aria-controls="bjGrid">検索</button>
      </div>
    </div>
  </section>
</Base>

<style>
