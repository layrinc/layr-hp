---
/**
 * LAYR公式メディア一覧（/media/）— WordPress風ブログUI。
 * 3列カードグリッド＋キーワード検索＋カテゴリチップ（クライアントサイドフィルタ）。
 * サムネイルは記事画像が無い場合、カテゴリ別のアイソメトリックイラストで自動生成。
 */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { ISO } from '../../lib/iso-illusts.mjs';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const iso = (d: Date) => d.toISOString().slice(0, 10);

// カテゴリ一覧（件数つき）
const cats = [...new Set(posts.map((p) => p.data.category))];
const catCount = (c: string) => posts.filter((p) => p.data.category === c).length;

// カテゴリ→サムネイル用イラスト
const CAT_ISO: Record<string, string> = {
  'LINEマーケティング': ISO.phone,
  'LINE運用': ISO.chart,
  '事例': ISO.report,
};
const thumbOf = (c: string) => CAT_ISO[c] || ISO.build;

const title = 'LAYR公式メディア｜LINEマーケティング運用コラム';
const description = 'LINE公式アカウントの構築・運用の現場から、ブロック率の下げ方、ステップ配信の設計、メルマガとの使い分けなど、地方中小企業・スクール・店舗がすぐ使えるLINEマーケティングの実務ノウハウを発信しています。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'LAYR公式メディア' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'LAYR公式メディア｜LINEマーケティング運用コラム',
    url: new URL('/media/', Astro.site).href,
    inLanguage: 'ja',
    isPartOf: { '@id': 'https://layr.co.jp/#website' },
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- ヒーロー -->
  <header class="bj-hero">
    <div class="container">
      <nav class="bj-bc" aria-label="パンくず"><a href="/">トップ</a><span>／</span><em>LAYR公式メディア</em></nav>
      <p class="bj-badge">LAYR MEDIA</p>
      <h1>LAYR公式メディア<br class="sp" /><span class="bj-h1-sub">LINEマーケティング運用コラム</span></h1>
      <div class="bj-search" role="search">
        <input type="search" id="bjSearch" placeholder="キーワードで記事を検索" aria-label="記事を検索" />
        <button type="button" id="bjSearchBtn">検索</button>
      </div>
    </div>
    <span class="bj-wm" aria-hidden="true">COLUMN</span>
  </header>

  <div class="container bj-main">
    <!-- カテゴリチップ -->
    <div class="bj-cats" role="tablist" aria-label="カテゴリで絞り込み">
      <button class="bj-cat on" data-cat="">すべて</button>
      {cats.map((c) => (
        <button class="bj-cat" data-cat={c}>{c}<i>{catCount(c)}</i></button>
      ))}
    </div>

    <!-- 3列カードグリッド -->
    <div class="bj-grid" id="bjGrid">
      {posts.map((post) => (
        <a
          class="bj-card"
          href={`/media/${post.id}/`}
          data-cat={post.data.category}
          data-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
        >
          <div class="bj-thumb">
            <span class="bj-thumb-iso" set:html={thumbOf(post.data.category)} />
            <span class="bj-thumb-cat">{post.data.category}</span>
          </div>
          <div class="bj-body">
            <time datetime={iso(post.data.date)}>{fmt(post.data.date)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="bj-more">続きを読む ›</span>
          </div>
        </a>
      ))}
    </div>
    <p class="bj-empty" id="bjEmpty" hidden>該当する記事が見つかりませんでした。条件を変えてお試しください。</p>
  </div>
</Base>

<style>
  /* hero */
  .bj-hero{position:relative;background:linear-gradient(160deg,#F4FAF8 0%,#fff 55%,#EDF7F2 100%);padding:clamp(36px,5vw,64px) 0 clamp(40px,5vw,64px);overflow:hidden;border-bottom:1px solid var(--line,#E3ECEC)}
  .bj-bc{font-size:12px;color:var(--muted);margin-bottom:22px}
  .bj-bc a{color:var(--green-dark);font-weight:700;text-decoration:none}
  .bj-bc span{opacity:.4;margin:0 6px}
  .bj-bc em{font-style:normal}
  .bj-badge{display:inline-block;background:var(--black,#0E1A1C);color:#fff;font-family:var(--font-en);font-weight:700;font-size:12px;letter-spacing:.14em;border-radius:999px;padding:8px 22px;margin-bottom:18px}
  .bj-hero h1{font-size:clamp(30px,5.4vw,52px);font-weight:700;letter-spacing:-.01em;line-height:1.3;color:var(--black)}
  .bj-hero h1 .sp{display:none}
  .bj-h1-sub{display:block;font-size:clamp(14px,2.1vw,19px);font-weight:700;color:var(--green-dark);margin-top:14px;letter-spacing:.01em;line-height:1.6}
  .bj-lead{font-size:14.5px;color:var(--muted);margin:16px 0 28px;line-height:1.9}
  .bj-search{display:flex;max-width:520px;margin-top:clamp(26px,3.6vw,40px)}
  .bj-search input{flex:1;font-family:var(--font-jp);font-size:14.5px;padding:15px 18px;border:1.5px solid var(--line);border-right:none;border-radius:12px 0 0 12px;outline:none;background:#fff}
  .bj-search input:focus{border-color:var(--green)}
  .bj-search button{font-family:var(--font-jp);font-weight:700;font-size:14px;color:#fff;background:var(--green-dark);border:none;border-radius:0 12px 12px 0;padding:0 28px;cursor:pointer}
  .bj-wm{position:absolute;right:-1%;bottom:-8%;font-family:var(--font-en);font-weight:700;font-size:clamp(90px,14vw,190px);letter-spacing:.02em;color:var(--green-dark);opacity:.045;pointer-events:none;line-height:1}
  /* cats */
  .bj-main{padding:clamp(34px,4.5vw,54px) var(--gutter) clamp(64px,8vw,110px)}
  .bj-cats{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:30px}
  .bj-cat{font-family:var(--font-jp);font-size:13px;font-weight:700;color:var(--black);background:#fff;border:1.5px solid var(--line);border-radius:999px;padding:9px 20px;cursor:pointer;transition:all .15s}
  .bj-cat i{font-style:normal;font-size:11px;color:var(--muted);margin-left:7px;font-family:var(--font-en);font-weight:700}
  .bj-cat:hover{border-color:var(--green)}
  .bj-cat.on{background:var(--green-dark);border-color:var(--green-dark);color:#fff}
  .bj-cat.on i{color:rgba(255,255,255,.7)}
  /* grid */
  .bj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,2.4vw,28px)}
  .bj-card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;transition:transform .18s,box-shadow .18s,border-color .18s}
  .bj-card:hover{transform:translateY(-5px);box-shadow:0 14px 34px rgba(14,26,28,.09);border-color:color-mix(in srgb,var(--green) 40%,#fff)}
  .bj-thumb{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,#EAF6F1 0%,#F6FAF9 55%,#DFF1E9 100%);display:grid;place-items:center;overflow:hidden}
  .bj-thumb-iso{width:52%;max-width:200px;display:block;transition:transform .25s}
  .bj-card:hover .bj-thumb-iso{transform:translateY(-4px) scale(1.04)}
  .bj-thumb-iso :global(svg){width:100%;height:auto;display:block}
  .bj-thumb-cat{position:absolute;left:12px;bottom:12px;background:rgba(14,26,28,.82);color:#fff;font-size:11px;font-weight:700;border-radius:999px;padding:5px 14px;backdrop-filter:blur(4px)}
  .bj-body{display:flex;flex-direction:column;gap:8px;padding:18px 20px 20px;flex:1}
  .bj-body time{font-family:var(--font-en);font-weight:700;font-size:12px;color:var(--muted);letter-spacing:.04em}
  .bj-body h2{font-size:15.5px;font-weight:700;line-height:1.65;color:var(--black);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .bj-body p{font-size:12.5px;color:var(--muted);line-height:1.85;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .bj-more{margin-top:auto;padding-top:10px;font-size:12.5px;font-weight:700;color:var(--green-dark)}
  .bj-card:hover .bj-more{text-decoration:underline;text-underline-offset:4px}
  .bj-empty{text-align:center;color:var(--muted);font-size:13.5px;padding:60px 0}
  @media (max-width: 900px){
    .bj-grid{grid-template-columns:1fr 1fr}
    .bj-hero h1 .sp{display:block}
  }
  @media (max-width: 600px){
    .bj-grid{grid-template-columns:1fr}
  }
</style>

<script is:inline>
  // カテゴリ×キーワードのクライアントサイド絞り込み
  (function () {
    var grid = document.getElementById('bjGrid');
    if (!grid || grid.dataset.bound) return;
    grid.dataset.bound = '1';
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.bj-card'));
    var empty = document.getElementById('bjEmpty');
    var input = document.getElementById('bjSearch');
    var cat = '';
    function apply() {
      var q = (input.value || '').trim().toLowerCase();
      var shown = 0;
      cards.forEach(function (c) {
        var ok = (!cat || c.dataset.cat === cat) && (!q || c.dataset.text.indexOf(q) !== -1);
        c.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      empty.hidden = shown > 0;
    }
    document.querySelectorAll('.bj-cat').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('.bj-cat').forEach(function (x) { x.classList.remove('on'); });
        b.classList.add('on');
        cat = b.dataset.cat || '';
        apply();
      });
    });
    input.addEventListener('input', apply);
    document.getElementById('bjSearchBtn').addEventListener('click', apply);
  })();
</script>
