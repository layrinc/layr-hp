---
/**
 * お役立ち資料の一覧ページ（リード獲得用・アーカイブ形式）。
 * 資料の追加・編集は src/data/materials.json を編集する。
 * カードの「ダウンロード」→ 個別ページ /document/<id>/ のフォームへ。送信後その場でPDFを提供。
 */
import Base from '../../layouts/Base.astro';
import materials from '../../data/materials.json';

const title = 'お役立ち資料 無料ダウンロード（LINE運用・広告運用）｜LAYR';
const description = 'LINE公式アカウントの構築・運用、Web広告運用代行に関する資料を無料配布中。フォーム送信後、その場でPDFをダウンロードいただけます。サービス紹介資料・料金の目安・進め方をまとめています。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'お役立ち資料' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'LAYRお役立ち資料',
    itemListElement: materials.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.title })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="subpage-pad"></div>
  <div class="page-hero container">
    <h1 class="sec-jp">お役立ち資料</h1>
  </div>

  <section class="mat-sec">
    <div class="container">
      <p class="mat-lead">LINE運用・広告運用の資料を無料配布中です。<br />フォーム送信後、その場でPDFをダウンロードいただけます。</p>

      <div class="mat-grid">
        {materials.map((m) => (
          <article class="mat-card">
            <a class="mat-thumb" href={`/document/${m.id}/`} aria-hidden="true" tabindex="-1">
              <img src={m.thumb} alt="" width="1200" height="675" loading="lazy" />
            </a>
            <div class="mat-body">
              <h2 class="mat-title">{m.title}</h2>
              <p class="mat-desc">{m.desc}</p>
              <a class="btn btn-green mat-dl" href={`/document/${m.id}/`}>ダウンロード</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</Base>


<style>
  .mat-sec{padding:44px 0 30px}
  .mat-lead{font-size:calc(15px * var(--fs,1));line-height:2;color:var(--text,#1B2A2E);margin:0 0 38px}
  .mat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,2.6vw,32px)}
  .mat-card{background:#fff;border:1px solid var(--line,#E3ECEC);border-radius:calc(var(--radius,18px) * .7);overflow:hidden;display:flex;flex-direction:column;transition:transform .2s, box-shadow .2s}
  .mat-card:hover{transform:translateY(-4px);box-shadow:var(--sd-lg,0 14px 34px rgba(14,26,28,.1))}
  .mat-thumb{display:block}
  .mat-thumb img{width:100%;height:auto;display:block}
  .mat-body{display:flex;flex-direction:column;gap:10px;padding:20px 22px 24px;flex:1}
  .mat-title{font-size:calc(16.5px * var(--fs,1));font-weight:800;line-height:1.6;color:var(--black,#0E1A1C);margin:0}
  .mat-desc{font-size:calc(13.5px * var(--fs,1));line-height:1.9;color:var(--muted);margin:0;flex:1}
  .mat-dl{width:100%;margin-top:6px}

  .mat-form-sec{padding:50px 0 110px}
  .mat-form-card{max-width:640px;margin:0 auto;background:var(--paper,#F6FAF9);border-radius:calc(var(--radius,18px) * .7);padding:clamp(28px,4vw,44px)}
  .mat-form-title{font-size:calc(21px * var(--fs,1));font-weight:900;margin:0 0 10px;color:var(--black,#0E1A1C)}
  .doc-form-note{margin-bottom:22px;font-size:calc(13.5px * var(--fs,1));color:var(--muted);line-height:1.9}
  .doc-form{display:flex;flex-direction:column;gap:16px}
  .doc-form label{display:flex;flex-direction:column;gap:7px}
  .req{color:#fff;padding:1px 8px;margin-left:6px;display:inline-block}
  .opt{color:var(--muted);padding:1px 8px;margin-left:6px;display:inline-block}
  .doc-form input[type="text"],.doc-form input[type="email"],.doc-form input[type="tel"],.doc-form select{font-family:var(--font-jp);font-size:calc(15px * var(--fs,1));padding:13px 15px;color:var(--text);outline:none;transition:border-color .2s}
  .doc-consent{flex-direction:row!important;align-items:flex-start;gap:10px!important;font-weight:400!important;font-size:calc(13px * var(--fs,1))!important;color:var(--muted)}
  .doc-consent input{margin-top:4px;accent-color:var(--green-cta);width:16px;height:16px}
  .doc-submit{width:100%;border:none;font-family:var(--font-jp)}
  .doc-submit:disabled{opacity:.6;cursor:wait}
  .doc-fallback{padding:20px 22px;text-align:center}
  .doc-fallback p{font-size:calc(13px * var(--fs,1));color:var(--muted);margin-bottom:14px}
  .doc-fallback .btn{width:100%}

  @media (max-width:980px){
    .mat-grid{grid-template-columns:repeat(2,1fr)}
  }
  @media (max-width:640px){
    .mat-grid{grid-template-columns:1fr}
    .mat-form-sec{padding:40px 0 84px}
  }
</style>
