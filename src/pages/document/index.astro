---
/**
 * サービス紹介資料の請求ページ（リード獲得用）。
 * フォームは FormSubmit（バックエンド不要の転送サービス）経由で
 * info@layr.co.jp にメール着信する。初回のみ有効化メールの承認が必要。
 */
import Base from '../../layouts/Base.astro';
import settings from '../../data/settings.json';

const title = 'サービス紹介資料ダウンロード｜株式会社LAYR';
const description = 'LINEマーケティング専業・株式会社LAYRのサービス紹介資料（LINE公式アカウントの構築と、運用・改善の支援内容と料金目安）を無料でお送りします。フォーム入力後、メールで資料をお届けします。';

// 送信先: FormSubmit経由で会社メールへ。送信後はサンクスページへ戻す。
const formAction = `https://formsubmit.co/${settings.email}`;
const thanksUrl = new URL('/document/thanks/', Astro.site).href;
---
<Base title={title} description={description}>
  <section class="doc-sec">
    <div class="container doc-wrap">

      <!-- 左: 資料の紹介 -->
      <div class="doc-intro">
        <p class="sec-en">DOCUMENT</p>
        <h1 class="doc-title">LAYR サービス紹介資料</h1>
        <p class="doc-lead">LINE公式アカウントの構築と、運用・改善の支援内容、料金の目安、進め方をまとめた資料です。フォーム送信後、メールでお届けします。</p>

        <div class="doc-slides" aria-hidden="true">
          <div class="ds ds1"><span class="ds-tag">LAYR</span><b>サービス紹介資料</b></div>
          <div class="ds ds2"><i></i><i class="short"></i><em style="--h:46%"></em><em style="--h:78%"></em><em style="--h:60%"></em></div>
          <div class="ds"><i></i><i></i><i class="short"></i></div>
          <div class="ds ds4"><span class="ds-pill"></span><i></i><i class="short"></i></div>
        </div>

        <h2 class="doc-sub">資料に含まれる内容</h2>
        <ul class="doc-list">
          <li>LAYRのサービス全体像（LINE公式アカウントの構築／運用・改善）</li>
          <li>構築の支援範囲（アカウント設計・リッチメニュー・シナリオ配信・友だち追加導線）</li>
          <li>運用の支援範囲（月次の配信企画・セグメント配信・効果測定・改善提案）</li>
          <li>進め方（無料相談〜構築〜運用改善）と料金の目安</li>
          <li>支援イメージ・活用事例、よくあるご質問</li>
        </ul>
      </div>

      <!-- 右: 請求フォーム -->
      <div class="doc-form-card">
        <p class="doc-form-note">下記をご入力のうえ「資料を請求する」を押してください。<br>1営業日以内に、メールで資料をお送りします。</p>
        <form action={formAction} method="POST" class="doc-form">
          <input type="hidden" name="_subject" value="【資料請求】LAYRサービス紹介資料" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value={thanksUrl} />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <label><span class="lbl">会社名・屋号 <span class="req">必須</span></span>
            <input type="text" name="会社名" required placeholder="株式会社〇〇" />
          </label>
          <label><span class="lbl">お名前 <span class="req">必須</span></span>
            <input type="text" name="お名前" required placeholder="山田 太郎" />
          </label>
          <label><span class="lbl">メールアドレス <span class="req">必須</span></span>
            <input type="email" name="メールアドレス" required placeholder="taro@example.com" />
          </label>
          <label><span class="lbl">電話番号 <span class="opt">任意</span></span>
            <input type="tel" name="電話番号" placeholder="090-1234-5678" />
          </label>
          <label><span class="lbl">興味のある内容 <span class="req">必須</span></span>
            <select name="興味のある内容" required>
              <option value="">選択してください</option>
              <option>LINE公式アカウントの構築</option>
              <option>LINEの運用・配信代行</option>
              <option>LINEの友だち集め・登録導線の改善</option>
              <option>全般的に相談したい</option>
            </select>
          </label>
          <label class="doc-consent">
            <input type="checkbox" required />
            <span><a href="/privacy/" target="_blank" rel="noopener">プライバシーポリシー</a>に同意のうえ、入力情報を資料送付およびご連絡の目的で利用することに同意します。</span>
          </label>
          <button type="submit" class="btn btn-green btn-lg doc-submit" id="docSubmit">資料を請求する</button>

          <!-- 送信システム障害時の自動フォールバック（通常は非表示） -->
          <div class="doc-fallback" id="docFallback" hidden>
            <p><strong>送信システムが混み合っているようです。</strong><br>お手数ですが、下のボタンからメールでご請求ください（入力内容は引き継がれます）。</p>
            <a class="btn btn-black" id="docMailto" href={`mailto:${settings.email}`}>メールで資料を請求する</a>
          </div>
        </form>
      </div>

    </div>
  </section>
</Base>

<script>
  // フォーム送信: 通常はFormSubmit(AJAX)へ。障害・タイムアウト時は
  // 入力内容を引き継いだメール下書きへ自動フォールバックし、リードを取りこぼさない。
  const form = document.querySelector('.doc-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('docSubmit') as HTMLButtonElement | null;
  const fallback = document.getElementById('docFallback');
  const mailtoLink = document.getElementById('docMailto') as HTMLAnchorElement | null;

  if (form && submitBtn && fallback && mailtoLink) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = '送信中…';

      const fd = new FormData(form);
      const ajaxUrl = form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/');
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 8000);

      try {
        const res = await fetch(ajaxUrl, {
          method: 'POST',
          body: fd,
          headers: { Accept: 'application/json' },
          signal: controller.signal,
        });
        clearTimeout(timer);
        if (!res.ok) throw new Error('bad status');
        location.href = '/document/thanks/';
      } catch {
        clearTimeout(timer);
        // メール下書きを組み立てて表示
        const v = (k: string) => (fd.get(k) || '').toString();
        const body = [
          'サービス紹介資料を希望します。',
          '',
          `会社名・屋号: ${v('会社名')}`,
          `お名前: ${v('お名前')}`,
          `メールアドレス: ${v('メールアドレス')}`,
          `電話番号: ${v('電話番号')}`,
          `興味のある内容: ${v('興味のある内容')}`,
        ].join('\n');
        const base = mailtoLink.href.split('?')[0];
        mailtoLink.href = `${base}?subject=${encodeURIComponent('【資料請求】LAYRサービス紹介資料')}&body=${encodeURIComponent(body)}`;
        fallback.hidden = false;
        fallback.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        submitBtn.disabled = false;
        submitBtn.textContent = '資料を請求する';
      }
    });
  }
</script>

<style>
  /* 配色・タイポ・角丸・罫線は style.css に一本化した。
     ここにはこのページ固有のレイアウトだけ置く。 */
  .doc-sec{padding:150px 0 100px}
  .doc-wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:52px;align-items:start}
  .doc-title{font-size:calc(clamp(24px,3.6vw,32px) * var(--fs,1));margin-top:10px}
  .doc-lead{color:var(--muted);margin-top:14px;max-width:36em}
  .doc-slides{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:28px 0 34px;max-width:480px}
  .ds{aspect-ratio:16/10;background:var(--paper);padding:14px;position:relative;overflow:hidden;display:flex;flex-direction:column;gap:7px;justify-content:center}
  .ds1{background:var(--green-cta);color:#fff;align-items:flex-start;justify-content:flex-end}
  .ds1 .ds-tag{background:color-mix(in srgb, #FFFFFF 25%, transparent);padding:2px 10px}
  .ds i{display:block;height:8px;border-radius:2px;background:var(--bg)}
  .ds i.short{width:60%}
  .ds2{flex-direction:row;align-items:flex-end;gap:8px;padding:16px 18px}
  .ds2 i{display:none}
  .ds2 em{flex:1;height:var(--h);border-radius:2px 2px 0 0;background:var(--line)}
  .ds2 em:last-child{background:var(--green)}
  .ds4 .ds-pill{width:42%;height:12px;background:var(--green-pale)}
  .doc-sub{margin-bottom:14px}
  .doc-list{display:flex;flex-direction:column;gap:9px}
  .doc-list li{position:relative}
  .doc-form-card{background:var(--paper);padding:36px 34px}
  .doc-form-note{margin-bottom:22px}
  .doc-form{display:flex;flex-direction:column;gap:16px}
  .doc-form label{display:flex;flex-direction:column;gap:7px}
  .req{color:#fff;padding:1px 8px;margin-left:6px;display:inline-block}
  .opt{color:var(--muted);padding:1px 8px;margin-left:6px;display:inline-block}
  .doc-form input[type="text"],.doc-form input[type="email"],.doc-form input[type="tel"],.doc-form select{font-family:var(--font-jp);font-size:calc(15px * var(--fs,1));padding:13px 15px;color:var(--text);outline:none;transition:border-color .2s}
  .doc-consent{flex-direction:row!important;align-items:flex-start;gap:10px!important;font-weight:400!important;font-size:calc(13px * var(--fs,1))!important;color:var(--muted)}
  .doc-consent input{margin-top:4px;accent-color:var(--green-cta);width:16px;height:16px}
  .doc-submit{width:100%;border:none;font-family:var(--font-jp)}
  .doc-submit:disabled{opacity:.6;cursor:wait}
  .doc-fallback{padding:20px 22px;text-align:center}
  .doc-fallback p{font-size:calc(13px * var(--fs,1));color:var(--muted);margin-bottom:14px}
  .doc-fallback .btn{width:100%}
  @media (max-width:900px){
    .doc-wrap{grid-template-columns:1fr;gap:40px}
    .doc-sec{padding:130px 0 80px}
  }
</style>
