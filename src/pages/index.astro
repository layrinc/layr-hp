---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// ===== 管理画面（/admin →「サイト設定」）から編集できるデータ =====
import settings from '../data/settings.json';
import hero from '../data/hero.json';
import stats from '../data/stats.json';
import cases from '../data/cases.json';
import faq from '../data/faq.json';
import promiseData from '../data/promise.json';
import message from '../data/message.json';
import company from '../data/company.json';
import theme from '../data/theme.json';

// コラム最新3本を取得（下書きは除外・日付降順）
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.slice(0, 3);
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const iso = (d: Date) => d.toISOString().slice(0, 10);

const title = '株式会社LAYR｜LINE構築・運用を軸にしたマーケティング支援会社';
const description = '株式会社LAYRは、LINE公式アカウントの構築・運用マーケティングと広告運用代行を軸に、中小企業の売上を伸ばすマーケティング支援会社です。広告からLINEまで一気通貫で設計し、リピート・紹介が生まれる仕組みを作ります。';

// FAQの構造化データ(JSON-LD)。検索結果にQ&Aが展開表示される可能性が上がる。
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// 会社の構造化データ(JSON-LD)。検索エンジンに会社情報を正しく伝える。
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  url: 'https://layr.co.jp',
  email: settings.email,
  description: 'LINE公式アカウントの構築・運用マーケティングと広告運用代行を軸にした、中小企業向けマーケティング支援会社。',
  founder: { '@type': 'Person', name: '河出 壱貫' },
  foundingDate: '2026-08',
  areaServed: 'JP',
  knowsAbout: ['LINE公式アカウント', 'LINEマーケティング', 'Web広告運用', 'デジタルマーケティング'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '道玄坂1丁目10番8号 渋谷道玄坂東急ビル2F-C',
    addressLocality: '渋谷区',
    addressRegion: '東京都',
    addressCountry: 'JP',
  },
};

// CTAリンク: LINE友だち追加URLが設定されていればそちら、無ければメール
const consult = settings.line_url?.trim()
  ? settings.line_url
  : `mailto:${settings.email}?subject=${encodeURIComponent('【無料相談】LINE活用について')}`;
const contact = `mailto:${settings.email}?subject=${encodeURIComponent('お問い合わせ')}`;
---
<Base title={title} description={description} jsonLd={[orgJsonLd, faqJsonLd]}>

  <!-- ============ HERO ============ -->
  <section class="hero" aria-label="メインビジュアル">
    <div class="hero-deco" aria-hidden="true">
      <div class="ring1"></div>
      <div class="ring2"></div>
      <div class="dot-grid"></div>
    </div>
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">{hero.eyebrow}</p>
        <h1>{hero.catch_line1}<br><span class="marker">{hero.catch_line2}</span><br>{hero.catch_line3}</h1>
        <p class="hero-sub">{hero.sub}</p>
        <div class="hero-actions">
          <a class="btn btn-green btn-lg" href={consult}>{hero.cta_primary}</a>
          <a class="btn btn-black btn-lg" href="#service">{hero.cta_secondary}</a>
        </div>
        <ul class="hero-chips">
          {hero.chips.map((chip) => <li>{chip}</li>)}
        </ul>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hero-swoosh"></div>
        <div class="hero-badge">
          <span class="s1">{hero.badge_line1}</span>
          <span class="s2">{hero.badge_line2}</span>
        </div>
        <div class="phone">
          <div class="phone-screen">
            <div class="talk-header">
              <span class="oa-icon">S</span>
              〇〇サロン 公式LINE
              <span class="oa-check">友だち 3,214</span>
            </div>
            <div class="talk-body">
              <div class="msg in">友だち追加ありがとうございます🎁 30秒のアンケートに答えると、初回クーポンをお届けします</div>
              <div class="msg out">回答しました！</div>
              <div class="msg in">ありがとうございます！あなた向けのクーポンです<span class="coupon">初回限定 20%OFFクーポン</span></div>
            </div>
            <div class="richmenu">
              <span class="hot">予約する</span><span>クーポン</span><span>メニュー</span>
              <span>口コミ</span><span>アクセス</span><span>相談する</span>
            </div>
          </div>
        </div>
        {hero.float_chips[0] && <div class="float-chip chip1">{hero.float_chips[0].label}<strong>{hero.float_chips[0].value}</strong></div>}
        {hero.float_chips[1] && <div class="float-chip chip2">{hero.float_chips[1].label}<strong>{hero.float_chips[1].value}</strong></div>}
        {hero.float_chips[2] && <div class="float-chip chip3">{hero.float_chips[2].label}<strong>{hero.float_chips[2].value}</strong></div>}
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="stats" aria-labelledby="stats-title">
    {stats.show_edit_note && <div class="draft-note"><p>【要編集】実績数値はサンプルです。管理画面の「サイト設定 → 実績数値」で実数値に差し替え、この注意書きをオフにしてください。</p></div>}
    <div class="container">
      <h2 class="stats-title" id="stats-title">{stats.title_before}<span class="marker">{stats.title_marker}</span></h2>
      <div class="stats-grid">
        {stats.items.map((item) => (
          <div class="stat-card reveal">
            <span class="stat-tag">{item.tag}</span>
            <p class="stat-num">{item.arrow && <span class="up">▲</span>}{item.number}<small>{item.unit}</small></p>
            <p class="stat-desc">{item.desc.split('\n').map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROBLEM ============ -->
  <section class="problem" aria-labelledby="problem-title">
    <div class="container">
      <div class="sec-head reveal" data-wm="PROBLEM">
        <h2 class="sec-en" id="problem-title">PROBLEM</h2>
        <p class="sec-jp">こんなお悩みはありませんか？</p>
      </div>
      <ul class="problem-list">
        <li class="reveal"><span class="check"></span>LINE公式アカウントを作ったが、配信が止まり放置されている</li>
        <li class="reveal"><span class="check"></span>友だちは増えたのに、売上につながっている実感がない</li>
        <li class="reveal"><span class="check"></span>広告で集客はできるが、リピートせず広告費がかさみ続けている</li>
        <li class="reveal"><span class="check"></span>配信のネタ・書き方が分からず、ブロックばかり増えていく</li>
        <li class="reveal"><span class="check"></span>広告代理店とLINE運用会社が別で、全体を見ている人がいない</li>
      </ul>
      <div class="problem-arrow" aria-hidden="true"></div>
      <div class="problem-answer reveal">
        <strong>その課題、<span class="marker">「入口」と「受け皿」を分けて発注している</span>ことが原因です。</strong>
        <p>LAYRは、広告（入口）とLINE（受け皿）を同じ担当者が一気通貫で設計します。集客した見込み客をLINEで確実に受け止め、配信でリピート・紹介まで育てる。この全体設計が、広告費を「消費」から「投資」に変えます。</p>
      </div>
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <div class="cta-band angle-top">
    <div class="container cta-band-inner">
      <div>
        <h2>LINE活用の現状診断、<span>無料</span>で承ります。</h2>
        <p>アカウントの有無・運用状況を伺い、改善の優先順位を整理してお返しします。</p>
      </div>
      <div class="cta-band-btns">
        <a class="btn btn-green" href={consult}>無料相談に申し込む</a>
        <a class="btn btn-white" href={contact}>メールで問い合わせる</a>
      </div>
    </div>
  </div>

  <!-- ============ SERVICE ============ -->
  <section id="service" aria-labelledby="service-title">
    <div class="container">
      <div class="sec-head reveal" data-wm="SERVICE">
        <h2 class="sec-en" id="service-title">SERVICE</h2>
        <p class="sec-jp">事業内容</p>
        <p class="sec-lead">LINEを軸に、集客の入口から売上までを設計します。単体でのご依頼も、一気通貫でのご依頼も可能です。</p>
      </div>
      <div class="service-grid">

        <div class="service-card wide reveal">
          <span class="service-badge">主力サービス</span>
          <p class="service-num">SERVICE 01</p>
          <h3>LINE公式アカウント構築・運用マーケティング</h3>
          <p>一度つながったお客様を逃さず、リピート・紹介につなげる仕組みを構築します。アカウント設計・リッチメニュー・あいさつメッセージ・シナリオ配信の構築から、セグメント配信の設計、毎月の配信ライティング・効果測定・改善まで、LINEマーケティングの全工程を代行します。</p>
          <ul class="service-tags">
            <li>アカウント設計・構築</li>
            <li>リッチメニュー</li>
            <li>シナリオ配信</li>
            <li>セグメント配信</li>
            <li>配信ライティング</li>
            <li>月次レポート・改善</li>
          </ul>
        </div>

        <div class="service-card reveal">
          <div class="service-visual" aria-hidden="true">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="3" y1="20" x2="21" y2="20"/></svg>
          </div>
          <p class="service-num">SERVICE 02</p>
          <h3>広告運用代行</h3>
          <p>投資対効果を最大化するため、データを見ながら継続的にPDCAを回します。Meta広告・Google広告・LINE広告を、LINEへの導線とセットで設計。CPA（獲得単価）だけでなく、LTV（顧客生涯価値）まで見て広告費の使い方を判断します。</p>
          <ul class="service-tags">
            <li>Meta広告</li>
            <li>Google広告</li>
            <li>LINE広告</li>
            <li>友だち追加広告</li>
            <li>数値レポート</li>
          </ul>
        </div>

        <div class="service-card reveal">
          <div class="service-visual" aria-hidden="true">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="9" y1="13" x2="13" y2="13"/></svg>
          </div>
          <p class="service-num">SERVICE 03</p>
          <h3>LINEマーケティング コンサルティング</h3>
          <p>「運用は自社でやりたい」という企業向けに、戦略設計と改善のアドバイスを提供します。配信設計・セグメントの切り方・キャンペーン企画・数値の見方まで、社内で回せる状態を作ります。</p>
          <ul class="service-tags">
            <li>戦略設計</li>
            <li>配信改善</li>
            <li>社内運用の内製化支援</li>
          </ul>
        </div>

      </div>
      <p class="service-note">※ LINE・広告と連動するLP・クリエイティブの制作も、セットで対応可能です。</p>
    </div>
  </section>

  <!-- ============ REASON ============ -->
  <section class="reason" id="reason" aria-labelledby="reason-title">
    <div class="container">
      <div class="sec-head reveal" data-wm="REASON">
        <h2 class="sec-en" id="reason-title">REASON</h2>
        <p class="sec-jp">LAYRが選ばれる理由</p>
      </div>
      <div class="reason-grid">
        <div class="reason-card reveal">
          <span class="reason-num" aria-hidden="true">01</span>
          <h3>「構築して終わり」に<br>しません</h3>
          <p>LINEの成果はアカウント開設ではなく、配信が回り始めてから生まれます。LAYRは構築後の配信運用・効果測定・改善まで伴走し、成果が出る状態まで責任を持ちます。</p>
        </div>
        <div class="reason-card reveal">
          <span class="reason-num" aria-hidden="true">02</span>
          <h3>広告からLINEまで、<br>一気通貫で設計します</h3>
          <p>入口（広告）と受け皿（LINE）を同じ担当者が設計するため、導線の分断が起きません。CPAとLTVを同時に見ながら、広告費が最も回収される形に全体を最適化します。</p>
        </div>
        <div class="reason-card reveal">
          <span class="reason-num" aria-hidden="true">03</span>
          <h3>数値で報告し、<br>数値で改善します</h3>
          <p>開封率・クリック率・CVR・ブロック率。感覚ではなくデータで判断します。月次レポートは前月比・目標比で共有し、翌月に何をするかまで具体的に提示します。</p>
        </div>
        <div class="reason-card reveal">
          <span class="reason-num" aria-hidden="true">04</span>
          <h3>代表が直接、<br>最後まで担当します</h3>
          <p>営業だけして現場は別の担当者、という体制ではありません。ヒアリングから設計・運用・品質管理まで代表が一貫して担当するため、話が早く、認識のズレが起きません。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CASE ============ -->
  <section id="case" aria-labelledby="case-title">
    <div class="container">
      <div class="sec-head reveal" data-wm="CASE">
        <h2 class="sec-en" id="case-title">CASE</h2>
        <p class="sec-jp">支援実績</p>
      </div>
    </div>
    {cases.show_edit_note && <div class="draft-note"><p>【要編集】以下の実績はサンプルです。管理画面の「サイト設定 → 支援実績」で実案件に差し替え、この注意書きをオフにしてください（クライアント名の掲載は先方の許可を取ってから）。</p></div>}
    <div class="container">
      <div class="case-grid">
        {cases.items.map((c) => (
          <div class="case-card reveal">
            <div class="case-head">
              <span class="case-tag">{c.tag}</span>
              <h3>{c.title}</h3>
            </div>
            <div class="case-body">
              <dl>
                <div class="case-row"><dt>課題</dt><dd>{c.problem}</dd></div>
                <div class="case-row"><dt>施策</dt><dd>{c.action}</dd></div>
              </dl>
            </div>
            <div class="case-result">
              <p class="label">{c.metric_label}</p>
              <div class="case-graph" aria-hidden="true"><span class="bar b1" style={`--h:${c.graph_before}%`} data-label="Before"></span><span class="bar b2" style={`--h:${c.graph_after}%`} data-label="After"></span></div>
              <div class="case-metric">
                <span class="before">{c.before}</span>
                <span class="arrow">→</span>
                <span class="after">{c.after_number}<small>{c.after_unit}</small></span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE（文言はデザイン設定から） ============ -->
  <div class="marquee angle-both" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => theme.marquee_items.map((m) => <span class={m.highlight ? 'fill' : ''}>{m.text}</span>))}
    </div>
  </div>

  <!-- ============ COLUMN（管理画面から追加された記事が自動で並ぶ） ============ -->
  <section id="column" aria-labelledby="column-title">
    <div class="container">
      <div class="sec-head reveal" data-wm="COLUMN">
        <h2 class="sec-en" id="column-title">COLUMN</h2>
        <p class="sec-jp">LINEマーケティングコラム</p>
        <p class="sec-lead">現場で得たLINE活用・広告運用の知見を発信しています。</p>
      </div>
      <div class="column-grid">
        {latest.map((post) => (
          <a class="column-card reveal" href={`/blog/${post.id}/`}>
            <div class="column-meta"><time datetime={iso(post.data.date)}>{fmt(post.data.date)}</time><span class="column-cat">{post.data.category}</span></div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="more">READ MORE ›</span>
          </a>
        ))}
      </div>
      <div class="column-more reveal">
        <a class="btn btn-black" href="/blog/">コラム一覧を見る</a>
      </div>
    </div>
  </section>

  <!-- ============ PROMISE ============ -->
  <section class="promise" aria-labelledby="promise-title" style="background:var(--bg)">
    <div class="container">
      <div class="sec-head reveal" data-wm="PROMISE">
        <h2 class="sec-en" id="promise-title">PROMISE</h2>
        <p class="sec-jp">LAYRのお約束</p>
      </div>
      <div class="promise-grid">
        <div class="promise-box yes reveal">
          <h3><span class="ico">○</span>お約束できること</h3>
          <ul>
            {promiseData.yes_items.map((item) => (
              <li><span class="mark">○</span><div><strong>{item.title}</strong><span>{item.desc}</span></div></li>
            ))}
          </ul>
        </div>
        <div class="promise-box no reveal">
          <h3><span class="ico">×</span>お約束できないこと</h3>
          <ul>
            {promiseData.no_items.map((item) => (
              <li><span class="mark">×</span><div><strong>{item.title}</strong><span>{item.desc}</span></div></li>
            ))}
          </ul>
        </div>
      </div>
      <p class="promise-close reveal">この方針にご共感いただける方は、<br>ぜひ<span class="marker">無料相談</span>にお申し込みください。</p>
    </div>
  </section>

  <!-- ============ MESSAGE ============ -->
  <section class="message" id="message" aria-labelledby="message-title" style="background:#fff">
    <div class="container">
      <div class="sec-head reveal" data-wm="MESSAGE">
        <h2 class="sec-en" id="message-title">MESSAGE</h2>
        <p class="sec-jp">代表挨拶</p>
      </div>
      <div class="message-wrap">
        <div class="message-photo reveal">
          {message.photo
            ? <img src={message.photo} alt={`${company.name} ${message.sign_name}`} />
            : <span class="todo">【要編集】<br>代表写真を管理画面の<br>「サイト設定 → 代表挨拶」で設定</span>}
        </div>
        <div class="message-body reveal">
          {message.paragraphs.map((p) => <p>{p}</p>)}
          <div class="sign">
            <span class="title">{message.sign_title}</span>
            <span class="name">{message.sign_name}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="faq" id="faq" aria-labelledby="faq-title" style="background:var(--bg)">
    <div class="container">
      <div class="sec-head reveal" data-wm="FAQ">
        <h2 class="sec-en" id="faq-title">FAQ</h2>
        <p class="sec-jp">よくあるご質問</p>
      </div>
      <div class="faq-list reveal">
        {faq.items.map((item) => (
          <details class="faq-item">
            <summary><span class="q">Q.</span>{item.q}</summary>
            <div class="a"><span class="mark">A.</span><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ COMPANY ============ -->
  <section class="company" id="company" aria-labelledby="company-title" style="background:#fff">
    <div class="container">
      <div class="sec-head reveal" data-wm="COMPANY">
        <h2 class="sec-en" id="company-title">COMPANY</h2>
        <p class="sec-jp">会社概要</p>
      </div>
      <table class="company-table reveal">
        <tbody>
          <tr><th>会社名</th><td>{company.name}</td></tr>
          <tr><th>代表者</th><td>{company.representative}</td></tr>
          <tr><th>所在地</th><td>{company.address}</td></tr>
          <tr><th>設立</th><td>{company.founded}</td></tr>
          <tr>
            <th>事業内容</th>
            <td>
              <ul>
                {company.business.map((b) => <li>{b}</li>)}
              </ul>
            </td>
          </tr>
          <tr><th>お問い合わせ</th><td><a href={`mailto:${settings.email}`}>{settings.email}</a></td></tr>
