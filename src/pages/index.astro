---
/**
 * トップページ。中身は page-home.json のブロック配列で決まる（ブロック型CMS）。
 * 編集はカスタマイザー（/admin/customize/）から。ここは器だけ。
 */
import Base from '../layouts/Base.astro';
import Block from '../components/Block.astro';
import PriceSimulator from '../components/PriceSimulator.astro';
import CustomerJourney from '../components/CustomerJourney.astro';
import JourneyHappiness from '../components/JourneyHappiness.astro';
import HomeIsometricArt from '../components/HomeIsometricArt.astro';
import '../styles/home-isometric.css';
import settings from '../data/settings.json';
import page from '../data/page-home.json';
import { getCollection } from 'astro:content';

// 料金シミュレーターは pricing ブロックの直後に差し込む（ブロックCMS外の固定要素）
const pricingIdx = page.blocks.findIndex((b) => b.type === 'pricing');
const simConsult = settings.line_url?.trim() || `mailto:${settings.email}?subject=${encodeURIComponent('【無料相談】LINE活用について')}`;

// コラムブロック用に最新記事を取得（下書き除外・日付降順）
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = 'LINE公式アカウント構築・運用代行｜株式会社LAYR';
const description = 'LINE公式アカウントの構築代行と運用代行をワンストップで。アカウント設計・リッチメニュー・ステップ配信の初期構築は15万円〜、月次の配信企画・セグメント配信・効果測定まで担う運用支援は月5万円〜。全国オンライン対応、無料相談は30分から。';

// 構造化データ: サービス（料金レンジ付き）＋FAQPage。
// Organization / WebSite は Base.astro が全ページ共通で出力する。
// 価格は pricing ブロック（page-home.json）の表示と必ず一致させること。
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://layr.co.jp/#service-line',
  name: 'LINE公式アカウント構築・運用代行',
  serviceType: 'LINEマーケティング支援',
  provider: { '@id': 'https://layr.co.jp/#organization' },
  areaServed: 'JP',
  url: 'https://layr.co.jp/service/line/',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'LINEマーケティング支援プラン',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'LINE公式アカウント構築',
        description: 'アカウント設計・リッチメニュー・ステップ配信の初期構築（制作期間2〜4週間）',
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 100000, maxPrice: 400000, priceCurrency: 'JPY' },
      },
      {
        '@type': 'Offer',
        name: 'LINE運用支援',
        description: '月次の配信企画・セグメント配信・効果測定・改善提案',
        priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: 30000, maxPrice: 100000, priceCurrency: 'JPY', unitText: '月' },
      },
    ],
  },
};
// FAQブロック（ブロック型は 'accordion'。旧名 'faq' too）からFAQPageを生成
const faqBlock = page.blocks.find((b) => b.type === 'faq' || b.type === 'accordion');
const jsonLd: object[] = [serviceJsonLd];
if (faqBlock && Array.isArray(faqBlock.p?.items)) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqBlock.p.items.map((item: any) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---
<Base title={title} description={description} jsonLd={jsonLd}>
  {page.blocks.map((block, i) => {
    // _fs = ブロック単位の文字サイズ倍率（CSSの font-size:calc(... * var(--fs,1)) が拾う）
    const fs = Number((block.p as any)?._fs) || 1;
    // Keep the CMS's approved hero copy and links; replace its visual with the customer journey.
    if (block.type === 'heroText') {
      return <div style={`--fs:${fs}`}>
        <CustomerJourney hero={block.p as any} consult={simConsult} />
        <JourneyHappiness serviceLink />
      </div>;
    }
    const rendered = fs !== 1
      ? <div style={`--fs:${fs}`}><Block block={block} posts={posts} isometric /></div>
      : <Block block={block} posts={posts} isometric />;
    // pricingブロックの直後に料金シミュレーターを固定挿入
    if (i === pricingIdx) {
      return (
        <>
          {rendered}
          <section class="sim-sec" id="sim">
            <div class="container">
              <div class="home-sim-heading">
                <div class="sec-head">
                  <p class="sec-en">PRICE SIMULATOR</p>
                  <h2 class="sec-jp">30秒 料金シミュレーション</h2>
                  <p class="sec-lead">選択式4問で、貴社に合うプランと料金の目安がその場で分かります。</p>
                </div>
                <HomeIsometricArt kind="sale" />
              </div>
              <PriceSimulator docHref="/document/" consult={simConsult} />
            </div>
          </section>
        </>
      );
    }
    return rendered;
  })}
  <style>
    .sim-sec{padding:clamp(56px,7vw,96px) 0;background:#fff}
  </style>
</Base>
