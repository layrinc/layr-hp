---
/**
 * トップページ。中身は page-home.json のブロック配列で決まる（ブロック型CMS）。
 * 編集はカスタマイザー（/admin/customize/）から。ここは器だけ。
 */
import Base from '../layouts/Base.astro';
import Block from '../components/Block.astro';
import page from '../data/page-home.json';
import { getCollection } from 'astro:content';

// コラムブロック用に最新記事を取得（下書き除外・日付降順）
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = '株式会社LAYR｜LINE構築・運用を軸にしたマーケティング支援会社';
const description = '株式会社LAYRは、LINE公式アカウントの構築・運用マーケティングと広告運用代行を軸に、中小企業の売上を伸ばすマーケティング支援会社です。広告からLINEまで一気通貫で設計し、リピート・紹介が生まれる仕組みを作ります。';

// 構造化データ: 会社情報＋（FAQブロックがあれば）FAQPage
const companyBlock = page.blocks.find((b) => b.type === 'company');
const faqBlock = page.blocks.find((b) => b.type === 'faq');
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: companyBlock?.p?.name ?? '株式会社LAYR',
    url: 'https://layr.co.jp',
    email: 'info@layr.co.jp',
    description: 'LINE公式アカウントの構築・運用マーケティングと広告運用代行を軸にした、中小企業向けマーケティング支援会社。',
    founder: { '@type': 'Person', name: companyBlock?.p?.representative ?? '河出 壱貫' },
    foundingDate: '2026-08',
    areaServed: 'JP',
    knowsAbout: ['LINE公式アカウント', 'LINEマーケティング', 'Web広告運用', 'デジタルマーケティング'],
    address: {
      '@type': 'PostalAddress',
      streetAddress: '道玄坂1丁目10番8号 渋谷道玄坂東急ビル2F-C',
      addressLocality: '渋谷区',
      addressRegion: '東京都',
      addressCountry: 'JP',
    },
  },
];
if (faqBlock && Array.isArray(faqBlock.p?.items)) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqBlock.p.items.map((item: any) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---
<Base title={title} description={description} jsonLd={jsonLd}>
  {page.blocks.map((block) => <Block block={block} posts={posts} />)}
</Base>
