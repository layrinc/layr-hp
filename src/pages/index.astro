---
/**
 * トップページ。中身は page-home.json のブロック配列で決まる（ブロック型CMS）。
 * 編集はカスタマイザー（/admin/customize/）から。ここは器だけ。
 */
import Base from '../layouts/Base.astro';
import Block from '../components/Block.astro';
import page from '../data/page-home.json';
import { getCollection } from 'astro:content';

// コラムブロック用に最新記事を取得（下書き除外・日付降順）
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = '株式会社LAYR｜LINE公式アカウントの構築・運用｜LINEマーケティング専業';
const description = '株式会社LAYRは、LINE公式アカウントの構築と運用・改善に特化したLINEマーケティング専業の会社です。アカウント設計・リッチメニュー・シナリオ配信の構築から、月次の配信企画・効果測定・改善提案までを一貫して担当し、リピートと紹介が生まれる仕組みを作ります。';

// 構造化データ: 会社情報＋（FAQブロックがあれば）FAQPage
const companyBlock = page.blocks.find((b) => b.type === 'company');
const faqBlock = page.blocks.find((b) => b.type === 'faq');
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: companyBlock?.p?.name ?? '株式会社LAYR',
    url: 'https://layr.co.jp',
    email: 'info@layr.co.jp',
    description: 'LINE公式アカウントの構築と運用・改善に特化した、中小企業向けLINEマーケティング専業の会社。',
    founder: { '@type': 'Person', name: companyBlock?.p?.representative ?? '河出 壱貫' },
    foundingDate: '2026-08',
    areaServed: 'JP',
    knowsAbout: ['LINE公式アカウント', 'LINEマーケティング', 'LINE公式アカウント構築', 'ステップ配信', 'リッチメニュー設計', 'セグメント配信'],
    address: {
      '@type': 'PostalAddress',
      streetAddress: '道玄坂1丁目10番8号 渋谷道玄坂東急ビル2F-C',
      addressLocality: '渋谷区',
      addressRegion: '東京都',
      addressCountry: 'JP',
    },
  },
];
if (faqBlock && Array.isArray(faqBlock.p?.items)) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqBlock.p.items.map((item: any) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---
<Base title={title} description={description} jsonLd={jsonLd}>
  {page.blocks.map((block) => {
    // _fs = ブロック単位の文字サイズ倍率（CSSの font-size:calc(... * var(--fs,1)) が拾う）
    const fs = Number((block.p as any)?._fs) || 1;
    return fs !== 1
      ? <div style={`--fs:${fs}`}><Block block={block} posts={posts} /></div>
      : <Block block={block} posts={posts} />;
  })}
</Base>
