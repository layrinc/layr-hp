---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const iso = (d: Date) => d.toISOString().slice(0, 10);

const title = 'LINE公式アカウント運用コラム｜株式会社LAYR';
const description = 'LINE公式アカウントの構築・運用の現場から、ブロック率の下げ方、ステップ配信の設計、メルマガとの使い分けなど、地方中小企業・スクール・店舗がすぐ使えるLINEマーケティングの実務ノウハウを発信しています。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'コラム' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'LINE公式アカウント運用コラム',
    url: new URL('/blog/', Astro.site).href,
    inLanguage: 'ja',
    isPartOf: { '@id': 'https://layr.co.jp/#website' },
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="page-hero">
    <p class="sec-en">COLUMN</p>
    <h1 class="sec-jp">LINE公式アカウント運用コラム</h1>
  </div>

  <div class="post-list">
    {posts.map((post) => (
      <a class="post-item" href={`/blog/${post.id}/`}>
        <div class="column-meta"><time datetime={iso(post.data.date)}>{fmt(post.data.date)}</time><span class="column-cat">{post.data.category}</span></div>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
      </a>
    ))}
  </div>
</Base>
