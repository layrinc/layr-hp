---
import Base from './Base.astro';
import Brand from '../components/LtoriMediaBrand.astro';
import service from '../data/service-ltori.json';
import { mediaPath, mediaInfo, topicGuides, categoryPath } from '../lib/ltori-media.mjs';
import '../styles/ltori-media.css';
const { title, description, jsonLd } = Astro.props;
// Non-article routes use the media source; category slugs are not article IDs.
const source = Astro.props.articleId ? `media/${Astro.props.articleId}` : 'media';
---
<Base title={`${title}｜${mediaInfo.name}`} description={description} jsonLd={jsonLd} hideHeader={true}>
  <div class="lm" data-lm-source={source}>
    <a class="lm-skip" href="#lm-content">本文へ移動</a>
    <header class="lm-header">
      <div class="container lm-masthead"><Brand />
        <nav class="lm-desktop-nav" aria-label="採用LINEのカテゴリー">{topicGuides.map(guide=><a href={categoryPath(guide.slug)} aria-current={Astro.url.pathname===categoryPath(guide.slug) ? 'page' : undefined}>{guide.category}</a>)}<a href={mediaPath}>記事一覧</a><a class="lm-about-link" href={mediaInfo.aboutPath} aria-current={Astro.url.pathname===mediaInfo.aboutPath ? 'page' : undefined}>このメディアについて</a></nav>
        <details class="lm-mobile-nav"><summary>メニュー <span aria-hidden="true">＋</span></summary><nav aria-label="モバイルメニュー">{topicGuides.map(guide=><a href={categoryPath(guide.slug)} aria-current={Astro.url.pathname===categoryPath(guide.slug) ? 'page' : undefined}>{guide.category}<span aria-hidden="true">→</span></a>)}<a href={mediaPath}>記事一覧</a><a href={mediaInfo.aboutPath}>このメディアについて</a></nav></details>
        <a class="lm-button lm-header-contact" href={mediaInfo.contactPath} aria-current={Astro.url.pathname===mediaInfo.contactPath ? 'page' : undefined}>お問い合わせ</a>
      </div>
    </header>
    <div class="container lm-main" id="lm-content" tabindex="-1"><slot /></div>
  </div>
  <footer slot="footer" class="lm lm-footer">
    <div class="container">
      <div class="lm-footer-top"><div><Brand /><p>採用の疑問を、次の行動につなげる。</p></div><nav aria-label="メディアの運営情報"><a href={mediaInfo.aboutPath}>このメディアについて</a><a href={`${mediaInfo.aboutPath}#operator`}>運営会社</a><a href={mediaInfo.contactPath}>お問い合わせ</a><a href="/privacy/">プライバシーポリシー</a><a href={service.path} data-lm-cta="service_site">サービスサイトを見てみる <span aria-hidden="true">↗</span></a></nav></div>
      <p class="lm-footer-copy">運営：株式会社LAYR <span aria-hidden="true">／</span> © 2026 LAYR Inc.</p>
    </div>
  </footer>
  <script>
    const source = document.querySelector<HTMLElement>('[data-lm-source]')?.dataset.lmSource;
    // Article-body links use the same attribution as the surrounding CTAs.
    document.querySelectorAll<HTMLAnchorElement>('.lm-article a[href]').forEach(link => {
      const url = new URL(link.href);
      if (url.origin !== location.origin || !source) return;
      if ((url.pathname === '/contact/' && url.searchParams.get('service') === 'ltori') || url.pathname === '/document/ltori-service/') {
        url.searchParams.set('source', source);
        link.href = url.pathname + url.search + url.hash;
        link.dataset.lmCta ||= 'article_body';
      }
    });
    document.querySelectorAll('[data-lm-cta]').forEach(link => link.addEventListener('click', () => {
      const analytics = (window as any).gtag;
      if (typeof analytics === 'function') analytics('event', 'ltori_media_cta_click', {
        cta: (link as HTMLElement).dataset.lmCta, page_path: location.pathname, page_source: source, service: 'ltori',
      });
    }));
  </script>
</Base>
