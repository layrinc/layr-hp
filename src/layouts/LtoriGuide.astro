---
import Base from './Base.astro';
import service from '../data/service-ltori.json';
import { consultationHref } from '../lib/ltori-seo.mjs';
import '../styles/ltori-seo.css';
const { title, description, source, breadcrumbs, jsonLd = [] } = Astro.props;
const consult = consultationHref(source);
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, item: new URL(item.path, Astro.site).href })) },
  ...jsonLd,
];
---
<Base title={title} description={description} hideHeader={true} jsonLd={structuredData} ogImage="/service/ltori/isometric-hero.webp">
  <div class="ltg" data-ltg-source={source}>
    <a class="ltg-skip" href="#ltg-main">本文へ移動</a>
    <header class="ltg-header">
      <a href={service.path} class="ltg-logo"><strong>{service.name}<span>.</span></strong><small>{service.descriptor} by LAYR</small></a>
      <nav aria-label="サービスメニュー"><a href={service.path}>サービス概要</a><a href="/service/ltori/area/">対応エリア</a><a class="ltg-button" href={consult} data-ltg-cta="header">無料相談 <span aria-hidden="true">↗</span></a></nav>
    </header>
    <div class="ltg-wrap">
      <nav aria-label="パンくずリスト" class="ltg-breadcrumb"><ol>{breadcrumbs.map((item, i) => <li>{i === breadcrumbs.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}</li>)}</ol></nav>
    </div>
    <div id="ltg-main" tabindex="-1"><slot /></div>
    <section class="ltg-section ltg-tint" aria-labelledby="ltg-consult-title">
      <div class="ltg-wrap ltg-split">
        <div><p class="ltg-label">採用担当者さまへ</p><h2 id="ltg-consult-title">今の採用に、<br />LINEでできることを。</h2><p>募集職種、採用の入口、候補者との連絡方法。<br />現状を伺い、必要な仕組みを一緒に整理します。</p></div>
        <div class="ltg-actions"><a class="ltg-button" href={consult} data-ltg-cta="footer">無料で相談する <span aria-hidden="true">↗</span></a><a href={service.source} target="_blank" rel="noopener" data-ltg-doc>サービス資料を見る ↗</a><p class="ltg-small">全国オンライン対応。構築・配信・改善まで支援します。</p></div>
      </div>
    </section>
  </div>
  <script>
    const guideRoot = document.querySelector<HTMLElement>('[data-ltg-source]');
    const guideSource = guideRoot?.dataset.ltgSource || '';
    const track = (type: string, placement: string) => {
      const analytics = (window as Window & {gtag?: (...args: unknown[]) => void}).gtag;
      if (typeof analytics === 'function') analytics('event', 'select_content', {content_type: type, content_id: 'ltori', page_source: guideSource, placement});
    };
    guideRoot?.querySelectorAll<HTMLElement>('[data-ltg-cta]').forEach(a => a.addEventListener('click', () => track('consultation_cta', a.dataset.ltgCta || '')));
    guideRoot?.querySelectorAll('[data-ltg-doc]').forEach(a => a.addEventListener('click', () => track('service_document', 'guide')));
  </script>
</Base>
