---
/**
 * 全ページ共通レイアウト。
 * ヘッダー・フッター・SEO(head)・共通スクリプトをここに集約する。
 * デザイン調整のうち「全ページ共通の骨格」はこのファイルを編集する。
 */
import '../styles/style.css';
// 管理画面（/admin →「サイト設定」）から編集できる共通データ
import settings from '../data/settings.json';
import theme from '../data/theme.json';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  /** SNSシェア用画像（省略時は基本設定のOGP画像） */
  ogImage?: string;
  /** robotsメタ（例: "noindex, nofollow"。サンクスページ等で使用） */
  robots?: string;
  /** 構造化データ(JSON-LD)。ページ側から渡す。 */
  jsonLd?: object | object[] | null;
}

const { title, description, ogType = 'website', ogImage, robots, jsonLd = null } = Astro.props;

// 右下の資料ダウンロード誘導ポップアップ（資料ページ自身では出さない）
const showDocPop = !Astro.url.pathname.startsWith('/document');

// ===== デザイン設定（/admin →「サイト設定 → デザイン設定」） =====
// 英字見出しフォントの選択肢。追加したい場合はここにマッピングを足す。
const fontMap: Record<string, { family: string; gf: string }> = {
  Montserrat: { family: 'Montserrat', gf: 'Montserrat:wght@700;800' },
  Archivo: { family: 'Archivo', gf: 'Archivo:wght@700;800' },
  Poppins: { family: 'Poppins', gf: 'Poppins:wght@700;800' },
};
const font = fontMap[theme.font_en] ?? fontMap.Montserrat;
const fontHref = `https://fonts.googleapis.com/css2?family=${font.gf}&family=Noto+Sans+JP:wght@400;500;700;900&display=swap`;
// theme.json の値でCSS変数を上書きする。
// :root:root と二重にすることで詳細度を上げ、style.css の既定値より必ず優先させる。
const themeCss = `:root:root{--green:${theme.accent};--green-dark:${theme.accent_dark};--black:${theme.base_black};--bg:${theme.bg_tint};--radius:${theme.radius}px;--font-en:'${font.family}','Noto Sans JP',sans-serif}`;
const ogImageUrl = (ogImage || (settings as any).og_image || '') as string;

// canonical / OG URL は astro.config.mjs の site を基準に自動生成
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// CTAリンク: LINE友だち追加URLが設定されていればそちら、無ければメール
const consult = settings.line_url?.trim()
  ? settings.line_url
  : `mailto:${settings.email}?subject=${encodeURIComponent('【無料相談】LINE活用について')}`;
const contact = `mailto:${settings.email}?subject=${encodeURIComponent('お問い合わせ')}`;
const taglineLines = settings.tagline.split('\n');
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230F1613'/%3E%3Cpath d='M8 21l8 4 8-4' fill='none' stroke='%2306C755' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' opacity='.55'/%3E%3Cpath d='M8 16l8 4 8-4' fill='none' stroke='%2306C755' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' opacity='.8'/%3E%3Cpath d='M16 7l8 4-8 4-8-4z' fill='%2306C755'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content="株式会社LAYR" />
  {ogImageUrl && <meta property="og:image" content={new URL(ogImageUrl, Astro.site).href} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={favicon} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontHref} rel="stylesheet" />
  <style is:inline set:html={themeCss}></style>
  {typeof (theme as any).custom_css === 'string' && (theme as any).custom_css.trim() !== '' && (
    <style is:inline id="layr-custom-css" set:html={(theme as any).custom_css}></style>
  )}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body class={theme.show_watermark ? '' : 'no-wm'}>

<header class="header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="株式会社LAYR トップへ">
      <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6 21.5l10 5 10-5" stroke="#06C755" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".45"/>
        <path d="M6 15.5l10 5 10-5" stroke="#06C755" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".75"/>
        <path d="M16 5l10 5-10 5-10-5 10-5z" fill="#06C755"/>
      </svg>
      <span>
        <span class="brand-name">LAYR</span>
        <span class="brand-sub">LINEマーケティング支援</span>
      </span>
    </a>
    <nav class="gnav" id="gnav" aria-label="グローバルナビゲーション">
      <ul>
        <li><a href="/#service">サービス</a></li>
        <li><a href="/#reason">選ばれる理由</a></li>
        <li><a href="/#case">支援実績</a></li>
        <li><a href="/blog/">コラム</a></li>
        <li><a href="/#message">代表挨拶</a></li>
        <li><a href="/#company">会社概要</a></li>
      </ul>
    </nav>
    <div class="header-btns">
      <a class="btn btn-black" href={contact}>お問い合わせ</a>
      <a class="btn btn-green" href={consult}>LINE活用 無料相談</a>
    </div>
    <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="gnav" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="footer">
  <div class="footer-inner">
    <div>
      <div class="brand">
        <svg width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6 21.5l10 5 10-5" stroke="#06C755" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".45"/>
          <path d="M6 15.5l10 5 10-5" stroke="#06C755" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".75"/>
          <path d="M16 5l10 5-10 5-10-5 10-5z" fill="#06C755"/>
        </svg>
        <span class="brand-name">LAYR</span>
      </div>
      <p class="footer-tagline" data-edit-ml="settings.tagline">{taglineLines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
    </div>
    <div>
      <h4>SERVICE</h4>
      <ul class="footer-nav">
        <li><a href="/#service">LINE構築・運用マーケティング</a></li>
        <li><a href="/#service">広告運用代行</a></li>
        <li><a href="/#service">LINEコンサルティング</a></li>
      </ul>
    </div>
    <div>
      <h4>SITEMAP</h4>
      <ul class="footer-nav">
        <li><a href="/#reason">選ばれる理由</a></li>
        <li><a href="/#case">支援実績</a></li>
        <li><a href="/blog/">コラム</a></li>
        <li><a href="/document/">サービス紹介資料</a></li>
        <li><a href="/#company">会社概要</a></li>
        <li><a href="/#contact">お問い合わせ</a></li>
        <li><a href="/privacy/">プライバシーポリシー</a></li>
      </ul>
    </div>
  </div>
  <p class="footer-copy">© 2026 LAYR Inc. All Rights Reserved.</p>
</footer>

{showDocPop && (
  <aside class="doc-pop" id="docPop" aria-label="サービス紹介資料のご案内">
    <button class="doc-pop-toggle" id="docPopToggle" aria-expanded="true" aria-label="資料案内を折りたたむ">∨</button>
    <a class="doc-pop-body" href="/document/">
      <p class="doc-pop-head">サービス紹介資料<br />無料ダウンロード</p>
      <div class="doc-pop-thumbs" aria-hidden="true">
        <span class="t t1"></span><span class="t t2"></span><span class="t t3"></span>
      </div>
      <span class="doc-pop-btn">資料をダウンロード ▶</span>
    </a>
  </aside>
)}

<script is:inline>
  // カスタマイザー（/admin/customize/）のライブプレビュー受信ブリッジ。
  // カスタマイザーのiframe内で表示されている時だけ動く。
  if (window.self !== window.top) {
    window.addEventListener('message', function (e) {
      if (e.origin !== location.origin) return;
      var d = e.data;
      if (!d || d.type !== 'layr-preview') return;
      if (d.vars) {
        for (var k in d.vars) document.documentElement.style.setProperty(k, d.vars[k]);
      }
      if (d.fontHref) {
        var id = 'layr-preview-font';
        var l = document.getElementById(id);
        if (!l) { l = document.createElement('link'); l.id = id; l.rel = 'stylesheet'; document.head.appendChild(l); }
        if (l.href !== d.fontHref) l.href = d.fontHref;
      }
      if (d.texts) {
        for (var key in d.texts) {
          document.querySelectorAll('[data-edit="' + key + '"]').forEach(function (el) { el.textContent = d.texts[key]; });
        }
      }
      if (d.mlTexts) {
        for (var mk in d.mlTexts) {
          document.querySelectorAll('[data-edit-ml="' + mk + '"]').forEach(function (el) {
            var esc = d.mlTexts[mk].replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            el.innerHTML = esc.replace(/\n/g, '<br>');
          });
        }
      }
      if (d.show) {
        for (var sk in d.show) {
          document.querySelectorAll('[data-edit-show="' + sk + '"]').forEach(function (el) { el.style.display = d.show[sk] ? '' : 'none'; });
        }
      }
      if (d.heights) {
        for (var hk in d.heights) {
          document.querySelectorAll('[data-edit-h="' + hk + '"]').forEach(function (el) { el.style.setProperty('--h', d.heights[hk] + '%'); });
        }
      }
      if (typeof d.css === 'string') {
        var s = document.getElementById('layr-custom-css');
        if (!s) { s = document.createElement('style'); s.id = 'layr-custom-css'; document.head.appendChild(s); }
        s.textContent = d.css;
      }
    });
  }
</script>

<script>
  // モバイルメニュー開閉
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('gnav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    });
    nav.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.tagName === 'A') {
        nav.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // 右下の資料ポップアップ: 折りたたみ状態を記憶する
  const pop = document.getElementById('docPop');
  const popToggle = document.getElementById('docPopToggle');
  if (pop && popToggle) {
    const KEY = 'layrDocPopCollapsed';
    const setState = (collapsed: boolean) => {
      pop.classList.toggle('is-collapsed', collapsed);
      popToggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      popToggle.textContent = collapsed ? '📄 サービス紹介資料' : '∨';
      popToggle.setAttribute('aria-label', collapsed ? '資料案内を開く' : '資料案内を折りたたむ');
    };
    setState(localStorage.getItem(KEY) === '1');
    popToggle.addEventListener('click', () => {
      const next = !pop.classList.contains('is-collapsed');
      localStorage.setItem(KEY, next ? '1' : '0');
      setState(next);
    });
  }

  // スクロールで要素をフェードイン
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-visible'));
  }
</script>
</body>
</html>
