---
/**
 * 全ページ共通レイアウト。
 * ヘッダー・フッター・SEO(head)・共通スクリプトをここに集約する。
 * デザイン調整のうち「全ページ共通の骨格」はこのファイルを編集する。
 */
import '../styles/style.css';
// 管理画面（/admin →「サイト設定」）から編集できる共通データ
import settings from '../data/settings.json';
import theme from '../data/theme.json';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  /** SNSシェア用画像（省略時は基本設定のOGP画像） */
  ogImage?: string;
  /** robotsメタ（例: "noindex, nofollow"。サンクスページ等で使用） */
  robots?: string;
  /** 構造化データ(JSON-LD)。ページ側から渡す。 */
  jsonLd?: object | object[] | null;
  /** trueで共通ヘッダーを出さない（独立LP用。ページ側で専用ヘッダーを持つ） */
  hideHeader?: boolean;
}

const { title, description, ogType = 'website', ogImage, robots, jsonLd = null, hideHeader = false } = Astro.props;

// ===== デザイン設定（/admin →「サイト設定 → デザイン設定」） =====
// 英字見出しフォントの選択肢。追加したい場合はここにマッピングを足す。
// 英数字書体。既定は和文と同じ Noto Sans JP（和欧の骨格を揃え、書体の種類を1本に絞る）。
// 幾何学サンセリフ(Poppins等)はNoto Sans JPと骨格が合わず英数字だけ浮くため既定から外した。
const fontMap: Record<string, { family: string; gf: string }> = {
  NotoSansJP: { family: 'Noto Sans JP', gf: '' },
  Montserrat: { family: 'Montserrat', gf: 'Montserrat:wght@500;700' },
  Archivo: { family: 'Archivo', gf: 'Archivo:wght@500;700' },
  Poppins: { family: 'Poppins', gf: 'Poppins:wght@500;700' },
};
const font = fontMap[theme.font_en] ?? fontMap.NotoSansJP;
// 和文は 400 / 500 / 700 の3ウエイトのみ使う（900は公開ページで未使用のため読まない）
const fontHref = `https://fonts.googleapis.com/css2?${font.gf ? `family=${font.gf}&` : ''}family=Noto+Sans+JP:wght@400;500;700&display=swap`;
// theme.json の値でCSS変数を上書きする。
// :root:root と二重にすることで詳細度を上げ、style.css の既定値より必ず優先させる。
const themeCss = `:root:root{--green:${theme.accent};--green-dark:${theme.accent_dark};--black:${theme.base_black};--bg:${theme.bg_tint};--radius:${theme.radius}px;--font-en:'${font.family}','Noto Sans JP',sans-serif}`;
// OGP画像: ページ指定 → サイト設定 → 既定の /ogp.png の順で必ず1枚出す
const ogImageUrl = (ogImage || (settings as any).og_image || '/ogp.png') as string;
const ogImageAbs = new URL(ogImageUrl, Astro.site).href;

// canonical / OG URL は astro.config.mjs の site を基準に自動生成
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// 全ページ共通の構造化データ（Organization / WebSite）。
// ページ固有の jsonLd（FAQ・Service・記事など）はこの後ろに連結して出力する。
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://layr.co.jp/#organization',
  name: '株式会社LAYR',
  url: 'https://layr.co.jp/',
  logo: { '@type': 'ImageObject', url: new URL('/ogp.png', Astro.site).href, width: 1200, height: 630 },
  email: settings.email,
  description: 'LINE公式アカウントの構築と運用・改善に特化した、中小企業向けLINEマーケティング専業の会社。',
  founder: { '@type': 'Person', name: '河出 壱貫' },
  foundingDate: '2026-08',
  areaServed: 'JP',
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: settings.email, url: 'https://layr.co.jp/contact/', availableLanguage: 'ja' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '道玄坂1丁目10番8号 渋谷道玄坂東急ビル2F-C',
    addressLocality: '渋谷区',
    addressRegion: '東京都',
    addressCountry: 'JP',
  },
};
const webSiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://layr.co.jp/#website',
  name: '株式会社LAYR',
  url: 'https://layr.co.jp/',
  inLanguage: 'ja',
  publisher: { '@id': 'https://layr.co.jp/#organization' },
};
const allJsonLd = [orgJsonLd, webSiteJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
// </script> によるHTML破壊を防ぐ（JSON-LD内の < をエスケープ）
const jsonLdHtml = JSON.stringify(allJsonLd).replace(/</g, '\\u003c');

// CTAリンク: LINE友だち追加URLが設定されていればそちら、無ければメール
const consult = settings.line_url?.trim()
  ? settings.line_url
  : `mailto:${settings.email}?subject=${encodeURIComponent('【無料相談】LINE活用について')}`;
const contact = `mailto:${settings.email}?subject=${encodeURIComponent('お問い合わせ')}`;
const taglineLines = settings.tagline.split('\n');
// favicon はCSS変数を使えないので、テーマ色から組み立てて必ずロゴと同じ緑にする。
// （ここをハードコードすると、ヘッダーロゴとCTAで色相の違う緑が並ぶ事故になる）
const faviconAccent = encodeURIComponent(theme.accent);
const faviconBase = encodeURIComponent(theme.base_black);
const favicon = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='white'/%3E%3Crect width='32' height='32' rx='7' fill='none' stroke='%23E4EAEA' stroke-width='1'/%3E%3Ctext x='16.2' y='19.9' text-anchor='middle' font-family='Helvetica Neue,Helvetica,Arial,sans-serif' font-weight='700' font-size='10' letter-spacing='.6' fill='${faviconBase}'%3ELAYR%3C/text%3E%3C/svg%3E`;
---
<!doctype html>
<html lang="ja" class="no-js">
<head>
  <meta charset="UTF-8" />
  <script is:inline>document.documentElement.classList.remove('no-js')</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content="株式会社LAYR" />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageAbs} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href={favicon} sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontHref} rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href={fontHref} rel="stylesheet" /></noscript>
  <style is:inline set:html={themeCss}></style>
  {typeof (theme as any).custom_css === 'string' && (theme as any).custom_css.trim() !== '' && (
    <style is:inline id="layr-custom-css" set:html={(theme as any).custom_css}></style>
  )}
  <script type="application/ld+json" set:html={jsonLdHtml} />
  {(settings as any).ga_id && (
    <Fragment>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${(settings as any).ga_id}`}></script>
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','${(settings as any).ga_id}');`}></script>
    </Fragment>
  )}
</head>
<body>

{!hideHeader && (
<header class="header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="株式会社LAYR トップへ">
      <span>
        <span class="brand-name">LAYR</span>
        <span class="brand-sub">LINE構築・運用を軸にしたマーケティング支援会社。</span>
      </span>
    </a>
    <nav class="gnav" id="gnav" aria-label="グローバルナビゲーション">
      <p class="gnav-label" aria-hidden="true">MENU</p>
      <ul>
        <li><a href="/service/">サービス</a></li>
        <li><a href="/#reason">できること</a></li>
        <li><a href="/case/">支援実績</a></li>
        <li><a href="/#flow">運用のながれ</a></li>
        <li><a href="/#price">価格</a></li>
        <li><a href="/media/">メディア</a></li>
        <li><a href="/#company">会社概要</a></li>
      </ul>
      <div class="gnav-cta">
        <a class="btn btn-line" href="/contact/">お問い合わせ</a>
        <a class="btn btn-black" href="/document/">資料をダウンロード</a>
      </div>
    </nav>
    <div class="gnav-backdrop" id="gnavBackdrop" aria-hidden="true"></div>
    <div class="header-btns">
      <a class="btn btn-black" href="/document/">資料請求</a>
      <a class="btn btn-line" href="/contact/">お問い合わせ</a>
    </div>
    <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="gnav" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
)}

<main>
  <slot />
</main>

<footer class="footer">
  <div class="footer-inner">
    <div>
      <div class="brand">
        <span class="brand-name">LAYR</span>
      </div>
      <p class="footer-tagline" data-edit-ml="settings.tagline">{taglineLines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
      {/* SNS。settings.json にURLがある分だけ出す */}
      <ul class="footer-sns">
        {(settings as any).youtube_url && (
          <li><a href={(settings as any).youtube_url} target="_blank" rel="noopener" aria-label="YouTube（地方ビジネスをLINEマーケティングで加速CH）">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
          </a></li>
        )}
        {(settings as any).instagram_url && (
          <li><a href={(settings as any).instagram_url} target="_blank" rel="noopener" aria-label="Instagram（@layr_line）">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.3-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.3 2.2-.4 1.3-.1 1.7-.1 4.9-.1Zm0 1.8c-3.1 0-3.5 0-4.7.1-.9 0-1.4.2-1.7.3-.4.2-.7.4-1 .7-.3.3-.5.6-.7 1-.1.3-.3.8-.3 1.7-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c0 .9.2 1.4.3 1.7.2.4.4.7.7 1 .3.3.6.5 1 .7.3.1.8.3 1.7.3 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c.9 0 1.4-.2 1.7-.3.4-.2.7-.4 1-.7.3-.3.5-.6.7-1 .1-.3.3-.8.3-1.7.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c0-.9-.2-1.4-.3-1.7-.2-.4-.4-.7-.7-1-.3-.3-.6-.5-1-.7-.3-.1-.8-.3-1.7-.3-1.2-.1-1.6-.1-4.7-.1Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 8.1a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Zm6.2-8.3a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0Z"/></svg>
          </a></li>
        )}
        {settings.line_url?.trim() && (
          <li><a href={settings.line_url} target="_blank" rel="noopener" aria-label="LINE公式アカウント">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.6c5.5 0 10 3.6 10 8.1 0 1.8-.7 3.4-2 4.9-1.9 2.2-6.2 4.9-7.2 5.3-.9.4-.8-.2-.8-.4l.1-.8c0-.3.1-.7-.1-1-.2-.3-.7-.4-1.1-.5-5-.7-8.9-4.2-8.9-8.5 0-4.5 4.5-8.1 10-8.1ZM8.1 9.2H7c-.2 0-.3.1-.3.3v4.3c0 .2.1.3.3.3h1.1c.2 0 .3-.1.3-.3V9.5c0-.2-.1-.3-.3-.3Zm5.6 0h-1.1c-.2 0-.3.1-.3.3v2.5L10.4 9.4l-.1-.1h-1.2c-.2 0-.3.1-.3.3v4.3c0 .2.1.3.3.3h1.1c.2 0 .3-.1.3-.3v-2.5l1.9 2.6.1.1h1.2c.2 0 .3-.1.3-.3V9.5c0-.2-.1-.3-.3-.3Zm4.6 1.4c.2 0 .3-.1.3-.3V9.5c0-.2-.1-.3-.3-.3h-2.8c-.2 0-.3.1-.3.3v4.3c0 .2.1.3.3.3h2.8c.2 0 .3-.1.3-.3v-1.1c0-.2-.1-.3-.3-.3h-1.4v-.6h1.4c.2 0 .3-.1.3-.3v-1.1c0-.2-.1-.3-.3-.3h-1.4v-.5h1.4Z"/></svg>
          </a></li>
        )}
      </ul>
    </div>
    <div>
      <h4>SERVICE</h4>
      <ul class="footer-nav">
        <li><a href="/service/">サービス一覧</a></li>
        <!-- 各サービスは「サービス一覧」の下位。段差（インデント）で階層を示す -->
        <li class="ft-child"><a href="/service/line/">LINE構築・運用マーケティング</a></li>
        <li class="ft-child"><a href="/service/ad/">広告運用代行</a></li>
        <li class="ft-child"><a href="/yorozuya/">WebマーケティングBPO</a></li>
        <li class="ft-child"><a href="/service/ai/">よろず屋AI（AI導入支援）</a></li>
      </ul>
    </div>
    <div>
      <h4>SITEMAP</h4>
      <ul class="footer-nav">
        <li><a href="/#reason">できること</a></li>
        <li><a href="/case/">支援実績</a></li>
        <li><a href="/media/">メディア</a></li>
        <li><a href="/document/">サービス資料＆お役立ち資料</a></li>
        <li><a href="/#company">会社概要</a></li>
        <li><a href="/contact/">お問い合わせ</a></li>
        <li><a href="/privacy/">プライバシーポリシー</a></li>
      </ul>
    </div>
  </div>
  <p class="footer-copy">© 2026 LAYR Inc. All Rights Reserved.</p>
</footer>

<script is:inline>
  // カスタマイザー（/admin/customize/）のライブプレビュー受信ブリッジ。
  // カスタマイザーのiframe内で表示されている時だけ動く。
  if (window.self !== window.top) {
    window.addEventListener('message', function (e) {
      if (e.origin !== location.origin) return;
      var d = e.data;
      if (!d || d.type !== 'layr-preview') return;
      if (d.vars) {
        for (var k in d.vars) document.documentElement.style.setProperty(k, d.vars[k]);
      }
      if (d.fontHref) {
        var id = 'layr-preview-font';
        var l = document.getElementById(id);
        if (!l) { l = document.createElement('link'); l.id = id; l.rel = 'stylesheet'; document.head.appendChild(l); }
        if (l.href !== d.fontHref) l.href = d.fontHref;
      }
      if (d.texts) {
        for (var key in d.texts) {
          document.querySelectorAll('[data-edit="' + key + '"]').forEach(function (el) { el.textContent = d.texts[key]; });
        }
      }
      if (d.mlTexts) {
        for (var mk in d.mlTexts) {
          document.querySelectorAll('[data-edit-ml="' + mk + '"]').forEach(function (el) {
            var esc = d.mlTexts[mk].replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            el.innerHTML = esc.replace(/\n/g, '<br>');
          });
        }
      }
      if (d.show) {
        for (var sk in d.show) {
          document.querySelectorAll('[data-edit-show="' + sk + '"]').forEach(function (el) { el.style.display = d.show[sk] ? '' : 'none'; });
        }
      }
      if (d.heights) {
        for (var hk in d.heights) {
          document.querySelectorAll('[data-edit-h="' + hk + '"]').forEach(function (el) { el.style.setProperty('--h', d.heights[hk] + '%'); });
        }
      }
      if (typeof d.css === 'string') {
        var s = document.getElementById('layr-custom-css');
        if (!s) { s = document.createElement('style'); s.id = 'layr-custom-css'; document.head.appendChild(s); }
        s.textContent = d.css;
      }
    });
  }
</script>

<script>
  // モバイルメニュー開閉
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('gnav');
  const backdrop = document.getElementById('gnavBackdrop');
  const setMenu = (open: boolean) => {
    if (!btn || !nav) return;
    nav.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('nav-open', open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
  };
  if (btn && nav) {
    btn.addEventListener('click', () => setMenu(!nav.classList.contains('is-open')));
    nav.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('a')) setMenu(false);
    });
    backdrop?.addEventListener('click', () => setMenu(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  }

  // スクロールで要素をフェードイン
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-visible'));
  }
</script>
</body>
</html>
