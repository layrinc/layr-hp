---
/**
 * 全ページ共通レイアウト。
 * ヘッダー・フッター・SEO(head)・共通スクリプトをここに集約する。
 * デザイン調整のうち「全ページ共通の骨格」はこのファイルを編集する。
 */
import '../styles/style.css';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  /** 構造化データ(JSON-LD)。ページ側から渡す。 */
  jsonLd?: object | object[] | null;
}

const { title, description, ogType = 'website', jsonLd = null } = Astro.props;

// canonical / OG URL は astro.config.mjs の site を基準に自動生成
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// CTAリンク（全ページ共通。将来LINE友だち追加URLへ差し替え可）
const consult = 'mailto:info@layr.co.jp?subject=%E3%80%90%E7%84%A1%E6%96%99%E7%9B%B8%E8%AB%87%E3%80%91LINE%E6%B4%BB%E7%94%A8%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6';
const contact = 'mailto:info@layr.co.jp?subject=%E3%81%8A%E5%95%8F%E3%81%84%E5%90%88%E3%82%8F%E3%81%9B';
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230F1613'/%3E%3Cpath d='M8 21l8 4 8-4' fill='none' stroke='%2306C755' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' opacity='.55'/%3E%3Cpath d='M8 16l8 4 8-4' fill='none' stroke='%2306C755' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' opacity='.8'/%3E%3Cpath d='M16 7l8 4-8 4-8-4z' fill='%2306C755'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content="株式会社LAYR" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={favicon} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>

<header class="header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="株式会社LAYR トップへ">
      <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6 21.5l10 5 10-5" stroke="#06C755" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".45"/>
        <path d="M6 15.5l10 5 10-5" stroke="#06C755" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".75"/>
        <path d="M16 5l10 5-10 5-10-5 10-5z" fill="#06C755"/>
      </svg>
      <span>
        <span class="brand-name">LAYR</span>
        <span class="brand-sub">LINEマーケティング支援</span>
      </span>
    </a>
    <nav class="gnav" id="gnav" aria-label="グローバルナビゲーション">
      <ul>
        <li><a href="/#service">サービス</a></li>
        <li><a href="/#reason">選ばれる理由</a></li>
        <li><a href="/#case">支援実績</a></li>
        <li><a href="/blog/">コラム</a></li>
        <li><a href="/#message">代表挨拶</a></li>
        <li><a href="/#company">会社概要</a></li>
      </ul>
    </nav>
    <div class="header-btns">
      <a class="btn btn-black" href={contact}>お問い合わせ</a>
      <a class="btn btn-green" href={consult}>LINE活用 無料相談</a>
    </div>
    <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="gnav" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="footer">
  <div class="footer-inner">
    <div>
      <div class="brand">
        <svg width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6 21.5l10 5 10-5" stroke="#06C755" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".45"/>
          <path d="M6 15.5l10 5 10-5" stroke="#06C755" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".75"/>
          <path d="M16 5l10 5-10 5-10-5 10-5z" fill="#06C755"/>
        </svg>
        <span class="brand-name">LAYR</span>
      </div>
      <p class="footer-tagline">LINE構築・運用を軸にしたマーケティング支援会社。<br>一度きりの集客を、積み上がる売上に変える。</p>
    </div>
    <div>
      <h4>SERVICE</h4>
      <ul class="footer-nav">
        <li><a href="/#service">LINE構築・運用マーケティング</a></li>
        <li><a href="/#service">広告運用代行</a></li>
        <li><a href="/#service">LINEコンサルティング</a></li>
      </ul>
    </div>
    <div>
      <h4>SITEMAP</h4>
      <ul class="footer-nav">
        <li><a href="/#reason">選ばれる理由</a></li>
        <li><a href="/#case">支援実績</a></li>
        <li><a href="/blog/">コラム</a></li>
        <li><a href="/#company">会社概要</a></li>
        <li><a href="/#contact">お問い合わせ</a></li>
      </ul>
    </div>
  </div>
  <p class="footer-copy">© 2026 LAYR Inc. All Rights Reserved.</p>
</footer>

<script>
  // モバイルメニュー開閉
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('gnav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    });
    nav.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.tagName === 'A') {
        nav.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // スクロールで要素をフェードイン
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-visible'));
  }
</script>
</body>
</html>
