---
import clientData from '../data/clients.json';
interface Client { name: string; logo: string }
const clients = (clientData as { items: Client[] }).items.filter(client => client.name.trim() && client.logo.trim());
---
{clients.length > 0 && (
  <section class="client-marquee" data-client-marquee aria-label="お取引先・支援企業">
    <div class="client-marquee-head container">
      <p>CLIENTS<span>お取引先・支援企業</span></p>
      <button type="button" data-client-pause aria-pressed="false" hidden>動きを止める</button>
    </div>
    <div class="client-marquee-viewport" tabindex="0" aria-label="クライアントロゴ一覧">
      <div class="client-marquee-track">
        {[false, true].map(copy => (
          <ul class:list={['client-marquee-group', { 'client-marquee-copy': copy }]} aria-hidden={copy ? 'true' : undefined}>
            {clients.map(client => (
              <li><img src={client.logo} alt={copy ? '' : client.name} width="200" height="80" loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .client-marquee{padding:24px 0 32px;background:var(--tint-green);overflow:hidden}
  .client-marquee-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}
  .client-marquee-head p{display:flex;flex-wrap:wrap;gap:12px;font-size:calc(12px * var(--fs,1));letter-spacing:var(--track-label);color:var(--green-ink);font-weight:700}
  .client-marquee-head p span{font-weight:400;letter-spacing:var(--track-normal)}
  .client-marquee-head button{font:inherit;font-size:calc(12px * var(--fs,1));color:var(--green-ink);background:transparent;border:0;padding:8px;cursor:pointer;text-decoration:underline;text-underline-offset:4px;flex-shrink:0}
  .client-marquee-viewport{overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin;padding:4px 0 12px}
  .client-marquee-track{display:flex;width:max-content;min-width:100%}
  .client-marquee-group{display:flex;align-items:center;gap:24px;list-style:none;margin:0;padding:0 24px 0 0;min-width:100vw;flex-shrink:0;justify-content:space-around}
  .client-marquee-group li{display:grid;place-items:center;width:200px;height:80px;flex-shrink:0;border-radius:var(--radius);background:var(--paper);padding:14px 20px}
  .client-marquee-group img{display:block;width:100%;height:100%;object-fit:contain}
  .client-marquee-copy{display:none}
  .client-marquee.is-animated .client-marquee-viewport{overflow:hidden}
  .client-marquee.is-animated .client-marquee-copy{display:flex}
  .client-marquee.is-animated .client-marquee-track{animation:client-marquee-travel 36s linear infinite}
  .client-marquee.is-paused .client-marquee-track,.client-marquee:hover .client-marquee-track,.client-marquee:focus-within .client-marquee-track{animation-play-state:paused}
  .client-marquee button:focus-visible,.client-marquee-viewport:focus-visible{outline:2px solid var(--green-dark);outline-offset:-2px}
  @keyframes client-marquee-travel{to{transform:translateX(-50%)}}
  @media(max-width:640px){
    .client-marquee{padding:20px 0 24px}
    .client-marquee-group{gap:16px;padding-right:16px}
    .client-marquee-group li{width:168px;height:72px;padding:12px 16px}
  }
  @media(prefers-reduced-motion:reduce){
    .client-marquee.is-animated .client-marquee-track{animation:none}
    .client-marquee.is-animated .client-marquee-copy{display:none}
    .client-marquee.is-animated .client-marquee-viewport{overflow-x:auto}
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-client-marquee]').forEach(root => {
    const button = root.querySelector<HTMLButtonElement>('[data-client-pause]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const touch = window.matchMedia('(pointer: coarse)');
    let paused = false;
    const update = () => {
      // Touch screens use native swipe; desktop has a stoppable logo loop.
      const animate = !reduced.matches && !touch.matches;
      root.classList.toggle('is-animated', animate);
      root.classList.toggle('is-paused', paused);
      button.hidden = !animate;
      button.setAttribute('aria-pressed', String(paused));
      button.textContent = paused ? '動きを再開する' : '動きを止める';
    };
    button.addEventListener('click', () => { paused = !paused; update(); });
    reduced.addEventListener('change', update);
    touch.addEventListener('change', update);
    update();
  });
</script>
