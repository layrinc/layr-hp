---
const { id = 'customer-journey-happiness', serviceLink = false } = Astro.props;
const items = [
  { en: 'CUSTOMER', title: 'お客様が、うれしい。', body: '自分に合う、いい商品に出会えた。' },
  { en: 'BUSINESS', title: '企業が、うれしい。', body: '商品の価値が届き、事業が育つ。' },
  { en: 'LAYR', title: '私たちも、うれしい。', body: '一緒につくった成果を、ともに喜べる。' },
];
---
<section class="journey-happiness" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="happiness-heading">
      <div>
        <p class="happiness-eyebrow">HAPPINESS GOES AROUND</p>
        <h2 id={`${id}-title`}>いい出会いの先に、<br /><em>みんなの「うれしい」を。</em></h2>
        <p class="happiness-intro">お客様に、いい商品が届く。企業の事業が育つ。<br />その成果を、一緒につくった私たちも喜べる。<br />これが、LAYRの目指す「三方よし」です。</p>
        {serviceLink && <a class="happiness-link" href="/service/line/">LINE事業の支援内容を見る ↗</a>}
      </div>
      <img src="/images/journey/isome-success.svg" alt="成約を喜び、ハイタッチする二人のイラスト" width="480" height="340" loading="lazy" decoding="async" />
    </div>
    <div class="happiness-trio">
      {items.map(item => <div><p>{item.en}</p><h3>{item.title}</h3><span>{item.body}</span></div>)}
    </div>
    <p class="happiness-credit"><a href="https://isome-lab.com/" target="_blank" rel="noopener noreferrer">Illustrations by ISOME LAB ↗</a></p>
  </div>
</section>
<style>
  .journey-happiness{padding:clamp(64px,8vw,112px) 0 36px;background:var(--tint-green);scroll-margin-top:80px}
  .happiness-heading{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:48px}
  .happiness-eyebrow{font-size:calc(12px * var(--fs,1));font-weight:700;letter-spacing:var(--track-label);color:var(--green-ink);margin-bottom:22px}
  .happiness-heading h2{font-size:calc(clamp(26px,3vw,38px) * var(--fs,1));line-height:1.6;font-weight:700;letter-spacing:var(--track-tight);color:var(--black)}
  .happiness-heading em{font-style:normal;color:var(--green-ink)}
  .happiness-intro{font-size:calc(16px * var(--fs,1));line-height:2.1;margin:24px 0;color:var(--text)}
  .happiness-heading img{width:100%;height:auto;max-height:330px;object-fit:contain}
  .happiness-link{font-size:calc(14px * var(--fs,1));color:var(--green-ink);text-underline-offset:5px}
  .happiness-trio{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:52px;padding-top:28px;border-top:1px solid var(--green-line)}
  .happiness-trio p{font-size:calc(12px * var(--fs,1));color:var(--green-ink);letter-spacing:var(--track-label);margin-bottom:10px;font-weight:700}
  .happiness-trio h3{font-size:calc(20px * var(--fs,1));font-weight:700;margin:0 0 8px;color:var(--black)}
  .happiness-trio span{font-size:calc(14px * var(--fs,1));color:var(--text)}
  .happiness-credit{margin-top:40px;font-size:calc(12px * var(--fs,1));text-align:right}.happiness-credit a{color:var(--green-ink);text-underline-offset:4px}
  @media(max-width:768px){.happiness-heading{gap:24px;grid-template-columns:1fr}.happiness-heading img{max-height:240px}.happiness-trio{grid-template-columns:1fr;gap:26px;margin-top:32px}.happiness-intro br{display:none}}
</style>
