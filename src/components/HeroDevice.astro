---
import { Image } from 'astro:assets';
import heroArtwork from '../assets/layr-hero-approved.png';

/**
 * ユーザー指定の会話画面を保った透過端末画像を、右側へ直接配置する。
 * 画像内の会話内容を維持する。h1・リード・CTAは従来のHTMLを維持する。
 * 配信用WebPはAstroが生成し、読み上げ用の紹介文は既存データから取得する。
 */
interface Props { data?: any }
const { data = {} } = Astro.props;
const acc = data.account ?? {};
const msgs: any[] = Array.isArray(data.messages) ? data.messages : [];
const menu: any[] = Array.isArray(data.richmenu) ? data.richmenu : [];
const caption = data.caption || 'サービスを紹介するトーク形式のイメージです。';
---
<figure class="hero2-fig hero-device">
  <div class="hero-device-window" aria-hidden="true">
    <Image
      src={heroArtwork}
      alt=""
      format="webp"
      quality={90}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      draggable="false"
    />
  </div>
  <figcaption class="u-vh">
    <p>{caption}</p>
    <p>{acc.name}</p>
    {msgs.map((m: any) => (
      <p>{m?.from === 'user' ? '質問：' : `${acc.name}：`}{m?.text}</p>
    ))}
    <p>リッチメニュー：{menu.map((m: any) => m?.label).filter(Boolean).join('、')}</p>
  </figcaption>
</figure>
