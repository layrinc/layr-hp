---
import steps from '../data/customer-journey.json';
interface Props {
  hero: { line1: string; line2: string; line3?: string; sub: string; cta_primary: string; cta_primary_url: string; cta_line: string };
  consult: string;
  id?: string;
  eyebrow?: string;
}
const { hero, consult, id = 'customer-journey', eyebrow = 'LINE MARKETING / LAYR' } = Astro.props;
const circumference = 2 * Math.PI * 177;
---
<section class="customer-journey" id={id} data-customer-journey aria-label="広告で集客し、LPで商品を紹介し、LINEで購入につなげる導線">
  <div class="journey-view">
    <div class="journey-layout container">
      <div class="journey-orbit-column">
        <div class="journey-orbit-fit">
          <div class="journey-orbit" aria-label="広告・LP・LINEの3つの輪を順に結ぶ導線">
            <svg class="journey-route" viewBox="0 0 620 620" aria-hidden="true">
              <circle class="journey-track" cx="310" cy="310" r="177" />
              <circle class="journey-trace" cx="310" cy="310" r="177" stroke-dasharray={circumference} stroke-dashoffset={circumference} transform="rotate(-90 310 310)" />
            </svg>
            {steps.map((step, i) => (
              <a class={`journey-node journey-node-${i}`} href={`#${id}-stage-${i}`} data-journey-step={i} aria-label={`${i + 1}. ${step.name}の説明へ`}>
                <span class="journey-node-visual"><img src={`/images/journey/isome-${step.asset}.svg`} alt="" width="200" height="160" decoding="async" /></span>
                <span class="journey-node-caption">
                  <span class="journey-node-label"><small>0{i + 1}</small><b>{step.name}</b></span>
                  <span class="journey-node-action">{step.action}</span>
                </span>
              </a>
            ))}
            <div class="journey-bloom" role="img" aria-label="成約。桜が開花し、集客から販売までのつながりが実を結ぶ">
              <svg class="journey-flower" viewBox="-80 -80 160 160" aria-hidden="true">
                <g class="journey-flower-leaves">
                  <path d="M-4 26C-28 19-50 33-51 53C-27 56-10 46-4 26Z" />
                  <path d="M6 29C29 23 49 39 47 57C26 58 11 46 6 29Z" />
                </g>
                {[0, 72, 144, 216, 288].map(angle => (
                  <g transform={`rotate(${angle})`}>
                    <g data-bloom-petal>
                      <path class="journey-flower-petal" d="M0 6C-15-2-35-25-24-47C-18-61-5-57 0-48C5-57 18-61 24-47C35-25 15-2 0 6Z" />
                      <path class="journey-flower-vein" d="M0 1V-32M0-18L-8-26M0-18L8-26" />
                    </g>
                  </g>
                ))}
                <circle class="journey-flower-heart" r="10" />
                {[0, 72, 144, 216, 288].map(angle => (
                  <circle class="journey-flower-stamen" cx="0" cy="-5" r="1.5" transform={`rotate(${angle})`} />
                ))}
              </svg>
              <strong aria-hidden="true">成約</strong>
            </div>
            <div class="journey-traveler" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="7" r="3.5" /><path d="M5 21v-3a7 7 0 0 1 14 0v3" /></svg>
            </div>
          </div>
        </div>
        <p class="journey-summary"><span>集客から販売まで</span><span>一気通貫で支援します</span></p>
        <div class="journey-legend"><span>○ お客様の現在地</span><span>スクロールで3つの支援を見る ↓</span></div>
      </div>

      <div class="journey-mobile">
        <div class="journey-mobile-viewport" aria-label="広告・LP・LINEを横にたどる導線">
          <div class="journey-mobile-track">
            {steps.map((step, i) => (
              <article class="journey-mobile-card" id={`${id}-mobile-${i}`} data-journey-slide={i} aria-labelledby={`${id}-mobile-title-${i}`}>
                <h2 id={`${id}-mobile-title-${i}`}><small>0{i + 1}</small>{step.name}<span aria-hidden="true">{i < steps.length - 1 ? '→' : '✓'}</span></h2>
                <div class="journey-mobile-art">
                  <img src={`/images/journey/isome-${step.asset}.svg`} alt="" width="200" height="160" decoding="async" />
                  {step.asset === 'line' && (
                    <div class="journey-bloom journey-mobile-bloom" role="img" aria-label="成約。桜が開花し、集客から販売までのつながりが実を結ぶ">
                      <svg class="journey-flower" viewBox="-80 -80 160 160" aria-hidden="true">
                        <g class="journey-flower-leaves">
                          <path d="M-4 26C-28 19-50 33-51 53C-27 56-10 46-4 26Z" />
                          <path d="M6 29C29 23 49 39 47 57C26 58 11 46 6 29Z" />
                        </g>
                        {[0, 72, 144, 216, 288].map(angle => (
                          <g transform={`rotate(${angle})`}>
                            <g data-bloom-petal>
                              <path class="journey-flower-petal" d="M0 6C-15-2-35-25-24-47C-18-61-5-57 0-48C5-57 18-61 24-47C35-25 15-2 0 6Z" />
                              <path class="journey-flower-vein" d="M0 1V-32M0-18L-8-26M0-18L8-26" />
                            </g>
                          </g>
                        ))}
                        <circle class="journey-flower-heart" r="10" />
                        {[0, 72, 144, 216, 288].map(angle => (
                          <circle class="journey-flower-stamen" cx="0" cy="-5" r="1.5" transform={`rotate(${angle})`} />
                        ))}
                      </svg>
                      <strong aria-hidden="true">成約</strong>
                    </div>
                  )}
                </div>
                <div class="journey-mobile-description">
                  <p>{step.mobile_body}</p>
                  {step.asset === 'line' && <ol class="journey-mobile-messages" aria-label="LINEシナリオの流れ">
                    {step.support.map((support, n) => <li class:list={{ 'is-message-current': n === 0 }}><span>0{n + 1}</span>{support}</li>)}
                  </ol>}
                </div>
              </article>
            ))}
          </div>
        </div>
        <p class="journey-summary"><span>集客から販売まで</span><span>一気通貫で支援します</span></p>
      </div>
      <div class="journey-story">
        <div class="journey-panels">
          <div class="journey-panel journey-intro" data-phase="-1">
            <p class="journey-eyebrow">{eyebrow}</p>
            <h1>{hero.line1}<br /><em>{hero.line2}</em>{hero.line3 && <><br />{hero.line3}</>}</h1>
            <p class="journey-body" set:html={hero.sub} />
            <div class="journey-actions">
              <a class="btn btn-green" href={hero.cta_primary_url}>{hero.cta_primary}</a>
              <a class="btn btn-outline" href={consult}>{hero.cta_line}</a>
            </div>
          </div>
          {steps.map((step, i) => (
            <section class="journey-panel" data-phase={i} data-stage={step.asset} id={`${id}-stage-${i}`} aria-labelledby={`${id}-title-${i}`}>
              <p class="journey-eyebrow">STEP 0{i + 1}<span>{step.en}</span></p>
              <h2 id={`${id}-title-${i}`}>{step.title[0]}<br /><em>{step.title[1]}</em></h2>
              <p class="journey-body"><span class="journey-body-wide">{step.body}</span><span class="journey-body-mobile">{step.mobile_body}</span></p>
              <ul class:list={['journey-support', { 'journey-messages': step.asset === 'line' }]} aria-label={step.asset === 'line' ? 'LINEシナリオの流れ' : 'LAYRの支援内容'}>
                {step.support.map((support, n) => <li class:list={{ 'is-message-current': n === 0 }} style={step.asset === 'line' ? `--message-index:${n}` : undefined}><span>{step.asset === 'line' ? `0${n + 1}` : '✓'}</span>{support}</li>)}
              </ul>
            </section>
          ))}
        </div>
        <div class="journey-bottom">
          <p class="journey-mobile-cue" aria-hidden="true">下にスクロールして、次のステップへ ↓</p>
          <nav class="journey-steps" aria-label="導線の各ステップへ">
            {steps.map((step, i) => <a href={`#${id}-stage-${i}`} data-journey-step={i}>{step.name}<span aria-hidden="true">{i < steps.length - 1 ? '→' : '✓'}</span></a>)}
          </nav>
          <a class="journey-skip" href="#service">サービスを見る ↓</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .customer-journey{background:var(--paper);position:relative;padding:0}
  .journey-view{padding:32px 0 24px;background:radial-gradient(ellipse at 20% 45%,var(--tint-green),transparent 60%)}
  .journey-layout{display:grid;grid-template-columns:1.08fr 1fr;gap:clamp(24px,4vw,56px);align-items:center;max-width:1280px}
  .journey-orbit-column,.journey-story{min-width:0}
  .journey-orbit-fit{display:contents}
  .journey-mobile,.journey-mobile-cue{display:none}
  .journey-orbit{position:relative;width:100%;aspect-ratio:1;margin:auto}
  .journey-route{position:absolute;inset:0;width:100%;height:100%;overflow:visible;fill:none}
  .journey-track{stroke:var(--green-line);stroke-width:1.5;stroke-dasharray:3 7}
  .journey-trace{stroke:var(--green-dark);stroke-width:3;stroke-linecap:round}
  .journey-node{position:absolute;display:block;width:34%;aspect-ratio:1;text-decoration:none;color:var(--black);transform:translate(-50%,-50%);z-index:2;border-radius:var(--r-pill)}
  .journey-node-0{left:50%;top:21.4516%}.journey-node-1{left:74.7236%;top:64.2742%}.journey-node-2{left:25.2764%;top:64.2742%}
  .journey-node-visual{display:grid;place-items:center;width:100%;height:100%;border:1px solid var(--green-line);border-radius:var(--r-pill);background:var(--paper)}
  .journey-node img{display:block;width:84%;height:84%;object-fit:contain}
  .journey-node-caption{position:absolute;top:calc(100% + 4px);left:50%;transform:translateX(-50%);width:140%;max-width:170px;display:flex;flex-direction:column;align-items:center;gap:3px}
  .journey-node-action{font-size:calc(12px * var(--fs,1));line-height:1.5;text-align:center;color:var(--text)}
  .journey-node-label{display:flex;gap:8px;align-items:center;background:var(--paper);padding:3px 12px;border-radius:var(--r-pill);border:1px solid var(--line-soft);font-size:calc(14px * var(--fs,1));line-height:1.6}
  .journey-node small{font-size:calc(12px * var(--fs,1));color:var(--green-ink)}
  .journey-node[aria-current="step"] .journey-node-label{background:var(--green-dark);color:var(--paper);border-color:var(--green-dark)}
  .journey-node[aria-current="step"] small{color:inherit}
  .journey-traveler{position:absolute;left:50%;top:21.4516%;width:30px;height:30px;transform:translate(-50%,-50%);border-radius:var(--r-pill);background:var(--green-dark);color:var(--paper);border:3px solid var(--paper);z-index:3;padding:3px;pointer-events:none}
  .journey-traveler svg{width:100%;height:100%}
  .journey-bloom{position:absolute;left:50%;top:60%;width:20%;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;gap:2px;z-index:4;pointer-events:none;opacity:var(--journey-bloom-opacity,1)}
  .journey-bloom[hidden]{display:none}
  .journey-flower{width:100%;height:auto;overflow:visible}
  .journey-flower-leaves{fill:var(--green-pale2);stroke:var(--green);stroke-width:1}
  .journey-flower-petal{fill:color-mix(in srgb,var(--red) 24%,var(--paper));stroke:color-mix(in srgb,var(--red) 64%,var(--paper));stroke-width:1.4}
  .journey-flower-vein{fill:none;stroke:var(--red);stroke-opacity:.38;stroke-width:1.3;stroke-linecap:round}
  .journey-flower-heart{fill:var(--mark-y-bg);stroke:var(--mark-y-line);stroke-width:1.2}
  .journey-flower-stamen{fill:var(--mark-y-ink)}
  .journey-bloom strong{padding:2px 10px;background:var(--paper);border-radius:var(--r-pill);color:var(--green-ink);font-size:calc(clamp(15px,1.5vw,20px) * var(--fs,1));font-weight:700;line-height:1.5}
  .is-enhanced .journey-bloom{opacity:var(--journey-bloom-opacity,0)}
  .journey-legend{display:flex;justify-content:space-between;gap:12px;color:var(--green-ink);font-size:calc(12px * var(--fs,1));line-height:1.8}
  .journey-summary{font-size:calc(clamp(15px,1.5vw,20px) * var(--fs,1));font-weight:700;line-height:1.7;color:var(--black);text-align:center;margin:0 0 12px}
  .journey-summary span{display:inline-block}
  .journey-panels{display:grid;align-items:center}
  .journey-panel{margin:32px 0;min-width:0;padding:0}
  .journey-eyebrow{display:flex;flex-wrap:wrap;gap:12px;color:var(--green-ink);font-size:calc(12px * var(--fs,1));font-weight:700;letter-spacing:var(--track-label);margin:0 0 22px;line-height:1.7}
  .journey-eyebrow span{font-weight:400}
  .journey-panel h1,.journey-panel h2{font-size:calc(clamp(26px,3.15vw,42px) * var(--fs,1));line-height:1.55;letter-spacing:var(--track-tight);font-weight:700;color:var(--black);margin:0}
  .journey-panel em{color:var(--green-ink);font-style:normal}
  .journey-body{font-size:calc(16px * var(--fs,1));line-height:2;margin:24px 0;color:var(--text);max-width:33em}
  .journey-body-mobile{display:none}
  .journey-actions{display:flex;gap:12px;flex-wrap:wrap;margin:28px 0 18px}
  .journey-actions .btn{font-size:calc(14px * var(--fs,1));padding:12px 20px;min-height:46px;box-shadow:none}
  .journey-support{display:flex;flex-wrap:wrap;gap:8px 16px;list-style:none;padding:0;margin:20px 0 0;font-size:calc(14px * var(--fs,1))}
  .journey-support li{display:flex;gap:6px;align-items:center}.journey-support li span{color:var(--green-ink);font-size:calc(12px * var(--fs,1))}
  .journey-messages li{background:var(--tint-green);padding:8px 10px;border-radius:var(--radius)}
  .journey-bottom{border-top:1px solid var(--line);padding-top:18px;margin-top:20px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between}
  .journey-steps{display:flex;gap:14px}.journey-steps a{display:flex;gap:14px;align-items:center;font-size:calc(14px * var(--fs,1));font-weight:700;text-decoration:none;color:var(--black);min-height:32px}
  .journey-steps a span{color:var(--green-dark);font-weight:400}.journey-steps a[aria-current="step"]{color:var(--green-ink);text-decoration:underline;text-underline-offset:5px}
  .journey-skip{color:var(--green-ink);font-size:calc(12px * var(--fs,1));text-underline-offset:4px}
  .customer-journey.is-enhanced{height:400svh}
  .is-enhanced .journey-view{position:sticky;top:var(--journey-header,80px);height:calc(100svh - var(--journey-header,80px));display:grid;align-items:center;min-height:580px}
  .is-enhanced .journey-panel{grid-area:1/1;margin:0}
  .is-enhanced .journey-panel[hidden]{display:block;visibility:hidden;pointer-events:none}
  .is-enhanced .journey-orbit{max-width:min(100%,68svh)}
  .is-enhanced .journey-messages li{opacity:clamp(.22,calc(var(--journey-message,0) - var(--message-index)),1)}
  .customer-journey:not(.is-enhanced) .journey-layout{grid-template-columns:1fr}
  .customer-journey:not(.is-enhanced) .journey-story,
  .customer-journey:not(.is-enhanced) .journey-panels{display:contents}
  .customer-journey:not(.is-enhanced) .journey-intro{order:-4;margin-top:0}
  .customer-journey:not(.is-enhanced) .journey-orbit-column{order:-3;max-width:320px;width:100%;margin:auto}
  .customer-journey:not(.is-enhanced) .journey-bottom{order:2}
  .customer-journey:not(.is-enhanced) .journey-traveler,
  .customer-journey:not(.is-enhanced) .journey-bloom,
  .customer-journey:not(.is-enhanced) .journey-legend{display:none}
  .journey-node:hover .journey-node-visual{border-color:var(--green-dark)}
  .journey-node:focus-visible,.journey-steps a:focus-visible,.journey-skip:focus-visible{outline:2px solid var(--green-dark);outline-offset:5px}
  @media(max-width:900px){
    .journey-layout{gap:20px;grid-template-columns:1fr 1fr}.journey-panel h1,.journey-panel h2{font-size:calc(28px * var(--fs,1))}
    .journey-actions{gap:8px}.journey-actions .btn{padding:10px 14px}.journey-legend{flex-direction:column;gap:0}.journey-body{margin:18px 0}
  }
  @media(max-width:640px){
    .journey-view{padding:20px 0}
    .journey-layout{grid-template-columns:minmax(0,1fr);gap:16px}
    .journey-orbit-column{display:none}
    .journey-story{display:contents}
    .journey-panels{order:0}
    .customer-journey .journey-panel:not(.journey-intro){display:none}
    .journey-panel h1{font-size:calc(clamp(26px,8vw,42px) * var(--fs,1));line-height:1.45}
    .journey-eyebrow{margin-bottom:6px;gap:8px;line-height:1.5}
    .journey-body{margin:8px 0;font-size:calc(14px * var(--fs,1));line-height:1.65}
    .journey-actions{margin:12px 0 0;gap:8px}
    .journey-actions .btn{padding:8px 12px;font-size:calc(14px * var(--fs,1));min-height:40px}
    .journey-mobile{display:grid;order:1;gap:8px;min-width:0}
    .journey-mobile-viewport{min-width:0;touch-action:pan-y pinch-zoom}
    .journey-mobile-track{position:relative;display:grid;gap:16px}
    .journey-mobile-card{display:grid;grid-template-rows:auto minmax(64px,1fr) auto;gap:8px;min-width:0;padding:12px;border:1px solid var(--green-line);border-radius:var(--r-lg);background:var(--paper)}
    .journey-mobile-card h2{display:flex;align-items:center;gap:10px;margin:0;color:var(--black);font-size:calc(20px * var(--fs,1));line-height:1.45}
    .journey-mobile-card h2 small{color:var(--green-ink);font-size:calc(14px * var(--fs,1))}
    .journey-mobile-card h2 span{margin-left:auto;color:var(--green-dark)}
    .journey-mobile-card[aria-current="step"]{border-color:var(--green-dark)}
    .journey-mobile-art{position:relative;min-height:64px;display:grid;place-items:center}
    .journey-mobile-art img{width:100%;height:100%;min-height:0;max-height:180px;object-fit:contain}
    .journey-mobile-description p{margin:0;color:var(--text);font-size:calc(14px * var(--fs,1));line-height:1.65}
    .journey-mobile-messages{padding:0;margin:6px 0 0;list-style:none;display:grid;gap:4px}
    .journey-mobile-messages li{display:flex;align-items:center;gap:6px;padding:3px 6px;border-radius:var(--radius);background:var(--tint-green);font-size:calc(12px * var(--fs,1));line-height:1.5}
    .journey-mobile-messages li span{color:var(--green-ink)}
    .journey-mobile-bloom{left:auto;right:0;top:auto;bottom:0;width:64px;transform:none}
    .journey-mobile-bloom strong{padding:1px 7px;font-size:calc(12px * var(--fs,1))}
    .journey-mobile .journey-summary{margin:0;font-size:calc(14px * var(--fs,1));line-height:1.6}
    .journey-bottom{order:2;margin:0;padding-top:6px;gap:6px 8px}
    .journey-steps{gap:10px}
    .journey-steps a{gap:10px;font-size:calc(12px * var(--fs,1));min-height:32px}
    .journey-skip{font-size:calc(12px * var(--fs,1))}
    .customer-journey.is-enhanced{height:430svh}
    .is-enhanced .journey-view{min-height:0;padding:14px 0 8px;align-items:stretch}
    .is-enhanced .journey-layout{width:100%;height:100%;grid-template-rows:auto minmax(0,1fr) auto;gap:12px}
    .is-enhanced .journey-intro .journey-body{display:none}
    .is-enhanced .journey-mobile{grid-template-rows:minmax(220px,1fr) auto;align-self:stretch;min-height:0}
    .is-enhanced .journey-mobile-viewport{height:100%;max-height:320px;min-height:220px;overflow:hidden;align-self:center}
    .is-enhanced .journey-mobile-track{display:flex;width:100%;height:100%;gap:16px;transform:translate3d(var(--journey-mobile-x,0px),0,0)}
    .is-enhanced .journey-mobile-card{flex:0 0 calc(100% - 40px);height:100%;min-height:220px}
    .is-enhanced .journey-mobile-messages li{grid-area:1/1;opacity:0;visibility:hidden}
    .is-enhanced .journey-mobile-messages li.is-message-current{opacity:1;visibility:visible}
    .is-enhanced .journey-mobile-cue{display:block;width:100%;margin:0;color:var(--green-ink);font-size:calc(12px * var(--fs,1));line-height:1.5}
    .customer-journey:not(.is-enhanced) .journey-panel:not(.journey-intro){display:none}
    .customer-journey:not(.is-enhanced) .journey-mobile-art{height:160px}
    .customer-journey:not(.is-enhanced) .journey-steps{display:none}
  }
  @media(prefers-reduced-motion:reduce){.is-enhanced .journey-messages li{opacity:1}}
</style>

<script>
  import { mobileJourneyState, mobileStepProgress } from '../lib/customer-journey-mobile.mjs';

  // One scroll value owns every visual state. No clock, damping, or autoplay.
  document.querySelectorAll<HTMLElement>('[data-customer-journey]').forEach((root) => {
    const view = root.querySelector<HTMLElement>('.journey-view')!;
    const layout = root.querySelector<HTMLElement>('.journey-layout')!;
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-phase]'));
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-journey-step]'));
    const stages = panels.filter(panel => Number(panel.dataset.phase) >= 0);
    const stepCount = stages.length;
    const linePhase = stages.findIndex(panel => panel.dataset.stage === 'line');
    const messages = Array.from(stages[linePhase]?.querySelectorAll<HTMLElement>('.journey-messages li') ?? []);
    const mobileMessages = Array.from(root.querySelectorAll<HTMLElement>('.journey-mobile-messages li'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-journey-slide]'));
    const cue = root.querySelector<HTMLElement>('.journey-mobile-cue')!;
    const trace = root.querySelector<SVGCircleElement>('.journey-trace')!;
    const traveler = root.querySelector<HTMLElement>('.journey-traveler')!;
    const blooms = Array.from(root.querySelectorAll<HTMLElement>('.journey-bloom')).map(element => ({
      element, petals: Array.from(element.querySelectorAll<SVGGElement>('[data-bloom-petal]'))
    }));
    const header = document.querySelector<HTMLElement>('.header');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 640px)');
    const clamp = (n: number) => Math.max(0, Math.min(1, n));
    const ease = (n: number) => { const t = clamp(n); return t * t * (3 - 2 * t); };
    const introEnd = .12;
    const loopEnd = .90;
    const bloomEnd = .975;
    let frame = 0;
    let active = -2;
    let headerHeight = 0;
    let mobileStride = 0;
    let enhanced = true;

    const setPanels = (phase: number) => {
      panels.forEach(panel => { panel.hidden = Number(panel.dataset.phase) !== (mobile.matches ? -1 : phase); });
    };
    const draw = () => {
      frame = 0;
      if (!enhanced) return;
      const distance = Math.max(1, root.offsetHeight - view.offsetHeight);
      const progress = clamp((headerHeight - root.getBoundingClientRect().top) / distance);
      const phone = mobileJourneyState(progress);
      const route = clamp((progress - introEnd) / (loopEnd - introEnd));
      const phase = mobile.matches ? phone.phase : progress < introEnd ? -1 : Math.min(stepCount - 1, Math.floor(route * stepCount));
      if (phase !== active) {
        setPanels(phase);
        links.forEach(link => {
          if (Number(link.dataset.journeyStep) === phase) link.setAttribute('aria-current', 'step');
          else link.removeAttribute('aria-current');
        });
        cards.forEach((card, i) => {
          if (i === phase) card.setAttribute('aria-current', 'step');
          else card.removeAttribute('aria-current');
        });
        active = phase;
      }
      // Desktop follows its original circle; the phone translates a single horizontal row.
      trace.setAttribute('stroke-dashoffset', String(2 * Math.PI * 177 * (1 - route)));
      const angle = (-90 + route * 360) * Math.PI / 180;
      traveler.style.left = `${50 + Math.cos(angle) * 177 / 620 * 100}%`;
      traveler.style.top = `${50 + Math.sin(angle) * 177 / 620 * 100}%`;
      if (mobile.matches) {
        const position = reduced.matches ? phone.phase : phone.position;
        view.style.setProperty('--journey-mobile-x', `${-position * mobileStride}px`);
        cue.textContent = phone.complete ? '成約まで、一気通貫。続きは下へ ↓' : '下にスクロールして、次のステップへ ↓';
      }
      const messageProgress = mobile.matches ? phone.messageProgress : clamp(route * stepCount - linePhase);
      view.style.setProperty('--journey-message', String(messageProgress * (messages.length + 1)));
      [messages, mobileMessages].forEach(group => {
        const current = Math.min(group.length - 1, Math.floor(messageProgress * group.length));
        group.forEach((message, i) => message.classList.toggle('is-message-current', i === current));
      });
      const bloomProgress = mobile.matches ? phone.bloomProgress : clamp((progress - loopEnd) / (bloomEnd - loopEnd));
      const bloomVisible = bloomProgress > 0;
      const openness = reduced.matches ? Number(bloomVisible) : bloomProgress;
      view.style.setProperty('--journey-bloom-opacity', String(ease(openness * 4)));
      traveler.style.opacity = String(1 - ease(openness));
      blooms.forEach(({ element, petals }) => {
        element.hidden = !bloomVisible;
        element.setAttribute('aria-hidden', String(!bloomVisible));
        petals.forEach((petal, i) => {
          const opening = ease((openness - i * .05) / .8);
          petal.setAttribute('transform', `scale(${.28 + .72 * opening} ${.1 + .9 * opening})`);
        });
      });
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(draw); };
    const measure = () => {
      headerHeight = header?.offsetHeight ?? 0;
      root.style.setProperty('--journey-header', `${headerHeight}px`);
      root.classList.add('is-enhanced');
      setPanels(Math.max(-1, active));
      links.forEach(link => {
        link.setAttribute('href', `#${root.id}-${mobile.matches ? 'mobile' : 'stage'}-${link.dataset.journeyStep}`);
      });
      if (mobile.matches) {
        const padding = getComputedStyle(view);
        const available = view.clientHeight - parseFloat(padding.paddingTop) - parseFloat(padding.paddingBottom);
        const viewport = root.querySelector<HTMLElement>('.journey-mobile-viewport')!;
        mobileStride = cards[1].offsetLeft - cards[0].offsetLeft;
        enhanced = layout.scrollHeight <= available + 2 && viewport.clientHeight >= 220 &&
          cards.every(card => card.scrollHeight <= card.clientHeight + 2);
      } else {
        enhanced = window.innerHeight >= 650 && layout.scrollHeight + 40 <= window.innerHeight - headerHeight;
      }
      root.classList.toggle('is-enhanced', enhanced);
      if (!enhanced) {
        panels.forEach(panel => { panel.hidden = false; });
        links.forEach(link => link.removeAttribute('aria-current'));
        cards.forEach(card => card.removeAttribute('aria-current'));
        trace.setAttribute('stroke-dashoffset', '0');
        traveler.hidden = true;
        blooms.forEach(({ element }) => {
          element.hidden = true;
          element.setAttribute('aria-hidden', 'true');
        });
      } else {
        traveler.hidden = false;
        active = -2;
      }
      schedule();
    };
    links.forEach(link => link.addEventListener('click', (event) => {
      if (!enhanced || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const phase = Number(link.dataset.journeyStep);
      const progress = mobile.matches ? mobileStepProgress[phase] : introEnd + (loopEnd - introEnd) * ((phase + .08) / stepCount);
      const top = window.scrollY + root.getBoundingClientRect().top - headerHeight;
      window.scrollTo({ top: top + (root.offsetHeight - view.offsetHeight) * progress, behavior: reduced.matches ? 'instant' : 'smooth' });
    }));
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', measure);
    window.addEventListener('pageshow', measure);
    reduced.addEventListener('change', schedule);
    document.fonts.ready.then(measure);
    measure();
  });
</script>
