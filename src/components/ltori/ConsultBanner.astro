---
import service from '../../data/service-ltori.json';
interface Props { placement: string; }
const { placement } = Astro.props;
---
<div class="lt-consult-card">
  <div class="lt-consult-art" aria-hidden="true">
    <span class="lt-consult-label">LET’S TALK!</span>
    <img src="/service/ltori/isometric-communication.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="" />
    <span class="lt-consult-stamp">採用のこと、<br />一緒に考えます。</span>
  </div>
  <div class="lt-consult-bubble">
    <p class="lt-consult-kicker">まずは、お気軽に。</p>
    <h2><mark>貴社に合う採用LINE</mark>を<br />一緒につくりませんか？</h2>
    <p>お悩みの整理から、Lトリがお手伝いします。</p>
    <a class="lt-button lt-button-large" href="/contact/?service=ltori" data-lt-cta={placement}>
      <span><small>オンラインでご相談いただけます</small>無料相談をする</span><span class="lt-button-arrow" aria-hidden="true">↗</span>
    </a>
    <a class="lt-doc-link" href={service.source} target="_blank" rel="noopener" data-lt-doc>サービス資料を見る <span aria-hidden="true">↗</span></a>
  </div>
</div>
