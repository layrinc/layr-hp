---
import {areaPath} from '../../lib/ltori-seo.mjs';
import {localCoverageFor, townSource} from '../../lib/ltori-local-content.mjs';
const {area} = Astro.props;
const coverage = localCoverageFor(area);
---
<section class="lt-section lt-area-links" id="area" aria-labelledby="local-area-title">
  <div class="lt-wrap">
    <div class="lt-section-heading">
      <p class="lt-eyebrow">Service Area</p>
      <h2 id="local-area-title">{area.fullName}全域で<br /><mark>採用LINEの構築・運用を支援</mark></h2>
      <p>事業所や店舗の所在地に合わせて、採用の導線を設計します。ご相談から構築・配信・運用改善まで、オンラインで対応します。</p>
    </div>
    {coverage.children.length > 0 ? <>
      <h3>{area.name}の{coverage.kind === 'wards' ? '区別' : '市区町村別'}の対応ページ</h3>
      <nav aria-label={`${area.name}の地域別ページ`}><ul class="lt-area-list">{coverage.children.map(city=><li><a href={areaPath(city)}>{city.name}</a></li>)}</ul></nav>
    </> : coverage.labels.length > 0 ? <>
      <h3>{area.name}の対応エリア例</h3>
      <ul class="lt-local-town-list">{coverage.labels.map(town=><li>{town}</li>)}</ul>
    </> : <p>町域名の記載がない場合も、勤務地と募集内容をお知らせください。ご希望の運用方法をオンラインで伺います。</p>}
    <p class="lt-local-coverage-note">掲載している地域以外も、{area.fullName}での採用をご相談いただけます。現地での撮影・訪問が必要な場合は、対応可否と費用を個別に確認します。</p>
    {coverage.kind === 'towns' && <p class="lt-note">町域表記の出典：<a class="lt-local-source" href={townSource.sourceUrl} target="_blank" rel="noopener">日本郵便「住所の郵便番号」</a>（{townSource.sourceUpdatedAt}更新）。町域表記の一部を例示しています。</p>}
  </div>
</section>
