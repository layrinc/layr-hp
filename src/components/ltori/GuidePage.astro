---
import Layout from '../../layouts/LtoriGuide.astro';
import Pricing from './GuidePricing.astro';
import service from '../../data/service-ltori.json';
import company from '../../data/company.json';
import { consultationHref, guideKey, guideName, guidePath, publishedGuides } from '../../lib/ltori-seo.mjs';
const { guide } = Astro.props;
const name = guideName(guide);
const source = guideKey(guide);
const consult = consultationHref(source);
const parent = guide.kind === 'area' && guide.slug.includes('/') ? publishedGuides.find(g => g.kind === 'area' && g.slug === guide.slug.split('/')[0]) : null;
const breadcrumbs = [{name:'ホーム',path:'/'},{name:service.name,path:service.path},{name:'全国対応・活用案',path:'/service/ltori/area/'},...(parent ? [{name:parent.label,path:guidePath(parent)}] : []),{name:guide.label,path:guidePath(guide)}];
const related = (guide.related || []).map(key => publishedGuides.find(g => guideKey(g) === key)).filter(Boolean);
const faqs = [...guide.faq, {q:'オンラインで相談・依頼できますか？',a:'全国の企業からオンラインでご相談いただけます。打ち合わせと構築確認もオンラインで進めます。現地撮影・訪問などが必要な場合は、対応可否と費用を個別にご相談ください。'}];
const jsonLd = [{ '@context':'https://schema.org','@type':'Service',name:`${name}の${service.descriptor}`,serviceType:service.descriptor,description:guide.description,url:new URL(guidePath(guide),Astro.site).href,provider:{'@id':'https://layr.co.jp/#organization'},areaServed:guide.kind==='area'?{'@type':parent?'City':'AdministrativeArea',name}:{'@type':'Country',name:'日本'} }];
---
<Layout title={`${name}の採用LINE構築・運用支援｜${service.name}｜LAYR`} description={guide.description} source={source} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <section class="ltg-hero ltg-wrap">
    <div><p class="ltg-label">{name}の企業さまへ · 全国オンライン対応</p><h1>{name}の<br /><span>採用LINE</span><wbr /><span class="ltg-title-tail">構築・運用支援</span></h1><p class="ltg-lead">{guide.headline}</p><p>{guide.lead}</p><div class="ltg-actions"><a class="ltg-button" href={consult} data-ltg-cta="hero">自社での活用を相談する <span aria-hidden="true">↗</span></a><a href="#approach">活用案を読む ↓</a></div></div>
    <aside class="ltg-brief"><p class="ltg-label">最初に整理すること</p><ol>{guide.checklist.slice(0,3).map((item,i)=><li><span aria-hidden="true">0{i+1}</span><p>{item}</p></li>)}</ol><p class="ltg-small">エルトリは候補者との接点を育てる採用LINE支援です。求人を見つけてもらう入口も、一緒に整理します。</p></aside>
  </section>
  <section class="ltg-section ltg-tint" id="approach">
    <div class="ltg-wrap ltg-split"><div><p class="ltg-label">{guide.kind==='area'?'地域の情報と、採用の入口':'業種に合わせた設計'}</p><h2>{guide.contextTitle}</h2></div><div><p>{guide.context}</p>{guide.sources[guide.contextSource] && <p class="ltg-small">参照：<a href={guide.sources[guide.contextSource].url} target="_blank" rel="noopener">{guide.sources[guide.contextSource].title} ↗</a></p>}<p class="ltg-small">以下は{company.name}による活用提案です。導入実績や効果を示すものではありません。</p></div></div>
  </section>
  <section class="ltg-section"><div class="ltg-wrap"><p class="ltg-label">候補者に届ける情報</p><h2>応募の前から、<br />次の一歩をつくる。</h2><ol class="ltg-steps">{guide.steps.map((step,i)=><li><span class="ltg-step-number" aria-hidden="true">0{i+1}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol><p class="ltg-small">配信の出し分け・予約受付・リマインドなどは、利用ツールとプランに応じて設計します。</p></div></section>
  <section class="ltg-section ltg-tint"><div class="ltg-wrap ltg-split"><div><p class="ltg-label">ご相談の準備</p><h2>まずは、今ある情報から。</h2><p>すべて揃っていなくても大丈夫です。<br />募集内容と、伝えたい職場の姿を伺います。</p></div><ul class="ltg-checklist">{guide.checklist.map(item=><li>{item}</li>)}</ul></div></section>
  <Pricing />
  <section class="ltg-section ltg-tint"><div class="ltg-wrap ltg-split"><div><p class="ltg-label">進め方</p><h2>オンラインで、<br />相談から改善まで。</h2></div><ol class="ltg-process"><li><strong>ヒアリング・設計</strong><p>募集職種、採用方法、候補者との連絡を整理します。</p></li><li><strong>構築・確認</strong><p>アカウント、メニュー、配信をつくり、企業さまと動作を確認します。</p></li><li><strong>配信・改善</strong><p>反応と面談につながる動きを確認し、運用内容を見直します。</p></li></ol></div></section>
  <section class="ltg-section"><div class="ltg-wrap"><p class="ltg-label">よくあるご質問</p><h2>{name}でのご相談について</h2><div class="ltg-faq">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
  <section class="ltg-section ltg-tint"><div class="ltg-wrap"><p class="ltg-label">関連する活用案</p><h2>地域と、仕事の特徴から。</h2><ul class="ltg-link-list">{related.map(g=><li><a href={guidePath(g)}>{guideName(g)}の採用LINE <span aria-hidden="true">↗</span></a></li>)}</ul><p><a href="/service/ltori/area/">全国の対応エリア・活用案へ →</a></p></div></section>
  <div class="ltg-wrap ltg-sources"><p class="ltg-small">編集：{company.name} · 内容確認日：<time datetime={guide.checkedAt}>{guide.checkedAt}</time></p>{guide.sources.length>0&&<><p class="ltg-small">地域情報の出典</p><ul>{guide.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener">{s.title} ↗</a></li>)}</ul><p class="ltg-small">公的機関との提携を示すものではありません。募集・制度等の最新情報は各公式サイトでご確認ください。</p></>}</div>
</Layout>
