    <div class={`container zz-row is-${p.side === 'right' ? 'right' : 'left'}`}>
      <div class="zz-txt">
        {p.eyebrow && <p class="zz-eyebrow"><i></i><span>{p.eyebrow}</span></p>}
        {p.title && <h2 class="zz-title" set:html={rich(p.title)}></h2>}
        {p.lead && <div class="zz-lead blk-rich" set:html={rich(p.lead)}></div>}
        {(p.steps || []).length > 0 && (
          <ol class="zz-steps reveal">
            {p.steps.map((s: any, i: number) => (
