---
/**
 * 30秒料金シミュレーター（選択式4問 → 構築×運用プランと料金目安）。
 * TOP（index.astroがpricingブロック直後に挿入）と /service/line/ の両方で使う共通部品。
 * 1ページ1回のみ設置可（getElementById使用のため）。
 */
interface Props { docHref?: string; consult?: string; }
const { docHref = '/document/', consult = '/contact/' } = Astro.props;
---
<div class="sim-card" id="simCard">
  <div class="sim-prog"><span class="on" data-s="1">1</span><i></i><span data-s="2">2</span><i></i><span data-s="3">3</span><i></i><span data-s="4">4</span><i></i><span data-s="5">¥</span></div>
  <div class="sim-step" data-step="1">
    <p class="sim-q">Q1. 業種を教えてください</p>
    <div class="sim-opts">
      <button data-v="store">店舗・飲食</button><button data-v="clinic">クリニック・美容</button><button data-v="ec">EC・通販</button><button data-v="school">スクール・教育</button><button data-v="other">その他・BtoB</button>
    </div>
  </div>
  <div class="sim-step" data-step="2" hidden>
    <p class="sim-q">Q2. LINE公式アカウントの現状は？</p>
    <div class="sim-opts">
      <button data-v="new">これから開設する</button><button data-v="idle">開設済みだが、ほぼ動かせていない</button><button data-v="active">運用中。テコ入れしたい</button>
    </div>
  </div>
  <div class="sim-step" data-step="3" hidden>
    <p class="sim-q">Q3. LINEで一番やりたいことは？</p>
    <div class="sim-opts">
      <button data-v="base">まずは形を整えたい（土台づくり）</button><button data-v="grow">集客・再来店を伸ばしたい</button><button data-v="auto">予約・販売・診断まで自動化したい</button>
    </div>
  </div>
  <div class="sim-step" data-step="4" hidden>
    <p class="sim-q">Q4. 毎月の運用は誰がやりますか？</p>
    <div class="sim-opts">
      <button data-v="self">自社で運用する（構築のみ依頼）</button><button data-v="lite">配信は任せたい（月2回ほど）</button><button data-v="std">週1配信＋分析まで任せたい</button><button data-v="full">戦略から丸ごと任せたい</button>
    </div>
  </div>
  <div class="sim-step" data-step="5" hidden>
    <p class="sim-q">貴社の目安はこちらです</p>
    <div class="sim-result">
      <div class="sim-price"><p class="t">初期構築</p><p class="n" id="simBuildName"></p><p class="v"><em id="simBuild"></em>万円</p></div>
      <div class="sim-plus">＋</div>
      <div class="sim-price"><p class="t">月額運用</p><p class="n" id="simOpsName"></p><p class="v" id="simOps"></p></div>
    </div>
    <ul class="sim-inc" id="simInc"></ul>
    <p class="sim-note">※ 税抜の目安です。LINE公式アカウント・Lステップの利用料は別途各社へ発生します。正式なお見積もりはヒアリング後に無料でご提示します。</p>
    <div class="sim-cta">
      <a class="btn btn-green" href={docHref}>この内容で資料をダウンロード</a>
      <a class="btn btn-line sim-line" href={consult}>LINEで相談する</a>
    </div>
  </div>
  <button class="sim-back" id="simBack" hidden>← 最初にもどる</button>
</div>

<style>
  .sim-card{background:#fff;border:1.5px solid var(--line,#E3ECEC);border-radius:20px;padding:clamp(26px,4vw,40px);box-shadow:0 2px 12px rgba(14,26,28,.04);max-width:820px;margin:0 auto}
  .sim-prog{display:flex;align-items:center;gap:0;margin-bottom:30px}
  .sim-prog span{width:34px;height:34px;border-radius:50%;background:#F1F5F4;color:var(--muted,#5A6B6D);display:grid;place-items:center;font-family:var(--font-en,"Noto Sans JP");font-weight:700;font-size:13px;flex:none;transition:background .2s,color .2s}
  .sim-prog span.on{background:var(--green,#17A673);color:#fff}
  .sim-prog span.done{background:var(--green-dark,#0E4F44);color:#fff}
  .sim-prog i{flex:1;height:2px;background:var(--line,#E3ECEC)}
  .sim-q{font-size:17px;font-weight:700;color:var(--black,#0E1A1C);margin-bottom:18px;text-align:left}
  .sim-opts{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .sim-opts button{font-family:var(--font-jp,'Noto Sans JP');text-align:left;font-size:14px;font-weight:700;color:var(--black,#0E1A1C);background:#fff;border:2px solid var(--line,#E3ECEC);border-radius:12px;padding:15px 18px;cursor:pointer;transition:border-color .15s,background .15s}
  .sim-opts button:hover{border-color:var(--green,#17A673);background:color-mix(in srgb,var(--green,#17A673) 6%,#fff)}
  .sim-back{margin-top:20px;background:none;border:none;color:var(--muted,#5A6B6D);font-size:13px;cursor:pointer;font-family:var(--font-jp,'Noto Sans JP');text-decoration:underline;text-underline-offset:4px}
  .sim-result{display:flex;align-items:stretch;gap:12px;flex-wrap:wrap;margin-bottom:18px}
  .sim-price{flex:1;min-width:180px;background:color-mix(in srgb,var(--green,#17A673) 7%,#fff);border-radius:14px;padding:20px 22px;text-align:center}
  .sim-price .t{font-size:12px;font-weight:700;color:var(--muted,#5A6B6D)}
  .sim-price .n{font-size:15px;font-weight:700;color:var(--green-dark,#0E4F44);margin:3px 0}
  .sim-price .v{font-size:15px;font-weight:700;color:var(--black,#0E1A1C)}
  .sim-price .v :global(em){font-style:normal;font-family:var(--font-en,"Noto Sans JP");font-size:34px;font-weight:700;letter-spacing:-.02em}
  .sim-plus{display:grid;place-items:center;font-size:20px;font-weight:700;color:var(--green,#17A673)}
  .sim-inc{list-style:none;margin:0 0 14px;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .sim-inc :global(li){font-size:12px;font-weight:700;color:var(--green-dark,#0E4F44);background:var(--tint,#EDF7F2);border-radius:999px;padding:5px 14px}
  .sim-note{font-size:11.5px;color:var(--muted,#5A6B6D);line-height:1.8;margin-bottom:20px;text-align:left}
  .sim-cta{display:flex;gap:12px;flex-wrap:wrap}
  .sim-cta .sim-line :global(svg){width:1.2em;height:1.2em}
  @media(max-width:640px){.sim-opts{grid-template-columns:1fr}.sim-plus{width:100%}}
</style>

<script is:inline>
  (function () {
    var card = document.getElementById('simCard');
    if (!card || card.dataset.bound) return;
    card.dataset.bound = '1';
    var ans = {};
    var step = 1;
    var BUILD = { base: ['ライト', 10, ['初期基本設定', 'リッチメニュー', 'あいさつ・応答設定']], grow: ['スタンダード', 25, ['導線作成', 'リッチメニューデザイン', 'ステップ配信', 'フォーム制作']], auto: ['プレミアム', 40, ['戦略設計（3C/4P）', 'タブ付きリッチメニュー', '診断コンテンツ', '流入経路分析']] };
    var OPS = { self: ['なし（自社運用）', 0, []], lite: ['サポート', 3, ['配信代行 月2回']], std: ['スタンダード', 5, ['配信 週1回', '配信内容の作成', '分析レポート', 'Zoomコンサル月1回']], full: ['戦略', 10, ['配信 月8回（随時）', '分析レポート', 'Zoomコンサル月1回', '改善提案']] };
    var KEYS = ['industry', 'status', 'goal', 'ops'];
    function show(n) {
      step = n;
      card.querySelectorAll('.sim-step').forEach(function (s) { s.hidden = String(n) !== s.dataset.step; });
      card.querySelectorAll('.sim-prog span').forEach(function (sp, i) {
        sp.className = i + 1 < n ? 'done' : i + 1 === n ? 'on' : '';
      });
      document.getElementById('simBack').hidden = n === 1;
      if (n === 5) render();
    }
    function render() {
      var b = BUILD[ans.goal] || BUILD.base;
      var o = OPS[ans.ops] || OPS.self;
      document.getElementById('simBuildName').textContent = b[0] + 'プラン';
      document.getElementById('simBuild').textContent = b[1];
      document.getElementById('simOpsName').textContent = o[0];
      document.getElementById('simOps').innerHTML = o[1] ? '<em>' + o[1] + '</em>万円/月' : '<em>0</em>円';
      document.getElementById('simInc').innerHTML = b[2].concat(o[2]).map(function (x) { return '<li>' + x + '</li>'; }).join('');
      if (typeof gtag === 'function') gtag('event', 'sim_complete', { industry: ans.industry, build: b[0], ops: o[0] });
    }
    card.querySelectorAll('.sim-step .sim-opts button').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var s = Number(btn.closest('.sim-step').dataset.step);
        ans[KEYS[s - 1]] = btn.dataset.v;
        show(s + 1);
      });
    });
    document.getElementById('simBack').addEventListener('click', function () { ans = {}; show(1); });
  })();
</script>
