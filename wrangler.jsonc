{
  "$schema": "node_modules/wrangler/config-schema.json",
  // layr.co.jp コーポレートサイト（Astro静的ビルドをWorkers Assetsで配信）
  "name": "layr-hp",
  "main": "worker/index.mjs",
  "account_id": "970414d67575a1afb2eb889748741af7",
  "compatibility_date": "2026-08-01",
  "keep_vars": true,
  "d1_databases": [{ "binding": "SEO_DB" }],
  "triggers": { "crons": ["0 0 * * *", "15 21 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
